<UserControl
    x:Class="Xperience.App.Controls.LyricsNotFoundControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsHitTestVisible="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Gentle floating, swaying, drooping flag & breathing aura (3.6s smooth sine loop) -->
        <Storyboard x:Name="SadNoteFloatStoryboard" RepeatBehavior="Forever">
            <!-- Note vertical hover bob -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteBodyCanvas"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="-7.5">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:3.6" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- Gentle melancholic head-tilt sway -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoteBodyCanvas"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="-3.2" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="3.2">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:3.6" Value="-3.2">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- Secondary motion: musical flag gently droops slightly out of phase -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlagCanvas"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.Rotation)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1.5" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="-2.5">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:2.7" Value="5.5">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:3.6" Value="1.5">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- Ground shadow narrows & softens as the note floats upward -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShadowEllipse"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.78">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:3.6" Value="1.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShadowEllipse"
                                           Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0.28" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.14">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:3.6" Value="0.28">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- Ambient glow breathing pulse -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AmbientHaloEllipse"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0.94" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="1.06">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:3.6" Value="0.94">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AmbientHaloEllipse"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0.94" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="1.06">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:3.6" Value="0.94">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <!-- Quiet floating mini-note drift -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniNotePath"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="4" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.2" Value="-6">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:3.6" Value="4">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MiniNotePath"
                                           Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0.16" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.44" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.6" Value="0.16" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Animated glistening teardrop forming, falling, and fading out (2.9s cycle) -->
        <Storyboard x:Name="SadNoteTeardropStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TeardropGroup"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.20" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="1.00">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.65" Value="0.92" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.10" Value="0.65" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.90" Value="0.20" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TeardropGroup"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.20" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="1.00">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.65" Value="1.15" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.10" Value="0.80" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.90" Value="0.20" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TeardropGroup"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="-1.5" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.55" Value="0.0" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.05" Value="22.0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.90" Value="-1.5" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TeardropGroup"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="0.96" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.55" Value="0.92" />
                <LinearDoubleKeyFrame KeyTime="0:0:2.10" Value="0.0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:2.90" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Expressive periodic eye blink (4.6s organic cadence) -->
        <Storyboard x:Name="SadNoteBlinkStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EyesGroup"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.00" Value="1.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:3.70" Value="1.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:3.82" Value="0.10" />
                <LinearDoubleKeyFrame KeyTime="0:0:3.96" Value="1.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:4.60" Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Background="Transparent"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Padding="20,16">

        <StackPanel x:Name="ContentStack"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">

            <!-- Custom Animated Sad Musical Note SVG Icon -->
            <Viewbox x:Name="IconViewbox"
                     Width="92"
                     Height="92"
                     HorizontalAlignment="Center"
                     Stretch="Uniform">
                <Canvas Width="120" Height="120">
                    <!-- Soft radial ambient aura behind the musical note -->
                    <Ellipse x:Name="AmbientHaloEllipse"
                             Canvas.Left="10"
                             Canvas.Top="10"
                             Width="100"
                             Height="100"
                             Opacity="0.26"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <CompositeTransform />
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush x:Name="AmbientHaloBrush">
                                <GradientStop x:Name="AmbientHaloInnerStop" Offset="0.0" Color="#662DD4BF" />
                                <GradientStop x:Name="AmbientHaloOuterStop" Offset="1.0" Color="#002DD4BF" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Floating ground shadow -->
                    <Ellipse x:Name="ShadowEllipse"
                             Canvas.Left="24"
                             Canvas.Top="104"
                             Width="52"
                             Height="8"
                             Opacity="0.28"
                             Fill="#FF000000"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <CompositeTransform />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Delicate floating secondary mini-note accent -->
                    <Path x:Name="MiniNotePath"
                          Data="M 19,43 C 19,45.8 16.5,48 13.5,48 C 10.5,48 8.2,45.8 8.2,43.2 C 8.2,40.6 10.5,38.4 13.5,38.4 C 15.1,38.4 16.4,39 17.2,39.8 L 17.2,26.5 C 17.2,25.5 18,24.8 19,25 C 22.8,25.7 25.4,28.1 26.2,31.3 C 26.5,32.3 25.3,33.1 24.5,32.4 C 23.1,31.1 21.3,30.2 19,29.9 Z"
                          Fill="#88FFFFFF"
                          Opacity="0.26">
                        <Path.RenderTransform>
                            <CompositeTransform />
                        </Path.RenderTransform>
                    </Path>

                    <!-- Main Swaying & Floating Sad Musical Note Body -->
                    <Canvas x:Name="NoteBodyCanvas" Width="120" Height="120">
                        <Canvas.RenderTransform>
                            <CompositeTransform CenterX="56" CenterY="64" />
                        </Canvas.RenderTransform>

                        <!-- Secondary-motion drooping musical flag -->
                        <Canvas x:Name="FlagCanvas" Width="120" Height="120">
                            <Canvas.RenderTransform>
                                <CompositeTransform CenterX="74" CenterY="23" />
                            </Canvas.RenderTransform>
                            <Path x:Name="NoteFlagPath"
                                  Data="M 73,19.2 C 85,19.4 97,24.8 102.2,36 C 105.6,43.4 103.8,52.2 97.6,57.4 C 96.0,58.7 93.5,57.6 93.9,55.4 C 95.3,48.0 94.0,42.0 89.2,37.6 C 84.6,33.4 79.2,31.6 73,31.4 Z"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round" />
                        </Canvas>

                        <!-- Seamless single-path eighth-note stem + plump notehead -->
                        <Path x:Name="NoteBodyPath"
                              Data="M 69,23 A 4,4 0 0,1 77,23 L 77,73.5 C 77,87 64.5,97 48,97 C 31,97 19,86.5 19,73.5 C 19,60.5 31,50 48,50 C 57,50 64.5,53.4 69,58.5 Z"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round" />

                        <!-- Subtle top-left glass specular highlight arc -->
                        <Path x:Name="NoteSpecularPath"
                              Data="M 27.5,67 C 30.8,59.5 38.8,55 47.5,54.8"
                              Stroke="#54FFFFFF"
                              StrokeThickness="2.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />

                        <!-- Sad slanted eyebrows -->
                        <Path x:Name="LeftBrowPath"
                              Data="M 30.8,67.5 Q 36.2,66.2 40.8,62.4"
                              StrokeThickness="2.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />

                        <Path x:Name="RightBrowPath"
                              Data="M 65.2,67.5 Q 59.8,66.2 55.2,62.4"
                              StrokeThickness="2.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />

                        <!-- Expressive glossy eyes (with periodic blink) -->
                        <Canvas x:Name="EyesGroup" Width="120" Height="120">
                            <Canvas.RenderTransform>
                                <CompositeTransform CenterX="48" CenterY="73.5" />
                            </Canvas.RenderTransform>

                            <Ellipse x:Name="LeftEyeEllipse"
                                     Canvas.Left="34.2"
                                     Canvas.Top="69.7"
                                     Width="7.6"
                                     Height="7.6" />
                            <Ellipse x:Name="LeftEyeGlint"
                                     Canvas.Left="35.6"
                                     Canvas.Top="70.9"
                                     Width="2.6"
                                     Height="2.6"
                                     Fill="#F2FFFFFF" />

                            <Ellipse x:Name="RightEyeEllipse"
                                     Canvas.Left="54.2"
                                     Canvas.Top="69.7"
                                     Width="7.6"
                                     Height="7.6" />
                            <Ellipse x:Name="RightEyeGlint"
                                     Canvas.Left="55.6"
                                     Canvas.Top="70.9"
                                     Width="2.6"
                                     Height="2.6"
                                     Fill="#F2FFFFFF" />
                        </Canvas>

                        <!-- Cute sad downturned frown -->
                        <Path x:Name="FrownPath"
                              Data="M 41.2,85.8 Q 48,79.4 54.8,85.8"
                              StrokeThickness="2.9"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />

                        <!-- Animated glistening teardrop -->
                        <Canvas x:Name="TeardropGroup"
                                Canvas.Left="59.2"
                                Canvas.Top="77.2"
                                Width="10"
                                Height="15"
                                Opacity="0">
                            <Canvas.RenderTransform>
                                <CompositeTransform CenterX="5" CenterY="2" ScaleX="0.2" ScaleY="0.2" />
                            </Canvas.RenderTransform>
                            <Path Data="M 5,0 C 5,0 0.6,6.2 0.6,9.4 A 4.4,4.4 0 1,0 9.4,9.4 C 9.4,6.2 5,0 5,0 Z"
                                  Fill="#FF56CCF2"
                                  Stroke="#AABAE6FD"
                                  StrokeThickness="0.7" />
                            <Ellipse Canvas.Left="2.9"
                                     Canvas.Top="8.0"
                                     Width="2.1"
                                     Height="3.1"
                                     Fill="#DCFFFFFF" />
                        </Canvas>
                    </Canvas>
                </Canvas>
            </Viewbox>

            <!-- Pure English Not-Found Copy -->
            <StackPanel HorizontalAlignment="Center"
                        Spacing="4"
                        Margin="0,2,0,0">
                <TextBlock x:Name="TitleTextBlock"
                           Text="No lyrics found"
                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                           FontSize="16.5"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="SubtitleTextBlock"
                           Text="We couldn't find synced lyrics for this track."
                           FontFamily="{StaticResource TokenBodyFontFamily}"
                           FontSize="12.5"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="250" />

                <TextBlock x:Name="HelperTextBlock"
                           Text="You can import a local .LRC file above anytime."
                           FontFamily="{StaticResource TokenBodyFontFamily}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="240"
                           Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
