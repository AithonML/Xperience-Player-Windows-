<UserControl
    x:Class="Xperience.App.Controls.NightcorePillButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Xperience.App.Controls"
    xmlns:helpers="using:Xperience.App.Helpers"
    mc:Ignorable="d">

    <Grid x:Name="RootContainer"
          Height="36"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          CenterPoint="64,18,0">
        <Grid.ScaleTransition>
            <Vector3Transition Duration="0:0:0.22" />
        </Grid.ScaleTransition>

        <!-- Outer Neon Pulse Halo (Visible and pulsing when Nightcore DSP Mode is ON) -->
        <Border x:Name="NeonGlowHaloBorder"
                CornerRadius="18"
                Margin="-3,-3,-3,-3"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.45" />
            </Border.OpacityTransition>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="#88FF2E93" />
                    <GradientStop Offset="0.5" Color="#88A855F7" />
                    <GradientStop Offset="1.0" Color="#8806B6D4" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Base LiquidGlass Pill -->
        <controls:LiquidGlassPanel x:Name="PillGlassHost"
                                   Height="36"
                                   GlassCornerRadius="18"
                                   GlassPadding="0"
                                   SampleLiveBackdrop="True">
            <Border x:Name="PillAccentSurfaceBorder"
                    CornerRadius="18"
                    BorderThickness="1.25"
                    BorderBrush="#36FFFFFF"
                    Background="#18FFFFFF">
                <Button x:Name="TogglePillButton"
                        Click="OnTogglePillButtonClicked"
                        Style="{StaticResource TransparentEmbeddedButtonStyle}"
                        Height="36"
                        CornerRadius="18"
                        Padding="13,0"
                        helpers:MicroInteractions.HoverScale="1.06"
                        helpers:MicroInteractions.PressScale="0.93"
                        ToolTipService.ToolTip="1-Click Nightcore Real-Time DSP (1.22x Coupled Pitch + 90Hz Sub-Bass + 3.5kHz Presence + Soft Limiter)">
                    <StackPanel Orientation="Horizontal"
                                Spacing="7"
                                VerticalAlignment="Center">
                        <!-- Neon Pulse Dot / Icon -->
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="ActivePulseDot"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="#44FF2E93"
                                    Opacity="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Border.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.35" />
                                </Border.OpacityTransition>
                            </Border>
                            <FontIcon x:Name="NightcoreIcon"
                                      Glyph="&#xE945;"
                                      FontSize="12.5"
                                      Foreground="#FFFFFFFF"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <!-- Primary Label ("Nightcore ON" when active, "Nightcore" when inactive) -->
                        <TextBlock x:Name="LabelTextBlock"
                                   Text="Nightcore"
                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFFFF"
                                   VerticalAlignment="Center" />

                        <!-- Rate & Coupled Pitch Chip (Shown when active) -->
                        <Border x:Name="RateBadgeBorder"
                                Visibility="Collapsed"
                                CornerRadius="8"
                                Padding="6,1.5"
                                VerticalAlignment="Center"
                                Background="#38000000"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="0.75">
                            <TextBlock x:Name="RateBadgeText"
                                       Text="1.22x"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#FFFFE4F3"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
            </Border>
        </controls:LiquidGlassPanel>
    </Grid>
</UserControl>
