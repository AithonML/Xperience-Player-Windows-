<UserControl
    x:Class="Xperience.App.Controls.ExplicitBadgeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.Name="Explicit"
    ToolTipService.ToolTip="Explicit"
    IsHitTestVisible="True"
    mc:Ignorable="d">

    <Border x:Name="BadgeBorder"
            Width="16"
            Height="16"
            CornerRadius="4"
            BorderThickness="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <TextBlock x:Name="BadgeGlyphText"
                   Text="E"
                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                   FontWeight="Bold"
                   FontSize="9.5"
                   LineHeight="9.5"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,-0.5,0,0" />
    </Border>
</UserControl>
