                                                CommandParameter="{x:Bind ViewModel.HomeMoreLike2SeedAlbum, Mode=OneWay}"
                                                Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                                Foreground="#67E8F9"
                                                CornerRadius="14"
                                                Padding="12,0"
                                                FontSize="11.5"
                                                FontWeight="SemiBold" />
                                    </controls:LiquidGlassPanel>
                                </Grid>

                                <Grid x:Name="HomeMoreLike2CarouselHost">
                                    <ScrollViewer x:Name="HomeMoreLike2ScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Padding="18,12,18,20"
                                                  Loaded="OnHomeHorizontalCarouselLoaded"
                                                  SizeChanged="OnHomeHorizontalCarouselSizeChanged"
                                                  ViewChanged="OnHomeHorizontalCarouselViewChanged">
                                        <ItemsControl x:Name="HomeMoreLike2ItemsControl"
                                                      ItemsSource="{x:Bind ViewModel.HomeMoreLike2, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="14"
                                                                SizeChanged="OnHomeHorizontalItemsPanelSizeChanged" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="entities:AlbumItem">
                                                    <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                            Padding="0"
                                                            Click="OnAlbumCardClicked"
                                                            Tag="{x:Bind}"
                                                            helpers:MicroInteractions.HoverScale="1.05"
                                                            helpers:MicroInteractions.PressScale="0.94"
                                                            helpers:MicroInteractions.HoverElevationY="-4">
                                                        <Border Width="172"
                                                                Height="204"
                                                                CornerRadius="24"
                                                                BorderBrush="#33FFFFFF"
                                                                BorderThickness="1"
                                                                Background="#FF141822">
                                                            <Grid>
                                                                <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                                    <FontIcon Glyph="&#xEC4F;"
                                                                              FontSize="34"
                                                                              Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Border CornerRadius="23" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                    <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                           Stretch="UniformToFill"
                                                                           HorizontalAlignment="Stretch"
                                                                           VerticalAlignment="Stretch" />
                                                                </Border>
                                                                <Border IsHitTestVisible="False"
                                                                        Loaded="OnProgressiveCardBlurLoaded"
                                                                        SizeChanged="OnProgressiveCardBlurSizeChanged" />
                                                                <Border IsHitTestVisible="False" CornerRadius="23">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                            <GradientStop Color="#0A000000" Offset="0.0" />
                                                                            <GradientStop Color="#14000000" Offset="0.44" />
                                                                            <GradientStop Color="#92070A12" Offset="0.74" />
                                                                            <GradientStop Color="#EC070A12" Offset="1.0" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <Border HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        Margin="0,10,10,0"
                                                                        CornerRadius="11"
                                                                        Padding="8,3"
                                                                        Background="#78121622"
                                                                        BorderBrush="#42FFFFFF"
                                                                        BorderThickness="0.8"
                                                                        Visibility="{x:Bind HasReleaseYear, Mode=OneWay}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <Ellipse Width="5" Height="5" Fill="#38BDF8" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{x:Bind ReleaseYearText, Mode=OneWay}"
                                                                                   FontSize="10.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="White" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Bottom" Spacing="2" Margin="12,0,12,11">
                                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                               FontSize="12.5"
                                                                               FontWeight="Bold"
                                                                               Foreground="White"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind AlbumArtistSubtitle, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                               FontSize="11"
                                                                               Foreground="#CCDAE6F5"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <!-- 7. Radio Stations (Clickable Header + Cards + See More Card) -->
                            <StackPanel Visibility="{x:Bind ViewModel.HomeRadioStationsVisibility, Mode=OneWay}"
                                        Spacing="10">
                                <Button Command="{x:Bind ViewModel.OpenRadioStationsGridCommand, Mode=OneWay}"
                                        Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="2,4"
                                        helpers:MicroInteractions.HoverScale="1.01"
                                        helpers:MicroInteractions.PressScale="0.985">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                            <Border Width="28" Height="28"
                                                    CornerRadius="9"
                                                    Background="#2422D3EE"
                                                    BorderBrush="#5522D3EE"
                                                    BorderThickness="1">
                                                <FontIcon Glyph="&#xE95A;" FontSize="13" Foreground="#38BDF8" />
                                            </Border>
                                            <TextBlock Text="Radio Stations"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="18.5"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="See more"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#67E8F9" />
                                            <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="#67E8F9" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Grid x:Name="HomeRadioStationsCarouselHost">
                                    <ScrollViewer x:Name="HomeRadioStationsScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Padding="18,12,18,20"
                                                  Loaded="OnHomeHorizontalCarouselLoaded"
                                                  SizeChanged="OnHomeHorizontalCarouselSizeChanged"
                                                  ViewChanged="OnHomeHorizontalCarouselViewChanged">
                                        <StackPanel x:Name="HomeRadioStationsTrackStack"
                                                    Orientation="Horizontal"
                                                    Spacing="14"
                                                    SizeChanged="OnHomeHorizontalItemsPanelSizeChanged">
                                            <ItemsControl x:Name="HomeRadioStationsItemsControl"
                                                          ItemsSource="{x:Bind ViewModel.HomeRadioStations, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="14"
                                                                    SizeChanged="OnHomeHorizontalItemsPanelSizeChanged" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:RadioStationItem">
                                                        <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                                Padding="0"
                                                                Click="OnRadioStationCardClicked"
                                                                Tag="{x:Bind}"
                                                                helpers:MicroInteractions.HoverScale="1.05"
                                                                helpers:MicroInteractions.PressScale="0.94"
                                                                helpers:MicroInteractions.HoverElevationY="-4">
                                                            <Border Width="172"
                                                                    Height="204"
                                                                    CornerRadius="24"
                                                                    BorderBrush="#33FFFFFF"
                                                                    BorderThickness="1"
                                                                    Background="#FF141822">
                                                                <Grid>
                                                                    <Grid Opacity="{x:Bind DefaultIconOpacity, Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xE95A;"
                                                                                  FontSize="34"
                                                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <Border CornerRadius="23" Opacity="{x:Bind ArtworkOpacity, Mode=OneWay}">
                                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeArtworkUri, Mode=OneWay}"
                                                                               Stretch="UniformToFill"
                                                                               HorizontalAlignment="Stretch"
                                                                               VerticalAlignment="Stretch" />
                                                                    </Border>
                                                                    <Border IsHitTestVisible="False"
                                                                            Loaded="OnProgressiveCardBlurLoaded"
                                                                            SizeChanged="OnProgressiveCardBlurSizeChanged" />
                                                                    <Border IsHitTestVisible="False" CornerRadius="23">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                                <GradientStop Color="#12000000" Offset="0.0" />
                                                                                <GradientStop Color="#16000000" Offset="0.40" />
                                                                                <GradientStop Color="#92070A12" Offset="0.70" />
                                                                                <GradientStop Color="#EE070A12" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <Border HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Margin="10,10,0,0"
                                                                            CornerRadius="10"
                                                                            Padding="9,3"
                                                                            Background="#78121622"
                                                                            BorderBrush="#42FFFFFF"
                                                                            BorderThickness="0.8">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <FontIcon Glyph="&#xE95A;" FontSize="9.5" Foreground="#67E8F9" />
                                                                            <TextBlock Text="RADIO"
                                                                                       FontSize="9.5"
                                                                                       FontWeight="Bold"
                                                                                       CharacterSpacing="50"
                                                                                       Foreground="#A5F3FC" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Width="30" Height="30"
                                                                            CornerRadius="15"
                                                                            Padding="0"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,10,10,0"
                                                                            Background="#78121622"
                                                                            BorderBrush="#42FFFFFF"
                                                                            BorderThickness="0.8">
                                                                        <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="#38BDF8" Margin="1,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel VerticalAlignment="Bottom" Spacing="2" Margin="12,0,12,12">
                                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                   FontSize="13.5"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="White"
                                                                                   MaxLines="1"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                                   FontSize="11"
                                                                                   Foreground="#CCDAE6F5"
                                                                                   MaxLines="1"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- End "See more" Glass Card -->
                                            <Button Command="{x:Bind ViewModel.OpenRadioStationsGridCommand, Mode=OneWay}"
                                                    Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                    Padding="0"
                                                    helpers:MicroInteractions.HoverScale="1.05"
                                                    helpers:MicroInteractions.PressScale="0.94">
                                                <Border Width="144"
                                                        Height="204"
                                                        CornerRadius="24"
                                                        Background="#26182234"
                                                        BorderBrush="#4038BDF8"
                                                        BorderThickness="1">
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="8"
                                                                Padding="12">
                                                        <Border Width="42" Height="42"
                                                                CornerRadius="21"
                                                                Background="#2E22D3EE"
                                                                BorderBrush="#6638BDF8"
                                                                BorderThickness="1"
                                                                HorizontalAlignment="Center">
                                                            <FontIcon Glyph="&#xE76C;" FontSize="15" Foreground="#67E8F9" />
                                                        </Border>
                                                        <TextBlock Text="See more"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="13.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="All stations"
                                                                   FontSize="11"
                                                                   Foreground="#9EB4C8"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <!-- 8. Recommended Songs (Responsive up to 4 Columns, Flat Album-Detail Song Row Style) -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="Recommended Songs"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="18.5"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                           Margin="2,0,0,0" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.HomeRecommendedTracks, Mode=OneWay}"
                                              Margin="2,0,2,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:ResponsiveAutoFillGridPanel MinItemWidth="268"
                                                                                  MaxColumns="4"
                                                                                  ColumnSpacing="10"
                                                                                  RowSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:TrackItem">
                                            <Grid MinHeight="56"
                                                  CornerRadius="14"
                                                  Tapped="OnHomeRecommendedTrackTapped"
                                                  RightTapped="OnTrackRowRightTapped"
                                                  PointerEntered="OnHomeTrackRowPointerEntered"
                                                  PointerExited="OnHomeTrackRowPointerExited"
                                                  Tag="{x:Bind}"
                                                  Background="Transparent"
                                                  helpers:MicroInteractions.HoverScale="1.01"
                                                  helpers:MicroInteractions.PressScale="0.988">

                                                <!-- Layer 0: Active Playing Song Illuminated Box Background -->
                                                <Border CornerRadius="14"
                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                        Opacity="{x:Bind ActiveRowHighlightOpacity, Mode=OneWay}"
                                                        IsHitTestVisible="False">
                                                    <Border.OpacityTransition>
                                                        <ScalarTransition Duration="0:0:0.22" />
                                                    </Border.OpacityTransition>
                                                </Border>

                                                <!-- Layer 1: Smooth Hover Highlight Layer -->
                                                <Border CornerRadius="14"
                                                        Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                                                        Opacity="0"
                                                        IsHitTestVisible="False">
                                                    <Border.OpacityTransition>
                                                        <ScalarTransition Duration="0:0:0.16" />
                                                    </Border.OpacityTransition>
                                                </Border>

                                                <!-- Layer 2: Song Row Content (Thumbnail + Equalizer, Title/Artist, Duration, Heart, Vertical More) -->
                                                <Grid Padding="8,7,6,7" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Column 0: Rounded-Square Album Thumbnail + Active 3-Bar Equalizer Overlay -->
                                                    <Border Grid.Column="0"
                                                            Width="42" Height="42"
                                                            CornerRadius="9"
                                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                            VerticalAlignment="Center">
                                                        <Grid>
                                                            <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                                <FontIcon Glyph="&#xEC4F;"
                                                                          FontSize="15"
                                                                          Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Border CornerRadius="9"
                                                                    Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                       Stretch="UniformToFill"
                                                                       HorizontalAlignment="Stretch"
                                                                       VerticalAlignment="Stretch" />
                                                            </Border>
                                                            <!-- Playing Indicator Scrim & 3-Bar Equalizer (|||) -->
                                                            <Border CornerRadius="9"
                                                                    Background="#A6070A12"
                                                                    Opacity="{x:Bind PlayingIndicatorOpacity, Mode=OneWay}"
                                                                    IsHitTestVisible="False">
                                                                <StackPanel Orientation="Horizontal"
                                                                            Spacing="2.5"
                                                                            Height="16"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                                    <Border Width="3"
                                                                            Height="11"
                                                                            CornerRadius="1.5"
                                                                            VerticalAlignment="Center"
                                                                            Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                                    <Border Width="3"
                                                                            Height="16"
                                                                            CornerRadius="1.5"
                                                                            VerticalAlignment="Center"
                                                                            Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                                    <Border Width="3"
                                                                            Height="10"
                                                                            CornerRadius="1.5"
                                                                            VerticalAlignment="Center"
                                                                            Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Column 1: Stacked Song Title (+ Explicit Badge + Offline Icon) & Artist Subtitle -->
                                                    <StackPanel Grid.Column="1"
                                                                Spacing="2"
                                                                VerticalAlignment="Center">
                                                        <Grid ColumnSpacing="5" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                           Opacity="{x:Bind InactiveTitleOpacity, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="13.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                           Opacity="{x:Bind ActiveTitleOpacity, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="13.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                            <controls:ExplicitBadgeControl Grid.Column="1"
                                                                                           IsCompact="True"
                                                                                           Visibility="{x:Bind IsExplicit, Mode=OneWay}"
                                                                                           VerticalAlignment="Center" />
                                                            <FontIcon Grid.Column="2"
                                                                      Glyph="&#xE896;"
                                                                      FontSize="10.5"
                                                                      Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                      Opacity="{x:Bind DownloadedBadgeOpacity, Mode=OneWay}"
                                                                      ToolTipService.ToolTip="Available Offline / Local Audio"
                                                                      VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="11.5"
                                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                   MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Column 2: Formatted Duration -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="2,0,0,0" />

                                                    <!-- Column 3: Heart / Love Button -->
                                                    <Button Grid.Column="3"
                                                            Click="OnTrackRowLikeClicked"
                                                            Tag="{x:Bind}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Width="30"
                                                            Height="30"
                                                            CornerRadius="15"
                                                            Padding="0"
                                                            ToolTipService.ToolTip="Like"
                                                            helpers:MicroInteractions.HoverScale="1.15"
                                                            helpers:MicroInteractions.PressScale="0.88">
                                                        <FontIcon Glyph="{x:Bind LikeGlyph, Mode=OneWay}"
                                                                  Opacity="{x:Bind LikeIconOpacity, Mode=OneWay}"
                                                                  FontSize="13"
                                                                  Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                    </Button>

                                                    <!-- Column 4: Vertical 3-Dots More Options Button -->
                                                    <Button Grid.Column="4"
                                                            Click="OnTrackRowMoreClicked"
                                                            Tag="{x:Bind}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Width="30"
                                                            Height="30"
                                                            CornerRadius="15"
                                                            Padding="0"
                                                            ToolTipService.ToolTip="Song Options"
                                                            helpers:MicroInteractions.HoverScale="1.14"
                                                            helpers:MicroInteractions.PressScale="0.88">
                                                        <FontIcon Glyph="&#xE712;"
                                                                  FontSize="12.5"
                                                                  Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                  RenderTransformOrigin="0.5,0.5">
                                                            <FontIcon.RenderTransform>
                                                                <RotateTransform Angle="90" />
                                                            </FontIcon.RenderTransform>
                                                        </FontIcon>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 9. New Releases (Clickable Header + Cards + See More Card) -->
                            <StackPanel Visibility="{x:Bind ViewModel.HomeNewReleasesVisibility, Mode=OneWay}"
                                        Spacing="10">
                                <Button Command="{x:Bind ViewModel.OpenNewReleasesGridCommand, Mode=OneWay}"
                                        Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="2,4"
                                        helpers:MicroInteractions.HoverScale="1.01"
                                        helpers:MicroInteractions.PressScale="0.985">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                            <Border Width="28" Height="28"
                                                    CornerRadius="9"
                                                    Background="#2422D3EE"
                                                    BorderBrush="#5522D3EE"
                                                    BorderThickness="1">
                                                <FontIcon Glyph="&#xEC4F;" FontSize="13" Foreground="#38BDF8" />
                                            </Border>
                                            <TextBlock Text="New Releases"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="18.5"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="See more"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#67E8F9" />
                                            <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="#67E8F9" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Grid x:Name="HomeNewReleasesCarouselHost">
                                    <ScrollViewer x:Name="HomeNewReleasesScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Padding="18,12,18,20"
                                                  Loaded="OnHomeHorizontalCarouselLoaded"
                                                  SizeChanged="OnHomeHorizontalCarouselSizeChanged"
                                                  ViewChanged="OnHomeHorizontalCarouselViewChanged">
                                        <StackPanel x:Name="HomeNewReleasesTrackStack"
                                                    Orientation="Horizontal"
                                                    Spacing="14"
                                                    SizeChanged="OnHomeHorizontalItemsPanelSizeChanged">
                                            <ItemsControl x:Name="HomeNewReleasesItemsControl"
                                                          ItemsSource="{x:Bind ViewModel.HomeNewReleases, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="14"
                                                                    SizeChanged="OnHomeHorizontalItemsPanelSizeChanged" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:NewReleaseItem">
                                                        <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                                Padding="0"
                                                                Click="OnNewReleaseCardClicked"
                                                                Tag="{x:Bind}"
                                                                helpers:MicroInteractions.HoverScale="1.05"
                                                                helpers:MicroInteractions.PressScale="0.94"
                                                                helpers:MicroInteractions.HoverElevationY="-4">
                                                            <Border Width="172"
                                                                    Height="204"
                                                                    CornerRadius="24"
                                                                    BorderBrush="#33FFFFFF"
                                                                    BorderThickness="1"
                                                                    Background="#FF141822">
                                                                <Grid>
                                                                    <Grid Opacity="{x:Bind DefaultIconOpacity, Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xEC4F;"
                                                                                  FontSize="34"
                                                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <Border CornerRadius="23" Opacity="{x:Bind ArtworkOpacity, Mode=OneWay}">
                                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeArtworkUri, Mode=OneWay}"
                                                                               Stretch="UniformToFill"
                                                                               HorizontalAlignment="Stretch"
                                                                               VerticalAlignment="Stretch" />
                                                                    </Border>
                                                                    <Border IsHitTestVisible="False"
                                                                            Loaded="OnProgressiveCardBlurLoaded"
                                                                            SizeChanged="OnProgressiveCardBlurSizeChanged" />
                                                                    <Border IsHitTestVisible="False" CornerRadius="23">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                                <GradientStop Color="#12000000" Offset="0.0" />
                                                                                <GradientStop Color="#16000000" Offset="0.40" />
                                                                                <GradientStop Color="#92070A12" Offset="0.70" />
                                                                                <GradientStop Color="#EE070A12" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <StackPanel Orientation="Horizontal"
                                                                                Spacing="5"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Top"
                                                                                Margin="10,10,0,0">
                                                                        <Border CornerRadius="10"
                                                                                Padding="8,3"
                                                                                Background="#78121622"
                                                                                BorderBrush="#42FFFFFF"
                                                                                BorderThickness="0.8">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                <Ellipse Width="5" Height="5" Fill="#22D3EE" VerticalAlignment="Center" />
                                                                                <TextBlock Text="NEW"
                                                                                           FontSize="9.5"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="#A5F3FC" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border CornerRadius="10"
                                                                                Padding="8,3"
                                                                                Background="#78121622"
                                                                                BorderBrush="#42FFFFFF"
                                                                                BorderThickness="0.8">
                                                                            <TextBlock Text="{x:Bind TypeBadgeText, Mode=OneWay}"
                                                                                       FontSize="9.5"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="White" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <Border Width="30" Height="30"
                                                                            CornerRadius="15"
                                                                            Padding="0"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,10,10,0"
                                                                            Background="#78121622"
                                                                            BorderBrush="#42FFFFFF"
                                                                            BorderThickness="0.8">
                                                                        <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="White" Margin="1,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel VerticalAlignment="Bottom" Spacing="2" Margin="12,0,12,12">
                                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                   FontSize="13.5"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="White"
                                                                                   MaxLines="2"
                                                                                   TextWrapping="Wrap"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                                   FontSize="11"
                                                                                   Foreground="#CCDAE6F5"
                                                                                   MaxLines="1"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- End "See more" Glass Card -->
                                            <Button Command="{x:Bind ViewModel.OpenNewReleasesGridCommand, Mode=OneWay}"
                                                    Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                    Padding="0"
                                                    helpers:MicroInteractions.HoverScale="1.05"
                                                    helpers:MicroInteractions.PressScale="0.94">
                                                <Border Width="144"
                                                        Height="204"
                                                        CornerRadius="24"
                                                        Background="#26182234"
                                                        BorderBrush="#4038BDF8"
                                                        BorderThickness="1">
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="8"
                                                                Padding="12">
                                                        <Border Width="42" Height="42"
                                                                CornerRadius="21"
                                                                Background="#2E22D3EE"
                                                                BorderBrush="#6638BDF8"
                                                                BorderThickness="1"
                                                                HorizontalAlignment="Center">
                                                            <FontIcon Glyph="&#xE76C;" FontSize="15" Foreground="#67E8F9" />
                                                        </Border>
                                                        <TextBlock Text="See more"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="13.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="All releases"
                                                                   FontSize="11"
                                                                   Foreground="#9EB4C8"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <!-- 10. More like: [Album] #3 -->
                            <StackPanel Visibility="{x:Bind ViewModel.HomeMoreLike3Visibility, Mode=OneWay}"
                                        Spacing="10">
                                <Grid Margin="2,0,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                        <Border Width="28" Height="28"
                                                CornerRadius="9"
                                                Background="#2422D3EE"
                                                BorderBrush="#5522D3EE"
                                                BorderThickness="1">
                                            <FontIcon Glyph="&#xE958;" FontSize="13" Foreground="#38BDF8" />
                                        </Border>
                                        <TextBlock Text="{x:Bind ViewModel.HomeMoreLike3Title, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="18.5"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <controls:LiquidGlassPanel Grid.Column="1"
                                                               Height="28"
                                                               VerticalAlignment="Center"
                                                               GlassCornerRadius="14"
                                                               GlassPadding="0"
                                                               SampleLiveBackdrop="True"
                                                               EnableHoverScale="True"
                                                               HighlightAlphaMultiplier="0.70">
                                        <Button Content="Similar"
                                                Command="{x:Bind ViewModel.OpenMoreLikeSeedAlbumCommand, Mode=OneWay}"
                                                CommandParameter="{x:Bind ViewModel.HomeMoreLike3SeedAlbum, Mode=OneWay}"
                                                Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                                Foreground="#67E8F9"
                                                CornerRadius="14"
                                                Padding="12,0"
                                                FontSize="11.5"
                                                FontWeight="SemiBold" />
                                    </controls:LiquidGlassPanel>
                                </Grid>

                                <Grid x:Name="HomeMoreLike3CarouselHost">
                                    <ScrollViewer x:Name="HomeMoreLike3ScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Padding="18,12,18,20"
                                                  Loaded="OnHomeHorizontalCarouselLoaded"
                                                  SizeChanged="OnHomeHorizontalCarouselSizeChanged"
                                                  ViewChanged="OnHomeHorizontalCarouselViewChanged">
                                        <ItemsControl x:Name="HomeMoreLike3ItemsControl"
                                                      ItemsSource="{x:Bind ViewModel.HomeMoreLike3, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="14"
                                                                SizeChanged="OnHomeHorizontalItemsPanelSizeChanged" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="entities:AlbumItem">
                                                    <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                            Padding="0"
                                                            Click="OnAlbumCardClicked"
                                                            Tag="{x:Bind}"
                                                            helpers:MicroInteractions.HoverScale="1.05"
                                                            helpers:MicroInteractions.PressScale="0.94"
                                                            helpers:MicroInteractions.HoverElevationY="-4">
                                                        <Border Width="172"
                                                                Height="204"
                                                                CornerRadius="24"
                                                                BorderBrush="#33FFFFFF"
                                                                BorderThickness="1"
                                                                Background="#FF141822">
                                                            <Grid>
                                                                <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                                    <FontIcon Glyph="&#xEC4F;"
                                                                              FontSize="34"
                                                                              Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Border CornerRadius="23" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                    <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                           Stretch="UniformToFill"
                                                                           HorizontalAlignment="Stretch"
                                                                           VerticalAlignment="Stretch" />
                                                                </Border>
                                                                <Border IsHitTestVisible="False"
                                                                        Loaded="OnProgressiveCardBlurLoaded"
                                                                        SizeChanged="OnProgressiveCardBlurSizeChanged" />
                                                                <Border IsHitTestVisible="False" CornerRadius="23">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                            <GradientStop Color="#0A000000" Offset="0.0" />
                                                                            <GradientStop Color="#14000000" Offset="0.44" />
                                                                            <GradientStop Color="#92070A12" Offset="0.74" />
                                                                            <GradientStop Color="#EC070A12" Offset="1.0" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <Border HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        Margin="0,10,10,0"
                                                                        CornerRadius="11"
                                                                        Padding="8,3"
                                                                        Background="#78121622"
                                                                        BorderBrush="#42FFFFFF"
                                                                        BorderThickness="0.8"
                                                                        Visibility="{x:Bind HasReleaseYear, Mode=OneWay}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <Ellipse Width="5" Height="5" Fill="#38BDF8" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{x:Bind ReleaseYearText, Mode=OneWay}"
                                                                                   FontSize="10.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="White" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Bottom" Spacing="2" Margin="12,0,12,11">
                                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                               FontSize="12.5"
                                                                               FontWeight="Bold"
                                                                               Foreground="White"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind AlbumArtistSubtitle, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                               FontSize="11"
                                                                               Foreground="#CCDAE6F5"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <!-- 11. Recommended Albums -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="Recommended Albums"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="18.5"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                           Margin="2,0,0,0" />

                                <Grid x:Name="HomeRecommendedAlbumsCarouselHost">
                                    <ScrollViewer x:Name="HomeRecommendedAlbumsScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Padding="18,12,18,22"
                                                  Loaded="OnHomeHorizontalCarouselLoaded"
                                                  SizeChanged="OnHomeHorizontalCarouselSizeChanged"
                                                  ViewChanged="OnHomeHorizontalCarouselViewChanged">
                                        <ItemsControl x:Name="HomeRecommendedAlbumsItemsControl"
                                                      ItemsSource="{x:Bind ViewModel.HomeRecommendedAlbums, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="14"
                                                                SizeChanged="OnHomeHorizontalItemsPanelSizeChanged" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="entities:AlbumItem">
                                                    <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                            Padding="8,10"
                                                            Click="OnAlbumCardClicked"
                                                            Tag="{x:Bind}"
                                                            helpers:MicroInteractions.HoverScale="1.05"
                                                            helpers:MicroInteractions.PressScale="0.94"
                                                            helpers:MicroInteractions.HoverElevationY="-4">
                                                        <StackPanel Width="172" Spacing="7">
                                                            <Border Width="172" Height="172"
                                                                    CornerRadius="24"
                                                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                    BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                                    BorderThickness="1">
                                                                <Grid>
                                                                    <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xEC4F;"
                                                                                  FontSize="38"
                                                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <Border CornerRadius="23"
                                                                            Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                               Stretch="UniformToFill"
                                                                               HorizontalAlignment="Stretch"
                                                                               VerticalAlignment="Stretch" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                       MaxLines="2"
                                                                       TextWrapping="Wrap"
                                                                       TextAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                       FontSize="11.5"
                                                                       Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,-3,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <!-- 12. Discover by Genre (Genre Pills Directly Below Header + Up-to-4-Col Flat Album-Style Track Grid) -->
                            <StackPanel Spacing="12">
                                <!-- Row 1: Title + Active Genre Badge -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Discover by Genre"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Border Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="9,3"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedHomeGenre, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Row 2: Wrapping Genre Selection Pills Directly Below Header -->
                                <ItemsControl x:Name="HomeGenreTagsItemsControl"
                                              ItemsSource="{x:Bind ViewModel.HomeGenreTags, Mode=OneWay}"
                                              Margin="2,0,2,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:FlowWrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Content="{x:Bind}"
                                                    Click="OnHomeGenrePillClicked"
                                                    Loaded="OnHomeGenrePillLoaded"
                                                    Tag="{x:Bind}"
                                                    Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                                    BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="16,7"
                                                    FontSize="12"
                                                    helpers:MicroInteractions.HoverScale="1.05"
                                                    helpers:MicroInteractions.PressScale="0.94" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Row 3: Responsive Multi-Column Flat Album-Style Genre Tracks (Up to 4 Columns) -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.HomeGenreTracks, Mode=OneWay}"
                                              Margin="2,2,2,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:ResponsiveAutoFillGridPanel MinItemWidth="268"
                                                                                  MaxColumns="4"
                                                                                  ColumnSpacing="10"
                                                                                  RowSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:TrackItem">
                                            <Grid MinHeight="56"
                                                  CornerRadius="14"
                                                  Tapped="OnHomeGenreTrackTapped"
                                                  RightTapped="OnTrackRowRightTapped"
                                                  PointerEntered="OnHomeTrackRowPointerEntered"
                                                  PointerExited="OnHomeTrackRowPointerExited"
                                                  Tag="{x:Bind}"
                                                  Background="Transparent"
                                                  helpers:MicroInteractions.HoverScale="1.01"
                                                  helpers:MicroInteractions.PressScale="0.988">

                                                <!-- Layer 0: Active Playing Song Illuminated Box Background -->
                                                <Border CornerRadius="14"
                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                        Opacity="{x:Bind ActiveRowHighlightOpacity, Mode=OneWay}"
                                                        IsHitTestVisible="False">
                                                    <Border.OpacityTransition>
                                                        <ScalarTransition Duration="0:0:0.22" />
                                                    </Border.OpacityTransition>
                                                </Border>

                                                <!-- Layer 1: Smooth Hover Highlight Layer -->
                                                <Border CornerRadius="14"
                                                        Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                                                        Opacity="0"
                                                        IsHitTestVisible="False">
                                                    <Border.OpacityTransition>
                                                        <ScalarTransition Duration="0:0:0.16" />
                                                    </Border.OpacityTransition>
                                                </Border>

                                                <!-- Layer 2: Song Row Content (Thumbnail + Equalizer, Title/Artist, Duration, Heart, Vertical More) -->
                                                <Grid Padding="8,7,6,7" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Column 0: Rounded-Square Album Thumbnail + Active 3-Bar Equalizer Overlay -->
                                                    <Border Grid.Column="0"
                                                            Width="42" Height="42"
                                                            CornerRadius="9"
                                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                            VerticalAlignment="Center">
                                                        <Grid>
                                                            <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                                <FontIcon Glyph="&#xEC4F;"
                                                                          FontSize="15"
                                                                          Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Border CornerRadius="9"
                                                                    Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                       Stretch="UniformToFill"
                                                                       HorizontalAlignment="Stretch"
                                                                       VerticalAlignment="Stretch" />
                                                            </Border>
                                                            <!-- Playing Indicator Scrim & 3-Bar Equalizer (|||) -->
                                                            <Border CornerRadius="9"
                                                                    Background="#A6070A12"
                                                                    Opacity="{x:Bind PlayingIndicatorOpacity, Mode=OneWay}"
                                                                    IsHitTestVisible="False">
                                                                <StackPanel Orientation="Horizontal"
                                                                            Spacing="2.5"
                                                                            Height="16"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                                    <Border Width="3"
                                                                            Height="11"
                                                                            CornerRadius="1.5"
                                                                            VerticalAlignment="Center"
                                                                            Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                                    <Border Width="3"
                                                                            Height="16"
                                                                            CornerRadius="1.5"
                                                                            VerticalAlignment="Center"
                                                                            Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                                    <Border Width="3"
                                                                            Height="10"
                                                                            CornerRadius="1.5"
                                                                            VerticalAlignment="Center"
                                                                            Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Column 1: Stacked Song Title (+ Explicit Badge + Offline Icon) & Artist Subtitle -->
                                                    <StackPanel Grid.Column="1"
                                                                Spacing="2"
                                                                VerticalAlignment="Center">
                                                        <Grid ColumnSpacing="5" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                           Opacity="{x:Bind InactiveTitleOpacity, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="13.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                           Opacity="{x:Bind ActiveTitleOpacity, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="13.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                            <controls:ExplicitBadgeControl Grid.Column="1"
                                                                                           IsCompact="True"
                                                                                           Visibility="{x:Bind IsExplicit, Mode=OneWay}"
                                                                                           VerticalAlignment="Center" />
                                                            <FontIcon Grid.Column="2"
                                                                      Glyph="&#xE896;"
                                                                      FontSize="10.5"
                                                                      Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                      Opacity="{x:Bind DownloadedBadgeOpacity, Mode=OneWay}"
                                                                      ToolTipService.ToolTip="Available Offline / Local Audio"
                                                                      VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="11.5"
                                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                   MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Column 2: Formatted Duration -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="2,0,0,0" />

                                                    <!-- Column 3: Heart / Love Button -->
                                                    <Button Grid.Column="3"
                                                            Click="OnTrackRowLikeClicked"
                                                            Tag="{x:Bind}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Width="30"
                                                            Height="30"
                                                            CornerRadius="15"
                                                            Padding="0"
                                                            ToolTipService.ToolTip="Like"
                                                            helpers:MicroInteractions.HoverScale="1.15"
                                                            helpers:MicroInteractions.PressScale="0.88">
                                                        <FontIcon Glyph="{x:Bind LikeGlyph, Mode=OneWay}"
                                                                  Opacity="{x:Bind LikeIconOpacity, Mode=OneWay}"
                                                                  FontSize="13"
                                                                  Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                    </Button>

                                                    <!-- Column 4: Vertical 3-Dots More Options Button -->
                                                    <Button Grid.Column="4"
                                                            Click="OnTrackRowMoreClicked"
                                                            Tag="{x:Bind}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Width="30"
                                                            Height="30"
                                                            CornerRadius="15"
                                                            Padding="0"
                                                            ToolTipService.ToolTip="Song Options"
                                                            helpers:MicroInteractions.HoverScale="1.14"
                                                            helpers:MicroInteractions.PressScale="0.88">
                                                        <FontIcon Glyph="&#xE712;"
                                                                  FontSize="12.5"
                                                                  Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                  RenderTransformOrigin="0.5,0.5">
                                                            <FontIcon.RenderTransform>
                                                                <RotateTransform Angle="90" />
                                                            </FontIcon.RenderTransform>
                                                        </FontIcon>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- ========================================================================= -->
                        <!-- VIEW 1B: HOME CATEGORY GRID SUB-PAGE (New Releases & Radio Stations)      -->
                        <!-- Desktop-adapted grid expansion matching Android's sub-page design         -->
                        <!-- ========================================================================= -->
                        <StackPanel x:Name="HomeCategoryGridSectionRoot"
                                    x:Load="{x:Bind ViewModel.IsHomeCategoryGridViewOpen, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HomeCategoryGridViewVisibility, Mode=OneWay}"
                                    Spacing="18"
                                    Margin="2,2,2,24">

                            <!-- Top Navigation & Category Toggle Bar -->
                            <Grid ColumnSpacing="14" Margin="2,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:LiquidGlassPanel Grid.Column="0"
                                                           Height="40"
                                                           VerticalAlignment="Center"
                                                           GlassCornerRadius="20"
                                                           GlassPadding="0"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.NavigateBackFromDetailCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            CornerRadius="20"
                                            Padding="16,0"
                                            FontSize="12.5"
                                            FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72B;" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                            <TextBlock Text="Home" />
                                        </StackPanel>
                                    </Button>
                                </controls:LiquidGlassPanel>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.HomeCategoryGridHeaderTitle, Mode=OneWay}"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.HomeCategoryGridSubtitle, Mode=OneWay}"
                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                </StackPanel>

                                <controls:LiquidGlassPanel Grid.Column="2"
                                                           Height="40"
                                                           VerticalAlignment="Center"
                                                           GlassCornerRadius="20"
                                                           GlassPadding="0"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.ToggleHomeCategoryGridModeCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            CornerRadius="20"
                                            Padding="18,0"
                                            FontSize="12.5"
                                            FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="{x:Bind ViewModel.HomeCategoryGridToggleGlyph, Mode=OneWay}" FontSize="12.5" Foreground="#38BDF8" />
                                            <TextBlock Text="{x:Bind ViewModel.HomeCategoryGridToggleLabel, Mode=OneWay}" Foreground="#A5F3FC" />
                                        </StackPanel>
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </Grid>

                            <!-- New Releases Filter Chips (All / Albums / Singles) -->
                            <StackPanel Visibility="{x:Bind ViewModel.HomeNewReleasesFilterBarVisibility, Mode=OneWay}"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="2,0,0,0">
                                <Button Content="{x:Bind ViewModel.NewReleasesFilterAllLabel, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SelectNewReleasesFilterCommand, Mode=OneWay}"
                                        CommandParameter="All"
                                        Style="{x:Bind GetSegmentButtonStyle(ViewModel.IsFilterAllSelected), Mode=OneWay}"
                                        BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="16,6"
                                        FontSize="12.5"
                                        helpers:MicroInteractions.HoverScale="1.05"
                                        helpers:MicroInteractions.PressScale="0.93" />
                                <Button Content="{x:Bind ViewModel.NewReleasesFilterAlbumsLabel, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SelectNewReleasesFilterCommand, Mode=OneWay}"
                                        CommandParameter="Albums"
                                        Style="{x:Bind GetSegmentButtonStyle(ViewModel.IsFilterAlbumsSelected), Mode=OneWay}"
                                        BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="16,6"
                                        FontSize="12.5"
                                        helpers:MicroInteractions.HoverScale="1.05"
                                        helpers:MicroInteractions.PressScale="0.93" />
                                <Button Content="{x:Bind ViewModel.NewReleasesFilterSinglesLabel, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.SelectNewReleasesFilterCommand, Mode=OneWay}"
                                        CommandParameter="Singles"
                                        Style="{x:Bind GetSegmentButtonStyle(ViewModel.IsFilterSinglesSelected), Mode=OneWay}"
                                        BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="16,6"
                                        FontSize="12.5"
                                        helpers:MicroInteractions.HoverScale="1.05"
                                        helpers:MicroInteractions.PressScale="0.93" />
                            </StackPanel>

                            <!-- New Releases Fluid Auto-Fill Responsive Grid (Stretches evenly to 100% width with zero gap) -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredNewReleasesGridItems, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.HomeNewReleasesGridVisibility, Mode=OneWay}"
                                          Margin="2,6,2,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ResponsiveAutoFillGridPanel MinItemWidth="192"
                                                                              ColumnSpacing="16"
                                                                              RowSpacing="16"
                                                                              ItemAspectRatio="1.19" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:NewReleaseItem">
                                        <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Click="OnNewReleaseCardClicked"
                                                Tag="{x:Bind}"
                                                helpers:MicroInteractions.HoverScale="1.035"
                                                helpers:MicroInteractions.PressScale="0.95"
                                                helpers:MicroInteractions.HoverElevationY="-4">
                                            <Border CornerRadius="26"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    Background="#FF141822"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                                                <Grid>
                                                    <Grid Opacity="{x:Bind DefaultIconOpacity, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xEC4F;"
                                                                  FontSize="38"
                                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Border CornerRadius="25" Opacity="{x:Bind ArtworkOpacity, Mode=OneWay}">
                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeArtworkUri, Mode=OneWay}"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Stretch" />
                                                    </Border>
                                                    <Border IsHitTestVisible="False"
                                                            Loaded="OnProgressiveCardBlurLoaded"
                                                            SizeChanged="OnProgressiveCardBlurSizeChanged" />
                                                    <Border IsHitTestVisible="False" CornerRadius="25">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                <GradientStop Color="#12000000" Offset="0.0" />
                                                                <GradientStop Color="#16000000" Offset="0.40" />
                                                                <GradientStop Color="#92070A12" Offset="0.70" />
                                                                <GradientStop Color="#EE070A12" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="6"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Margin="12,12,0,0">
                                                        <Border Padding="8,3"
                                                                CornerRadius="10"
                                                                Background="#7A0B2B3A"
                                                                BorderBrush="#7022D3EE"
                                                                BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <Ellipse Width="5" Height="5" Fill="#22D3EE" VerticalAlignment="Center" />
                                                                <TextBlock Text="NEW"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="#A5F3FC" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Padding="8,3"
                                                                CornerRadius="10"
                                                                Background="#8A0D121A"
                                                                BorderBrush="#38FFFFFF"
                                                                BorderThickness="1">
                                                            <TextBlock Text="{x:Bind TypeBadgeText, Mode=OneWay}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="White" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Border Width="32" Height="32"
                                                            CornerRadius="16"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,12,12,0"
                                                            Background="#80111622"
                                                            BorderBrush="#4DFFFFFF"
                                                            BorderThickness="1">
                                                        <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="White" Margin="1,0,0,0" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Bottom" Spacing="3" Margin="14,0,14,14">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="14.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   MaxLines="2"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="11.5"
                                                                   Foreground="#CCDAE6F5"
                                                                   MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Radio Stations Fluid Auto-Fill Responsive Grid (Stretches evenly to 100% width with zero gap) -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RadioStationsGridItems, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.HomeRadioStationsGridVisibility, Mode=OneWay}"
                                          Margin="2,6,2,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ResponsiveAutoFillGridPanel MinItemWidth="192"
                                                                              ColumnSpacing="16"
                                                                              RowSpacing="16"
                                                                              ItemAspectRatio="1.19" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RadioStationItem">
                                        <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Click="OnRadioStationCardClicked"
                                                Tag="{x:Bind}"
                                                helpers:MicroInteractions.HoverScale="1.035"
                                                helpers:MicroInteractions.PressScale="0.95"
                                                helpers:MicroInteractions.HoverElevationY="-4">
                                            <Border CornerRadius="26"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    Background="#FF141822"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                                                <Grid>
                                                    <Grid Opacity="{x:Bind DefaultIconOpacity, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE95A;"
                                                                  FontSize="38"
                                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Border CornerRadius="25" Opacity="{x:Bind ArtworkOpacity, Mode=OneWay}">
                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeArtworkUri, Mode=OneWay}"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Stretch" />
                                                    </Border>
                                                    <Border IsHitTestVisible="False"
                                                            Loaded="OnProgressiveCardBlurLoaded"
                                                            SizeChanged="OnProgressiveCardBlurSizeChanged" />
                                                    <Border IsHitTestVisible="False" CornerRadius="25">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                <GradientStop Color="#12000000" Offset="0.0" />
                                                                <GradientStop Color="#16000000" Offset="0.40" />
                                                                <GradientStop Color="#92070A12" Offset="0.70" />
                                                                <GradientStop Color="#EE070A12" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Border HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="12,12,0,0"
                                                            Padding="9,3"
                                                            CornerRadius="10"
                                                            Background="#80112233"
                                                            BorderBrush="#6638BDF8"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <FontIcon Glyph="&#xE95A;" FontSize="10" Foreground="#67E8F9" />
                                                            <TextBlock Text="RADIO"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       CharacterSpacing="50"
                                                                       Foreground="#A5F3FC" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Width="32" Height="32"
                                                            CornerRadius="16"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,12,12,0"
                                                            Background="#80111622"
                                                            BorderBrush="#4DFFFFFF"
                                                            BorderThickness="1">
                                                        <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="#38BDF8" Margin="1,0,0,0" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Bottom" Spacing="3" Margin="14,0,14,14">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="14.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   MaxLines="2"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="11.5"
                                                                   Foreground="#CCDAE6F5"
                                                                   MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- ========================================================================= -->
                    <!-- VIEW 2: ARTIST DETAIL SCREEN (YouTube Music Exclusive + Apple Wordmark)   -->
                    <!-- Seamless Full-Bleed Hero Background (Photo + Smooth Fade-In 16:9 Video),  -->
                    <!-- Top Songs by Play Count, Albums, Singles, Playlists & Related Artists     -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="ArtistDetailSectionRoot"
                                Visibility="{x:Bind ViewModel.ArtistDetailViewVisibility, Mode=OneWay}"
                                Spacing="0"
                                Margin="-22,-68,-14,-32"
                                Background="{StaticResource ArtistAmbientBackgroundBrush}">

                        <!-- Seamless Full-Bleed Edge-to-Edge Artist Background Header -->
                        <Grid x:Name="ArtistDetailHeaderGrid"
                              MinHeight="500"
                              Margin="0"
                              Background="{StaticResource ArtistAmbientBackgroundBrush}">

                            <Grid x:Name="ArtistDetailCleanBackdrop" IsHitTestVisible="False">
                                <!-- LAYER 0: Fallback Artist Icon when no banner/avatar exists -->
                                <Grid Opacity="{x:Bind ViewModel.CurrentArtistDetail.DefaultIconOpacity, Mode=OneWay}">
                                    <FontIcon Glyph="&#xEC4F;"
                                              FontSize="84"
                                              Foreground="{StaticResource ArtistPrimaryInkBrush}"
                                              Opacity="0.30"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <!-- LAYER 1: Apple Music 16:9 Looping Artist Motion Video (Loads Invisibly Underneath Banner, Cross-Fades In Only After First Decoded Frame) -->
                                <Border x:Name="ArtistDetailHeaderVideoContainer"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.38" />
                                    </Border.OpacityTransition>
                                    <Grid>
                                        <MediaPlayerElement x:Name="ArtistDetailHeaderMediaPlayerElement"
                                                            AreTransportControlsEnabled="False"
                                                            Opacity="0"
                                                            Stretch="UniformToFill" />
                                        <canvas:CanvasControl x:Name="ArtistDetailHeaderVideoCanvas"
                                                              ClearColor="Transparent"
                                                              Draw="OnArtistDetailHeaderVideoCanvasDraw" />
                                    </Grid>
                                </Border>

                                <!-- LAYER 2: High-Resolution Wide Artist Banner Photo (Stays Cleanly Visible On Top at Opacity=1.0 While Video Loads, Cross-Fades Out Once First Frame Renders) -->
                                <Border x:Name="ArtistDetailPhotoBorder"
                                        Opacity="1">
                                    <Border.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.38" />
                                    </Border.OpacityTransition>
                                    <Border Opacity="{x:Bind ViewModel.CurrentArtistDetail.AvatarOpacity, Mode=OneWay}">
                                        <Border.Background>
                                            <ImageBrush helpers:BitmapDecodeHelper.DecodeWidth="960" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentArtistDetail.SafeBannerUri, Mode=OneWay}"
                                                        Stretch="UniformToFill"
                                                        AlignmentX="Center"
                                                        AlignmentY="Top" />
                                        </Border.Background>
                                    </Border>
                                </Border>

                                <!-- LAYER 3A: Bottom-to-Top Seamless Dissolve into Artist Main Background Color -->
                                <Border IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop x:Name="ArtistHeroStop0" Color="#181E222A" Offset="0.0" />
                                            <GradientStop x:Name="ArtistHeroStop1" Color="#001E222A" Offset="0.34" />
                                            <GradientStop x:Name="ArtistHeroStop2" Color="#881E222A" Offset="0.64" />
                                            <GradientStop x:Name="ArtistHeroStop3" Color="#E61E222A" Offset="0.86" />
                                            <GradientStop x:Name="ArtistHeroStop4" Color="#FF1E222A" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <!-- Top-Left Floating Circular Back Button + Subscribers Pill (No Syncing Label) -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="26,72,26,0">
                                <controls:LiquidGlassPanel Width="44"
                                                           Height="44"
                                                           GlassCornerRadius="22"
                                                           GlassPadding="0"
                                                           SampleLiveBackdrop="True"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.NavigateBackFromDetailCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="22"
                                            Padding="0"
                                            ToolTipService.ToolTip="Back">
                                        <FontIcon Glyph="&#xE72B;"
                                                  FontSize="14"
                                                  Foreground="{StaticResource ArtistPrimaryInkBrush}" />
                                    </Button>
                                </controls:LiquidGlassPanel>

                                <controls:LiquidGlassPanel Height="40"
                                                           GlassCornerRadius="20"
                                                           GlassPadding="16,0"
                                                           SampleLiveBackdrop="True"
                                                           Visibility="{x:Bind ViewModel.ArtistSubscribersPillVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <Border Width="7"
                                                Height="7"
                                                CornerRadius="3.5"
                                                Background="#FFFF3B5C"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentArtistDetail.DisplaySubscribersPillText, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ArtistPrimaryInkBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </controls:LiquidGlassPanel>

                                <Border Width="138"
                                        Height="40"
                                        CornerRadius="20"
                                        Background="{StaticResource ArtistSkeletonFillBrush}"
                                        Visibility="{x:Bind ViewModel.ArtistSubscribersSkeletonVisibility, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Centered Bottom Artist Identity, Custom Apple Music Wordmark, Circular Glass Actions, Monthly Listeners & Bio -->
                            <StackPanel VerticalAlignment="Bottom"
                                        HorizontalAlignment="Center"
                                        MaxWidth="740"
                                        Spacing="10"
                                        Margin="28,120,28,20">

                                <!-- Artist Title: Wordmark Skeleton / Plain Text / Apple Music Wordmark -->
                                <Grid HorizontalAlignment="Center" MinHeight="54">
                                    <Border Width="210"
                                            Height="46"
                                            CornerRadius="12"
                                            Background="{StaticResource ArtistSkeletonFillBrush}"
                                            Visibility="{x:Bind ViewModel.ArtistWordmarkSkeletonVisibility, Mode=OneWay}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />

                                    <TextBlock x:Name="ArtistTitleTextBlock"
                                               Text="{x:Bind ViewModel.CurrentArtistDetail.Name, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.ArtistTitleTextVisibility, Mode=OneWay}"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="46"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource ArtistPrimaryInkBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis" />

                                    <Image x:Name="ArtistWordmarkImage"
                                           helpers:BitmapDecodeHelper.DecodeWidth="512" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentArtistDetail.SafeCustomTitleLogoUri, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.ArtistWordmarkImageVisibility, Mode=OneWay}"
                                           ImageOpened="OnArtistWordmarkImageOpened"
                                           ImageFailed="OnArtistWordmarkImageFailed"
                                           MaxWidth="360"
                                           MaxHeight="104"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Grid>

                                <!-- Centered Circular Action Buttons Row: Shuffle & Play -->
                                <Grid HorizontalAlignment="Center" Margin="0,2,0,2">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="14"
                                                HorizontalAlignment="Center"
                                                Visibility="{x:Bind ViewModel.ArtistHeroLoadedVisibility, Mode=OneWay}">
                                        <controls:LiquidGlassPanel Width="52"
                                                                   Height="52"
                                                                   GlassCornerRadius="26"
                                                                   GlassPadding="0"
                                                                   SampleLiveBackdrop="True"
                                                                   EnableHoverScale="True">
                                            <Button Command="{x:Bind ViewModel.ShuffleArtistTopTracksCommand, Mode=OneWay}"
                                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                                    Width="52"
                                                    Height="52"
                                                    CornerRadius="26"
                                                    Padding="0"
                                                    ToolTipService.ToolTip="Shuffle"
                                                    helpers:MicroInteractions.HoverScale="1.06"
                                                    helpers:MicroInteractions.PressScale="0.93">
                                                <FontIcon Glyph="&#xE8B1;"
                                                          FontSize="17"
                                                          Foreground="{StaticResource ArtistPrimaryInkBrush}" />
                                            </Button>
                                        </controls:LiquidGlassPanel>

                                        <controls:LiquidGlassPanel Width="52"
                                                                   Height="52"
                                                                   GlassCornerRadius="26"
                                                                   GlassPadding="0"
                                                                   SampleLiveBackdrop="True"
                                                                   EnableHoverScale="True">
                                            <Button Command="{x:Bind ViewModel.PlayArtistTopTracksCommand, Mode=OneWay}"
                                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                                    Width="52"
                                                    Height="52"
                                                    CornerRadius="26"
                                                    Padding="0"
                                                    ToolTipService.ToolTip="Play"
