                                        Spacing="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Width="310">

                                <!-- Rounded-Square Album Cover + Apple Music Canvas Motion Overlay -->
                                <Border Width="236"
                                        Height="236"
                                        CornerRadius="24"
                                        Background="{StaticResource AlbumCardBackgroundBrush}"
                                        BorderBrush="{StaticResource AlbumCardBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,8">
                                    <Grid Width="236" Height="236">
                                        <Grid Opacity="{x:Bind ViewModel.CurrentAlbumDetail.DefaultIconOpacity, Mode=OneWay}">
                                            <FontIcon Glyph="&#xEC4F;"
                                                      FontSize="64"
                                                      Foreground="{StaticResource AlbumSecondaryInkBrush}"
                                                      Opacity="0.45"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Apple Music Canvas Animated Motion Cover inside Album Detail Hero (Loads Invisibly Underneath Static Cover, Reveals Only After First Frame) -->
                                        <Border x:Name="AlbumDetailCanvasVideoContainer"
                                                CornerRadius="23"
                                                Width="236"
                                                Height="236"
                                                Opacity="0"
                                                IsHitTestVisible="False">
                                            <Border.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.35" />
                                            </Border.OpacityTransition>
                                            <Grid Width="236" Height="236">
                                                <MediaPlayerElement x:Name="AlbumDetailCanvasMediaPlayerElement"
                                                                    AreTransportControlsEnabled="False"
                                                                    Opacity="0"
                                                                    Stretch="UniformToFill"
                                                                    Width="236"
                                                                    Height="236"
                                                                    Loaded="OnAlbumDetailCanvasMediaPlayerElementLoaded"
                                                                    Unloaded="OnMediaPlayerElementUnloaded" />
                                                <canvas:CanvasControl x:Name="AlbumDetailCanvasVideoCanvas"
                                                                      ClearColor="Transparent"
                                                                      Width="236"
                                                                      Height="236"
                                                                      Draw="OnAlbumDetailCanvasVideoCanvasDraw"
                                                                      Unloaded="OnDynamicCanvasControlUnloaded" />
                                            </Grid>
                                        </Border>

                                        <!-- Static Album Cover Artwork (Stays Cleanly Visible On Top at Opacity=1.0 While Canvas Loads, Cross-Fades Out Once First Frame Renders) -->
                                        <Border x:Name="AlbumDetailStaticCoverHost"
                                                CornerRadius="23"
                                                Opacity="1"
                                                IsHitTestVisible="False">
                                            <Border.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.35" />
                                            </Border.OpacityTransition>
                                            <Border CornerRadius="23"
                                                    Opacity="{x:Bind ViewModel.CurrentAlbumDetail.CoverArtOpacity, Mode=OneWay}">
                                                <Border.Background>
                                                    <ImageBrush helpers:BitmapDecodeHelper.DecodeWidth="512" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentAlbumDetail.SafeCoverArtUri, Mode=OneWay}"
                                                                Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Album Title (Centered) -->
                                <TextBlock Text="{x:Bind ViewModel.CurrentAlbumDetail.Title, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AlbumPrimaryInkBrush}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />

