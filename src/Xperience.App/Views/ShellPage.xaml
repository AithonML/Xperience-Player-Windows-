                                    <StackPanel Spacing="6"
                                                HorizontalAlignment="Center"
                                                Visibility="{x:Bind ViewModel.AlbumMetadataSkeletonVisibility, Mode=OneWay}">
                                        <Border Width="264"
                                                Height="11"
                                                CornerRadius="5.5"
                                                Background="{StaticResource AlbumSkeletonFillBrush}"
                                                HorizontalAlignment="Center" />
                                        <Border Width="220"
                                                Height="11"
                                                CornerRadius="5.5"
                                                Background="{StaticResource AlbumSkeletonFillBrush}"
                                                HorizontalAlignment="Center" />
                                        <Border Width="44"
                                                Height="11"
                                                CornerRadius="5.5"
                                                Background="{StaticResource AlbumSkeletonFillBrush}"
                                                HorizontalAlignment="Center"
                                                Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- RIGHT COLUMN: "Tracks" Section Header + Flat Tracklist (or Skeleton Track Rows) -->
                            <StackPanel Grid.Column="1"
                                        Spacing="10"
                                        VerticalAlignment="Top">
                                <TextBlock Text="Tracks"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AlbumPrimaryInkBrush}"
                                           Margin="8,0,0,4" />

                                <!-- Tracklist Skeleton Placeholders while Loading -->
                                <StackPanel x:Name="AlbumSkeletonContainer"
                                            Visibility="{x:Bind ViewModel.AlbumSkeletonVisibility, Mode=OneWay}"
                                            Spacing="6">
                                    <Border Height="56" CornerRadius="14" Padding="14,8">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="14" Height="14" CornerRadius="4" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="190" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                                <Border Width="110" Height="11" CornerRadius="5" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="88" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Height="56" CornerRadius="14" Padding="14,8">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="14" Height="14" CornerRadius="4" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="165" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                                <Border Width="105" Height="11" CornerRadius="5" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="88" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Height="56" CornerRadius="14" Padding="14,8">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="14" Height="14" CornerRadius="4" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="220" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                                <Border Width="120" Height="11" CornerRadius="5" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="88" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Height="56" CornerRadius="14" Padding="14,8">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="14" Height="14" CornerRadius="4" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="180" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                                <Border Width="110" Height="11" CornerRadius="5" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="88" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Height="56" CornerRadius="14" Padding="14,8">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="14" Height="14" CornerRadius="4" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="205" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                                <Border Width="115" Height="11" CornerRadius="5" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="88" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Height="56" CornerRadius="14" Padding="14,8">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="14" Height="14" CornerRadius="4" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="175" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                                <Border Width="105" Height="11" CornerRadius="5" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="88" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Ordered Flat Album Tracklist (Track Number / Playing Equalizer Indicator, Title + Explicit + Artist, Duration, Heart, Vertical More) -->
                                <ItemsRepeater Visibility="{x:Bind ViewModel.AlbumContentVisibility, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.AlbumDetailTracks, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="entities:TrackItem">
                                            <Grid MinHeight="56"
                                                  CornerRadius="14"
                                                  Tapped="OnAlbumDetailTrackTapped"
                                                  RightTapped="OnTrackRowRightTapped"
                                                  PointerEntered="OnAlbumTrackRowPointerEntered"
                                                  PointerExited="OnAlbumTrackRowPointerExited"
                                                  Tag="{x:Bind}"
                                                  Background="Transparent"
                                                  helpers:MicroInteractions.HoverScale="1.008"
                                                  helpers:MicroInteractions.PressScale="0.992">

                                                <!-- Layer 0: Active Playing Song Illuminated Box Background (Image 2) -->
                                                <Border CornerRadius="14"
                                                        Background="{StaticResource AlbumTrackActiveBackgroundBrush}"
                                                        Opacity="{x:Bind ActiveRowHighlightOpacity, Mode=OneWay}"
                                                        IsHitTestVisible="False">
                                                    <Border.OpacityTransition>
                                                        <ScalarTransition Duration="0:0:0.22" />
                                                    </Border.OpacityTransition>
                                                </Border>

                                                <!-- Layer 1: Smooth Hover Highlight Layer -->
                                                <Border CornerRadius="14"
                                                        Background="{StaticResource AlbumCardBackgroundBrush}"
                                                        Opacity="0"
                                                        IsHitTestVisible="False">
                                                    <Border.OpacityTransition>
                                                        <ScalarTransition Duration="0:0:0.16" />
                                                    </Border.OpacityTransition>
                                                </Border>

                                                <!-- Layer 2: Song Row Content -->
                                                <Grid Padding="12,8,12,8" ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Column 0: Track Number OR 3-Bar Playing Equalizer Indicator (||| in Image 2) -->
                                                    <Grid Grid.Column="0"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DisplayTrackNumber, Mode=OneWay}"
                                                                   Opacity="{x:Bind TrackNumberOpacity, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AlbumSecondaryInkBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />

                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="2.5"
                                                                    Height="16"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Opacity="{x:Bind PlayingIndicatorOpacity, Mode=OneWay}">
                                                            <Border Width="3"
                                                                    Height="12"
                                                                    CornerRadius="1.5"
                                                                    VerticalAlignment="Center"
                                                                    Background="{StaticResource AlbumTrackActiveAccentBrush}" />
                                                            <Border Width="3"
                                                                    Height="16"
                                                                    CornerRadius="1.5"
                                                                    VerticalAlignment="Center"
                                                                    Background="{StaticResource AlbumTrackActiveAccentBrush}" />
                                                            <Border Width="3"
                                                                    Height="11"
                                                                    CornerRadius="1.5"
                                                                    VerticalAlignment="Center"
                                                                    Background="{StaticResource AlbumTrackActiveAccentBrush}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Column 1: Stacked Song Title (+ Explicit Badge) & Artist Subtitle -->
                                                    <StackPanel Grid.Column="1"
                                                                Spacing="2"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="6"
                                                                    VerticalAlignment="Center">
                                                            <Grid VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                           Opacity="{x:Bind InactiveTitleOpacity, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource AlbumPrimaryInkBrush}"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                           Opacity="{x:Bind ActiveTitleOpacity, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource AlbumTrackActiveAccentBrush}"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>

                                                            <controls:ExplicitBadgeControl Visibility="{x:Bind IsExplicit, Mode=OneWay}"
                                                                                           VerticalAlignment="Center" />

                                                            <FontIcon Glyph="&#xE896;"
                                                                      FontSize="11"
                                                                      Foreground="{StaticResource AlbumSecondaryInkBrush}"
                                                                      Opacity="{x:Bind DownloadedBadgeOpacity, Mode=OneWay}"
                                                                      ToolTipService.ToolTip="Available Offline / Local Audio"
                                                                      VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource AlbumSecondaryInkBrush}"
                                                                   MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Column 2: Formatted Duration -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                               FontSize="12.5"
                                                               Foreground="{StaticResource AlbumSecondaryInkBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,6,0" />

                                                    <!-- Column 3: Like / Heart Button -->
                                                    <Button Grid.Column="3"
                                                            Click="OnTrackRowLikeClicked"
                                                            Tag="{x:Bind}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Width="32"
                                                            Height="32"
                                                            CornerRadius="16"
                                                            Padding="0"
                                                            ToolTipService.ToolTip="Like"
                                                            helpers:MicroInteractions.HoverScale="1.15"
                                                            helpers:MicroInteractions.PressScale="0.88">
                                                        <FontIcon Glyph="{x:Bind LikeGlyph, Mode=OneWay}"
                                                                  Opacity="{x:Bind LikeIconOpacity, Mode=OneWay}"
                                                                  FontSize="13.5"
                                                                  Foreground="{StaticResource AlbumSecondaryInkBrush}" />
                                                    </Button>

                                                    <!-- Column 4: Vertical 3-Dots More Options Button -->
                                                    <Button Grid.Column="4"
                                                            Click="OnTrackRowMoreClicked"
                                                            Tag="{x:Bind}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Width="32"
                                                            Height="32"
                                                            CornerRadius="16"
                                                            Padding="0"
                                                            ToolTipService.ToolTip="Song Options"
                                                            helpers:MicroInteractions.HoverScale="1.14"
                                                            helpers:MicroInteractions.PressScale="0.88">
                                                        <FontIcon Glyph="&#xE712;"
                                                                  FontSize="13"
                                                                  Foreground="{StaticResource AlbumSecondaryInkBrush}"
                                                                  RenderTransformOrigin="0.5,0.5">
                                                            <FontIcon.RenderTransform>
                                                                <RotateTransform Angle="90" />
                                                            </FontIcon.RenderTransform>
                                                        </FontIcon>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom Carousels Skeleton while Loading -->
                        <StackPanel Visibility="{x:Bind ViewModel.AlbumSkeletonVisibility, Mode=OneWay}"
                                    Spacing="14"
                                    Margin="6,8,6,0">
                            <Border Width="180" Height="22" CornerRadius="8" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <StackPanel Width="148" Spacing="8">
                                    <Border Width="148" Height="148" CornerRadius="18" Background="{StaticResource AlbumSkeletonFillBrush}" />
                                    <Border Width="118" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                    <Border Width="84" Height="11" CornerRadius="5" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Width="148" Spacing="8">
                                    <Border Width="148" Height="148" CornerRadius="18" Background="{StaticResource AlbumSkeletonFillBrush}" />
                                    <Border Width="118" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                    <Border Width="84" Height="11" CornerRadius="5" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Width="148" Spacing="8">
                                    <Border Width="148" Height="148" CornerRadius="18" Background="{StaticResource AlbumSkeletonFillBrush}" />
                                    <Border Width="118" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                    <Border Width="84" Height="11" CornerRadius="5" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Width="148" Spacing="8">
                                    <Border Width="148" Height="148" CornerRadius="18" Background="{StaticResource AlbumSkeletonFillBrush}" />
                                    <Border Width="118" Height="13" CornerRadius="6" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                    <Border Width="84" Height="11" CornerRadius="5" Background="{StaticResource AlbumSkeletonFillBrush}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- SECTION: Other Versions (Deluxe, Remastered & Alternate Editions from YouTube Music) -->
                        <StackPanel Spacing="10"
                                    Margin="6,6,6,0"
                                    Visibility="{x:Bind ViewModel.HasAlbumOtherVersionsVisibility, Mode=OneWay}">
                            <StackPanel Spacing="2" Margin="4,0,0,0">
                                <TextBlock Text="Other Versions"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AlbumPrimaryInkBrush}" />
                                <TextBlock Text="Deluxe, Remastered &amp; Alternate Editions"
                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                           FontSize="12.5"
                                           Foreground="{StaticResource AlbumSecondaryInkBrush}" />
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Padding="4,8,16,14">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AlbumOtherVersions, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="18" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AlbumItem">
                                            <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                    Padding="4,6"
                                                    Click="OnAlbumCardClicked"
                                                    Tag="{x:Bind}"
                                                    helpers:MicroInteractions.HoverScale="1.04"
                                                    helpers:MicroInteractions.PressScale="0.95"
                                                    helpers:MicroInteractions.HoverElevationY="-4">
                                                <StackPanel Width="150" Spacing="6">
                                                    <Border Width="148"
                                                            Height="148"
                                                            CornerRadius="18"
                                                            Background="{StaticResource AlbumCardBackgroundBrush}"
                                                            BorderBrush="{StaticResource AlbumCardBorderBrush}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Left">
                                                        <Grid>
                                                            <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                                <FontIcon Glyph="&#xEC4F;"
                                                                          FontSize="36"
                                                                          Foreground="{StaticResource AlbumSecondaryInkBrush}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Border CornerRadius="17"
                                                                    Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                <Border.Background>
                                                                    <ImageBrush helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                                Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="13.5"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource AlbumPrimaryInkBrush}"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               Margin="2,2,0,0" />
                                                    <TextBlock Text="{x:Bind OtherVersionSubtitle, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource AlbumSecondaryInkBrush}"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               Margin="2,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- SECTION: More by [Artist] (Rounded-Square Album & EP Cards from YouTube Music) -->
                        <StackPanel Spacing="10"
                                    Margin="6,6,6,0"
                                    Visibility="{x:Bind ViewModel.HasAlbumOtherAlbumsVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.AlbumMoreByArtistHeader, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AlbumPrimaryInkBrush}"
                                       Margin="4,0,0,0" />

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Padding="4,8,16,18">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AlbumOtherAlbums, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="18" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:AlbumItem">
                                            <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                    Padding="4,6"
                                                    Click="OnAlbumCardClicked"
                                                    Tag="{x:Bind}"
                                                    helpers:MicroInteractions.HoverScale="1.04"
                                                    helpers:MicroInteractions.PressScale="0.95"
                                                    helpers:MicroInteractions.HoverElevationY="-4">
                                                <StackPanel Width="150" Spacing="6">
                                                    <Border Width="148"
                                                            Height="148"
                                                            CornerRadius="18"
                                                            Background="{StaticResource AlbumCardBackgroundBrush}"
                                                            BorderBrush="{StaticResource AlbumCardBorderBrush}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Left">
                                                        <Grid>
                                                            <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                                <FontIcon Glyph="&#xEC4F;"
                                                                          FontSize="36"
                                                                          Foreground="{StaticResource AlbumSecondaryInkBrush}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Border CornerRadius="17"
                                                                    Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                <Border.Background>
                                                                    <ImageBrush helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                                Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="13.5"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource AlbumPrimaryInkBrush}"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               Margin="2,2,0,0" />
                                                    <TextBlock Text="{x:Bind YearArtistSubtitle, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource AlbumSecondaryInkBrush}"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               Margin="2,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- VIEW 4: LIKED SONGS SCREEN (Android Parity: Sticky Floating Header +     -->
                    <!-- 2-Column Songs + Fans Also Like & Recommended + Library A–Z/# Rail)      -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="LikedSectionRoot"
                                Visibility="{x:Bind ViewModel.LikedViewVisibility, Mode=OneWay}"
                                Spacing="18"
                                Margin="2,2,2,0">

                        <!-- Top Clearance Spacer for Floating Sticky Liked Header & Slicers -->
                        <Border Height="132" IsHitTestVisible="False" />

                        <!-- LIKED TAB 1: SONGS TWO-COLUMN PANE (58% Left Songs + Play/Shuffle | 42% Right Fans Also Like & Recommended) -->
                        <Grid x:Name="LikedSongsSplitGrid"
                              Visibility="{x:Bind ViewModel.LikedRightRecommendationsPaneVisibility, Mode=OneWay}"
                              ColumnSpacing="22"
                              RowSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LikedSongsLeftColumnDef" Width="58*" />
                                <ColumnDefinition x:Name="LikedSongsRightColumnDef" Width="42*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- LEFT PANE: Play All / Shuffle + Single-Column Song List (or Empty Card) -->
                            <StackPanel x:Name="LikedSongsLeftPane"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Spacing="16"
                                        VerticalAlignment="Top">

                                <!-- Action Bar: Equal 50/50 Play All (Solid Accent) & Shuffle (Frosted Glass) — Songs Tab Only -->
                                <Grid x:Name="LikedPlayActionsBar"
                                      Visibility="{x:Bind ViewModel.LikedPlayActionsVisibility, Mode=OneWay}"
                                      ColumnSpacing="12"
                                      Margin="0,0,42,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="LikedPlayAllButton"
                                            Grid.Column="0"
                                            Command="{x:Bind ViewModel.PlayAllLikedSongsCommand, Mode=OneWay}"
                                            Height="42"
                                            CornerRadius="21"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="{ThemeResource TokenPrimaryAccentBrush}"
                                            BorderThickness="0"
                                            Padding="18,0"
                                            FontSize="13"
                                            helpers:MicroInteractions.HoverScale="1.025"
                                            helpers:MicroInteractions.PressScale="0.96">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon x:Name="LikedPlayAllIcon" Glyph="&#xE768;" FontSize="12.5" Foreground="#FF071018" />
                                            <TextBlock x:Name="LikedPlayAllText" Text="Play All" FontWeight="Bold" Foreground="#FF071018" />
                                        </StackPanel>
                                    </Button>

                                    <controls:LiquidGlassPanel Grid.Column="1"
                                                               Height="42"
                                                               GlassCornerRadius="21"
                                                               GlassPadding="0"
                                                               SampleLiveBackdrop="True"
                                                               EnableHoverScale="True"
                                                               HorizontalAlignment="Stretch">
                                        <Button Command="{x:Bind ViewModel.ShuffleLikedSongsCommand, Mode=OneWay}"
                                                Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                                Height="42"
                                                CornerRadius="21"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Padding="18,0"
                                                FontSize="13">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8B1;" FontSize="13" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                <TextBlock Text="Shuffle" FontWeight="SemiBold" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </controls:LiquidGlassPanel>
                                </Grid>

                                <!-- Empty Liked State Card (Stays in Left Pane while Right Recommendations Stay Visible) -->
                                <controls:LiquidGlassPanel Visibility="{x:Bind ViewModel.LikedSongsEmptyVisibility, Mode=OneWay}"
                                                           MaxWidth="520"
                                                           HorizontalAlignment="Left"
                                                           Margin="0,12,0,0"
                                                           GlassCornerRadius="24"
                                                           GlassPadding="28,24"
                                                           SampleLiveBackdrop="True">
                                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                                        <Border Width="56"
                                                Height="56"
                                                CornerRadius="28"
                                                HorizontalAlignment="Center"
                                                Background="#28FF2D55"
                                                BorderBrush="#55FF2D55"
                                                BorderThickness="1.2">
                                            <FontIcon Glyph="&#xEB51;" FontSize="22" Foreground="#FFFF2D55" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="No Liked Songs Yet"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                   TextAlignment="Center" />
                                        <TextBlock Text="Tap the heart on any online stream or local track to save it here for quick playback."
                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center" />
                                        <Button Command="{x:Bind ViewModel.SelectSectionCommand, Mode=OneWay}"
                                                CommandParameter="Home"
                                                Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                                HorizontalAlignment="Center"
                                                Margin="0,6,0,0"
                                                Height="40"
                                                CornerRadius="20"
                                                Padding="20,0"
                                                FontSize="13"
                                                helpers:MicroInteractions.HoverScale="1.05"
                                                helpers:MicroInteractions.PressScale="0.94">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE774;" FontSize="13.5" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                <TextBlock Text="Explore Music" FontWeight="Bold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </controls:LiquidGlassPanel>

                                <!-- LIKED TAB 1A: SONGS (RECENT ORDER — Single-Column Vertical Stack) -->
                                <ItemsRepeater x:Name="LikedSongsRecentControl"
                                              Visibility="{x:Bind ViewModel.LikedSongsRecentVisibility, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.LikedSongs, Mode=OneWay}"
                                              ItemTemplate="{StaticResource LikedSongRowTemplate}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>

                                <!-- LIKED TAB 1B: SONGS (A–Z ALPHABETICAL GROUPS — Exact Library Letter Headers + 42px Rail Clearance) -->
                                <ItemsControl x:Name="LikedSongsGroupsControl"
                                              Visibility="{x:Bind ViewModel.LikedSongsAlphaVisibility, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.LikedSongGroups, Mode=OneWay}"
                                              Margin="0,0,42,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="20" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LibraryTrackGroup">
                                            <StackPanel Spacing="10">
                                                <Grid Margin="2,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" MinWidth="32" Height="30" CornerRadius="10" Padding="10,3"
                                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                            BorderThickness="0.9">
                                                        <TextBlock Text="{x:Bind Letter, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="14.5" FontWeight="ExtraBold"
                                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Column="1" Height="1" Margin="10,0,10,0" VerticalAlignment="Center" Opacity="0.55"
                                                            Background="{ThemeResource TokenGlassBorderBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneWay}"
                                                              ItemTemplate="{StaticResource LikedSongRowTemplate}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="8" />
                                                    </ItemsRepeater.Layout>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- RIGHT PANE: "Fans Also Like & Recommended" (Android LikedScreen.kt Parity) -->
                            <StackPanel x:Name="LikedRecommendationsColumn"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Spacing="12"
                                        VerticalAlignment="Top">

                                <StackPanel Spacing="2" Margin="2,0,0,2">
                                    <TextBlock Text="Fans Also Like &amp; Recommended"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    <TextBlock Text="Discoveries from YouTube Music based on your favorites"
                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                               FontSize="11.5"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                </StackPanel>

                                <!-- Shimmer Skeleton (3 Rows) while Fetching -->
                                <StackPanel x:Name="LikedRecommendationsSkeletonHost"
                                            Visibility="{x:Bind ViewModel.LikedRecommendationsLoadingVisibility, Mode=OneWay}"
                                            Spacing="8">
                                    <Border Height="64" CornerRadius="16" Padding="10,8"
                                            Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                            BorderThickness="0.9">
                                        <Grid ColumnSpacing="11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="48" Height="48" CornerRadius="11" Background="{ThemeResource TokenActiveSegmentBackgroundBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                                <Border Width="148" Height="12" CornerRadius="6" Background="{ThemeResource TokenActiveSegmentBackgroundBrush}" HorizontalAlignment="Left" />
                                                <Border Width="96" Height="10" CornerRadius="5" Background="{ThemeResource TokenActiveSegmentBackgroundBrush}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16" Background="{ThemeResource TokenActiveSegmentBackgroundBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Height="64" CornerRadius="16" Padding="10,8"
                                            Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                            BorderThickness="0.9">
                                        <Grid ColumnSpacing="11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="48" Height="48" CornerRadius="11" Background="{ThemeResource TokenActiveSegmentBackgroundBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                                <Border Width="170" Height="12" CornerRadius="6" Background="{ThemeResource TokenActiveSegmentBackgroundBrush}" HorizontalAlignment="Left" />
                                                <Border Width="114" Height="10" CornerRadius="5" Background="{ThemeResource TokenActiveSegmentBackgroundBrush}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16" Background="{ThemeResource TokenActiveSegmentBackgroundBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Height="64" CornerRadius="16" Padding="10,8"
                                            Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                            BorderThickness="0.9">
                                        <Grid ColumnSpacing="11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="48" Height="48" CornerRadius="11" Background="{ThemeResource TokenActiveSegmentBackgroundBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                                <Border Width="134" Height="12" CornerRadius="6" Background="{ThemeResource TokenActiveSegmentBackgroundBrush}" HorizontalAlignment="Left" />
                                                <Border Width="88" Height="10" CornerRadius="5" Background="{ThemeResource TokenActiveSegmentBackgroundBrush}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16" Background="{ThemeResource TokenActiveSegmentBackgroundBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Empty Recommendations Hint -->
                                <Border Visibility="{x:Bind ViewModel.LikedRecommendationsEmptyVisibility, Mode=OneWay}"
                                        CornerRadius="16"
                                        Padding="16,14"
                                        Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                        BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                        BorderThickness="0.9">
                                    <TextBlock Text="Add more favorites to get personalized recommendations."
                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- Recommended Tracks List (Up to 10 Cards) -->
                                <ItemsRepeater Visibility="{x:Bind ViewModel.LikedRecommendationsListVisibility, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.LikedRecommendations, Mode=OneWay}"
                                              ItemTemplate="{StaticResource LikedRecommendationRowTemplate}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </Grid>

                        <!-- LIKED TAB 2: EMPTY ARTISTS STATE -->
                        <Border Visibility="{x:Bind ViewModel.LikedArtistsEmptyVisibility, Mode=OneWay}"
                                CornerRadius="20"
                                Padding="24,28"
                                MaxWidth="520"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE77B;" FontSize="26" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No liked artists yet"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                           TextAlignment="Center" />
                                <TextBlock Text="Favorite songs by your go-to artists and they will appear here."
                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                           FontSize="12.5"
                                           Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- LIKED TAB 2A: DERIVED ARTISTS (RECENT ORDER) -->
                        <ItemsRepeater Visibility="{x:Bind ViewModel.LikedArtistsRecentVisibility, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.LikedDerivedArtists, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="168" MinColumnSpacing="16" MinRowSpacing="20" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="entities:ArtistItem">
                                    <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                            Padding="6,8"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Click="OnArtistCircleClicked"
                                            Tag="{x:Bind}"
                                            helpers:MicroInteractions.HoverScale="1.05"
                                            helpers:MicroInteractions.PressScale="0.94"
                                            helpers:MicroInteractions.HoverElevationY="-3">
                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="148" Height="148" CornerRadius="74"
                                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                    BorderThickness="1.5" HorizontalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{x:Bind InitialLetter, Mode=OneWay}"
                                                               Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="36" FontWeight="Bold"
                                                               Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Border CornerRadius="73" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeAvatarUri, Mode=OneWay}"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Stretch" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Spacing="2" MaxWidth="156">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                           FontSize="13.5" FontWeight="Bold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                                <TextBlock Text="{x:Bind DisplaySubtitle, Mode=OneWay}"
                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                           FontSize="11.5" Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- LIKED TAB 2B: DERIVED ARTISTS (A–Z GROUPS, 42px Rail Clearance) -->
                        <ItemsControl x:Name="LikedArtistsGroupsControl"
                                      Visibility="{x:Bind ViewModel.LikedArtistsAlphaVisibility, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.LikedArtistGroups, Mode=OneWay}"
                                      Margin="0,0,42,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="22" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:LibraryArtistGroup">
                                    <StackPanel Spacing="14">
                                        <Grid Margin="2,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" MinWidth="32" Height="30" CornerRadius="10" Padding="10,3"
                                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                    BorderThickness="0.9">
                                                <TextBlock Text="{x:Bind Letter, Mode=OneWay}"
                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                           FontSize="14.5" FontWeight="ExtraBold"
                                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="1" Height="1" Margin="10,0,10,0" VerticalAlignment="Center" Opacity="0.55"
                                                    Background="{ThemeResource TokenGlassBorderBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TokenSecondaryTextBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="168" MinColumnSpacing="16" MinRowSpacing="20" ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="entities:ArtistItem">
                                                    <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                            Padding="6,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Click="OnArtistCircleClicked" Tag="{x:Bind}"
                                                            helpers:MicroInteractions.HoverScale="1.05" helpers:MicroInteractions.PressScale="0.94" helpers:MicroInteractions.HoverElevationY="-3">
                                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                            <Border Width="148" Height="148" CornerRadius="74"
                                                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                    BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                                    BorderThickness="1.5" HorizontalAlignment="Center">
                                                                <Grid>
                                                                    <TextBlock Text="{x:Bind InitialLetter, Mode=OneWay}" Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenHeadingFontFamily}" FontSize="36" FontWeight="Bold"
                                                                               Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <Border CornerRadius="73" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeAvatarUri, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Spacing="2" MaxWidth="156">
                                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontFamily="{StaticResource TokenHeadingFontFamily}" FontSize="13.5" FontWeight="Bold"
                                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                                                <TextBlock Text="{x:Bind DisplaySubtitle, Mode=OneWay}" FontFamily="{StaticResource TokenBodyFontFamily}" FontSize="11.5"
                                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- LIKED TAB 3: EMPTY ALBUMS STATE -->
                        <Border Visibility="{x:Bind ViewModel.LikedAlbumsEmptyVisibility, Mode=OneWay}"
                                CornerRadius="20"
                                Padding="24,28"
                                MaxWidth="520"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE93C;" FontSize="26" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No liked albums yet"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                           TextAlignment="Center" />
                                <TextBlock Text="Like tracks from your favorite albums and they will be grouped here."
                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                           FontSize="12.5"
                                           Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- LIKED TAB 3A: DERIVED ALBUMS (RECENT ORDER) -->
                        <ItemsRepeater Visibility="{x:Bind ViewModel.LikedAlbumsRecentVisibility, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.LikedDerivedAlbums, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="192" MinItemHeight="228" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="entities:AlbumItem">
                                    <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                            Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            Click="OnAlbumCardClicked" Tag="{x:Bind}"
                                            helpers:MicroInteractions.HoverScale="1.035" helpers:MicroInteractions.PressScale="0.95" helpers:MicroInteractions.HoverElevationY="-4">
                                        <Border CornerRadius="24" Background="{ThemeResource TokenSurfaceBackgroundBrush}" BorderBrush="#33FFFFFF" BorderThickness="1">
                                            <Grid>
                                                <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}" Background="{ThemeResource TokenAccentBadgeBackgroundBrush}">
                                                    <FontIcon Glyph="&#xE93C;" FontSize="42" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <Border CornerRadius="23" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                    <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                </Border>
                                                <Border IsHitTestVisible="False" CornerRadius="23">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0.40" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0.0" />
                                                            <GradientStop Color="#4C080A10" Offset="0.48" />
                                                            <GradientStop Color="#DF080A10" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" CornerRadius="10" Padding="8,3"
                                                        Background="#78080A10" BorderBrush="#42FFFFFF" BorderThickness="0.8"
                                                        Opacity="{x:Bind TrackCountBadgeOpacity, Mode=OneWay}" IsHitTestVisible="False">
                                                    <TextBlock Text="{x:Bind TrackCountBadgeText, Mode=OneWay}" FontFamily="{StaticResource TokenHeadingFontFamily}" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,12" Spacing="2" IsHitTestVisible="False">
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontFamily="{StaticResource TokenHeadingFontFamily}" FontSize="14" FontWeight="Bold" Foreground="White" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind ArtistYearSubtitle, Mode=OneWay}" FontFamily="{StaticResource TokenBodyFontFamily}" FontSize="11.5" FontWeight="Medium" Foreground="#CCFFFFFF" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- LIKED TAB 3B: DERIVED ALBUMS (A–Z GROUPS, 42px Rail Clearance) -->
                        <ItemsControl x:Name="LikedAlbumsGroupsControl"
                                      Visibility="{x:Bind ViewModel.LikedAlbumsAlphaVisibility, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.LikedAlbumGroups, Mode=OneWay}"
                                      Margin="0,0,42,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="22" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:LibraryAlbumGroup">
                                    <StackPanel Spacing="14">
                                        <Grid Margin="2,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" MinWidth="32" Height="30" CornerRadius="10" Padding="10,3"
                                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                    BorderThickness="0.9">
                                                <TextBlock Text="{x:Bind Letter, Mode=OneWay}" FontFamily="{StaticResource TokenHeadingFontFamily}" FontSize="14.5" FontWeight="ExtraBold"
                                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="1" Height="1" Margin="10,0,10,0" VerticalAlignment="Center" Opacity="0.55" Background="{ThemeResource TokenGlassBorderBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}" FontFamily="{StaticResource TokenHeadingFontFamily}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TokenSecondaryTextBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                        <ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="192" MinItemHeight="228" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="entities:AlbumItem">
                                                    <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                            Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                            Click="OnAlbumCardClicked" Tag="{x:Bind}"
                                                            helpers:MicroInteractions.HoverScale="1.035" helpers:MicroInteractions.PressScale="0.95" helpers:MicroInteractions.HoverElevationY="-4">
                                                        <Border CornerRadius="24" Background="{ThemeResource TokenSurfaceBackgroundBrush}" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                            <Grid>
                                                                <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}" Background="{ThemeResource TokenAccentBadgeBackgroundBrush}">
                                                                    <FontIcon Glyph="&#xE93C;" FontSize="42" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Border CornerRadius="23" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                    <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                                </Border>
                                                                <Border IsHitTestVisible="False" CornerRadius="23">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0.40" EndPoint="0,1">
                                                                            <GradientStop Color="#00000000" Offset="0.0" />
                                                                            <GradientStop Color="#4C080A10" Offset="0.48" />
                                                                            <GradientStop Color="#DF080A10" Offset="1.0" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" CornerRadius="10" Padding="8,3"
                                                                        Background="#78080A10" BorderBrush="#42FFFFFF" BorderThickness="0.8"
                                                                        Opacity="{x:Bind TrackCountBadgeOpacity, Mode=OneWay}" IsHitTestVisible="False">
                                                                    <TextBlock Text="{x:Bind TrackCountBadgeText, Mode=OneWay}" FontFamily="{StaticResource TokenHeadingFontFamily}" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,12" Spacing="2" IsHitTestVisible="False">
                                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontFamily="{StaticResource TokenHeadingFontFamily}" FontSize="14" FontWeight="Bold" Foreground="White" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind ArtistYearSubtitle, Mode=OneWay}" FontFamily="{StaticResource TokenBodyFontFamily}" FontSize="11.5" FontWeight="Medium" Foreground="#CCFFFFFF" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- VIEW 4B: DEDICATED PLAYLISTS SCREEN (Android Parity: 4-State <Image>      -->
                    <!-- Cover/Collage, Quick-Play, Responsive Auto-Fill Grid, LiquidGlass Strip)  -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="PlaylistsSectionRoot"
                                Visibility="{x:Bind ViewModel.PlaylistsViewVisibility, Mode=OneWay}"
                                Spacing="18"
                                Margin="2,2,2,0">

                        <!-- Playlists Hero Header -->
                        <StackPanel Spacing="3" Margin="2,0,2,0">
                            <TextBlock Text="Playlists"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PlaylistsStatsSubtitle, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                       FontSize="12.5"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                        </StackPanel>

                        <!-- Sub-Row Action Strip: Left Duration Pill | Right New Playlist CTA -->
                        <Grid Margin="2,0,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Frosted Duration Pill -->
                            <controls:LiquidGlassPanel Grid.Column="0"
                                                       Height="38"
                                                       VerticalAlignment="Center"
                                                       GlassCornerRadius="19"
                                                       SampleLiveBackdrop="True"
                                                       GlassPadding="14,0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE90B;" FontSize="13" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.PlaylistsTotalDurationText, Mode=OneWay}"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                </StackPanel>
                            </controls:LiquidGlassPanel>

                            <!-- Right CTA Pills: Import YT Music (when signed in) + New Playlist -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <controls:LiquidGlassPanel Height="38"
                                                           VerticalAlignment="Center"
                                                           GlassCornerRadius="19"
                                                           SampleLiveBackdrop="True"
                                                           GlassPadding="0"
                                                           EnableHoverScale="True"
                                                           Visibility="{x:Bind ViewModel.YouTubeMusicSignedInVisibility, Mode=OneWay}">
                                    <Button Command="{x:Bind ViewModel.OpenYouTubePlaylistImportModalCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Height="38"
                                            CornerRadius="19"
                                            Padding="10,0,16,0"
                                            FontSize="12.5"
                                            ToolTipService.ToolTip="Import playlists from your YouTube Music account">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="20" Height="20" CornerRadius="10"
                                                    Background="#FFFF2E54">
                                                <FontIcon Glyph="&#xE896;" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Import YT Music"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </controls:LiquidGlassPanel>

                                <controls:LiquidGlassPanel Height="38"
                                                           VerticalAlignment="Center"
                                                           GlassCornerRadius="19"
                                                           SampleLiveBackdrop="True"
                                                           GlassPadding="0"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.OpenCreatePlaylistModalCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Height="38"
                                            CornerRadius="19"
                                            Padding="10,0,16,0"
                                            FontSize="12.5">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="20" Height="20" CornerRadius="10"
                                                    Background="{ThemeResource TokenPrimaryAccentBrush}">
                                                <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="New Playlist"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Auto-Generated Smart Suggested Playlists ("Sugerencias para ti" — Never Auto-Saved Until User Clicks Save) -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasSmartSuggestedPlaylistsVisibility, Mode=OneWay}"
                                    Spacing="12"
                                    Margin="2,4,2,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="24" Height="24"
                                                CornerRadius="8"
                                                Background="#24A855F7"
                                                BorderBrush="#55A855F7"
                                                BorderThickness="1">
                                            <FontIcon Glyph="&#xE734;" FontSize="11.5" Foreground="#C084FC" />
                                        </Border>
                                        <TextBlock Text="Suggested for You"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Automatically generated from your listening history (Top 20 This Week, 25-Track Genre Mix, and Favorites). Not saved to your library unless you click Save to Library."
                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.SmartSuggestedPlaylistCards, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ResponsiveAutoFillGridPanel MinItemWidth="212"
                                                                              ColumnSpacing="16"
                                                                              RowSpacing="18" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlaylistCardViewModel">
                                        <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="OnSmartPlaylistCardClicked"
                                                Tag="{x:Bind}"
                                                helpers:MicroInteractions.HoverScale="1.03"
                                                helpers:MicroInteractions.PressScale="0.96"
                                                helpers:MicroInteractions.HoverElevationY="-4">
                                            <StackPanel Spacing="8">
                                                <Border CornerRadius="20"
                                                        Height="192"
                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                        BorderBrush="#44C084FC"
                                                        BorderThickness="1.2">
                                                    <Grid>
                                                        <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE90B;"
                                                                      FontSize="44"
                                                                      Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Border CornerRadius="19"
                                                                Opacity="{x:Bind SingleCoverOpacity, Mode=OneWay}">
                                                            <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SingleCoverUri, Mode=OneWay}"
                                                                   Stretch="UniformToFill" />
                                                        </Border>
                                                        <Grid Opacity="{x:Bind CollageGridOpacity, Mode=OneWay}"
                                                              CornerRadius="19"
                                                              RowSpacing="2"
                                                              ColumnSpacing="2">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Row="0" Grid.Column="0" CornerRadius="18,4,4,4">
                                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind CollageCover1, Mode=OneWay}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <Border Grid.Row="0" Grid.Column="1" CornerRadius="4,18,4,4">
                                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind CollageCover2, Mode=OneWay}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <Border Grid.Row="1" Grid.Column="0" CornerRadius="4,4,4,18">
                                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind CollageCover3, Mode=OneWay}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <Border Grid.Row="1" Grid.Column="1" CornerRadius="4,4,18,4">
                                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind CollageCover4, Mode=OneWay}" Stretch="UniformToFill" />
                                                            </Border>
                                                        </Grid>
                                                        <Border IsHitTestVisible="False" CornerRadius="19">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#22FFFFFF" Offset="0.0" />
                                                                    <GradientStop Color="#00000000" Offset="0.32" />
                                                                    <GradientStop Color="#AA080A10" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- Top-Left Smart Category Pill -->
                                                        <Border HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Margin="10,10,0,0"
                                                                CornerRadius="10"
                                                                Padding="8,3.5"
                                                                Background="#88080A12"
                                                                BorderBrush="#66C084FC"
                                                                BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <FontIcon Glyph="{x:Bind SmartCategoryGlyph, Mode=OneWay}" FontSize="10" Foreground="#D8B4FE" />
                                                                <TextBlock Text="{x:Bind SmartBadgeText, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="10.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="White" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Bottom-Left Explicit Save to Library Button -->
                                                        <Button Click="OnSmartPlaylistSaveToLibraryClicked"
                                                                Tag="{x:Bind Playlist}"
                                                                Visibility="{x:Bind SmartSuggestionSaveVisibility, Mode=OneWay}"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Bottom"
                                                                Margin="10,0,0,10"
                                                                Height="32"
                                                                CornerRadius="16"
                                                                Padding="11,0"
                                                                Background="#CC1E1B4B"
                                                                BorderBrush="#88C084FC"
                                                                BorderThickness="1"
                                                                ToolTipService.ToolTip="Save this suggestion to your Playlists">
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE710;" FontSize="10.5" Foreground="#E9D5FF" />
                                                                <TextBlock Text="Save to Library"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White" />
                                                            </StackPanel>
                                                        </Button>

                                                        <Border Visibility="{x:Bind SmartSuggestionSavedBadgeVisibility, Mode=OneWay}"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Bottom"
                                                                Margin="10,0,0,10"
                                                                Height="30"
                                                                CornerRadius="15"
                                                                Padding="10,0"
                                                                Background="#CC064E3B"
                                                                BorderBrush="#8834D399"
                                                                BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE73E;" FontSize="10.5" Foreground="#6EE7B7" />
                                                                <TextBlock Text="Saved"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Bottom-Right Quick Play Button -->
                                                        <Button Click="OnSmartPlaylistQuickPlayClicked"
                                                                Tag="{x:Bind Playlist}"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="0,0,10,10"
                                                                Width="36" Height="36"
                                                                CornerRadius="18"
                                                                Padding="0"
                                                                Background="{ThemeResource TokenPrimaryAccentBrush}"
                                                                BorderBrush="#44FFFFFF"
                                                                BorderThickness="1"
                                                                ToolTipService.ToolTip="Play suggestion">
                                                            <FontIcon Glyph="&#xE768;" FontSize="12.5" Foreground="White" />
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Spacing="2" Margin="2,0,2,0">
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="14.5"
                                                               FontWeight="Bold"
                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind DisplaySubtitle, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                               MaxLines="2"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Empty Playlists Prompt Card (Android Parity) -->
                        <controls:LiquidGlassPanel Visibility="{x:Bind ViewModel.EmptyPlaylistsVisibility, Mode=OneWay}"
                                                   MaxWidth="520"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,36,0,0"
                                                   GlassCornerRadius="24"
                                                   GlassPadding="32,28"
                                                   SampleLiveBackdrop="True">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <Border Width="76" Height="76"
                                        CornerRadius="26"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                        BorderThickness="1.2">
                                    <FontIcon Glyph="&#xE90B;" FontSize="32" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Your playlists live here"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                           TextAlignment="Center" />
                                <TextBlock Text="Collect favorite tracks, add custom cover art, and build mixes for every session."
                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10"
                                            HorizontalAlignment="Center"
                                            Margin="0,6,0,0">
                                    <Button Command="{x:Bind ViewModel.OpenCreatePlaylistModalCommand, Mode=OneWay}"
                                            Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                            Height="40"
                                            CornerRadius="20"
                                            Padding="20,0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            helpers:MicroInteractions.HoverScale="1.05"
                                            helpers:MicroInteractions.PressScale="0.94">
                                        <TextBlock Text="+ Create First Playlist" FontWeight="Bold" />
                                    </Button>

                                    <Button Command="{x:Bind ViewModel.OpenYouTubePlaylistImportModalCommand, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.YouTubeMusicSignedInVisibility, Mode=OneWay}"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            BorderBrush="#88FF2E54"
                                            BorderThickness="1"
                                            Height="40"
                                            CornerRadius="20"
                                            Padding="18,0"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            helpers:MicroInteractions.HoverScale="1.05"
                                            helpers:MicroInteractions.PressScale="0.94">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#FFFF2E54" />
                                            <TextBlock Text="Import from YouTube Music" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </controls:LiquidGlassPanel>

                        <!-- Responsive Playlists Grid (Matching Home/Library ResponsiveAutoFillGridPanel, ZERO ImageBrush) -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PlaylistCards, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.HasPlaylistsVisibility, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:ResponsiveAutoFillGridPanel MinItemWidth="192"
                                                                          ColumnSpacing="16"
                                                                          RowSpacing="20" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlaylistCardViewModel">
                                    <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="OnPlaylistCardClicked"
                                            RightTapped="OnPlaylistCardRightTapped"
                                            Tag="{x:Bind}"
                                            helpers:MicroInteractions.HoverScale="1.035"
                                            helpers:MicroInteractions.PressScale="0.95"
                                            helpers:MicroInteractions.HoverElevationY="-4">
                                        <StackPanel Spacing="8">
                                            <!-- Glossy Square Artwork Container (4-State <Image Stretch="UniformToFill" />) -->
                                            <Border CornerRadius="20"
                                                    Height="192"
                                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <!-- State 4: Default Icon Fallback -->
                                                    <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE90B;"
                                                                  FontSize="44"
                                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                    </Grid>

                                                    <!-- State 3: Single Distinct Track Cover (Full-bleed <Image>) -->
                                                    <Border CornerRadius="19"
                                                            Opacity="{x:Bind SingleCoverOpacity, Mode=OneWay}">
                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SingleCoverUri, Mode=OneWay}"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Stretch" />
                                                    </Border>

                                                    <!-- State 2: Automatic 2x2 Collage (>= 2 Distinct Covers, 4 <Image> cells) -->
                                                    <Grid Opacity="{x:Bind CollageGridOpacity, Mode=OneWay}"
                                                          CornerRadius="19"
                                                          RowSpacing="2"
                                                          ColumnSpacing="2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Row="0" Grid.Column="0" CornerRadius="18,4,4,4">
                                                            <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind CollageCover1, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                        </Border>
                                                        <Border Grid.Row="0" Grid.Column="1" CornerRadius="4,18,4,4">
                                                            <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind CollageCover2, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="0" CornerRadius="4,4,4,18">
                                                            <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind CollageCover3, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="4,4,18,4">
                                                            <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind CollageCover4, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- State 1: Custom User Cover Art (<Image>) -->
                                                    <Border CornerRadius="19"
                                                            Opacity="{x:Bind CustomCoverOpacity, Mode=OneWay}">
                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCustomCoverUri, Mode=OneWay}"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Stretch" />
                                                    </Border>

                                                    <!-- Top Specular Sheen + Bottom Contrast Scrim -->
                                                    <Border IsHitTestVisible="False" CornerRadius="19">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#22FFFFFF" Offset="0.0" />
                                                                <GradientStop Color="#00000000" Offset="0.28" />
                                                                <GradientStop Color="#00000000" Offset="0.62" />
                                                                <GradientStop Color="#99080A10" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>

                                                    <!-- Top-Left Frosted Track Count Badge -->
                                                    <Border HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="10,10,0,0"
                                                            CornerRadius="10"
                                                            Padding="8,3"
                                                            Background="#78080A10"
                                                            BorderBrush="#42FFFFFF"
                                                            BorderThickness="0.8"
                                                            IsHitTestVisible="False">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                            <Border Width="6" Height="6" CornerRadius="3"
                                                                    Background="{ThemeResource TokenPrimaryAccentBrush}"
                                                                    Visibility="{x:Bind QuickPlayVisibility, Mode=OneWay}" />
                                                            <TextBlock Text="{x:Bind TrackBadgeText, Mode=OneWay}"
                                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                       FontSize="10.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="White" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Top-Right YouTube Music Source Indicator Pill -->
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,10,10,0"
                                                            CornerRadius="10"
                                                            Padding="8,3"
                                                            Background="#C8181820"
                                                            BorderBrush="#88FF2E54"
                                                            BorderThickness="0.9"
                                                            Visibility="{x:Bind YouTubeMusicBadgeVisibility, Mode=OneWay}"
                                                            IsHitTestVisible="False">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                            <Border Width="6" Height="6" CornerRadius="3" Background="#FFFF2E54" />
                                                            <TextBlock Text="YT Music"
                                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="White" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Bottom-Right Circular Accent Quick-Play Button -->
                                                    <Button Click="OnPlaylistCardQuickPlayClicked"
                                                            Tag="{x:Bind Playlist}"
                                                            Visibility="{x:Bind QuickPlayVisibility, Mode=OneWay}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="0,0,10,10"
                                                            Width="36" Height="36"
                                                            CornerRadius="18"
                                                            Padding="0"
                                                            Background="{ThemeResource TokenPrimaryAccentBrush}"
                                                            BorderBrush="#44FFFFFF"
                                                            BorderThickness="1"
                                                            ToolTipService.ToolTip="Play Playlist"
                                                            helpers:MicroInteractions.HoverScale="1.12"
                                                            helpers:MicroInteractions.PressScale="0.90">
                                                        <FontIcon Glyph="&#xE768;" FontSize="12.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Card Title & Subtitle -->
                                            <StackPanel Spacing="2" Margin="2,0,2,0">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                           FontSize="14.5"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind DisplaySubtitle, Mode=OneWay}"
                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- VIEW 4C: PLAYLIST DETAIL SCREEN (Exact Album Detail Design Parity +       -->
                    <!-- Dynamic Cover-Color Background + "Related to this playlist" Carousel)     -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="PlaylistDetailSectionRoot"
                                x:Load="{x:Bind ViewModel.IsPlaylistDetailViewOpen, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.PlaylistDetailViewVisibility, Mode=OneWay}"
                                Spacing="26"
                                Margin="-22,-68,-14,-32"
                                Padding="28,74,28,42"
                                Background="{StaticResource PlaylistAmbientBackgroundBrush}">

                        <!-- Top Chrome: Left 44x44 Circular LiquidGlass Back | Right 44x44 Circular LiquidGlass Delete -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <controls:LiquidGlassPanel Grid.Column="0"
                                                       Width="44"
                                                       Height="44"
                                                       GlassCornerRadius="22"
                                                       GlassPadding="0"
                                                       SampleLiveBackdrop="True"
                                                       EnableHoverScale="True">
                                <Button Command="{x:Bind ViewModel.NavigateBackFromDetailCommand, Mode=OneWay}"
                                        Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                        Width="44"
                                        Height="44"
                                        CornerRadius="22"
                                        Padding="0"
                                        ToolTipService.ToolTip="Back">
                                    <FontIcon Glyph="&#xE72B;"
                                              FontSize="14"
                                              Foreground="{StaticResource PlaylistPrimaryInkBrush}" />
                                </Button>
                            </controls:LiquidGlassPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                <controls:LiquidGlassPanel Height="42"
                                                           GlassCornerRadius="21"
                                                           GlassPadding="0"
                                                           SampleLiveBackdrop="True"
                                                           EnableHoverScale="True"
                                                           Visibility="{x:Bind ViewModel.CurrentPlaylistSaveToLibraryVisibility, Mode=OneWay}">
                                    <Button Click="OnSmartPlaylistSaveToLibraryClicked"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Height="42"
                                            CornerRadius="21"
                                            Padding="16,0"
                                            ToolTipService.ToolTip="Save this suggested playlist to your library">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="#C084FC" />
                                            <TextBlock Text="Save to Library"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PlaylistPrimaryInkBrush}" />
                                        </StackPanel>
                                    </Button>
                                </controls:LiquidGlassPanel>

                                <controls:LiquidGlassPanel Height="42"
                                                           GlassCornerRadius="21"
                                                           GlassPadding="14,0"
                                                           SampleLiveBackdrop="True"
                                                           Visibility="{x:Bind ViewModel.CurrentPlaylistSavedBadgeVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#34D399" />
                                        <TextBlock Text="Saved"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PlaylistPrimaryInkBrush}" />
                                    </StackPanel>
                                </controls:LiquidGlassPanel>

                                <controls:LiquidGlassPanel Width="44"
                                                           Height="44"
                                                           GlassCornerRadius="22"
                                                           GlassPadding="0"
                                                           SampleLiveBackdrop="True"
                                                           EnableHoverScale="True"
                                                           Visibility="{x:Bind ViewModel.CurrentPlaylistRefreshButtonVisibility, Mode=OneWay}">
                                    <Button Command="{x:Bind ViewModel.RefreshCurrentYouTubePlaylistCommand, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.CanRefreshCurrentYouTubePlaylist, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="22"
                                            Padding="0"
                                            ToolTipService.ToolTip="Refresh from YouTube Music">
                                        <FontIcon Glyph="&#xE72C;"
                                                  FontSize="14"
                                                  Foreground="{StaticResource PlaylistPrimaryInkBrush}" />
                                    </Button>
                                </controls:LiquidGlassPanel>

                                <controls:LiquidGlassPanel Width="44"
                                                           Height="44"
                                                           GlassCornerRadius="22"
                                                           GlassPadding="0"
                                                           SampleLiveBackdrop="True"
                                                           EnableHoverScale="True"
                                                           Visibility="{x:Bind ViewModel.CurrentPlaylistDeleteButtonVisibility, Mode=OneWay}">
                                    <Button Command="{x:Bind ViewModel.RequestDeleteCurrentPlaylistCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="22"
                                            Padding="0"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.CurrentPlaylistDeleteButtonTooltip, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE74D;"
                                                  FontSize="14.5"
                                                  Foreground="#FFFF6B7A" />
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Two-Column Main Split (Exact AlbumDetailSectionRoot Parity: 320 Left Hero | * Right Tracklist) -->
                        <Grid ColumnSpacing="48" Margin="6,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: 236x236 4-State Cover + Title + Playlist Accent Label + Flat Metadata + Circular LiquidGlass Play/Shuffle + Expandable Description -->
                            <StackPanel Grid.Column="0"
                                        Width="310"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Spacing="10">

                                <!-- 236x236 4-State Glossy Playlist Cover (<Image Stretch="UniformToFill" />, ZERO ImageBrush) -->
                                <Border Width="236"
                                        Height="236"
                                        CornerRadius="24"
                                        Background="{StaticResource PlaylistCardBackgroundBrush}"
                                        BorderBrush="{StaticResource PlaylistCardBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,8">
                                    <Grid Width="236" Height="236">
                                        <!-- Default Icon -->
                                        <Grid Opacity="{x:Bind ViewModel.CurrentPlaylistCard.DefaultCoverIconOpacity, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE90B;"
                                                      FontSize="64"
                                                      Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                                      Opacity="0.45"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Single Distinct Cover -->
                                        <Border CornerRadius="23" Opacity="{x:Bind ViewModel.CurrentPlaylistCard.SingleCoverOpacity, Mode=OneWay}">
                                            <Image helpers:BitmapDecodeHelper.DecodeWidth="512" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentPlaylistCard.SingleCoverUri, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>

                                        <!-- 2x2 Collage (>= 2 Distinct Covers) -->
                                        <Grid Opacity="{x:Bind ViewModel.CurrentPlaylistCard.CollageGridOpacity, Mode=OneWay}"
                                              CornerRadius="23" RowSpacing="2" ColumnSpacing="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Row="0" Grid.Column="0" CornerRadius="22,4,4,4">
                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentPlaylistCard.CollageCover1, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="1" CornerRadius="4,22,4,4">
                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentPlaylistCard.CollageCover2, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="0" CornerRadius="4,4,4,22">
                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentPlaylistCard.CollageCover3, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="1" CornerRadius="4,4,22,4">
                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentPlaylistCard.CollageCover4, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                            </Border>
                                        </Grid>

                                        <!-- Custom User Cover -->
                                        <Border CornerRadius="23" Opacity="{x:Bind ViewModel.CurrentPlaylistCard.CustomCoverOpacity, Mode=OneWay}">
                                            <Image helpers:BitmapDecodeHelper.DecodeWidth="512" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentPlaylistCard.SafeCustomCoverUri, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>

                                        <!-- Subtle Top Specular Sheen -->
                                        <Border IsHitTestVisible="False" CornerRadius="23">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#22FFFFFF" Offset="0.0" />
                                                    <GradientStop Color="#00000000" Offset="0.32" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Centered Playlist Title (Exact Album Detail Typography) -->
                                <TextBlock Text="{x:Bind ViewModel.CurrentPlaylistDetail.Title, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PlaylistPrimaryInkBrush}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- YouTube Music Origin Indicator Pill -->
                                <Border Visibility="{x:Bind ViewModel.CurrentPlaylistYouTubeBadgeVisibility, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        Background="#B8181820"
                                        BorderBrush="#88FF2E54"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#FFFF2E54" />
                                        <TextBlock Text="YouTube Music"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </StackPanel>
                                </Border>

                                <!-- Subtle Accent Subtitle ("Playlist" or "Sugerencia para ti", Mirrors Album's Artist Accent Line) -->
                                <TextBlock Text="{x:Bind ViewModel.CurrentPlaylistTypeAccentLabel, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenSubheadingFontFamily}"
                                           FontSize="14.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PlaylistArtistLinkBrush}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <!-- Flat Metadata Line ("12 songs · 44m", No Pill Border — Exact Album Detail Parity) -->
                                <TextBlock Text="{x:Bind ViewModel.CurrentPlaylistCard.DetailMetadataPillText, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <!-- Circular Icon-Only 52x52 LiquidGlass Play & Shuffle Buttons (Exact Album Detail Parity) -->
                                <StackPanel Orientation="Horizontal"
                                            Spacing="16"
                                            HorizontalAlignment="Center"
                                            Margin="0,6,0,4"
                                            Opacity="{x:Bind ViewModel.CurrentPlaylistCard.ActionButtonOpacity, Mode=OneWay}">
                                    <controls:LiquidGlassPanel Width="52"
                                                               Height="52"
                                                               GlassCornerRadius="26"
                                                               GlassPadding="0"
                                                               SampleLiveBackdrop="True"
                                                               EnableHoverScale="True">
                                        <Button Command="{x:Bind ViewModel.PlayCurrentPlaylistCommand, Mode=OneWay}"
                                                Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                                Width="52"
                                                Height="52"
                                                CornerRadius="26"
                                                Padding="0"
                                                ToolTipService.ToolTip="Play"
                                                helpers:MicroInteractions.HoverScale="1.06"
                                                helpers:MicroInteractions.PressScale="0.93">
                                            <FontIcon Glyph="&#xE768;"
                                                      FontSize="16"
                                                      Foreground="{StaticResource PlaylistPrimaryInkBrush}" />
                                        </Button>
                                    </controls:LiquidGlassPanel>

                                    <controls:LiquidGlassPanel Width="52"
                                                               Height="52"
                                                               GlassCornerRadius="26"
                                                               GlassPadding="0"
                                                               SampleLiveBackdrop="True"
                                                               EnableHoverScale="True">
                                        <Button Command="{x:Bind ViewModel.ShuffleCurrentPlaylistCommand, Mode=OneWay}"
                                                Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                                Width="52"
                                                Height="52"
                                                CornerRadius="26"
                                                Padding="0"
                                                ToolTipService.ToolTip="Shuffle"
                                                helpers:MicroInteractions.HoverScale="1.06"
                                                helpers:MicroInteractions.PressScale="0.93">
                                            <FontIcon Glyph="&#xE8B1;"
                                                      FontSize="16"
                                                      Foreground="{StaticResource PlaylistPrimaryInkBrush}" />
                                        </Button>
                                    </controls:LiquidGlassPanel>
                                </StackPanel>

                                <!-- Expandable Playlist Description with Inline Smooth Spring Animation & MORE / LESS Button -->
                                <Grid HorizontalAlignment="Center" Width="296">
                                    <StackPanel x:Name="PlaylistDescriptionAnimatedContainer"
                                                Spacing="4"
                                                HorizontalAlignment="Center"
                                                Visibility="{x:Bind ViewModel.PlaylistDescriptionVisibility, Mode=OneWay}">
                                        <StackPanel.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.24" />
                                        </StackPanel.OpacityTransition>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentPlaylistDetail.Description, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxLines="{x:Bind ViewModel.PlaylistDescriptionMaxLines, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Button Command="{x:Bind ViewModel.TogglePlaylistDescriptionExpandedCommand, Mode=OneWay}"
                                                Content="{x:Bind ViewModel.PlaylistDescriptionToggleText, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.PlaylistDescriptionToggleVisibility, Mode=OneWay}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,2"
                                                HorizontalAlignment="Center"
                                                FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                FontSize="11.5"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource PlaylistArtistLinkBrush}"
                                                helpers:MicroInteractions.HoverScale="1.06"
                                                helpers:MicroInteractions.PressScale="0.94" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- RIGHT COLUMN: "Tracks" Header + Flat Album-Style Tracklist (or Ambient Empty Card) -->
                            <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">

                                <TextBlock Text="Tracks"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PlaylistPrimaryInkBrush}"
                                           Margin="8,0,0,4" />

                                <!-- Empty Tracks State (Ambient Palette Styled) -->
                                <Border Visibility="{x:Bind ViewModel.EmptyPlaylistDetailTracksVisibility, Mode=OneWay}"
                                        CornerRadius="22"
                                        Padding="28,32"
                                        Background="{StaticResource PlaylistCardBackgroundBrush}"
                                        BorderBrush="{StaticResource PlaylistCardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                        <Border Width="52"
                                                Height="52"
                                                CornerRadius="26"
                                                Background="{StaticResource PlaylistCardBackgroundBrush}"
                                                BorderBrush="{StaticResource PlaylistCardBorderBrush}"
                                                BorderThickness="1">
                                            <FontIcon Glyph="&#xEC4F;"
                                                      FontSize="22"
                                                      Foreground="{StaticResource PlaylistPrimaryInkBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="No tracks in this playlist yet"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PlaylistPrimaryInkBrush}"
                                                   TextAlignment="Center" />
                                        <TextBlock Text="Open any song's menu and choose Add to Playlist to start curating."
                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Flat Active-Highlight Playlist Track Rows (Exact AlbumDetail Styling + 48x48 Thumbnail + Remove '×') -->
                                <ItemsRepeater Visibility="{x:Bind ViewModel.HasPlaylistDetailTracksVisibility, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.PlaylistDetailTrackRows, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlaylistTrackRowItem">
                                            <Grid MinHeight="60"
                                                  CornerRadius="14"
                                                  Tapped="OnPlaylistDetailTrackTapped"
                                                  RightTapped="OnTrackRowRightTapped"
                                                  PointerEntered="OnAlbumTrackRowPointerEntered"
                                                  PointerExited="OnAlbumTrackRowPointerExited"
                                                  Tag="{x:Bind Track}"
                                                  Background="Transparent"
                                                  helpers:MicroInteractions.HoverScale="1.008"
                                                  helpers:MicroInteractions.PressScale="0.992">

                                                <!-- Layer 0: Active Playing Song Illuminated Box Background -->
                                                <Border CornerRadius="14"
                                                        Background="{StaticResource PlaylistTrackActiveBackgroundBrush}"
                                                        Opacity="{x:Bind Track.ActiveRowHighlightOpacity, Mode=OneWay}"
                                                        IsHitTestVisible="False">
                                                    <Border.OpacityTransition>
                                                        <ScalarTransition Duration="0:0:0.22" />
                                                    </Border.OpacityTransition>
                                                </Border>

                                                <!-- Layer 1: Smooth Hover Highlight Layer -->
                                                <Border CornerRadius="14"
                                                        Background="{StaticResource PlaylistCardBackgroundBrush}"
                                                        Opacity="0"
                                                        IsHitTestVisible="False">
                                                    <Border.OpacityTransition>
                                                        <ScalarTransition Duration="0:0:0.16" />
                                                    </Border.OpacityTransition>
                                                </Border>

                                                <!-- Layer 2: Song Row Content -->
                                                <Grid Padding="12,7,10,7" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Col 0: 1-Based Index OR 3-Bar Playing Equalizer -->
                                                    <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind IndexText, Mode=OneWay}"
                                                                   Opacity="{x:Bind Track.TrackNumberOpacity, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="2.5"
                                                                    Height="16"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Opacity="{x:Bind Track.PlayingIndicatorOpacity, Mode=OneWay}">
                                                            <Border Width="3" Height="12" CornerRadius="1.5" VerticalAlignment="Center" Background="{StaticResource PlaylistTrackActiveAccentBrush}" />
                                                            <Border Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center" Background="{StaticResource PlaylistTrackActiveAccentBrush}" />
                                                            <Border Width="3" Height="11" CornerRadius="1.5" VerticalAlignment="Center" Background="{StaticResource PlaylistTrackActiveAccentBrush}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Col 1: 48x48 Rounded-Square Cover (<Image Stretch="UniformToFill" />) -->
                                                    <Border Grid.Column="1"
                                                            Width="48"
                                                            Height="48"
                                                            CornerRadius="11"
                                                            Background="{StaticResource PlaylistCardBackgroundBrush}"
                                                            BorderBrush="{StaticResource PlaylistCardBorderBrush}"
                                                            BorderThickness="0.8"
                                                            VerticalAlignment="Center">
                                                        <Grid>
                                                            <Grid Opacity="{x:Bind Track.DefaultCoverIconOpacity, Mode=OneWay}">
                                                                <FontIcon Glyph="&#xEC4F;"
                                                                          FontSize="17"
                                                                          Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Border CornerRadius="10.5" Opacity="{x:Bind Track.CoverArtOpacity, Mode=OneWay}">
                                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind Track.SafeCoverArtUri, Mode=OneWay}"
                                                                       Stretch="UniformToFill"
                                                                       HorizontalAlignment="Stretch"
                                                                       VerticalAlignment="Stretch" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Col 2: Stacked Title (+ [E] + Offline) & Artist • Album -->
                                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                        <Grid ColumnSpacing="6" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Track.Title, Mode=OneWay}"
                                                                           Opacity="{x:Bind Track.InactiveTitleOpacity, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource PlaylistPrimaryInkBrush}"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind Track.Title, Mode=OneWay}"
                                                                           Opacity="{x:Bind Track.ActiveTitleOpacity, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource PlaylistTrackActiveAccentBrush}"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                            <controls:ExplicitBadgeControl Grid.Column="1"
                                                                                           IsCompact="True"
                                                                                           Visibility="{x:Bind Track.IsExplicit, Mode=OneWay}"
                                                                                           VerticalAlignment="Center" />
                                                            <FontIcon Grid.Column="2"
                                                                      Glyph="&#xE896;"
                                                                      FontSize="11"
                                                                      Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                                                      Opacity="{x:Bind Track.DownloadedBadgeOpacity, Mode=OneWay}"
                                                                      ToolTipService.ToolTip="Available Offline / Local Audio"
                                                                      VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind Track.ArtistAlbumDotSubtitle, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                                                   MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Col 3: Duration -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{x:Bind Track.FormattedDuration, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                               FontSize="12.5"
                                                               Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,4,0" />

                                                    <!-- Col 4: Like / Heart Button -->
                                                    <Button Grid.Column="4"
                                                            Click="OnTrackRowLikeClicked"
                                                            Tag="{x:Bind Track}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Width="32"
                                                            Height="32"
                                                            CornerRadius="16"
                                                            Padding="0"
                                                            ToolTipService.ToolTip="Like"
                                                            helpers:MicroInteractions.HoverScale="1.15"
                                                            helpers:MicroInteractions.PressScale="0.88">
                                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xEB51;"
                                                                      Opacity="0.78"
                                                                      FontSize="13.5"
                                                                      Foreground="{StaticResource PlaylistSecondaryInkBrush}" />
                                                            <FontIcon Glyph="&#xEB52;"
                                                                      FontSize="13.5"
                                                                      Foreground="{StaticResource PlaylistTrackActiveAccentBrush}"
                                                                      Visibility="{x:Bind Track.IsLiked, Mode=OneWay}" />
                                                        </Grid>
                                                    </Button>

                                                    <!-- Col 5: Vertical 3-Dots More Options -->
                                                    <Button Grid.Column="5"
                                                            Click="OnTrackRowMoreClicked"
                                                            Tag="{x:Bind Track}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Width="32"
                                                            Height="32"
                                                            CornerRadius="16"
                                                            Padding="0"
                                                            ToolTipService.ToolTip="Song Options"
                                                            helpers:MicroInteractions.HoverScale="1.14"
                                                            helpers:MicroInteractions.PressScale="0.88">
                                                        <FontIcon Glyph="&#xE712;"
                                                                  FontSize="13"
                                                                  Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                                                  RenderTransformOrigin="0.5,0.5">
                                                            <FontIcon.RenderTransform>
                                                                <RotateTransform Angle="90" />
                                                            </FontIcon.RenderTransform>
                                                        </FontIcon>
                                                    </Button>

                                                    <!-- Col 6: Remove ('×') from Playlist -->
                                                    <Button Grid.Column="6"
                                                            Click="OnRemovePlaylistTrackClicked"
                                                            Tag="{x:Bind Track}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Width="30"
                                                            Height="30"
                                                            CornerRadius="15"
                                                            Padding="0"
                                                            ToolTipService.ToolTip="Remove from Playlist"
                                                            helpers:MicroInteractions.HoverScale="1.14"
                                                            helpers:MicroInteractions.PressScale="0.88">
                                                        <FontIcon Glyph="&#xE711;"
                                                                  FontSize="10.5"
                                                                  Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                                                  Opacity="0.82" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Grid>

                        <!-- SECTION: Related to this playlist (Exact Album Detail "More by:" Carousel) -->
                        <StackPanel Spacing="10"
                                    Margin="6,6,6,0"
                                    Visibility="{x:Bind ViewModel.PlaylistRelatedSectionVisibility, Mode=OneWay}">
                            <StackPanel Spacing="2" Margin="4,0,0,0">
                                <TextBlock Text="Related to this playlist"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PlaylistPrimaryInkBrush}" />
                                <TextBlock Text="Based on the songs in this playlist"
                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                           FontSize="12.5"
                                           Foreground="{StaticResource PlaylistSecondaryInkBrush}" />
                            </StackPanel>

                            <!-- 4-Card Horizontal Loading Skeleton -->
                            <StackPanel x:Name="PlaylistRelatedSkeletonHost"
                                        Visibility="{x:Bind ViewModel.PlaylistRelatedSkeletonVisibility, Mode=OneWay}"
                                        Orientation="Horizontal"
                                        Spacing="18"
                                        Margin="4,8,0,14">
                                <StackPanel Width="148" Spacing="8">
                                    <Border Width="148" Height="148" CornerRadius="18" Background="{StaticResource PlaylistSkeletonFillBrush}" />
                                    <Border Width="118" Height="13" CornerRadius="6" Background="{StaticResource PlaylistSkeletonFillBrush}" HorizontalAlignment="Left" />
                                    <Border Width="84" Height="11" CornerRadius="5" Background="{StaticResource PlaylistSkeletonFillBrush}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Width="148" Spacing="8">
                                    <Border Width="148" Height="148" CornerRadius="18" Background="{StaticResource PlaylistSkeletonFillBrush}" />
                                    <Border Width="118" Height="13" CornerRadius="6" Background="{StaticResource PlaylistSkeletonFillBrush}" HorizontalAlignment="Left" />
                                    <Border Width="84" Height="11" CornerRadius="5" Background="{StaticResource PlaylistSkeletonFillBrush}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Width="148" Spacing="8">
                                    <Border Width="148" Height="148" CornerRadius="18" Background="{StaticResource PlaylistSkeletonFillBrush}" />
                                    <Border Width="118" Height="13" CornerRadius="6" Background="{StaticResource PlaylistSkeletonFillBrush}" HorizontalAlignment="Left" />
                                    <Border Width="84" Height="11" CornerRadius="5" Background="{StaticResource PlaylistSkeletonFillBrush}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Width="148" Spacing="8">
                                    <Border Width="148" Height="148" CornerRadius="18" Background="{StaticResource PlaylistSkeletonFillBrush}" />
                                    <Border Width="118" Height="13" CornerRadius="6" Background="{StaticResource PlaylistSkeletonFillBrush}" HorizontalAlignment="Left" />
                                    <Border Width="84" Height="11" CornerRadius="5" Background="{StaticResource PlaylistSkeletonFillBrush}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Horizontal Related Tracks Carousel -->
                            <ScrollViewer Visibility="{x:Bind ViewModel.HasPlaylistRelatedVisibility, Mode=OneWay}"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Padding="4,8,16,18">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.PlaylistRelatedTracks, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="18" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="entities:TrackItem">
                                            <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                    Padding="4,6"
                                                    Click="OnPlaylistRelatedTrackClicked"
                                                    RightTapped="OnTrackRowRightTapped"
                                                    Tag="{x:Bind}"
                                                    helpers:MicroInteractions.HoverScale="1.04"
                                                    helpers:MicroInteractions.PressScale="0.95"
                                                    helpers:MicroInteractions.HoverElevationY="-4">
                                                <StackPanel Width="150" Spacing="6">
                                                    <Border Width="148"
                                                            Height="148"
                                                            CornerRadius="18"
                                                            Background="{StaticResource PlaylistCardBackgroundBrush}"
                                                            BorderBrush="{StaticResource PlaylistCardBorderBrush}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Left">
                                                        <Grid>
                                                            <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                                <FontIcon Glyph="&#xEC4F;"
                                                                          FontSize="36"
                                                                          Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Border CornerRadius="17"
                                                                    Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                       Stretch="UniformToFill"
                                                                       HorizontalAlignment="Stretch"
                                                                       VerticalAlignment="Stretch" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="13.5"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource PlaylistPrimaryInkBrush}"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               Margin="2,2,0,0" />
                                                    <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource PlaylistSecondaryInkBrush}"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               Margin="2,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- VIEW 5: ANDROID-MATCHED LIBRARY 2.0 WORKSPACE                             -->
                    <!-- Floating Sticky Header + Slicers sit above CatalogScrollViewer;           -->
                    <!-- Right-side A–Z + '#' Fast-Scroll Rail sits on Artists/Albums/Songs tabs.  -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="LibrarySectionRoot"
                                Visibility="{x:Bind ViewModel.LibraryViewVisibility, Mode=OneWay}"
                                Spacing="18">

                        <!-- Top Clearance Spacer for Floating Sticky Library Header & Slicers -->
                        <Border Height="132" IsHitTestVisible="False" />

                        <!-- ===================================================================== -->
                        <!-- TAB 1: "ALL" OVERVIEW (Recently Added -> Artists -> Albums -> Songs)  -->
                        <!-- ===================================================================== -->
                        <StackPanel x:Name="LibraryOverviewRoot"
                                    Visibility="{x:Bind ViewModel.LibraryOverviewVisibility, Mode=OneWay}"
                                    Spacing="22">

                            <!-- Empty Overview State Card (Source-aware Local / Online / All) -->
                            <controls:LiquidGlassPanel Visibility="{x:Bind ViewModel.LibraryOverviewEmptyVisibility, Mode=OneWay}"
                                                       MaxWidth="560"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,18,0,12"
                                                       GlassCornerRadius="22"
                                                       GlassPadding="28,24">
                                <StackPanel Spacing="12" HorizontalAlignment="Center">
                                    <Border Width="56" Height="56"
                                            CornerRadius="28"
                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xEC4F;"
                                                  FontSize="24"
                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    </Border>

                                    <TextBlock Text="{x:Bind ViewModel.LibraryEmptyHeadline, Mode=OneWay}"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                               TextAlignment="Center" />

                                    <TextBlock Text="{x:Bind ViewModel.LibraryEmptyBody, Mode=OneWay}"
                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               MaxWidth="440" />

                                    <StackPanel Visibility="{x:Bind ViewModel.LibraryEmptyImportActionsVisibility, Mode=OneWay}"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                HorizontalAlignment="Center"
                                                Margin="0,6,0,0">
                                        <Button Command="{x:Bind ViewModel.ScanUserMusicFolderCommand, Mode=OneWay}"
                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="20"
                                                Height="40"
                                                Padding="18,0"
                                                helpers:MicroInteractions.HoverScale="1.05"
                                                helpers:MicroInteractions.PressScale="0.94">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                <TextBlock Text="Scan Folder"
                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                           FontSize="12.5"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{x:Bind ViewModel.PickAndImportFilesCommand, Mode=OneWay}"
                                                Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                                BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                CornerRadius="20"
                                                Height="40"
                                                Padding="18,0"
                                                helpers:MicroInteractions.HoverScale="1.05"
                                                helpers:MicroInteractions.PressScale="0.94">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8E5;" FontSize="13" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                <TextBlock Text="Add Files"
                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </controls:LiquidGlassPanel>

                            <!-- 1. RECENTLY ADDED SECTION -->
                            <StackPanel Visibility="{x:Bind ViewModel.HasLibraryRecentlyAddedVisibility, Mode=OneWay}"
                                        Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,4,0" VerticalAlignment="Center">
                                    <Border Width="28" Height="28"
                                            CornerRadius="9"
                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                            BorderThickness="0.9">
                                        <FontIcon Glyph="&#xE81C;" FontSize="13.5" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    </Border>
                                    <TextBlock Text="Recently Added"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Command="{x:Bind ViewModel.OpenLibraryRecentlyAddedCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentMediaCardButtonStyle}"
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            CornerRadius="15"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="See all recently added"
                                            helpers:MicroInteractions.HoverScale="1.15"
                                            helpers:MicroInteractions.PressScale="0.90">
                                        <FontIcon Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </Button>
                                </StackPanel>

                                <Grid x:Name="LibraryRecentlyAddedCarouselHost">
                                    <ScrollViewer x:Name="LibraryRecentlyAddedScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  VerticalScrollMode="Disabled"
                                                  Padding="18,12,18,20"
                                                  Loaded="OnHomeHorizontalCarouselLoaded"
                                                  SizeChanged="OnHomeHorizontalCarouselSizeChanged"
                                                  ViewChanged="OnHomeHorizontalCarouselViewChanged">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="14"
                                                    SizeChanged="OnHomeHorizontalItemsPanelSizeChanged">
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.LibraryRecentlyAddedPreview, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="14"
                                                                    SizeChanged="OnHomeHorizontalItemsPanelSizeChanged" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:TrackItem">
                                                        <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                                Padding="0"
                                                                Click="OnLibraryRecentlyAddedCardClicked"
                                                                RightTapped="OnTrackRowRightTapped"
                                                                Tag="{x:Bind}"
                                                                helpers:MicroInteractions.HoverScale="1.05"
                                                                helpers:MicroInteractions.PressScale="0.94"
                                                                helpers:MicroInteractions.HoverElevationY="-4">
                                                            <Border Width="172"
                                                                    Height="204"
                                                                    CornerRadius="24"
                                                                    Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                                                    BorderBrush="#33FFFFFF"
                                                                    BorderThickness="1">
                                                                <Grid>
                                                                    <!-- Fallback Artwork -->
                                                                    <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}"
                                                                          Background="{ThemeResource TokenAccentBadgeBackgroundBrush}">
                                                                        <FontIcon Glyph="&#xEC4F;"
                                                                                  FontSize="36"
                                                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                                    </Grid>

                                                                    <!-- Full-bleed Cover Art (<Image> only) -->
                                                                    <Border CornerRadius="23" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                               Stretch="UniformToFill"
                                                                               HorizontalAlignment="Stretch"
                                                                               VerticalAlignment="Stretch" />
                                                                    </Border>

                                                                    <!-- Bottom Progressive Dark Scrim -->
                                                                    <Border IsHitTestVisible="False" CornerRadius="23">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0.40" EndPoint="0,1">
                                                                                <GradientStop Color="#00000000" Offset="0.0" />
                                                                                <GradientStop Color="#44080A10" Offset="0.46" />
                                                                                <GradientStop Color="#D8080A10" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>

                                                                    <!-- Active Playing Border Highlight -->
                                                                    <Border CornerRadius="23"
                                                                            BorderBrush="{ThemeResource TokenPrimaryAccentBrush}"
                                                                            BorderThickness="1.8"
                                                                            Opacity="{x:Bind ActiveRowHighlightOpacity, Mode=OneWay}"
                                                                            IsHitTestVisible="False" />

                                                                    <!-- Top-Left Active Equalizer Pill (when playing) -->
                                                                    <Border HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Margin="10,10,0,0"
                                                                            Width="26"
                                                                            Height="26"
                                                                            CornerRadius="13"
                                                                            Background="{ThemeResource TokenPrimaryAccentBrush}"
                                                                            Opacity="{x:Bind PlayingIndicatorOpacity, Mode=OneWay}"
                                                                            IsHitTestVisible="False">
                                                                        <StackPanel Orientation="Horizontal" Spacing="2" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Border Width="2.2" Height="6" CornerRadius="1" VerticalAlignment="Bottom" Background="White" />
                                                                            <Border Width="2.2" Height="11" CornerRadius="1" VerticalAlignment="Bottom" Background="White" />
                                                                            <Border Width="2.2" Height="8" CornerRadius="1" VerticalAlignment="Bottom" Background="White" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- Top-Right Frosted Duration Pill (e.g. 3:30) -->
                                                                    <Border HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,10,10,0"
                                                                            CornerRadius="10"
                                                                            Padding="8,3"
                                                                            Background="#78080A10"
                                                                            BorderBrush="#42FFFFFF"
                                                                            BorderThickness="0.8"
                                                                            IsHitTestVisible="False">
                                                                        <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                   FontSize="10.5"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="White" />
                                                                    </Border>

                                                                    <!-- Bottom-Left Title (+ [E]) & Artist -->
                                                                    <StackPanel VerticalAlignment="Bottom"
                                                                                Margin="12,0,12,12"
                                                                                Spacing="2"
                                                                                IsHitTestVisible="False">
                                                                        <Grid ColumnSpacing="5">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{x:Bind Title, Mode=OneWay}"
                                                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                       FontSize="13.5"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="White"
                                                                                       MaxLines="1"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <controls:ExplicitBadgeControl Grid.Column="1"
                                                                                                           IsCompact="True"
                                                                                                           Visibility="{x:Bind IsExplicit, Mode=OneWay}"
                                                                                                           VerticalAlignment="Center" />
                                                                        </Grid>
                                                                        <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                                   FontSize="11.5"
                                                                                   FontWeight="Medium"
                                                                                   Foreground="#CCFFFFFF"
                                                                                   MaxLines="1"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Trailing See More Timeline Card -->
                                            <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                    Padding="0"
                                                    Command="{x:Bind ViewModel.OpenLibraryRecentlyAddedCommand, Mode=OneWay}"
                                                    helpers:MicroInteractions.HoverScale="1.05"
                                                    helpers:MicroInteractions.PressScale="0.94">
                                                <Border Width="144"
                                                        Height="204"
                                                        CornerRadius="24"
                                                        Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                                        BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                                        <Border Width="42" Height="42"
                                                                CornerRadius="21"
                                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                                BorderThickness="1">
                                                            <FontIcon Glyph="&#xE72A;" FontSize="16" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind ViewModel.LibraryRecentlyAddedMoreCardCountText, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="Timeline"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <!-- 2. ARTISTS SECTION -->
                            <StackPanel Visibility="{x:Bind ViewModel.HasLibraryOverviewArtistsVisibility, Mode=OneWay}"
                                        Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,4,0" VerticalAlignment="Center">
                                    <Border Width="28" Height="28"
                                            CornerRadius="9"
                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                            BorderThickness="0.9">
                                        <FontIcon Glyph="&#xE77B;" FontSize="13.5" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    </Border>
                                    <TextBlock x:Uid="Section_Artists"
                                               helpers:Loc.Key="Section_Artists"
                                               Text="Artists"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand, Mode=OneWay}"
                                            CommandParameter="Artists"
                                            Style="{StaticResource TransparentMediaCardButtonStyle}"
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            CornerRadius="15"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.LibraryArtistsMoreLabel, Mode=OneWay}"
                                            helpers:MicroInteractions.HoverScale="1.15"
                                            helpers:MicroInteractions.PressScale="0.90">
                                        <FontIcon Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </Button>
                                </StackPanel>

                                <Grid x:Name="LibraryArtistsCarouselHost">
                                    <ScrollViewer x:Name="LibraryArtistsScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  VerticalScrollMode="Disabled"
                                                  Padding="18,14,18,22"
                                                  Loaded="OnHomeHorizontalCarouselLoaded"
                                                  SizeChanged="OnHomeHorizontalCarouselSizeChanged"
                                                  ViewChanged="OnHomeHorizontalCarouselViewChanged">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="14"
                                                    SizeChanged="OnHomeHorizontalItemsPanelSizeChanged">
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.LibraryArtistsPreview, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="14"
                                                                    SizeChanged="OnHomeHorizontalItemsPanelSizeChanged" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:ArtistItem">
                                                        <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                                Padding="6,10,6,12"
                                                                Margin="2,2,2,6"
                                                                Click="OnArtistCircleClicked"
                                                                Tag="{x:Bind}"
                                                                helpers:MicroInteractions.HoverScale="1.06"
                                                                helpers:MicroInteractions.PressScale="0.93"
                                                                helpers:MicroInteractions.HoverElevationY="-3">
                                                            <StackPanel Width="156" Spacing="8">
                                                                <Border Width="148"
                                                                        Height="148"
                                                                        CornerRadius="74"
                                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                        BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                                        BorderThickness="1.5"
                                                                        HorizontalAlignment="Center">
                                                                    <Grid>
                                                                        <TextBlock Text="{x:Bind InitialLetter, Mode=OneWay}"
                                                                                   Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                   FontSize="36"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                        <Border CornerRadius="73"
                                                                                Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                            <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeAvatarUri, Mode=OneWay}"
                                                                                   Stretch="UniformToFill"
                                                                                   HorizontalAlignment="Stretch"
                                                                                   VerticalAlignment="Stretch" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>

                                                                <StackPanel Spacing="2" HorizontalAlignment="Stretch">
                                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                               FontSize="13.5"
                                                                               FontWeight="Bold"
                                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextAlignment="Center" />
                                                                    <TextBlock Text="{x:Bind DisplaySubtitle, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                               FontSize="11.5"
                                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Trailing More Artists Card (when >10) -->
                                            <Button Visibility="{x:Bind ViewModel.LibraryArtistsMoreCardVisibility, Mode=OneWay}"
                                                    Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Command="{x:Bind ViewModel.SelectCategoryCommand, Mode=OneWay}"
                                                    CommandParameter="Artists"
                                                    helpers:MicroInteractions.HoverScale="1.05"
                                                    helpers:MicroInteractions.PressScale="0.94">
                                                <Border Width="144"
                                                        Height="196"
                                                        CornerRadius="24"
                                                        Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                                        BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                                        <Border Width="42" Height="42"
                                                                CornerRadius="21"
                                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                                BorderThickness="1">
                                                            <FontIcon Glyph="&#xE72A;" FontSize="16" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind ViewModel.LibraryArtistsMoreCardCountText, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="All artists"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <!-- 3. ALBUMS SECTION -->
                            <StackPanel Visibility="{x:Bind ViewModel.HasLibraryOverviewAlbumsVisibility, Mode=OneWay}"
                                        Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,4,0" VerticalAlignment="Center">
                                    <Border Width="28" Height="28"
                                            CornerRadius="9"
                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                            BorderThickness="0.9">
                                        <FontIcon Glyph="&#xE93C;" FontSize="13.5" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    </Border>
                                    <TextBlock x:Uid="Section_Albums"
                                               helpers:Loc.Key="Section_Albums"
                                               Text="Albums"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand, Mode=OneWay}"
                                            CommandParameter="Albums"
                                            Style="{StaticResource TransparentMediaCardButtonStyle}"
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            CornerRadius="15"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.LibraryAlbumsMoreLabel, Mode=OneWay}"
                                            helpers:MicroInteractions.HoverScale="1.15"
                                            helpers:MicroInteractions.PressScale="0.90">
                                        <FontIcon Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </Button>
                                </StackPanel>

                                <Grid x:Name="LibraryAlbumsCarouselHost">
                                    <ScrollViewer x:Name="LibraryAlbumsScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  VerticalScrollMode="Disabled"
                                                  Padding="18,12,18,20"
                                                  Loaded="OnHomeHorizontalCarouselLoaded"
                                                  SizeChanged="OnHomeHorizontalCarouselSizeChanged"
                                                  ViewChanged="OnHomeHorizontalCarouselViewChanged">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="14"
                                                    SizeChanged="OnHomeHorizontalItemsPanelSizeChanged">
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.LibraryAlbumsPreview, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="14"
                                                                    SizeChanged="OnHomeHorizontalItemsPanelSizeChanged" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:AlbumItem">
                                                        <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                                Padding="0"
                                                                Click="OnAlbumCardClicked"
                                                                Tag="{x:Bind}"
                                                                helpers:MicroInteractions.HoverScale="1.05"
                                                                helpers:MicroInteractions.PressScale="0.94"
                                                                helpers:MicroInteractions.HoverElevationY="-4">
                                                            <Border Width="172"
                                                                    Height="204"
                                                                    CornerRadius="24"
                                                                    Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                                                    BorderBrush="#33FFFFFF"
                                                                    BorderThickness="1">
                                                                <Grid>
                                                                    <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}"
                                                                          Background="{ThemeResource TokenAccentBadgeBackgroundBrush}">
                                                                        <FontIcon Glyph="&#xE93C;"
                                                                                  FontSize="40"
                                                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                                    </Grid>

                                                                    <Border CornerRadius="23" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                               Stretch="UniformToFill"
                                                                               HorizontalAlignment="Stretch"
                                                                               VerticalAlignment="Stretch" />
                                                                    </Border>

                                                                    <!-- Bottom Progressive Dark Scrim -->
                                                                    <Border IsHitTestVisible="False" CornerRadius="23">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0.40" EndPoint="0,1">
                                                                                <GradientStop Color="#00000000" Offset="0.0" />
                                                                                <GradientStop Color="#4C080A10" Offset="0.48" />
                                                                                <GradientStop Color="#DF080A10" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>

                                                                    <!-- Top-Right Frosted "{N} tracks" Pill Badge (Hidden when count unknown) -->
                                                                    <Border HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,10,10,0"
                                                                            CornerRadius="10"
                                                                            Padding="8,3"
                                                                            Background="#78080A10"
                                                                            BorderBrush="#42FFFFFF"
                                                                            BorderThickness="0.8"
                                                                            Opacity="{x:Bind TrackCountBadgeOpacity, Mode=OneWay}"
                                                                            IsHitTestVisible="False">
                                                                        <TextBlock Text="{x:Bind TrackCountBadgeText, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                   FontSize="10.5"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="White" />
                                                                    </Border>

                                                                    <!-- Bottom-Left Album Title & Artist • Year -->
                                                                    <StackPanel VerticalAlignment="Bottom"
                                                                                Margin="12,0,12,12"
                                                                                Spacing="2"
                                                                                IsHitTestVisible="False">
                                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                   FontSize="14"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="White"
                                                                                   MaxLines="1"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{x:Bind ArtistYearSubtitle, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                                   FontSize="11.5"
                                                                                   FontWeight="Medium"
                                                                                   Foreground="#CCFFFFFF"
                                                                                   MaxLines="1"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Trailing More Albums Card (when >10) -->
                                            <Button Visibility="{x:Bind ViewModel.LibraryAlbumsMoreCardVisibility, Mode=OneWay}"
                                                    Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                    Padding="0"
                                                    Command="{x:Bind ViewModel.SelectCategoryCommand, Mode=OneWay}"
                                                    CommandParameter="Albums"
                                                    helpers:MicroInteractions.HoverScale="1.05"
                                                    helpers:MicroInteractions.PressScale="0.94">
                                                <Border Width="144"
                                                        Height="204"
                                                        CornerRadius="24"
                                                        Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                                        BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                                        <Border Width="42" Height="42"
                                                                CornerRadius="21"
                                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                                BorderThickness="1">
                                                            <FontIcon Glyph="&#xE72A;" FontSize="16" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind ViewModel.LibraryAlbumsMoreCardCountText, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="All albums"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <!-- 4. SONGS SECTION (Responsive 2+ Column Grid) -->
                            <StackPanel Visibility="{x:Bind ViewModel.HasLibraryOverviewSongsVisibility, Mode=OneWay}"
                                        Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,4,0" VerticalAlignment="Center">
                                    <Border Width="28" Height="28"
                                            CornerRadius="9"
                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                            BorderThickness="0.9">
                                        <FontIcon Glyph="&#xEC4F;" FontSize="13.5" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    </Border>
                                    <TextBlock x:Uid="Section_Songs"
                                               helpers:Loc.Key="Section_Songs"
                                               Text="Songs"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Command="{x:Bind ViewModel.SelectCategoryCommand, Mode=OneWay}"
                                            CommandParameter="Songs"
                                            Style="{StaticResource TransparentMediaCardButtonStyle}"
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            CornerRadius="15"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.LibrarySongsMoreLabel, Mode=OneWay}"
                                            helpers:MicroInteractions.HoverScale="1.15"
                                            helpers:MicroInteractions.PressScale="0.90">
                                        <FontIcon Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </Button>
                                </StackPanel>

                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.LibrarySongsPreview, Mode=OneWay}"
                                              ItemTemplate="{StaticResource LibraryQueueSongRowTemplate}"
                                              Margin="2,0,2,0">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="340" MinItemHeight="68" MaximumRowsOrColumns="3" MinColumnSpacing="12" MinRowSpacing="8" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>

                            <!-- 5. LOCAL LIBRARY TOOLS BAR (Scan Folder & Import Files when Local or All) -->
                            <Border Visibility="{x:Bind ViewModel.LibraryLocalToolsBarVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    CornerRadius="22"
                                    Padding="16,10"
                                    Margin="0,6,0,4"
                                    Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                    BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                    BorderThickness="0.9">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button Command="{x:Bind ViewModel.ScanUserMusicFolderCommand, Mode=OneWay}"
                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                            BorderThickness="0.9"
                                            CornerRadius="16"
                                            Height="34"
                                            Padding="14,0"
                                            ToolTipService.ToolTip="Scan Music Folder (Recursive Metadata, Cover Art &amp; .LRC)"
                                            helpers:MicroInteractions.HoverScale="1.05"
                                            helpers:MicroInteractions.PressScale="0.94">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                            <TextBlock Text="Scan Folder"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{x:Bind ViewModel.PickAndImportFilesCommand, Mode=OneWay}"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                            CornerRadius="16"
                                            Height="34"
                                            Padding="14,0"
                                            ToolTipService.ToolTip="Import Individual Audio Files (.mp3, .flac, .m4a, .wav, .ogg)"
                                            helpers:MicroInteractions.HoverScale="1.05"
                                            helpers:MicroInteractions.PressScale="0.94">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8E5;" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                            <TextBlock Text="Add Files"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===================================================================== -->
                        <!-- TAB 2: ARTISTS A–Z + '#' ALPHABETICAL DIRECTORY                       -->
                        <!-- ===================================================================== -->
                        <StackPanel x:Name="LibraryArtistsDirectoryRoot"
                                    Visibility="{x:Bind ViewModel.LibraryArtistsDirectoryVisibility, Mode=OneWay}"
                                    Spacing="18"
                                    Margin="0,0,42,0">

                            <controls:LiquidGlassPanel Visibility="{x:Bind ViewModel.LibraryArtistsEmptyVisibility, Mode=OneWay}"
                                                       MaxWidth="480"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,24,0,0"
                                                       GlassCornerRadius="22"
                                                       GlassPadding="24,20">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE77B;" FontSize="28" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    <TextBlock Text="No artists found"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="15.5"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                               TextAlignment="Center" />
                                    <TextBlock Text="Switch sources or scan a local music folder to populate your artists directory."
                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </controls:LiquidGlassPanel>

                            <ItemsControl x:Name="LibraryArtistsGroupsControl"
                                          ItemsSource="{x:Bind ViewModel.LibraryArtistGroups, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="22" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LibraryArtistGroup">
                                        <StackPanel Spacing="14">
                                            <!-- Android Letter Section Header: Tinted Rounded Badge + Hairline Divider + Right Count -->
                                            <Grid Margin="2,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        MinWidth="32"
                                                        Height="30"
                                                        CornerRadius="10"
                                                        Padding="10,3"
                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                        BorderThickness="0.9">
                                                    <TextBlock Text="{x:Bind Letter, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="14.5"
                                                               FontWeight="ExtraBold"
                                                               Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <Border Grid.Column="1"
                                                        Height="1"
                                                        Margin="10,0,10,0"
                                                        VerticalAlignment="Center"
                                                        Opacity="0.55"
                                                        Background="{ThemeResource TokenGlassBorderBrush}" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind CountText, Mode=OneWay}"
                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Responsive Artists Circle Grid (Matches Home Artist Dimensions) -->
                                            <ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <UniformGridLayout MinItemWidth="168" MinColumnSpacing="16" MinRowSpacing="20" ItemsStretch="Fill" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:ArtistItem">
                                                        <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                                Padding="6,8"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Center"
                                                                Click="OnArtistCircleClicked"
                                                                Tag="{x:Bind}"
                                                                helpers:MicroInteractions.HoverScale="1.05"
                                                                helpers:MicroInteractions.PressScale="0.94"
                                                                helpers:MicroInteractions.HoverElevationY="-3">
                                                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                                <Border Width="148"
                                                                        Height="148"
                                                                        CornerRadius="74"
                                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                        BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                                        BorderThickness="1.5"
                                                                        HorizontalAlignment="Center">
                                                                    <Grid>
                                                                        <TextBlock Text="{x:Bind InitialLetter, Mode=OneWay}"
                                                                                   Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                   FontSize="36"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                        <Border CornerRadius="73"
                                                                                Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                            <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeAvatarUri, Mode=OneWay}"
                                                                                   Stretch="UniformToFill"
                                                                                   HorizontalAlignment="Stretch"
                                                                                   VerticalAlignment="Stretch" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Spacing="2" MaxWidth="156">
                                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                               FontSize="13.5"
                                                                               FontWeight="Bold"
                                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextAlignment="Center" />
                                                                    <TextBlock Text="{x:Bind DisplaySubtitle, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                               FontSize="11.5"
                                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ===================================================================== -->
                        <!-- TAB 3: ALBUMS A–Z + '#' ALPHABETICAL DIRECTORY                        -->
                        <!-- ===================================================================== -->
                        <StackPanel x:Name="LibraryAlbumsDirectoryRoot"
                                    Visibility="{x:Bind ViewModel.LibraryAlbumsDirectoryVisibility, Mode=OneWay}"
                                    Spacing="18"
                                    Margin="0,0,42,0">

                            <controls:LiquidGlassPanel Visibility="{x:Bind ViewModel.LibraryAlbumsEmptyVisibility, Mode=OneWay}"
                                                       MaxWidth="480"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,24,0,0"
                                                       GlassCornerRadius="22"
                                                       GlassPadding="24,20">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE93C;" FontSize="28" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    <TextBlock Text="No albums found"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="15.5"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                               TextAlignment="Center" />
                                    <TextBlock Text="Switch sources or scan a local music folder to populate your albums directory."
                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </controls:LiquidGlassPanel>

                            <ItemsControl x:Name="LibraryAlbumsGroupsControl"
                                          ItemsSource="{x:Bind ViewModel.LibraryAlbumGroups, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="22" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LibraryAlbumGroup">
                                        <StackPanel Spacing="14">
                                            <!-- Android Letter Section Header -->
                                            <Grid Margin="2,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        MinWidth="32"
                                                        Height="30"
                                                        CornerRadius="10"
                                                        Padding="10,3"
                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                        BorderThickness="0.9">
                                                    <TextBlock Text="{x:Bind Letter, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="14.5"
                                                               FontWeight="ExtraBold"
                                                               Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <Border Grid.Column="1"
                                                        Height="1"
                                                        Margin="10,0,10,0"
                                                        VerticalAlignment="Center"
                                                        Opacity="0.55"
                                                        Background="{ThemeResource TokenGlassBorderBrush}" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind CountText, Mode=OneWay}"
                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Responsive Full-Bleed Album Cards Grid (Matches Home New Releases Fluid Grid) -->
                                            <ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneWay}">
                                                <ItemsRepeater.Layout>
                                                    <UniformGridLayout MinItemWidth="192" MinItemHeight="228" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="entities:AlbumItem">
                                                        <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                                Padding="0"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                VerticalContentAlignment="Stretch"
                                                                Click="OnAlbumCardClicked"
                                                                Tag="{x:Bind}"
                                                                helpers:MicroInteractions.HoverScale="1.035"
                                                                helpers:MicroInteractions.PressScale="0.95"
                                                                helpers:MicroInteractions.HoverElevationY="-4">
                                                            <Border CornerRadius="24"
                                                                    Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                                                    BorderBrush="#33FFFFFF"
                                                                    BorderThickness="1">
                                                                <Grid>
                                                                    <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}"
                                                                          Background="{ThemeResource TokenAccentBadgeBackgroundBrush}">
                                                                        <FontIcon Glyph="&#xE93C;"
                                                                                  FontSize="42"
                                                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                                    </Grid>

                                                                    <Border CornerRadius="23" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                               Stretch="UniformToFill"
                                                                               HorizontalAlignment="Stretch"
                                                                               VerticalAlignment="Stretch" />
                                                                    </Border>

                                                                    <Border IsHitTestVisible="False" CornerRadius="23">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0.40" EndPoint="0,1">
                                                                                <GradientStop Color="#00000000" Offset="0.0" />
                                                                                <GradientStop Color="#4C080A10" Offset="0.48" />
                                                                                <GradientStop Color="#DF080A10" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>

                                                                    <!-- Top-Right Frosted "{N} tracks" Pill -->
                                                                    <Border HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,10,10,0"
                                                                            CornerRadius="10"
                                                                            Padding="8,3"
                                                                            Background="#78080A10"
                                                                            BorderBrush="#42FFFFFF"
                                                                            BorderThickness="0.8"
                                                                            Opacity="{x:Bind TrackCountBadgeOpacity, Mode=OneWay}"
                                                                            IsHitTestVisible="False">
                                                                        <TextBlock Text="{x:Bind TrackCountBadgeText, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                   FontSize="10.5"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="White" />
                                                                    </Border>

                                                                    <!-- Bottom-Left Title & Artist • Year -->
                                                                    <StackPanel VerticalAlignment="Bottom"
                                                                                Margin="12,0,12,12"
                                                                                Spacing="2"
                                                                                IsHitTestVisible="False">
                                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                   FontSize="14"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="White"
                                                                                   MaxLines="1"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{x:Bind ArtistYearSubtitle, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                                   FontSize="11.5"
                                                                                   FontWeight="Medium"
                                                                                   Foreground="#CCFFFFFF"
                                                                                   MaxLines="1"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ===================================================================== -->
                        <!-- TAB 4: SONGS A–Z + '#' ALPHABETICAL DIRECTORY                         -->
                        <!-- ===================================================================== -->
                        <StackPanel x:Name="LibrarySongsDirectoryRoot"
                                    Visibility="{x:Bind ViewModel.LibrarySongsDirectoryVisibility, Mode=OneWay}"
                                    Spacing="18"
                                    Margin="0,0,42,0">

                            <controls:LiquidGlassPanel Visibility="{x:Bind ViewModel.LibrarySongsEmptyVisibility, Mode=OneWay}"
                                                       MaxWidth="480"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,24,0,0"
                                                       GlassCornerRadius="22"
                                                       GlassPadding="24,20">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xEC4F;" FontSize="28" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    <TextBlock Text="No songs found"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="15.5"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                               TextAlignment="Center" />
                                    <TextBlock Text="Switch sources or scan a local music folder to populate your songs directory."
                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </controls:LiquidGlassPanel>

                            <ItemsControl x:Name="LibrarySongsGroupsControl"
                                          ItemsSource="{x:Bind ViewModel.LibrarySongGroups, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="20" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LibraryTrackGroup">
                                        <StackPanel Spacing="10">
                                            <!-- Android Letter Section Header -->
                                            <Grid Margin="2,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        MinWidth="32"
                                                        Height="30"
                                                        CornerRadius="10"
                                                        Padding="10,3"
                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                        BorderThickness="0.9">
                                                    <TextBlock Text="{x:Bind Letter, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="14.5"
                                                               FontWeight="ExtraBold"
                                                               Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <Border Grid.Column="1"
                                                        Height="1"
                                                        Margin="10,0,10,0"
                                                        VerticalAlignment="Center"
                                                        Opacity="0.55"
                                                        Background="{ThemeResource TokenGlassBorderBrush}" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind CountText, Mode=OneWay}"
                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Responsive Multi-Column Song Rows -->
                                            <ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource LibraryQueueSongRowTemplate}">
                                                <ItemsRepeater.Layout>
                                                    <UniformGridLayout MinItemWidth="340" MinItemHeight="68" MaximumRowsOrColumns="3" MinColumnSpacing="12" MinRowSpacing="8" ItemsStretch="Fill" />
                                                </ItemsRepeater.Layout>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ===================================================================== -->
                        <!-- EXPANDED RECENTLY ADDED CHRONOLOGICAL TIMELINE VIEW                   -->
                        <!-- ===================================================================== -->
                        <StackPanel x:Name="LibraryRecentlyAddedViewRoot"
                                    Visibility="{x:Bind ViewModel.LibraryRecentlyAddedViewVisibility, Mode=OneWay}"
                                    Spacing="18">

                            <controls:LiquidGlassPanel Visibility="{x:Bind ViewModel.LibraryRecentlyAddedEmptyVisibility, Mode=OneWay}"
                                                       MaxWidth="480"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,24,0,0"
                                                       GlassCornerRadius="22"
                                                       GlassPadding="24,20">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE81C;" FontSize="28" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    <TextBlock Text="No recently added tracks yet"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="15.5"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </controls:LiquidGlassPanel>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.LibraryRecentlyAddedGroups, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="20" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LibraryTrackGroup">
                                        <StackPanel Spacing="10">
                                            <!-- Chronological Period Section Header (Last week / Last month / 2025...) -->
                                            <Grid Margin="2,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Height="30"
                                                        CornerRadius="10"
                                                        Padding="12,3"
                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                        BorderThickness="0.9">
                                                    <TextBlock Text="{x:Bind Letter, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <Border Grid.Column="1"
                                                        Height="1"
                                                        Margin="10,0,10,0"
                                                        VerticalAlignment="Center"
                                                        Opacity="0.55"
                                                        Background="{ThemeResource TokenGlassBorderBrush}" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind CountText, Mode=OneWay}"
                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <ItemsRepeater ItemsSource="{x:Bind Items, Mode=OneWay}"
                                                          ItemTemplate="{StaticResource LibraryQueueSongRowTemplate}">
                                                <ItemsRepeater.Layout>
                                                    <UniformGridLayout MinItemWidth="340" MinItemHeight="68" MaximumRowsOrColumns="3" MinColumnSpacing="12" MinRowSpacing="8" ItemsStretch="Fill" />
                                                </ItemsRepeater.Layout>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- VIEW 5B: DEDICATED SEARCH PAGE (Recent Searches, 2-Col Moods & Genres,   -->
                    <!-- Categorized Results & Shimmer Skeleton Loading — Android Parity)          -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="SearchSectionRoot"
                                x:Load="{x:Bind ViewModel.IsSearchViewOpen, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.SearchViewVisibility, Mode=OneWay}"
                                Spacing="20"
                                Margin="2,2,2,0">

                        <!-- Search Page Hero Header + Top-Right Circular Close ('X') Button -->
                        <Grid Margin="2,0,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="Search"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SearchPageSubtitle, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                            </StackPanel>

                            <controls:LiquidGlassPanel Grid.Column="1"
                                                       Width="42"
                                                       Height="42"
                                                       VerticalAlignment="Center"
                                                       GlassCornerRadius="21"
                                                       GlassPadding="0"
                                                       SampleLiveBackdrop="True"
                                                       EnableHoverScale="True">
                                <Button Command="{x:Bind ViewModel.CloseSearchPageCommand, Mode=OneWay}"
                                        Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                        Width="42"
                                        Height="42"
                                        CornerRadius="21"
                                        Padding="0"
                                        ToolTipService.ToolTip="Close Search">
                                    <FontIcon Glyph="&#xE711;"
                                              FontSize="13.5"
                                              Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                </Button>
                            </controls:LiquidGlassPanel>
                        </Grid>

                        <!-- ===================================================================== -->
                        <!-- STATE A: EXPLORE MODE (Recent Searches + 2-Column Moods & Genres)     -->
                        <!-- ===================================================================== -->
                        <Grid x:Name="SearchExploreRoot"
                              Visibility="{x:Bind ViewModel.SearchExploreVisibility, Mode=OneWay}"
                              ColumnSpacing="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42*" />
                                <ColumnDefinition Width="58*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: Recent Searches + For you / Moods & moments / Genres -->
                            <StackPanel Grid.Column="0" Spacing="20">

                                <!-- Persisted Recent Searches Strip -->
                                <StackPanel Visibility="{x:Bind ViewModel.HasRecentSearchesVisibility, Mode=OneWay}"
                                            Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Recent Searches"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="Clear"
                                                Command="{x:Bind ViewModel.ClearRecentSearchesCommand, Mode=OneWay}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,3"
                                                FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                helpers:MicroInteractions.HoverScale="1.06"
                                                helpers:MicroInteractions.PressScale="0.93" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentSearches, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:FlowWrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border CornerRadius="16"
                                                        Height="32"
                                                        Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                                        BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                                        BorderThickness="1"
                                                        Padding="10,0,4,0"
                                                        helpers:MicroInteractions.HoverScale="1.03"
                                                        helpers:MicroInteractions.PressScale="0.96">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Click="OnRecentSearchChipClicked"
                                                                Tag="{x:Bind}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE81C;"
                                                                          FontSize="12"
                                                                          Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                                <TextBlock Text="{x:Bind}"
                                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                           FontSize="12.5"
                                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                           MaxWidth="190"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Click="OnRecentSearchRemoveClicked"
                                                                Tag="{x:Bind}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Width="22"
                                                                Height="22"
                                                                CornerRadius="11"
                                                                Padding="0"
                                                                ToolTipService.ToolTip="Remove"
                                                                VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE711;"
                                                                      FontSize="9"
                                                                      Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Shimmer Skeleton while Moods & Genres load -->
                                <controls:SearchSkeletonControl Mode="MoodsAndGenres"
                                                                Visibility="{x:Bind ViewModel.MoodsLoadingVisibility, Mode=OneWay}" />

                                <!-- Moods & Genres Sections (For you, Moods & moments, Genres) -->
                                <ItemsControl Visibility="{x:Bind ViewModel.MoodsContentVisibility, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.MoodGenreSections, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="22" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MoodGenreSectionViewModel">
                                            <StackPanel Spacing="12">
                                                <!-- Section Header + Circular Count Badge -->
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="17.5"
                                                               FontWeight="Bold"
                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Border MinWidth="24"
                                                            Height="22"
                                                            CornerRadius="11"
                                                            Padding="7,0"
                                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                            BorderThickness="0.8"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind CountText, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="11.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- 2-Column Colored Accent-Bar Gradient Tiles -->
                                                <ItemsControl ItemsSource="{x:Bind Items, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <controls:ResponsiveAutoFillGridPanel MinItemWidth="150"
                                                                                                  MaxColumns="2"
                                                                                                  ColumnSpacing="10"
                                                                                                  RowSpacing="10" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:MoodGenreTileViewModel">
                                                            <Button Click="OnMoodGenreTileClicked"
                                                                    Tag="{x:Bind}"
                                                                    Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                                    Padding="0"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    helpers:MicroInteractions.HoverScale="1.025"
                                                                    helpers:MicroInteractions.PressScale="0.96">
                                                                <Grid Height="64" CornerRadius="16">
                                                                    <!-- Base Gradient Surface -->
                                                                    <Border CornerRadius="16"
                                                                            Background="{x:Bind CardGradientBrush, Mode=OneWay}"
                                                                            BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                                                            BorderThickness="1" />

                                                                    <!-- Selected Accent Highlight Ring -->
                                                                    <Border CornerRadius="16"
                                                                            BorderBrush="{x:Bind StripeBrush, Mode=OneWay}"
                                                                            BorderThickness="1.8"
                                                                            Opacity="{x:Bind SelectedRingOpacity, Mode=OneWay}"
                                                                            IsHitTestVisible="False">
                                                                        <Border.OpacityTransition>
                                                                            <ScalarTransition Duration="0:0:0.18" />
                                                                        </Border.OpacityTransition>
                                                                    </Border>

                                                                    <Grid Padding="10,8,12,8" ColumnSpacing="10">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Vertical Colored Accent Stripe -->
                                                                        <Border Grid.Column="0"
                                                                                Width="4.5"
                                                                                Height="38"
                                                                                CornerRadius="2.25"
                                                                                VerticalAlignment="Center"
                                                                                Background="{x:Bind StripeBrush, Mode=OneWay}" />

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{x:Bind Title, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                   FontSize="13.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                                   TextWrapping="Wrap"
                                                                                   MaxLines="2"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center" />

                                                                        <FontIcon Grid.Column="2"
                                                                                  Glyph="&#xE72A;"
                                                                                  FontSize="11.5"
                                                                                  Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                                  Opacity="0.72"
                                                                                  VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- RIGHT COLUMN: Empty Prompt Card OR Selected Mood/Genre Detail Pane -->
                            <Grid Grid.Column="1" VerticalAlignment="Top">

                                <!-- Empty Selection Prompt Card (Matches Android screenshot media_1795115895717_60537cbe.jpg) -->
                                <Border Visibility="{x:Bind ViewModel.MoodDetailEmptyPromptVisibility, Mode=OneWay}"
                                        MaxWidth="440"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,78,0,0"
                                        CornerRadius="24"
                                        Padding="32,34"
                                        Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                        BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                                        <Border Width="56"
                                                Height="56"
                                                CornerRadius="28"
                                                HorizontalAlignment="Center"
                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                BorderThickness="1">
                                            <FontIcon Glyph="&#xEC4F;"
                                                      FontSize="22"
                                                      Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Select a Mood or Genre"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                   TextAlignment="Center" />
                                        <TextBlock Text="Pick any category on the left to browse curated playlists, featured albums, and songs right here."
                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Shimmer Skeleton while Selected Mood/Genre Category loads -->
                                <controls:SearchSkeletonControl Mode="MoodDetail"
                                                                Padding="4,0"
                                                                Visibility="{x:Bind ViewModel.MoodDetailLoadingVisibility, Mode=OneWay}" />

                                <!-- Populated Mood/Genre Detail Pane -->
                                <StackPanel x:Name="SearchMoodDetailRoot"
                                            Visibility="{x:Bind ViewModel.MoodDetailContentVisibility, Mode=OneWay}"
                                            Spacing="22">

                                    <!-- Mood Hero Banner -->
                                    <Border CornerRadius="20"
                                            Padding="16,14"
                                            Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="6"
                                                    Height="44"
                                                    CornerRadius="3"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind ViewModel.SelectedMoodStripeBrush, Mode=OneWay}" />

                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedMoodTitle, Mode=OneWay}"
                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Playlists, albums &amp; tracks curated on YouTube Music"
                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Command="{x:Bind ViewModel.ClearSelectedMoodCommand, Mode=OneWay}"
                                                    Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                                    BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="16"
                                                    Padding="12,6"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    helpers:MicroInteractions.HoverScale="1.05"
                                                    helpers:MicroInteractions.PressScale="0.94">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE72B;" FontSize="10.5" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                    <TextBlock Text="All Genres" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Curated Playlists -->
                                    <StackPanel Visibility="{x:Bind ViewModel.HasMoodDetailPlaylistsVisibility, Mode=OneWay}"
                                                Spacing="12">
                                        <TextBlock Text="Curated Playlists"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.MoodDetailPlaylists, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="148" MinColumnSpacing="14" MinRowSpacing="16" ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:RecommendedPlaylistItem">
                                                    <Button Click="OnRecommendedPlaylistCardClicked"
                                                            Tag="{x:Bind}"
                                                            Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                            Padding="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            helpers:MicroInteractions.HoverScale="1.035"
                                                            helpers:MicroInteractions.PressScale="0.95"
                                                            helpers:MicroInteractions.HoverElevationY="-3">
                                                        <StackPanel Spacing="7">
                                                            <Border CornerRadius="18"
                                                                    Height="148"
                                                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                    BorderBrush="#33FFFFFF"
                                                                    BorderThickness="1">
                                                                <Grid>
                                                                    <Grid Opacity="{x:Bind DefaultIconOpacity, Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xE90B;" FontSize="34" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <Border CornerRadius="17" Opacity="{x:Bind ArtworkOpacity, Mode=OneWay}">
                                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeArtworkUri, Mode=OneWay}"
                                                                               Stretch="UniformToFill"
                                                                               HorizontalAlignment="Stretch"
                                                                               VerticalAlignment="Stretch" />
                                                                    </Border>
                                                                    <Border HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,8,8,0"
                                                                            CornerRadius="9"
                                                                            Padding="7,2.5"
                                                                            Background="#80080A10"
                                                                            BorderBrush="#42FFFFFF"
                                                                            BorderThickness="0.8"
                                                                            Visibility="{x:Bind vm:ShellViewModel.NonEmptyVisibility(TrackCountText), Mode=OneWay}"
                                                                            IsHitTestVisible="False">
                                                                        <TextBlock Text="{x:Bind TrackCountText, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="White" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="13.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                           FontSize="11.5"
                                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>

                                    <!-- Featured Albums -->
                                    <StackPanel Visibility="{x:Bind ViewModel.HasMoodDetailAlbumsVisibility, Mode=OneWay}"
                                                Spacing="12">
                                        <TextBlock Text="Featured Albums"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.MoodDetailAlbums, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="148" MinItemHeight="176" MinColumnSpacing="14" MinRowSpacing="14" ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="entities:AlbumItem">
                                                    <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                            Padding="0"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch"
                                                            Click="OnAlbumCardClicked"
                                                            Tag="{x:Bind}"
                                                            helpers:MicroInteractions.HoverScale="1.035"
                                                            helpers:MicroInteractions.PressScale="0.95"
                                                            helpers:MicroInteractions.HoverElevationY="-3">
                                                        <Border CornerRadius="20"
                                                                Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                                                BorderBrush="#33FFFFFF"
                                                                BorderThickness="1">
                                                            <Grid>
                                                                <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}"
                                                                      Background="{ThemeResource TokenAccentBadgeBackgroundBrush}">
                                                                    <FontIcon Glyph="&#xE93C;" FontSize="36" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Border CornerRadius="19" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                    <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                           Stretch="UniformToFill"
                                                                           HorizontalAlignment="Stretch"
                                                                           VerticalAlignment="Stretch" />
                                                                </Border>
                                                                <Border IsHitTestVisible="False" CornerRadius="19">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0.42" EndPoint="0,1">
                                                                            <GradientStop Color="#00000000" Offset="0.0" />
                                                                            <GradientStop Color="#4C080A10" Offset="0.50" />
                                                                            <GradientStop Color="#E0080A10" Offset="1.0" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10" Spacing="1" IsHitTestVisible="False">
                                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                               FontSize="13.5"
                                                                               FontWeight="Bold"
                                                                               Foreground="White"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind ArtistYearSubtitle, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                               FontSize="11"
                                                                               Foreground="#CCFFFFFF"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>

                                    <!-- Curated Songs -->
                                    <StackPanel Visibility="{x:Bind ViewModel.HasMoodDetailSongsVisibility, Mode=OneWay}"
                                                Spacing="10">
                                        <TextBlock Text="Songs"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.MoodDetailSongs, Mode=OneWay}"
                                                      ItemTemplate="{StaticResource LibraryQueueSongRowTemplate}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="8" />
                                            </ItemsRepeater.Layout>
                                        </ItemsRepeater>
                                    </StackPanel>

                                    <!-- Fallback if Category returned empty -->
                                    <Border Visibility="{x:Bind ViewModel.MoodDetailEmptyResultVisibility, Mode=OneWay}"
                                            CornerRadius="22"
                                            Padding="28,26"
                                            Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xEC4F;" FontSize="28" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                            <TextBlock Text="No curated items available right now"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                       TextAlignment="Center" />
                                            <TextBlock Text="Try another mood or genre on the left, or search directly in the top bar."
                                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                                       FontSize="12.5"
                                                       Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ===================================================================== -->
                        <!-- STATE B: SEARCH RESULTS MODE (Filter Pills + Skeleton + Categorized)  -->
                        <!-- ===================================================================== -->
                        <StackPanel x:Name="SearchResultsRoot"
                                    Visibility="{x:Bind ViewModel.SearchResultsVisibility, Mode=OneWay}"
                                    Spacing="20">

                            <!-- Category Filter Pills + Active Search Scope Indicator -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Button Content="All"
                                            Command="{x:Bind ViewModel.SelectSearchResultFilterCommand, Mode=OneWay}"
                                            CommandParameter="All"
                                            Style="{x:Bind GetSegmentButtonStyle(ViewModel.IsSearchFilterAll), Mode=OneWay}"
                                            CornerRadius="17"
                                            Padding="16,6"
                                            FontSize="12.5" />
                                    <Button Content="Songs"
                                            Command="{x:Bind ViewModel.SelectSearchResultFilterCommand, Mode=OneWay}"
                                            CommandParameter="Songs"
                                            Style="{x:Bind GetSegmentButtonStyle(ViewModel.IsSearchFilterSongs), Mode=OneWay}"
                                            CornerRadius="17"
                                            Padding="16,6"
                                            FontSize="12.5" />
                                    <Button Content="Artists"
                                            Command="{x:Bind ViewModel.SelectSearchResultFilterCommand, Mode=OneWay}"
                                            CommandParameter="Artists"
                                            Style="{x:Bind GetSegmentButtonStyle(ViewModel.IsSearchFilterArtists), Mode=OneWay}"
                                            CornerRadius="17"
                                            Padding="16,6"
                                            FontSize="12.5" />
                                    <Button Content="Albums"
                                            Command="{x:Bind ViewModel.SelectSearchResultFilterCommand, Mode=OneWay}"
                                            CommandParameter="Albums"
                                            Style="{x:Bind GetSegmentButtonStyle(ViewModel.IsSearchFilterAlbums), Mode=OneWay}"
                                            CornerRadius="17"
                                            Padding="16,6"
                                            FontSize="12.5" />
                                    <Button Content="Playlists"
                                            Command="{x:Bind ViewModel.SelectSearchResultFilterCommand, Mode=OneWay}"
                                            CommandParameter="Playlists"
                                            Style="{x:Bind GetSegmentButtonStyle(ViewModel.IsSearchFilterPlaylists), Mode=OneWay}"
                                            CornerRadius="17"
                                            Padding="16,6"
                                            FontSize="12.5" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{x:Bind ViewModel.ToggleSearchSourceCommand, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.SearchSourceTooltip, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="12,5"
                                        FontSize="12"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind ViewModel.SearchSourceGlyph, Mode=OneWay}"
                                                  FontSize="12.5"
                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SearchSourceBadgeText, Mode=OneWay}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Shimmer Skeleton Loader during active search -->
                            <controls:SearchSkeletonControl Mode="SearchResults"
                                                            Padding="4,0"
                                                            Visibility="{x:Bind ViewModel.SearchLoadingVisibility, Mode=OneWay}" />

                            <!-- No Results Empty State -->
                            <controls:LiquidGlassPanel Visibility="{x:Bind ViewModel.SearchNoResultsVisibility, Mode=OneWay}"
                                                       MaxWidth="520"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,24,0,0"
                                                       GlassCornerRadius="24"
                                                       GlassPadding="28,24">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="26"
                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                            BorderThickness="1">
                                        <FontIcon Glyph="&#xE721;" FontSize="22" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    </Border>
                                    <TextBlock Text="No matching results found"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                               TextAlignment="Center" />
                                    <TextBlock Text="Try a different spelling or switch between YouTube Music and your Local Library using the globe icon in the search bar."
                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </controls:LiquidGlassPanel>

                            <!-- Categorized Results Content -->
                            <StackPanel Visibility="{x:Bind ViewModel.SearchResultsContentVisibility, Mode=OneWay}"
                                        Spacing="24">

                                <!-- 1. Top Result Hero Card -->
                                <StackPanel Visibility="{x:Bind ViewModel.HasSearchTopResultVisibility, Mode=OneWay}"
                                            Spacing="10">
                                    <TextBlock Text="Top Result"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />

                                    <Button Command="{x:Bind ViewModel.OpenSearchTopResultCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentMediaCardButtonStyle}"
                                            Padding="0"
                                            HorizontalAlignment="Left"
                                            MaxWidth="520"
                                            MinWidth="340"
                                            HorizontalContentAlignment="Stretch"
                                            helpers:MicroInteractions.HoverScale="1.02"
                                            helpers:MicroInteractions.PressScale="0.97">
                                        <Border CornerRadius="22"
                                                Padding="16,14"
                                                Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                BorderThickness="1.2">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="76"
                                                        Height="76"
                                                        CornerRadius="{x:Bind ViewModel.SearchTopResultCornerRadius, Mode=OneWay}"
                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                        BorderBrush="#33FFFFFF"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid Opacity="{x:Bind ViewModel.SearchTopResultDefaultIconOpacity, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xEC4F;" FontSize="28" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Border CornerRadius="{x:Bind ViewModel.SearchTopResultCornerRadius, Mode=OneWay}"
                                                                Opacity="{x:Bind ViewModel.SearchTopResultArtworkOpacity, Mode=OneWay}">
                                                            <Image helpers:BitmapDecodeHelper.DecodeWidth="128" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.SearchTopResultSafeArtworkUri, Mode=OneWay}"
                                                                   Stretch="UniformToFill"
                                                                   HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Stretch" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                    <Border HorizontalAlignment="Left"
                                                            CornerRadius="8"
                                                            Padding="8,2"
                                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                            BorderThickness="0.8">
                                                        <TextBlock Text="{x:Bind ViewModel.SearchTopResultKindBadgeText, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="10.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind ViewModel.SearchTopResultTitle, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind ViewModel.SearchTopResultSubtitle, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                               FontSize="12.5"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        Width="40"
                                                        Height="40"
                                                        CornerRadius="20"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource TokenPrimaryAccentBrush}">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </StackPanel>

                                <!-- 2. Songs Results (Flat Library-Style Responsive Rows with Equalizer, Heart, Vertical ⋮) -->
                                <StackPanel Visibility="{x:Bind ViewModel.HasSearchSongsSectionVisibility, Mode=OneWay}"
                                            Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Songs"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <Border MinWidth="24" Height="22" CornerRadius="11" Padding="7,0"
                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.SearchSongsCountLabel, Mode=OneWay}"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SearchResultSongs, Mode=OneWay}"
                                                  ItemTemplate="{StaticResource LibraryQueueSongRowTemplate}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="360" MinItemHeight="68" MaximumRowsOrColumns="2" MinColumnSpacing="12" MinRowSpacing="8" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                </StackPanel>

                                <!-- 3. Artists Results -->
                                <StackPanel Visibility="{x:Bind ViewModel.HasSearchArtistsSectionVisibility, Mode=OneWay}"
                                            Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Artists"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <Border MinWidth="24" Height="22" CornerRadius="11" Padding="7,0"
                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.SearchArtistsCountLabel, Mode=OneWay}"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SearchResultArtists, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="156" MinColumnSpacing="16" MinRowSpacing="18" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="entities:ArtistItem">
                                                <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                        Padding="6,8"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Click="OnSearchArtistCardClicked"
                                                        Tag="{x:Bind}"
                                                        helpers:MicroInteractions.HoverScale="1.05"
                                                        helpers:MicroInteractions.PressScale="0.94"
                                                        helpers:MicroInteractions.HoverElevationY="-3">
                                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                        <Border Width="136" Height="136" CornerRadius="68"
                                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                                BorderThickness="1.5"
                                                                HorizontalAlignment="Center">
                                                            <Grid>
                                                                <TextBlock Text="{x:Bind InitialLetter, Mode=OneWay}"
                                                                           Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="34"
                                                                           FontWeight="Bold"
                                                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                <Border CornerRadius="67" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                    <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeAvatarUri, Mode=OneWay}"
                                                                           Stretch="UniformToFill"
                                                                           HorizontalAlignment="Stretch"
                                                                           VerticalAlignment="Stretch" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Spacing="2" MaxWidth="148">
                                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                       FontSize="13.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextAlignment="Center" />
                                                            <TextBlock Text="{x:Bind DisplaySubtitle, Mode=OneWay}"
                                                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                       FontSize="11.5"
                                                                       Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <!-- 4. Albums Results -->
                                <StackPanel Visibility="{x:Bind ViewModel.HasSearchAlbumsSectionVisibility, Mode=OneWay}"
                                            Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Albums"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <Border MinWidth="24" Height="22" CornerRadius="11" Padding="7,0"
                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.SearchAlbumsCountLabel, Mode=OneWay}"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SearchResultAlbums, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="176" MinItemHeight="210" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="entities:AlbumItem">
                                                <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        Click="OnSearchAlbumCardClicked"
                                                        Tag="{x:Bind}"
                                                        helpers:MicroInteractions.HoverScale="1.035"
                                                        helpers:MicroInteractions.PressScale="0.95"
                                                        helpers:MicroInteractions.HoverElevationY="-4">
                                                    <Border CornerRadius="22"
                                                            Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                                                            BorderBrush="#33FFFFFF"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}"
                                                                  Background="{ThemeResource TokenAccentBadgeBackgroundBrush}">
                                                                <FontIcon Glyph="&#xE93C;" FontSize="40" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Border CornerRadius="21" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                       Stretch="UniformToFill"
                                                                       HorizontalAlignment="Stretch"
                                                                       VerticalAlignment="Stretch" />
                                                            </Border>
                                                            <Border IsHitTestVisible="False" CornerRadius="21">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0.40" EndPoint="0,1">
                                                                        <GradientStop Color="#00000000" Offset="0.0" />
                                                                        <GradientStop Color="#4C080A10" Offset="0.48" />
                                                                        <GradientStop Color="#DF080A10" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,12" Spacing="2" IsHitTestVisible="False">
                                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           Foreground="White"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind ArtistYearSubtitle, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                           FontSize="11.5"
                                                                           Foreground="#CCFFFFFF"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>

                                <!-- 5. Playlists Results -->
                                <StackPanel Visibility="{x:Bind ViewModel.HasSearchPlaylistsSectionVisibility, Mode=OneWay}"
                                            Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Playlists"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <Border MinWidth="24" Height="22" CornerRadius="11" Padding="7,0"
                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.SearchPlaylistsCountLabel, Mode=OneWay}"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SearchResultPlaylists, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="176" MinColumnSpacing="16" MinRowSpacing="18" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:RecommendedPlaylistItem">
                                                <Button Click="OnSearchPlaylistCardClicked"
                                                        Tag="{x:Bind}"
                                                        Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        helpers:MicroInteractions.HoverScale="1.035"
                                                        helpers:MicroInteractions.PressScale="0.95"
                                                        helpers:MicroInteractions.HoverElevationY="-4">
                                                    <StackPanel Spacing="7">
                                                        <Border CornerRadius="20"
                                                                Height="172"
                                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                BorderBrush="#33FFFFFF"
                                                                BorderThickness="1">
                                                            <Grid>
                                                                <Grid Opacity="{x:Bind DefaultIconOpacity, Mode=OneWay}">
                                                                    <FontIcon Glyph="&#xE90B;" FontSize="38" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Grid>
                                                                <Border CornerRadius="19" Opacity="{x:Bind ArtworkOpacity, Mode=OneWay}">
                                                                    <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeArtworkUri, Mode=OneWay}"
                                                                           Stretch="UniformToFill"
                                                                           HorizontalAlignment="Stretch"
                                                                           VerticalAlignment="Stretch" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                       FontSize="11.5"
                                                                       Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ========================================================================= -->
                    <!-- ========================================================================= -->
                    <!-- VIEW 6: NATIVE WINDOWS 11 SETTINGS SCREEN (NavigationView + Win11 Cards)  -->
                    <!-- ========================================================================= -->
                    <Grid x:Name="SettingsSectionRoot"
                          x:Load="{x:Bind ViewModel.IsSettingsViewOpen, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.SettingsViewVisibility, Mode=OneWay}"
                          Margin="0,4,4,0">
                        <Grid.Resources>
                            <ResourceDictionary>
                                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Dark">
                                        <SolidColorBrush x:Key="Win11CardBackgroundBrush" Color="#0FFFFFFF" />
                                        <SolidColorBrush x:Key="Win11CardSubtleBackgroundBrush" Color="#08FFFFFF" />
                                        <SolidColorBrush x:Key="Win11CardBorderBrush" Color="#18FFFFFF" />
                                        <SolidColorBrush x:Key="Win11CardDividerBrush" Color="#14FFFFFF" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="Win11CardBackgroundBrush" Color="#C8FFFFFF" />
                                        <SolidColorBrush x:Key="Win11CardSubtleBackgroundBrush" Color="#88FFFFFF" />
                                        <SolidColorBrush x:Key="Win11CardBorderBrush" Color="#14000000" />
                                        <SolidColorBrush x:Key="Win11CardDividerBrush" Color="#12000000" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Grid.Resources>

                        <NavigationView x:Name="SettingsNavigationView"
                                        MinHeight="580"
                                        VerticalAlignment="Top"
                                        PaneDisplayMode="Left"
                                        IsBackButtonVisible="Visible"
                                        IsBackEnabled="True"
                                        IsPaneOpen="True"
                                        IsPaneToggleButtonVisible="False"
                                        IsSettingsVisible="False"
                                        OpenPaneLength="264"
                                        CompactModeThresholdWidth="0"
                                        ExpandedModeThresholdWidth="0"
                                        Background="Transparent"
                                        Loaded="OnSettingsNavigationViewLoaded"
                                        SelectionChanged="OnSettingsNavigationViewSelectionChanged"
                                        BackRequested="OnSettingsNavigationViewBackRequested">

                            <NavigationView.PaneHeader>
                                <StackPanel Spacing="2" Margin="14,6,12,10">
                                    <TextBlock Text="Settings"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="11.5"
                                               Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </NavigationView.PaneHeader>

                            <NavigationView.MenuItems>
                                <NavigationViewItem x:Name="SettingsNavAppearance"
                                                    Tag="AppearanceAndGlass"
                                                    Content="Appearance &amp; Personalization"
                                                    IsSelected="True">
                                    <NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE790;" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    </NavigationViewItem.Icon>
                                </NavigationViewItem>

                                <NavigationViewItem x:Name="SettingsNavLibrary"
                                                    Tag="LibraryAndFolders"
                                                    Content="Library &amp; Local Folders">
                                    <NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" Foreground="#FF38BDF8" />
                                    </NavigationViewItem.Icon>
                                </NavigationViewItem>

                                <NavigationViewItem x:Name="SettingsNavYouTube"
                                                    Tag="YouTubeMusicAccount"
                                                    Content="YouTube Music Account">
                                    <NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE77B;" Foreground="#FFF43F5E" />
                                    </NavigationViewItem.Icon>
                                </NavigationViewItem>

                                <NavigationViewItem x:Name="SettingsNavDownloads"
                                                    Tag="DownloadsAndOffline"
                                                    Content="Downloads &amp; Offline">
                                    <NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE896;" Foreground="#FF10B981" />
                                    </NavigationViewItem.Icon>
                                </NavigationViewItem>

                                <NavigationViewItem x:Name="SettingsNavLyrics"
                                                    Tag="LyricsAndVisualizers"
                                                    Content="Lyrics &amp; Apple Canvas">
                                    <NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE90A;" Foreground="#FFA855F7" />
                                    </NavigationViewItem.Icon>
                                </NavigationViewItem>

                                <NavigationViewItem x:Name="SettingsNavUpdates"
                                                    Tag="Updates"
                                                    helpers:Loc.Key="Settings_NavUpdates"
                                                    Content="Updates">
                                    <NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE777;" Foreground="#FF2DD4BF" />
                                    </NavigationViewItem.Icon>
                                </NavigationViewItem>
                            </NavigationView.MenuItems>

                            <!-- Right Native Windows 11 Settings Content Pane -->
                            <Grid x:Name="SettingsCategoryContentHost"
                                  MaxWidth="960"
                                  HorizontalAlignment="Stretch"
                                  Margin="24,4,16,24">
                                <Grid.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.18" />
                                </Grid.OpacityTransition>
                                <Grid.TranslationTransition>
                                    <Vector3Transition Duration="0:0:0.22" />
                                </Grid.TranslationTransition>

                                <!-- ================================================================= -->
                                <!-- CATEGORY 1: APPEARANCE & PERSONALIZATION                          -->
                                <!-- ================================================================= -->
                                <StackPanel Visibility="{x:Bind ViewModel.SettingsAppearanceVisibility, Mode=OneWay}"
                                            Spacing="16">
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="18" />
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>

                                    <StackPanel Spacing="4" Margin="0,0,0,4">
                                        <TextBlock Text="Appearance &amp; Personalization"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="Customize adaptive album cover accent colors, theme mode, playback controls, and optical surface rendering."
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </StackPanel>

                                    <!-- Group 1: Dynamic Album Cover Accent & Color Swatches (Win11 Multi-Row Card) -->
                                    <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <!-- Row 1: Dynamic Album Cover Accent Toggle -->
                                            <Grid Padding="20,16" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0"
                                                          Glyph="&#xE790;"
                                                          FontSize="20"
                                                          Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                          VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="Dynamic Album Cover Accent"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                        <Border Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind ViewModel.ActiveAccentColorHex, Mode=OneWay}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Automatically adapts native controls, toggles, and player highlights to the active song's cover art"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="2"
                                                              IsOn="{x:Bind ViewModel.IsDynamicCoverAccentEnabled, Mode=TwoWay}"
                                                              OnContent="Auto"
                                                              OffContent="Manual"
                                                              MinWidth="0"
                                                              VerticalAlignment="Center" />
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource Win11CardDividerBrush}" />

                                            <!-- Row 2: Manual Accent Swatches -->
                                            <Grid Padding="20,14" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="36,0,0,0">
                                                    <TextBlock Text="Preset Accent Colors"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                    <TextBlock Text="Pick a fixed accent color (switches Dynamic Album Cover Accent to Manual)"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                                            CommandParameter="#FF2DD4BF"
                                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                                            Background="#FF2DD4BF" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                                            CommandParameter="#FFA855F7"
                                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                                            Background="#FFA855F7" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                                            CommandParameter="#FFF43F5E"
                                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                                            Background="#FFF43F5E" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                                            CommandParameter="#FFF59E0B"
                                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                                            Background="#FFF59E0B" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                                            CommandParameter="#FF38BDF8"
                                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                                            Background="#FF38BDF8" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                                            CommandParameter="#FF10B981"
                                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                                            Background="#FF10B981" BorderBrush="#66FFFFFF" BorderThickness="1" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 2: Fullscreen Playback Controls Card -->
                                    <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="20,16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0"
                                                      Glyph="&#xE740;"
                                                      FontSize="20"
                                                      Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Fullscreen Seek Buttons (-5s / +10s)"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                <TextBlock Text="Show quick skip back and skip forward buttons alongside transport controls in Fullscreen Now Playing"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2"
                                                          IsOn="{x:Bind ViewModel.ShowFullscreenSeekButtons, Mode=TwoWay}"
                                                          OnContent="Show"
                                                          OffContent="Hide"
                                                          MinWidth="0"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Group 3: Theme Mode, Palette & Language (Win11 Grouped Card) -->
                                    <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <!-- Row 1: Light / Dark Mode -->
                                            <Grid Padding="20,16" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0"
                                                          Glyph="{x:Bind ViewModel.LightDarkModeGlyph, Mode=OneWay}"
                                                          FontSize="20"
                                                          Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                          VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="App Theme Mode"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                    <TextBlock Text="Switch between Obsidian Dark and Crystal Daylight Light Mode"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Command="{x:Bind ViewModel.ToggleLightDarkModeCommand, Mode=OneWay}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        CornerRadius="4"
                                                        Padding="14,7"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="{x:Bind ViewModel.LightDarkModeGlyph, Mode=OneWay}" FontSize="14" />
                                                        <TextBlock Text="Toggle Light / Dark" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource Win11CardDividerBrush}" />

                                            <!-- Row 2: Theme Presets -->
                                            <Grid Padding="20,14" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0"
                                                          Glyph="&#xE771;"
                                                          FontSize="20"
                                                          Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                          VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="Color Palette Preset"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                    <TextBlock Text="Select base background and contrast profile"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Content="Dark (Obsidian)"
                                                            Command="{x:Bind ViewModel.ApplyThemeCommand, Mode=OneWay}"
                                                            CommandParameter="ObsidianLiquidDark"
                                                            CornerRadius="4" Padding="12,6" FontSize="12" />
                                                    <Button Content="Light (Daylight)"
                                                            Command="{x:Bind ViewModel.ApplyThemeCommand, Mode=OneWay}"
                                                            CommandParameter="CrystalDaylight"
                                                            CornerRadius="4" Padding="12,6" FontSize="12" />
                                                    <Button Content="Aurora Cyber"
                                                            Command="{x:Bind ViewModel.ApplyThemeCommand, Mode=OneWay}"
                                                            CommandParameter="NeonAuroraDark"
                                                            CornerRadius="4" Padding="12,6" FontSize="12" />
                                                    <Button Content="High Contrast"
                                                            Command="{x:Bind ViewModel.ApplyThemeCommand, Mode=OneWay}"
                                                            CommandParameter="HighContrastAccessibility"
                                                            CornerRadius="4" Padding="12,6" FontSize="12" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource Win11CardDividerBrush}" />

                                            <!-- Row 3: Display Language -->
                                            <Grid Padding="20,14" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0"
                                                          Glyph="&#xF2B7;"
                                                          FontSize="20"
                                                          Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                          VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="Language"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                    <TextBlock Text="Application interface display language"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Content="English (US)"
                                                            Command="{x:Bind ViewModel.ChangeLanguageCommand, Mode=OneWay}"
                                                            CommandParameter="en-US"
                                                            CornerRadius="4" Padding="12,6" FontSize="12" />
                                                    <Button Content="Español (ES)"
                                                            Command="{x:Bind ViewModel.ChangeLanguageCommand, Mode=OneWay}"
                                                            CommandParameter="es-ES"
                                                            CornerRadius="4" Padding="12,6" FontSize="12" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Group 4: Win2D Optical Surface Shader Parameters (Win11 Grouped Card) -->
                                    <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <StackPanel Padding="20,16,20,12" Spacing="2">
                                                <TextBlock Text="Optical Surface Shader Parameters"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                <TextBlock Text="Fine-tune GPU refraction, frost blur, and specular intensity for player overlays"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                            </StackPanel>

                                            <Border Height="1" Background="{ThemeResource Win11CardDividerBrush}" />

                                            <Grid Padding="20,12" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="56" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Frost Blur Radius" FontSize="13.5" Foreground="{ThemeResource TokenPrimaryTextBrush}" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="30" Value="{x:Bind ViewModel.FrostBlurRadius, Mode=TwoWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind FormatPx(ViewModel.FrostBlurRadius), Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource Win11CardDividerBrush}" />

                                            <Grid Padding="20,12" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="56" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Refraction Strength" FontSize="13.5" Foreground="{ThemeResource TokenPrimaryTextBrush}" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{x:Bind ViewModel.DistortionStrength, Mode=TwoWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind FormatPx(ViewModel.DistortionStrength), Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource Win11CardDividerBrush}" />

                                            <Grid Padding="20,12" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="56" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Glass Tint Opacity" FontSize="13.5" Foreground="{ThemeResource TokenPrimaryTextBrush}" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.TintOpacityPercent, Mode=TwoWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind FormatPercent(ViewModel.TintOpacityPercent), Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource Win11CardDividerBrush}" />

                                            <Grid Padding="20,12" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="56" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Specular &amp; Meniscus" FontSize="13.5" Foreground="{ThemeResource TokenPrimaryTextBrush}" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.SpecularRimPercent, Mode=TwoWay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind FormatPercent(ViewModel.SpecularRimPercent), Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TokenPrimaryAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource Win11CardDividerBrush}" />

                                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="20,14" Background="{ThemeResource Win11CardSubtleBackgroundBrush}">
                                                <Button Content="Reset Defaults"
                                                        Command="{x:Bind ViewModel.ResetLiquidGlassPresetCommand, Mode=OneWay}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        CornerRadius="4" Padding="14,6" FontSize="12.5" />
                                                <Button Content="Toggle Draggable Lens"
                                                        Command="{x:Bind ViewModel.ToggleDraggableLensCommand, Mode=OneWay}"
                                                        CornerRadius="4" Padding="14,6" FontSize="12.5" />
                                                <Button Content="Export Theme JSON"
                                                        Command="{x:Bind ViewModel.ExportCustomThemeJsonCommand, Mode=OneWay}"
                                                        CornerRadius="4" Padding="14,6" FontSize="12.5" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ================================================================= -->
                                <!-- CATEGORY 2: LIBRARY & LOCAL FOLDERS                               -->
                                <!-- ================================================================= -->
                                <StackPanel Visibility="{x:Bind ViewModel.SettingsLibraryFoldersVisibility, Mode=OneWay}"
                                            Spacing="16">
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="18" />
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>

                                    <StackPanel Spacing="4" Margin="0,0,0,4">
                                        <TextBlock Text="Library &amp; Local Folders"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="Manage local music directories. All audio files, embedded covers, and .LRC lyrics are indexed automatically."
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </StackPanel>

                                    <!-- Top Action Card -->
                                    <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="20,16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0"
                                                      Glyph="&#xE8B7;"
                                                      FontSize="20"
                                                      Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Local Music Directories"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                <TextBlock Text="Add folders to watch or import individual audio tracks into your Local Library"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Command="{x:Bind ViewModel.AddLocalMusicDirectoryCommand, Mode=OneWay}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        CornerRadius="4"
                                                        Padding="14,7"
                                                        FontSize="12.5">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                        <TextBlock Text="Add Directory..." FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="Import Audio Files..."
                                                        Command="{x:Bind ViewModel.PickAndImportFilesCommand, Mode=OneWay}"
                                                        CornerRadius="4"
                                                        Padding="14,7"
                                                        FontSize="12.5" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Empty Folders State Card -->
                                    <Border Visibility="{x:Bind ViewModel.EmptyLocalDirectoriesVisibility, Mode=OneWay}"
                                            Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="20,18">
                                        <TextBlock Text="No custom directories configured yet. Click 'Add Directory...' above to add your music folders."
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </Border>

                                    <!-- Configured Folders List -->
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.LocalMusicDirectories, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.HasLocalDirectoriesVisibility, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                                        BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="18,12">
                                                    <Grid ColumnSpacing="14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource TokenPrimaryAccentBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{x:Bind}"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                   FontSize="13.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="2"
                                                                Click="OnRemoveLocalDirectoryClicked"
                                                                Tag="{x:Bind}"
                                                                CornerRadius="4"
                                                                Padding="12,5"
                                                                FontSize="12"
                                                                ToolTipService.ToolTip="Remove this directory from Local Library">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                                <TextBlock Text="Remove" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ================================================================= -->
                                <!-- CATEGORY 3: YOUTUBE MUSIC ACCOUNT                                 -->
                                <!-- ================================================================= -->
                                <StackPanel Visibility="{x:Bind ViewModel.SettingsYouTubeAccountVisibility, Mode=OneWay}"
                                            Spacing="16">
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="18" />
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>

                                    <StackPanel Spacing="4" Margin="0,0,0,4">
                                        <TextBlock Text="YouTube Music Account"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="Sign in to your YouTube Music account so Home recommendations combine your personal mixes with your listening history."
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </StackPanel>

                                    <!-- Account Connection Card -->
                                    <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="20,16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="40" Height="40"
                                                    CornerRadius="20"
                                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                    BorderThickness="1">
                                                <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.YouTubeAccountStatusText, Mode=OneWay}"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                <TextBlock Text="Personalized FEmusic_home shelves + Local History"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="Sign In with Browser..."
                                                        Command="{x:Bind ViewModel.LaunchInteractiveYouTubeLoginCommand, Mode=OneWay}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        CornerRadius="4"
                                                        Padding="14,7"
                                                        FontSize="12.5" />
                                                <Button Content="Disconnect"
                                                        Command="{x:Bind ViewModel.DisconnectYouTubeAccountCommand, Mode=OneWay}"
                                                        Visibility="{x:Bind ViewModel.YouTubeDisconnectButtonVisibility, Mode=OneWay}"
                                                        CornerRadius="4"
                                                        Padding="14,7"
                                                        FontSize="12.5" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- YouTube Music Playlists Import Card -->
                                    <Border Visibility="{x:Bind ViewModel.YouTubeMusicSignedInVisibility, Mode=OneWay}"
                                            Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="20,16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="40" Height="40"
                                                    CornerRadius="20"
                                                    Background="#24FF2E54"
                                                    BorderBrush="#66FF2E54"
                                                    BorderThickness="1">
                                                <FontIcon Glyph="&#xE8FD;" FontSize="17" Foreground="#FFFF4D6D" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="YouTube Music Playlists"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                <TextBlock Text="Import playlists from your YouTube Music library into Playlists. Removing an imported playlist from this app only deletes it locally and won't affect your YouTube Music account."
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="Import Playlists..."
                                                    Command="{x:Bind ViewModel.OpenYouTubePlaylistImportModalCommand, Mode=OneWay}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="4"
                                                    Padding="14,7"
                                                    FontSize="12.5" />
                                        </Grid>
                                    </Border>

                                    <!-- Direct Cookie / Session Paste Card -->
                                    <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="20,16">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Direct Cookie Header Connection (SAPISID / __Secure-3PAPISID)"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                <TextBlock Text="Alternatively, paste a YouTube Music Request Cookie header directly"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                            </StackPanel>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         PlaceholderText="Account Label (e.g. My YT Music)"
                                                         Text="{x:Bind ViewModel.YouTubeAccountLabelInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         CornerRadius="4"
                                                         FontSize="12.5" />
                                                <PasswordBox x:Name="YouTubeCookiePasswordBox"
                                                             Grid.Column="1"
                                                             PasswordRevealMode="Hidden"
                                                             PlaceholderText="Paste Cookie header from music.youtube.com..."
                                                             Password="{x:Bind ViewModel.YouTubeMusicCookieHeaderInput, Mode=TwoWay}"
                                                             CornerRadius="4"
                                                             FontSize="12.5" />
                                                <Button Grid.Column="2"
                                                        Content="Connect Cookie"
                                                        Command="{x:Bind ViewModel.ConnectYouTubeAccountCookieCommand, Mode=OneWay}"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        CornerRadius="4"
                                                        Padding="14,7"
                                                        FontSize="12.5" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ================================================================= -->
                                <!-- CATEGORY 4: DOWNLOADS & OFFLINE                                   -->
                                <!-- ================================================================= -->
                                <StackPanel Visibility="{x:Bind ViewModel.SettingsDownloadsVisibility, Mode=OneWay}"
                                            Spacing="16">
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="18" />
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>

                                    <StackPanel Spacing="4" Margin="0,0,0,4">
                                        <TextBlock Text="Downloads &amp; Offline"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="Downloaded songs automatically take priority over online streaming so playback is instant and zero-bandwidth."
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </StackPanel>

                                    <!-- Download Quality & Folder Card -->
                                    <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <!-- Row 1: Quality -->
                                            <Grid Padding="20,16" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="20" Foreground="{ThemeResource TokenPrimaryAccentBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="Default Download Quality"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                    <TextBlock Text="Preferred audio codec and bitrate when saving tracks offline"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Content="FLAC Lossless (Mornye)"
                                                            Command="{x:Bind ViewModel.SelectDownloadFormatCommand, Mode=OneWay}"
                                                            CommandParameter="FLAC"
                                                            Style="{x:Bind GetNativeSettingsButtonStyle(ViewModel.IsDownloadFormatFlac), Mode=OneWay}"
                                                            CornerRadius="4" Padding="12,6" FontSize="12" />
                                                    <Button Content="MP3 320kbps (YT Music)"
                                                            Command="{x:Bind ViewModel.SelectDownloadFormatCommand, Mode=OneWay}"
                                                            CommandParameter="MP3"
                                                            Style="{x:Bind GetNativeSettingsButtonStyle(ViewModel.IsDownloadFormatMp3), Mode=OneWay}"
                                                            CornerRadius="4" Padding="12,6" FontSize="12" />
                                                    <Button Content="M4A"
                                                            Command="{x:Bind ViewModel.SelectDownloadFormatCommand, Mode=OneWay}"
                                                            CommandParameter="M4A"
                                                            Style="{x:Bind GetNativeSettingsButtonStyle(ViewModel.IsDownloadFormatM4a), Mode=OneWay}"
                                                            CornerRadius="4" Padding="12,6" FontSize="12" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource Win11CardDividerBrush}" />

                                            <!-- Row 2: Download Folder -->
                                            <Grid Padding="20,16" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource TokenPrimaryTextBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="Download Folder"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.DownloadTargetDirectory, Mode=OneWay}"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="Change Download Folder..."
                                                        Command="{x:Bind ViewModel.PickDownloadDirectoryCommand, Mode=OneWay}"
                                                        CornerRadius="4"
                                                        Padding="14,7"
                                                        FontSize="12.5"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Embedded Metadata Tagging Card -->
                                    <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="20,16">
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Embedded Metadata &amp; Sidecar Assets"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                <TextBlock Text="Choose which tags and artwork are embedded into downloaded files"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                            </StackPanel>
                                            <Grid ColumnSpacing="16" RowSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <CheckBox Grid.Row="0" Grid.Column="0" Content="Title &amp; Artist" IsChecked="{x:Bind ViewModel.DownloadIncludeTitleAndArtist, Mode=TwoWay}" />
                                                <CheckBox Grid.Row="0" Grid.Column="1" Content="Album &amp; Track #" IsChecked="{x:Bind ViewModel.DownloadIncludeAlbumAndTrackNumber, Mode=TwoWay}" />
                                                <CheckBox Grid.Row="1" Grid.Column="0" Content="1280px High-Res Cover Art" IsChecked="{x:Bind ViewModel.DownloadIncludeHighResCoverArt, Mode=TwoWay}" />
                                                <CheckBox Grid.Row="1" Grid.Column="1" Content="Genre &amp; Release Year" IsChecked="{x:Bind ViewModel.DownloadIncludeGenreAndReleaseYear, Mode=TwoWay}" />
                                                <CheckBox Grid.Row="2" Grid.Column="0" Content="Synced Lyrics (.LRC)" IsChecked="{x:Bind ViewModel.DownloadIncludeSynchronizedLyrics, Mode=TwoWay}" />
                                                <CheckBox Grid.Row="2" Grid.Column="1" Content="ReplayGain &amp; ISRC" IsChecked="{x:Bind ViewModel.DownloadIncludeReplayGain, Mode=TwoWay}" />
                                                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Offline Apple Music Canvas Motion Video (.canvas.mp4)" IsChecked="{x:Bind ViewModel.DownloadIncludeAppleCanvasOffline, Mode=TwoWay}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ================================================================= -->
                                <!-- CATEGORY 5: LYRICS & APPLE CANVAS                                 -->
                                <!-- ================================================================= -->
                                <StackPanel Visibility="{x:Bind ViewModel.SettingsLyricsVisualizersVisibility, Mode=OneWay}"
                                            Spacing="16">
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="18" />
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>

                                    <StackPanel Spacing="4" Margin="0,0,0,4">
                                        <TextBlock Text="Lyrics &amp; Apple Canvas"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="Configure editorial motion album covers and synchronized lyrics provider priority."
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </StackPanel>

                                    <!-- Apple Music Canvas Card -->
                                    <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="20,16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE90A;" FontSize="20" Foreground="{ThemeResource TokenPrimaryAccentBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Apple Music Canvas (Editorial Animated Album Covers)"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                <TextBlock Text="Automatically loops Apple Music Editorial Motion Covers in Now Playing, Album Detail, and Fullscreen"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2"
                                                          IsOn="{x:Bind ViewModel.IsAppleMusicCanvasEnabled, Mode=TwoWay}"
                                                          OnContent="Active"
                                                          OffContent="Off"
                                                          MinWidth="0"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Lyrics Providers Priority List -->
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.LyricsProviders, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:LyricsProviderConfig">
                                                <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                                        BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="18,12"
                                                        Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                                                    <Grid ColumnSpacing="14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                CornerRadius="4"
                                                                Padding="6,3"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                                BorderThickness="1">
                                                            <TextBlock Text="{x:Bind PriorityLabel, Mode=OneWay}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                       HorizontalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                            <TextBlock Text="{x:Bind CapabilityBadge, Mode=OneWay}"
                                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                       FontSize="11.5"
                                                                       Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2"
                                                                Click="OnToggleLyricsProviderClicked"
                                                                Tag="{x:Bind}"
                                                                CornerRadius="4"
                                                                Padding="12,5"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                        </Button>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <Button Click="OnMoveLyricsProviderUpClicked"
                                                                    Tag="{x:Bind}"
                                                                    Width="32" Height="32"
                                                                    CornerRadius="4"
                                                                    Padding="0">
                                                                <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                                            </Button>
                                                            <Button Click="OnMoveLyricsProviderDownClicked"
                                                                    Tag="{x:Bind}"
                                                                    Width="32" Height="32"
                                                                    CornerRadius="4"
                                                                    Padding="0">
                                                                <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ================================================================= -->
                                <!-- CATEGORY 6: UPDATES & VERSION (GitHub Releases + SHA-256)         -->
                                <!-- ================================================================= -->
                                <StackPanel Visibility="{x:Bind ViewModel.SettingsUpdatesVisibility, Mode=OneWay}"
                                            Spacing="16">
                                    <StackPanel.ChildrenTransitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="18" />
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </StackPanel.ChildrenTransitions>

                                    <StackPanel Spacing="4" Margin="0,0,0,4">
                                        <TextBlock helpers:Loc.Key="Settings_UpdatesTitle"
                                                   Text="Updates"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock helpers:Loc.Key="Settings_UpdatesSubtitle"
                                                   Text="Keep Xperience Music Player up to date with official SHA-256 verified GitHub Releases."
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </StackPanel>

                                    <!-- Card 1: Installed Version & Manual Update Check -->
                                    <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <Grid Padding="20,16" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="40" Height="40"
                                                        CornerRadius="20"
                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE777;"
                                                              FontSize="18"
                                                              Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock helpers:Loc.Key="Settings_CurrentVersionLabel"
                                                                   Text="Installed Version"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="7,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind ViewModel.CurrentAppVersionDisplay, Mode=OneWay}"
                                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                        </Border>
                                                        <Border Background="{ThemeResource Win11CardSubtleBackgroundBrush}"
                                                                BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="7,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind ViewModel.CurrentAppArchitectureDisplay, Mode=OneWay}"
                                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                       FontSize="11"
                                                                       Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock helpers:Loc.Key="Settings_CurrentVersionDesc"
                                                               Text="Check if a newer release is available for your Windows device"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="10"
                                                            VerticalAlignment="Center">
                                                    <ProgressRing Width="18"
                                                                  Height="18"
                                                                  IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.CheckUpdatesLoadingVisibility, Mode=OneWay}"
                                                                  VerticalAlignment="Center" />
                                                    <Button Command="{x:Bind ViewModel.CheckForUpdatesManuallyCommand, Mode=OneWay}"
                                                            IsEnabled="{x:Bind ViewModel.IsCheckUpdatesButtonEnabled, Mode=OneWay}"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                            CornerRadius="4"
                                                            Padding="14,7"
                                                            FontSize="12.5"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                            <TextBlock helpers:Loc.Key="Settings_CheckUpdatesNow"
                                                                       Text="Check for updates now"
                                                                       FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Status / Result Feedback Footer Strip -->
                                            <StackPanel Visibility="{x:Bind ViewModel.UpdateCheckFeedbackVisibility, Mode=OneWay}">
                                                <Border Height="1" Background="{ThemeResource Win11CardDividerBrush}" />
                                                <Grid Padding="20,12"
                                                      ColumnSpacing="12"
                                                      Background="{ThemeResource Win11CardSubtleBackgroundBrush}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{x:Bind ViewModel.UpdateCheckFeedbackText, Mode=OneWay}"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="12.5"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Foreground="{x:Bind GetUpdateFeedbackForegroundBrush(ViewModel.IsUpdateCheckFeedbackError), Mode=OneWay}" />
                                                    <Button Grid.Column="1"
                                                            Visibility="{x:Bind ViewModel.AvailableUpdateActionVisibility, Mode=OneWay}"
                                                            Command="{x:Bind ViewModel.OpenAvailableUpdateDialogCommand, Mode=OneWay}"
                                                            CornerRadius="4"
                                                            Padding="12,5"
                                                            FontSize="12"
                                                            VerticalAlignment="Center">
                                                        <TextBlock helpers:Loc.Key="Settings_UpdatesViewAvailable"
                                                                   Text="View update"
                                                                   FontWeight="SemiBold" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Automatic Background Update Check Toggle -->
                                    <Border Background="{ThemeResource Win11CardBackgroundBrush}"
                                            BorderBrush="{ThemeResource Win11CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="20,16">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0"
                                                      Glyph="&#xE895;"
                                                      FontSize="20"
                                                      Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock helpers:Loc.Key="Settings_AutoCheckUpdatesTitle"
                                                           Text="Check for updates automatically on startup"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                <TextBlock helpers:Loc.Key="Settings_AutoCheckUpdatesDesc"
                                                           Text="Silently checks GitHub Releases in the background when the app launches"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2"
                                                          IsOn="{x:Bind ViewModel.AutoCheckUpdatesOnStartup, Mode=TwoWay}"
                                                          OnContent="{x:Bind ViewModel.UpdatesToggleOnLabel, Mode=OneWay}"
                                                          OffContent="{x:Bind ViewModel.UpdatesToggleOffLabel, Mode=OneWay}"
                                                          MinWidth="0"
                                                          VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </NavigationView>
                    </Grid>

                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ============================================================================= -->
            <!-- COLUMN 1: NOW PLAYING SIDEBAR (Raised up right below Window Caption Bar)      -->
            <!-- ============================================================================= -->
            <!-- ================================================================================= -->
            <!-- COLUMN 1: EDGE-TO-EDGE NOW PLAYING SIDEBAR (Android Full-Screen Style)            -->
            <!-- ================================================================================= -->
            <Grid x:Name="NowPlayingSidebarPanel"
                  Grid.Column="1"
                  VerticalAlignment="Stretch"
                  Margin="0"
                  PointerEntered="OnSidebarCoverStagePointerEntered"
                  PointerMoved="OnSidebarCoverStagePointerMoved"
                  PointerExited="OnSidebarCoverStagePointerExited">
                <Grid.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="SidebarQueueCardBrush" Color="#20FFFFFF" />
                                <SolidColorBrush x:Key="SidebarQueueCardBorderBrush" Color="#26FFFFFF" />
                                <SolidColorBrush x:Key="SidebarPrimaryInkBrush" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="SidebarSecondaryInkBrush" Color="#CCFFFFFF" />
                                <SolidColorBrush x:Key="SidebarEdgeHairlineBrush" Color="#24FFFFFF" />
                                <SolidColorBrush x:Key="SidebarOverlayShadowBrush" Color="#99000000" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="SidebarQueueCardBrush" Color="#88FFFFFF" />
                                <SolidColorBrush x:Key="SidebarQueueCardBorderBrush" Color="#1F0F172A" />
                                <SolidColorBrush x:Key="SidebarPrimaryInkBrush" Color="#FF0F172A" />
                                <SolidColorBrush x:Key="SidebarSecondaryInkBrush" Color="#B81E293B" />
                                <SolidColorBrush x:Key="SidebarEdgeHairlineBrush" Color="#1E0F172A" />
                                <SolidColorBrush x:Key="SidebarOverlayShadowBrush" Color="#77FFFFFF" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Grid.Resources>

                <!-- 1. Dedicated Clean Backdrop Source (Ambient Full-Height Base + Upper Cover/Canvas + Ambient Dissolve) -->
                <Grid x:Name="NowPlayingArtworkCleanBackdrop">
                    <!-- Full-Height Ambient Background Base Layer -->
                    <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Border.Background>
                            <SolidColorBrush x:Name="NowPlayingAmbientBackgroundBrush" Color="#FF141118" />
                        </Border.Background>
                    </Border>

                    <!-- Upper Aspect-Ratio Cover Art + Apple Music Canvas + Ambient Dissolve Gradient -->
                    <Grid x:Name="SidebarCoverBackdropHost"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Stretch"
                          Height="326">
                        <!-- Default Minimalist Fallback Artwork -->
                        <Grid Opacity="{x:Bind ViewModel.CurrentTrack.DefaultCoverIconOpacity, Mode=OneWay}">
                            <Border Width="116" Height="116"
                                    CornerRadius="58"
                                    BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                    BorderThickness="1.5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            <Border Width="76" Height="76"
                                    CornerRadius="38"
                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                    BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEC4F;"
                                          FontSize="32"
                                          Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Apple Music Canvas Animated Motion Cover Layer (Loads Invisibly Underneath Static Cover, Reveals Only After First Decoded Frame) -->
                        <Border x:Name="SidebarCanvasVideoContainer"
                                Opacity="0"
                                IsHitTestVisible="False">
                            <Border.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.35" />
                            </Border.OpacityTransition>
                            <Grid>
                                <MediaPlayerElement x:Name="SidebarCanvasMediaPlayerElement"
                                                    AreTransportControlsEnabled="False"
                                                    Opacity="0"
                                                    Stretch="UniformToFill" />
                                <canvas:CanvasControl x:Name="SidebarCanvasVideoCanvas"
                                                      ClearColor="Transparent"
                                                      Draw="OnSidebarCanvasVideoCanvasDraw" />
                            </Grid>
                        </Border>

                        <!-- Real Album Cover Artwork (Stays Cleanly Visible On Top at Opacity=1.0 While Canvas Loads, Cross-Fades Out Once First Frame Renders) -->
                        <Border x:Name="SidebarStaticCoverHost"
                                Opacity="1"
                                IsHitTestVisible="False">
                            <Border.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.35" />
                            </Border.OpacityTransition>
                            <Image x:Name="SidebarCoverImage"
                                   helpers:BitmapDecodeHelper.DecodeWidth="512" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentTrack.SafeCoverArtUri, Mode=OneWay}"
                                   Opacity="{x:Bind ViewModel.CurrentTrack.CoverArtOpacity, Mode=OneWay}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   ImageOpened="OnSidebarCoverImageOpened" />
                        </Border>

                        <!-- Smooth Ambient Dissolve Gradient (Top Header Feather + Seamless Merge Into Ambient Background Below) -->
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop x:Name="AmbientStopTop" Offset="0.00" Color="#B8141118" />
                                    <GradientStop x:Name="AmbientStopTopFade" Offset="0.32" Color="#00141118" />
                                    <GradientStop x:Name="AmbientStopMidClear" Offset="0.54" Color="#00141118" />
                                    <GradientStop x:Name="AmbientStopMidBlend" Offset="0.76" Color="#A4141118" />
                                    <GradientStop x:Name="AmbientStopNearBottom" Offset="0.90" Color="#EB141118" />
                                    <GradientStop x:Name="AmbientStopBottom" Offset="1.00" Color="#FF141118" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Subtle Edge Hairline Separating Workspace Column -->
                    <Border BorderThickness="1,0,0,0"
                            BorderBrush="{ThemeResource SidebarEdgeHairlineBrush}"
                            IsHitTestVisible="False" />
                </Grid>

                <!-- 2. Interactive Foreground Stack -->
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ROW 0: Upper Cover Interactive Stage (Header Below Caption Controls + Hover-Triggered Transport Controls) -->
                    <Grid x:Name="SidebarCoverInteractiveStage"
                          Grid.Row="0"
                          Height="288"
                          Background="#01000000"
                          PointerEntered="OnSidebarCoverStagePointerEntered"
                          PointerMoved="OnSidebarCoverStagePointerMoved"
                          PointerExited="OnSidebarCoverStagePointerExited">

                        <!-- Top Header (Margin Top=38 clears Windows caption buttons) -->
                        <Grid VerticalAlignment="Top"
                              Margin="12,38,12,0"
                              ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Circular Close Sidebar Button -->
                            <controls:LiquidGlassPanel Grid.Column="0"
                                                       Width="36" Height="36"
                                                       GlassCornerRadius="18"
                                                       GlassPadding="0"
                                                       SampleLiveBackdrop="True"
                                                       UseNowPlayingCoverBackdrop="True"
                                                       EnableHoverScale="True">
                                <Button Command="{x:Bind ViewModel.ToggleNowPlayingSidebarCommand, Mode=OneWay}"
                                        Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        Padding="0"
                                        ToolTipService.ToolTip="Hide Now Playing">
                                    <FontIcon Glyph="{x:Bind ViewModel.NowPlayingSidebarToggleGlyph, Mode=OneWay}"
                                              FontSize="14"
                                              Foreground="{ThemeResource SidebarPrimaryInkBrush}" />
                                </Button>
                            </controls:LiquidGlassPanel>

                            <!-- Title with Soft Optical Drop Shadow -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="2,0,2,0">
                                <TextBlock x:Uid="NowPlaying_Header"
                                           helpers:Loc.Key="NowPlaying_Header"
                                           Text="Now Playing"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource SidebarOverlayShadowBrush}"
                                           Margin="0,1.5,0,-1.5"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Uid="NowPlaying_Header"
                                           helpers:Loc.Key="NowPlaying_Header"
                                           Text="Now Playing"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource SidebarPrimaryInkBrush}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <!-- Right Unified LiquidGlass Pill: Fullscreen | Cast | Menu -->
                            <controls:LiquidGlassPanel Grid.Column="2"
                                                       Height="36"
                                                       GlassCornerRadius="18"
                                                       GlassPadding="4,0"
                                                       SampleLiveBackdrop="True"
                                                       UseNowPlayingCoverBackdrop="True">
                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <Button Command="{x:Bind ViewModel.OpenFullscreenNowPlayingCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Width="30" Height="30"
                                            CornerRadius="15"
                                            Padding="0"
                                            helpers:MicroInteractions.HoverScale="1.12"
                                            helpers:MicroInteractions.PressScale="0.90"
                                            ToolTipService.ToolTip="Fullscreen Now Playing">
                                        <FontIcon Glyph="&#xE740;"
                                                  FontSize="13"
                                                  Foreground="{ThemeResource SidebarPrimaryInkBrush}" />
                                    </Button>

                                    <Border Width="1" Height="16"
                                            Background="{ThemeResource SidebarEdgeHairlineBrush}"
                                            Margin="1,0"
                                            IsHitTestVisible="False" />

                                    <Button Click="OnSidebarCastClicked"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Width="30" Height="30"
                                            CornerRadius="15"
                                            Padding="0"
                                            helpers:MicroInteractions.HoverScale="1.12"
                                            helpers:MicroInteractions.PressScale="0.90"
                                            ToolTipService.ToolTip="Cast Device (Coming soon)">
                                        <FontIcon Glyph="&#xEC15;"
                                                  FontSize="13.5"
                                                  Foreground="{ThemeResource SidebarPrimaryInkBrush}" />
                                    </Button>

                                    <Border Width="1" Height="16"
                                            Background="{ThemeResource SidebarEdgeHairlineBrush}"
                                            Margin="1,0"
                                            IsHitTestVisible="False" />

                                    <Button Click="OnSidebarCurrentTrackMoreClicked"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Width="30" Height="30"
                                            CornerRadius="15"
                                            Padding="0"
                                            helpers:MicroInteractions.HoverScale="1.12"
                                            helpers:MicroInteractions.PressScale="0.90"
                                            ToolTipService.ToolTip="Current Song Options">
                                        <FontIcon Glyph="&#xE712;"
                                                  FontSize="13.5"
                                                  Foreground="{ThemeResource SidebarPrimaryInkBrush}" />
                                    </Button>
                                </StackPanel>
                            </controls:LiquidGlassPanel>
                        </Grid>

                        <!-- Center Hover-Triggered Transport Controls: Repeat | Prev | Play/Pause | Next | Shuffle -->
                        <StackPanel x:Name="SidebarTransportControlsHost"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,34,0,0"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                            <!-- 1. Repeat -->
                            <Grid x:Name="SidebarTransportSlotRepeat" Width="36" Height="36" Opacity="0">
                                <controls:LiquidGlassPanel Width="36" Height="36"
                                                           GlassCornerRadius="18"
                                                           GlassPadding="0"
                                                           SampleLiveBackdrop="True"
                                                           UseNowPlayingCoverBackdrop="True"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.CycleRepeatModeCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Width="36" Height="36"
                                            CornerRadius="18"
                                            Padding="0"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.RepeatModeTooltip, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind ViewModel.RepeatModeGlyph, Mode=OneWay}"
                                                  FontSize="13.5"
                                                  Foreground="{ThemeResource SidebarPrimaryInkBrush}"
                                                  Opacity="{x:Bind ViewModel.RepeatButtonAccentOpacity, Mode=OneWay}" />
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </Grid>

                            <!-- 2. Previous -->
                            <Grid x:Name="SidebarTransportSlotPrev" Width="42" Height="42" Opacity="0">
                                <controls:LiquidGlassPanel Width="42" Height="42"
                                                           GlassCornerRadius="21"
                                                           GlassPadding="0"
                                                           SampleLiveBackdrop="True"
                                                           UseNowPlayingCoverBackdrop="True"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.PreviousTrackCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Width="42" Height="42"
                                            CornerRadius="21"
                                            Padding="0"
                                            ToolTipService.ToolTip="Previous Track">
                                        <FontIcon Glyph="&#xE892;"
                                                  FontSize="14.5"
                                                  Foreground="{ThemeResource SidebarPrimaryInkBrush}" />
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </Grid>

                            <!-- 3. Play / Pause -->
                            <Grid x:Name="SidebarTransportSlotPlayPause" Width="56" Height="56" Opacity="0">
                                <controls:LiquidGlassPanel Width="56" Height="56"
                                                           GlassCornerRadius="28"
                                                           GlassPadding="0"
                                                           SampleLiveBackdrop="True"
                                                           UseNowPlayingCoverBackdrop="True"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.TogglePlayPauseCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Width="56" Height="56"
                                            CornerRadius="28"
                                            Padding="0"
                                            ToolTipService.ToolTip="Play / Pause">
                                        <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                                                  FontSize="22"
                                                  Foreground="{ThemeResource SidebarPrimaryInkBrush}"
                                                  Margin="1.5,0,0,0" />
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </Grid>

                            <!-- 4. Next -->
                            <Grid x:Name="SidebarTransportSlotNext" Width="42" Height="42" Opacity="0">
                                <controls:LiquidGlassPanel Width="42" Height="42"
                                                           GlassCornerRadius="21"
                                                           GlassPadding="0"
                                                           SampleLiveBackdrop="True"
                                                           UseNowPlayingCoverBackdrop="True"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.NextTrackCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Width="42" Height="42"
                                            CornerRadius="21"
                                            Padding="0"
                                            ToolTipService.ToolTip="Next Track">
                                        <FontIcon Glyph="&#xE893;"
                                                  FontSize="14.5"
                                                  Foreground="{ThemeResource SidebarPrimaryInkBrush}" />
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </Grid>

                            <!-- 5. Shuffle (Replaced Like) -->
                            <Grid x:Name="SidebarTransportSlotShuffle" Width="36" Height="36" Opacity="0">
                                <controls:LiquidGlassPanel Width="36" Height="36"
                                                           GlassCornerRadius="18"
                                                           GlassPadding="0"
                                                           SampleLiveBackdrop="True"
                                                           UseNowPlayingCoverBackdrop="True"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.ToggleShuffleCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Width="36" Height="36"
                                            CornerRadius="18"
                                            Padding="0"
                                            ToolTipService.ToolTip="Shuffle Playback Queue">
                                        <FontIcon Glyph="&#xE8B1;"
                                                  FontSize="13.5"
                                                  Foreground="{ThemeResource SidebarPrimaryInkBrush}"
                                                  Opacity="{x:Bind ViewModel.ShuffleButtonAccentOpacity, Mode=OneWay}" />
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: Centered Song Title + Artist & Album With Soft Shadow -->
                    <StackPanel Grid.Row="1"
                                Spacing="3"
                                Margin="16,-14,16,10"
                                HorizontalAlignment="Stretch">
                        <Grid HorizontalAlignment="Center" ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource SidebarOverlayShadowBrush}"
                                           Opacity="0.55"
                                           Margin="0,2.5,0,-2.5"
                                           TextAlignment="Center"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource SidebarOverlayShadowBrush}"
                                           Opacity="0.85"
                                           Margin="0,1,0,-1"
                                           TextAlignment="Center"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource SidebarPrimaryInkBrush}"
                                           TextAlignment="Center"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <controls:ExplicitBadgeControl Grid.Column="1"
                                                           Visibility="{x:Bind ViewModel.CurrentTrack.IsExplicit, Mode=OneWay}"
                                                           VerticalAlignment="Center" />
                        </Grid>

                        <Button Command="{x:Bind ViewModel.OpenCurrentTrackArtistCommand, Mode=OneWay}"
                                Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                HorizontalAlignment="Center"
                                Padding="8,2"
                                CornerRadius="10"
                                helpers:MicroInteractions.HoverScale="1.03"
                                helpers:MicroInteractions.PressScale="0.97"
                                ToolTipService.ToolTip="Open Artist Page">
                            <Grid HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentTrack.ArtistAlbumSubtitle, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource SidebarOverlayShadowBrush}"
                                           Opacity="0.72"
                                           Margin="0,1,0,-1"
                                           TextAlignment="Center"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentTrack.ArtistAlbumSubtitle, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource SidebarSecondaryInkBrush}"
                                           TextAlignment="Center"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- ROW 2: Expanding Jelly Volume Pill | Dynamic Squiggly Progress Bar Pill | Like Button -->
                    <Grid Grid.Row="2"
                          Margin="10,0,10,10"
                          ColumnSpacing="6"
                          Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Expandable Jelly Volume LiquidGlass Pill -->
                        <controls:LiquidGlassPanel x:Name="SidebarVolumeExpandablePill"
                                                   Grid.Column="0"
                                                   Width="36" Height="36"
                                                   VerticalAlignment="Center"
                                                   GlassCornerRadius="18"
                                                   GlassPadding="0"
                                                   SampleLiveBackdrop="True"
                                                   UseNowPlayingCoverBackdrop="True"
                                                   PointerEntered="OnSidebarVolumeHostPointerEntered"
                                                   PointerExited="OnSidebarVolumeHostPointerExited">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{x:Bind ViewModel.ToggleMuteCommand, Mode=OneWay}"
                                        Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        Padding="0"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.FormattedVolumePercent, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}"
                                              FontSize="13.5"
                                              Foreground="{ThemeResource SidebarPrimaryInkBrush}" />
                                </Button>

                                <controls:LiquidGlassVolumeSlider x:Name="SidebarVolumeSlider"
                                                                  Grid.Column="1"
                                                                  Value="{x:Bind ViewModel.VolumePercent, Mode=TwoWay}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,0"
                                                                  Opacity="0"
                                                                  IsHitTestVisible="False" />
                            </Grid>
                        </controls:LiquidGlassPanel>

                        <!-- Center (*): Squiggly Android-13 Style Progress Bar inside LiquidGlass Pill -->
                        <controls:LiquidGlassPanel Grid.Column="1"
                                                   Height="38"
                                                   VerticalAlignment="Center"
                                                   GlassCornerRadius="19"
                                                   GlassPadding="10,0"
                                                   SampleLiveBackdrop="True"
                                                   UseNowPlayingCoverBackdrop="True">
                            <Grid ColumnSpacing="4" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="SidebarPositionTextBlock"
                                           Grid.Column="0"
                                           Text="{x:Bind ViewModel.FormattedPosition, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource SidebarPrimaryInkBrush}"
                                           VerticalAlignment="Center"
                                           MinWidth="26" />

                                <controls:SquigglyProgressBarControl x:Name="SidebarSquigglyProgressBar"
                                                                     Grid.Column="1"
                                                                     Height="26"
                                                                     VerticalAlignment="Center"
                                                                     IsPlaying="{x:Bind ViewModel.IsPlaying, Mode=OneWay}"
                                                                     IsLightMode="{x:Bind ViewModel.IsLightMode, Mode=OneWay}"
                                                                     SeekRequested="OnSidebarSquigglySeekRequested"
                                                                     ScrubbingStateChanged="OnSidebarSquigglyScrubbingStateChanged"
                                                                     ScrubbingProgressChanged="OnSidebarSquigglyScrubbingProgressChanged" />

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind ViewModel.FormattedDuration, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource SidebarSecondaryInkBrush}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           MinWidth="26" />
                            </Grid>
                        </controls:LiquidGlassPanel>

                        <!-- Right: Circular LiquidGlass Like / Favorite Button -->
                        <controls:LiquidGlassPanel Grid.Column="2"
                                                   Width="36" Height="36"
                                                   VerticalAlignment="Center"
                                                   GlassCornerRadius="18"
                                                   GlassPadding="0"
                                                   SampleLiveBackdrop="True"
                                                   UseNowPlayingCoverBackdrop="True"
                                                   EnableHoverScale="True">
                            <Button Command="{x:Bind ViewModel.ToggleLikeCurrentTrackCommand, Mode=OneWay}"
                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Padding="0"
                                    ToolTipService.ToolTip="Like / Favorite Current Song">
                                <FontIcon x:Name="SidebarLikeButtonIcon"
                                          Glyph="{x:Bind ViewModel.LikeButtonGlyph, Mode=OneWay}"
                                          FontSize="14"
                                          Foreground="{ThemeResource SidebarPrimaryInkBrush}" />
                            </Button>
                        </controls:LiquidGlassPanel>
                    </Grid>

                    <!-- ROW 3: Queue / Lyrics Segmented Capsule (Animated LiquidGlass Slicer) -->
                    <controls:LiquidGlassPanel Grid.Row="3"
                                               Margin="10,0,10,8"
                                               Height="38"
                                               GlassCornerRadius="19"
                                               GlassPadding="3"
                                               SampleLiveBackdrop="True"
                                               UseNowPlayingCoverBackdrop="True"
                                               HighlightAlphaMultiplier="0.65">
                        <Grid x:Name="NowPlayingSlicerContainer">
                            <Grid x:Name="NowPlayingSlicerIndicatorHost"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Stretch"
                                  Width="148"
                                  IsHitTestVisible="False">
                                <Border CornerRadius="16"
                                        Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                                        BorderBrush="{ThemeResource TokenActiveSegmentBorderBrush}"
                                        BorderThickness="1" />
                                <controls:LiquidGlassPanel x:Name="NowPlayingSlicerLiquidGlass"
                                                           GlassCornerRadius="16"
                                                           SampleLiveBackdrop="True"
                                                           UseNowPlayingCoverBackdrop="True"
                                                           IsDraggableLens="True"
                                                           TintOpacityOverride="0.18"
                                                           HighlightAlphaMultiplier="0.90"
                                                           Opacity="0" />
                            </Grid>

                            <Grid x:Name="NowPlayingSlicerButtonsGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="NpBtnQueue"
                                        Grid.Column="0"
                                        x:Uid="Tab_Queue"
                                        helpers:Loc.Key="Tab_Queue"
                                        Content="Queue"
                                        Click="OnNowPlayingSlicerButtonClicked"
                                        Command="{x:Bind ViewModel.SelectNowPlayingTabCommand, Mode=OneWay}"
                                        CommandParameter="Queue"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="16"
                                        Padding="0,5"
                                        FontSize="12.5" />

                                <Button x:Name="NpBtnLyrics"
                                        Grid.Column="1"
                                        x:Uid="Tab_Lyrics"
                                        helpers:Loc.Key="Tab_Lyrics"
                                        Content="Lyrics"
                                        Click="OnNowPlayingSlicerButtonClicked"
                                        Command="{x:Bind ViewModel.SelectNowPlayingTabCommand, Mode=OneWay}"
                                        CommandParameter="Lyrics"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="16"
                                        Padding="0,5"
                                        FontSize="12.5" />
                            </Grid>
                        </Grid>
                    </controls:LiquidGlassPanel>

                    <!-- ROW 4: Queue (Android InlineQueue Cards + Jelly Drag Reorder) & Synchronized Lyrics -->
                    <Grid x:Name="NowPlayingTabContentHost" Grid.Row="4">
                        <!-- QUEUE TAB -->
                        <Grid x:Name="NowPlayingQueuePanelRoot"
                              Visibility="{x:Bind ViewModel.QueuePanelVisibility, Mode=OneWay}"
                              RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Android Playing Queue Header Pills -->
                            <Grid Grid.Row="0" Margin="12,0,12,2">
                                <controls:LiquidGlassPanel HorizontalAlignment="Left"
                                                           Height="28"
                                                           GlassCornerRadius="14"
                                                           GlassPadding="10,0"
                                                           SampleLiveBackdrop="True"
                                                           UseNowPlayingCoverBackdrop="True">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE90B;"
                                                  FontSize="11.5"
                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                        <TextBlock Text="Playing Queue"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource SidebarPrimaryInkBrush}" />
                                    </StackPanel>
                                </controls:LiquidGlassPanel>

                                <controls:LiquidGlassPanel HorizontalAlignment="Right"
                                                           Height="28"
                                                           GlassCornerRadius="14"
                                                           GlassPadding="10,0"
                                                           SampleLiveBackdrop="True"
                                                           UseNowPlayingCoverBackdrop="True">
                                    <TextBlock Text="{x:Bind ViewModel.QueueCountSummary, Mode=OneWay}"
                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource SidebarSecondaryInkBrush}"
                                               VerticalAlignment="Center" />
                                </controls:LiquidGlassPanel>
                            </Grid>

                            <ScrollViewer x:Name="NowPlayingQueueScrollViewer"
                                          Grid.Row="1"
                                          Style="{StaticResource LiquidGlassScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="7" Padding="10,2,10,24">
                                    <!-- Active Now Playing Card inside LiquidGlassPanel with 4-Bar Animated Equalizer -->
                                    <controls:LiquidGlassPanel GlassCornerRadius="14"
                                                               GlassPadding="0"
                                                               SampleLiveBackdrop="True"
                                                               UseNowPlayingCoverBackdrop="True"
                                                               TintOpacityOverride="0.34"
                                                               HighlightAlphaMultiplier="0.65">
                                        <Border x:Name="SidebarActiveQueueCardBorder"
                                                CornerRadius="14"
                                                Padding="8,7"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                RightTapped="OnSidebarCurrentTrackRightTapped">
                                            <Grid ColumnSpacing="9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="40" Height="40"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                        BorderBrush="{ThemeResource SidebarQueueCardBorderBrush}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid Opacity="{x:Bind ViewModel.CurrentTrack.DefaultCoverIconOpacity, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xEC4F;"
                                                                      FontSize="15"
                                                                      Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Border CornerRadius="7"
                                                                Opacity="{x:Bind ViewModel.CurrentTrack.CoverArtOpacity, Mode=OneWay}">
                                                            <Border.Background>
                                                                <ImageBrush helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentTrack.SafeCoverArtUri, Mode=OneWay}"
                                                                            Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <Grid HorizontalAlignment="Left" ColumnSpacing="5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="SidebarActiveCardTitleText"
                                                                   Grid.Column="0"
                                                                   Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Bold"
                                                                   MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <controls:ExplicitBadgeControl Grid.Column="1"
                                                                                       IsCompact="True"
                                                                                       Visibility="{x:Bind ViewModel.CurrentTrack.IsExplicit, Mode=OneWay}"
                                                                                       VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Artist, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                               FontSize="10.5"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource SidebarSecondaryInkBrush}" />
                                                </StackPanel>

                                                <!-- 4-Bar Animated Equalizer Pill -->
                                                <Border x:Name="SidebarActiveEqPill"
                                                        Grid.Column="2"
                                                        CornerRadius="8"
                                                        Padding="7,4"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="2.5"
                                                                Height="14"
                                                                VerticalAlignment="Center">
                                                        <Border x:Name="EqBar1" Width="2.5" Height="5" CornerRadius="1.25" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                        <Border x:Name="EqBar2" Width="2.5" Height="9" CornerRadius="1.25" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                        <Border x:Name="EqBar3" Width="2.5" Height="6" CornerRadius="1.25" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                        <Border x:Name="EqBar4" Width="2.5" Height="11" CornerRadius="1.25" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Static Handle Visual Alignment Indicator -->
                                                <StackPanel Grid.Column="3"
                                                            Spacing="3.5"
                                                            VerticalAlignment="Center"
                                                            Margin="4,0,6,0"
                                                            Opacity="0.38">
                                                    <Border Width="13" Height="1.8" CornerRadius="0.9" Background="{ThemeResource SidebarSecondaryInkBrush}" />
                                                    <Border Width="13" Height="1.8" CornerRadius="0.9" Background="{ThemeResource SidebarSecondaryInkBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </controls:LiquidGlassPanel>

                                    <!-- Upcoming Queue Cards with LiquidGlass & Jelly Drag Reorder -->
                                    <ItemsRepeater x:Name="SidebarQueueItemsControl"
                                                  ItemsSource="{x:Bind ViewModel.Queue, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="7" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="entities:TrackItem">
                                                <Border CornerRadius="14"
                                                        Background="{ThemeResource SidebarQueueCardBrush}"
                                                        BorderBrush="{ThemeResource SidebarQueueCardBorderBrush}"
                                                        BorderThickness="0.9"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        Tapped="OnQueueItemTapped"
                                                        RightTapped="OnTrackRowRightTapped"
                                                        Tag="{x:Bind}">
                                                    <Border CornerRadius="14"
                                                            Padding="8,7"
                                                            Background="Transparent">
                                                        <Grid ColumnSpacing="9">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Width="40" Height="40"
                                                                    CornerRadius="8"
                                                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                    BorderBrush="{ThemeResource SidebarQueueCardBorderBrush}"
                                                                    BorderThickness="1">
                                                                <Grid>
                                                                    <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xEC4F;"
                                                                                  FontSize="15"
                                                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <Border CornerRadius="7"
                                                                            Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                        <Border.Background>
                                                                            <ImageBrush helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                                        Stretch="UniformToFill" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                <Grid HorizontalAlignment="Left" ColumnSpacing="4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{x:Bind Title, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                               FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{ThemeResource SidebarPrimaryInkBrush}"
                                                                               VerticalAlignment="Center" />
                                                                    <controls:ExplicitBadgeControl Grid.Column="1"
                                                                                                   IsCompact="True"
                                                                                                   Visibility="{x:Bind IsExplicit, Mode=OneWay}"
                                                                                                   VerticalAlignment="Center" />
                                                                    <FontIcon Grid.Column="2"
                                                                              Glyph="&#xE896;"
                                                                              FontSize="9.5"
                                                                              Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                              Opacity="{x:Bind DownloadedBadgeOpacity, Mode=OneWay}"
                                                                              VerticalAlignment="Center" />
                                                                </Grid>
                                                                <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                           FontSize="10.5"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{ThemeResource SidebarSecondaryInkBrush}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Spacing="2"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                           FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{ThemeResource SidebarSecondaryInkBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,2,0" />

                                                                <Button Click="OnTrackRowMoreClicked"
                                                                        Tag="{x:Bind}"
                                                                        Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                                        Width="22" Height="24"
                                                                        Opacity="0.72"
                                                                        VerticalAlignment="Center">
                                                                    <FontIcon Glyph="&#xE712;"
                                                                              FontSize="11"
                                                                              Foreground="{ThemeResource SidebarSecondaryInkBrush}" />
                                                                </Button>

                                                                <!-- Dedicated '=' Jelly Drag Handle -->
                                                                <Border Background="Transparent"
                                                                        Padding="6,7"
                                                                        Tag="{x:Bind}"
                                                                        PointerPressed="OnQueueDragHandlePointerPressed"
                                                                        PointerMoved="OnQueueDragHandlePointerMoved"
                                                                        PointerReleased="OnQueueDragHandlePointerReleased"
                                                                        PointerCanceled="OnQueueDragHandlePointerCanceled"
                                                                        PointerCaptureLost="OnQueueDragHandlePointerCaptureLost"
                                                                        ToolTipService.ToolTip="Drag to reorder">
                                                                    <StackPanel Spacing="3.5" VerticalAlignment="Center">
                                                                        <Border Width="13" Height="1.8" CornerRadius="0.9" Background="{ThemeResource SidebarSecondaryInkBrush}" />
                                                                        <Border Width="13" Height="1.8" CornerRadius="0.9" Background="{ThemeResource SidebarSecondaryInkBrush}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- LYRICS TAB (Win2D Word-Sweep + Glow + Optical Defocus Blur) -->
                        <Grid x:Name="NowPlayingLyricsPanelRoot"
                              Visibility="{x:Bind ViewModel.LyricsPanelVisibility, Mode=OneWay}"
                              RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Provider Pill & Import .LRC Pill -->
                            <Grid Grid.Row="0" Margin="12,0,12,0">
                                <controls:LiquidGlassPanel HorizontalAlignment="Left"
                                                           Height="28"
                                                           GlassCornerRadius="14"
                                                           GlassPadding="10,0"
                                                           SampleLiveBackdrop="True"
                                                           UseNowPlayingCoverBackdrop="True">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="6.5" Height="6.5" CornerRadius="3.25"
                                                Background="{ThemeResource TokenPrimaryAccentBrush}"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentLyricsProviderBadge, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenSubheadingFontFamily}"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource SidebarPrimaryInkBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </controls:LiquidGlassPanel>

                                <controls:LiquidGlassPanel HorizontalAlignment="Right"
                                                           Height="28"
                                                           GlassCornerRadius="14"
                                                           GlassPadding="2,0"
                                                           SampleLiveBackdrop="True"
                                                           UseNowPlayingCoverBackdrop="True"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.ImportLrcForCurrentTrackCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Height="28"
                                            CornerRadius="14"
                                            Padding="10,0"
                                            ToolTipService.ToolTip="Import a synchronized .lrc lyric file for the current song">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8E5;"
                                                      FontSize="11"
                                                      Foreground="{ThemeResource SidebarPrimaryInkBrush}" />
                                            <TextBlock Text="Import .LRC"
                                                       FontFamily="{StaticResource TokenSubheadingFontFamily}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SidebarPrimaryInkBrush}" />
                                        </StackPanel>
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <controls:SynchronizedLyricsCanvasControl x:Name="SidebarSynchronizedLyricsControl"
                                                                          Visibility="{x:Bind ViewModel.LyricsContentVisibility, Mode=OneWay}"
                                                                          Lines="{x:Bind ViewModel.CurrentLyrics, Mode=OneWay}"
                                                                          PositionSeconds="{x:Bind ViewModel.CurrentPositionSeconds, Mode=OneWay}"
                                                                          IsPlaying="{x:Bind ViewModel.IsPlaying, Mode=OneWay}"
                                                                          IsLightMode="{x:Bind ViewModel.IsLightMode, Mode=OneWay}"
                                                                          LineClicked="OnSidebarSynchronizedLyricLineClicked"
                                                                          UserScrollingChanged="OnSidebarLyricsUserScrollingChanged" />

                                <controls:LyricsSkeletonControl x:Name="SidebarLyricsSkeletonControl"
                                                                Visibility="{x:Bind ViewModel.LyricsLoadingVisibility, Mode=OneWay}"
                                                                IsActive="{x:Bind ViewModel.IsLyricsLoading, Mode=OneWay}"
                                                                IsLightMode="{x:Bind ViewModel.IsLightMode, Mode=OneWay}"
                                                                IsFullscreen="False" />

                                <controls:LyricsNotFoundControl x:Name="SidebarLyricsNotFoundControl"
                                                                Visibility="{x:Bind ViewModel.LyricsNotFoundVisibility, Mode=OneWay}"
                                                                IsActive="{x:Bind ViewModel.IsLyricsNotFound, Mode=OneWay}"
                                                                IsLightMode="{x:Bind ViewModel.IsLightMode, Mode=OneWay}"
                                                                IsFullscreen="False"
                                                                Title="{x:Bind ViewModel.LyricsEmptyTitle, Mode=OneWay}"
                                                                Subtitle="{x:Bind ViewModel.LyricsEmptySubtitle, Mode=OneWay}"
                                                                HelperText="{x:Bind ViewModel.LyricsEmptyHelperText, Mode=OneWay}" />

                                <!-- Floating Sync Recenter Pill (Appears when manually scrolled) -->
                                <controls:LiquidGlassPanel x:Name="SidebarLyricsSyncPill"
                                                           Visibility="Collapsed"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Bottom"
                                                           Margin="0,0,14,16"
                                                           Height="32"
                                                           GlassCornerRadius="16"
                                                           GlassPadding="2,0"
                                                           SampleLiveBackdrop="True"
                                                           UseNowPlayingCoverBackdrop="True"
                                                           EnableHoverScale="True">
                                    <Button Click="OnSidebarLyricsSyncClicked"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Height="32"
                                            CornerRadius="16"
                                            Padding="12,0">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE895;"
                                                      FontSize="11.5"
                                                      Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                            <TextBlock Text="Sync"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource SidebarPrimaryInkBrush}" />
                                        </StackPanel>
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================================================================================= -->
        <!-- LAYER 1.5: LIBRARY FLOATING OVERLAYS (Sticky Header + LiquidGlass Slicers + Rail) -->
        <!-- Placed OUTSIDE MainWorkspaceContainer so every LiquidGlassPanel samples live      -->
        <!-- scrolling content identically to the Top Navbar with zero colored rim tinting!    -->
        <!-- ================================================================================= -->
        <Grid x:Name="LibraryFloatingOverlayGrid"
              Visibility="{x:Bind ViewModel.LibraryViewVisibility, Mode=OneWay}"
              Padding="12,0,0,0"
              ColumnSpacing="16"
              Canvas.ZIndex="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="LibraryOverlayRightSidebarColumn" Width="324" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="LibraryStickyHeaderOverlay"
                  Grid.Column="0"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Stretch"
                  Margin="-12,0,0,0">

                <!-- Scroll-Activated Top Gradient Scrim (Opacity=0 at top so Aurora starts from Y=0 like Home) -->
                <Border x:Name="LibraryHeaderScrimBorder"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.16" />
                    </Border.OpacityTransition>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E60D0F14" Offset="0.0" />
                            <GradientStop Color="#C40D0F14" Offset="0.62" />
                            <GradientStop Color="#660D0F14" Offset="0.86" />
                            <GradientStop Color="#000D0F14" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Padding="34,68,24,18" Spacing="12">
                    <!-- Title + Subtitle + Optional Back Button (Recently Added) & Scanning Spinner -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Back Button when expanded into Recently Added Timeline -->
                        <controls:LiquidGlassPanel Grid.Column="0"
                                                   Visibility="{x:Bind ViewModel.LibraryRecentlyAddedBackVisibility, Mode=OneWay}"
                                                   Width="38"
                                                   Height="38"
                                                   GlassCornerRadius="19"
                                                   Preset="Button"
                                                   SampleLiveBackdrop="True"
                                                   EnableHoverScale="True"
                                                   HighlightAlphaMultiplier="0.65"
                                                   VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.CloseLibraryRecentlyAddedCommand, Mode=OneWay}"
                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                    Width="38"
                                    Height="38"
                                    CornerRadius="19"
                                    Padding="0"
                                    ToolTipService.ToolTip="Back to Library Overview">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                            </Button>
                        </controls:LiquidGlassPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" IsHitTestVisible="False">
                            <TextBlock Text="{x:Bind ViewModel.LibraryHeaderTitle, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       CharacterSpacing="-16"
                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.LibraryHeaderSubtitle, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                       FontSize="12.5"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ProgressRing Grid.Column="2"
                                      Visibility="{x:Bind ViewModel.LibraryLoadingRingVisibility, Mode=OneWay}"
                                      IsActive="{x:Bind ViewModel.IsLibraryBusy, Mode=OneWay}"
                                      Width="22"
                                      Height="22"
                                      Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <!-- Two Side-by-Side LiquidGlass Segmented Slicers (1:1 Reworked Navbar LiquidGlass Style) -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <!-- Category Filter Slicer (All | Artists | Albums | Songs) -->
                        <controls:LiquidGlassPanel Height="42"
                                                   VerticalAlignment="Center"
                                                   GlassCornerRadius="21"
                                                   GlassPadding="4,3"
                                                   Preset="TabBar"
                                                   SampleLiveBackdrop="True"
                                                   HighlightAlphaMultiplier="0.65">
                            <Grid x:Name="CategorySlicerContainer">
                                <Grid x:Name="CategorySlicerIndicatorHost"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Stretch"
                                      Width="54"
                                      IsHitTestVisible="False">
                                    <Border CornerRadius="18"
                                            Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenActiveSegmentBorderBrush}"
                                            BorderThickness="1" />
                                    <controls:LiquidGlassPanel x:Name="CategorySlicerLiquidGlass"
                                                               GlassCornerRadius="18"
                                                               Preset="TabBarItem"
                                                               SampleLiveBackdrop="True"
                                                               IsDraggableLens="True"
                                                               TintOpacityOverride="0.18"
                                                               HighlightAlphaMultiplier="0.90"
                                                               Opacity="0" />
                                </Grid>

                                <StackPanel x:Name="CategorySlicerButtonsPanel"
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <Button x:Name="CatBtnAll"
                                            x:Uid="Filter_All"
                                            helpers:Loc.Key="Filter_All"
                                            Content="All"
                                            Click="OnCategorySlicerButtonClicked"
                                            Command="{x:Bind ViewModel.SelectCategoryCommand, Mode=OneWay}"
                                            CommandParameter="All"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            CornerRadius="18"
                                            Padding="16,5"
                                            FontSize="12.5" />
                                    <Button x:Name="CatBtnArtists"
                                            x:Uid="Filter_Artists"
                                            helpers:Loc.Key="Filter_Artists"
                                            Content="Artists"
                                            Click="OnCategorySlicerButtonClicked"
                                            Command="{x:Bind ViewModel.SelectCategoryCommand, Mode=OneWay}"
                                            CommandParameter="Artists"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            CornerRadius="18"
                                            Padding="14,5"
                                            FontSize="12.5" />
                                    <Button x:Name="CatBtnAlbums"
                                            x:Uid="Filter_Albums"
                                            helpers:Loc.Key="Filter_Albums"
                                            Content="Albums"
                                            Click="OnCategorySlicerButtonClicked"
                                            Command="{x:Bind ViewModel.SelectCategoryCommand, Mode=OneWay}"
                                            CommandParameter="Albums"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            CornerRadius="18"
                                            Padding="14,5"
                                            FontSize="12.5" />
                                    <Button x:Name="CatBtnSongs"
                                            x:Uid="Filter_Songs"
                                            helpers:Loc.Key="Filter_Songs"
                                            Content="Songs"
                                            Click="OnCategorySlicerButtonClicked"
                                            Command="{x:Bind ViewModel.SelectCategoryCommand, Mode=OneWay}"
                                            CommandParameter="Songs"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            CornerRadius="18"
                                            Padding="14,5"
                                            FontSize="12.5" />
                                </StackPanel>
                            </Grid>
                        </controls:LiquidGlassPanel>

                        <!-- Source Filter Slicer (Local | Online | All) -->
                        <controls:LiquidGlassPanel Height="42"
                                                   VerticalAlignment="Center"
                                                   GlassCornerRadius="21"
                                                   GlassPadding="4,3"
                                                   Preset="TabBar"
                                                   SampleLiveBackdrop="True"
                                                   HighlightAlphaMultiplier="0.65">
                            <Grid x:Name="SourceSlicerContainer">
                                <Grid x:Name="SourceSlicerIndicatorHost"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Stretch"
                                      Width="62"
                                      IsHitTestVisible="False">
                                    <Border CornerRadius="18"
                                            Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenActiveSegmentBorderBrush}"
                                            BorderThickness="1" />
                                    <controls:LiquidGlassPanel x:Name="SourceSlicerLiquidGlass"
                                                               GlassCornerRadius="18"
                                                               Preset="TabBarItem"
                                                               SampleLiveBackdrop="True"
                                                               IsDraggableLens="True"
                                                               TintOpacityOverride="0.18"
                                                               HighlightAlphaMultiplier="0.90"
                                                               Opacity="0" />
                                </Grid>

                                <StackPanel x:Name="SourceSlicerButtonsPanel"
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <Button x:Name="SrcBtnLocal"
                                            x:Uid="Source_Local"
                                            helpers:Loc.Key="Source_Local"
                                            Content="Local"
                                            Click="OnSourceSlicerButtonClicked"
                                            Command="{x:Bind ViewModel.SelectSourceCommand, Mode=OneWay}"
                                            CommandParameter="Local"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            CornerRadius="18"
                                            Padding="15,5"
                                            FontSize="12.5" />
                                    <Button x:Name="SrcBtnOnline"
                                            x:Uid="Source_Online"
                                            helpers:Loc.Key="Source_Online"
                                            Content="Online"
                                            Click="OnSourceSlicerButtonClicked"
                                            Command="{x:Bind ViewModel.SelectSourceCommand, Mode=OneWay}"
                                            CommandParameter="Online"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            CornerRadius="18"
                                            Padding="15,5"
                                            FontSize="12.5" />
                                    <Button x:Name="SrcBtnAll"
                                            Content="All"
                                            Click="OnSourceSlicerButtonClicked"
                                            Command="{x:Bind ViewModel.SelectSourceCommand, Mode=OneWay}"
                                            CommandParameter="All"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            CornerRadius="18"
                                            Padding="15,5"
                                            FontSize="12.5" />
                                </StackPanel>
                            </Grid>
                        </controls:LiquidGlassPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Floating Right-Side A–Z + '#' Fast-Scroll Index Rail (Layer 2 for Live LiquidGlass Refraction) -->
            <controls:AlphabetIndexRailControl x:Name="LibraryAlphabetRail"
                                               Grid.Column="0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Stretch"
                                               Margin="0,152,6,18"
                                               Visibility="{x:Bind ViewModel.LibraryAlphabetRailVisibility, Mode=OneWay}"
                                               LetterSelected="OnLibraryAlphabetLetterSelected" />
        </Grid>

        <!-- ================================================================================= -->
        <!-- LAYER 1.5B: LIKED SONGS FLOATING OVERLAYS (Sticky Header + Slicers + A–Z/# Rail)  -->
        <!-- Mirrors LibraryFloatingOverlayGrid so LiquidGlassPanels sample live scrolling!    -->
        <!-- ================================================================================= -->
        <Grid x:Name="LikedFloatingOverlayGrid"
              Visibility="{x:Bind ViewModel.LikedViewVisibility, Mode=OneWay}"
              Padding="12,0,0,0"
              ColumnSpacing="16"
              Canvas.ZIndex="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="LikedOverlayRightSidebarColumn" Width="324" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="LikedStickyHeaderOverlay"
                  Grid.Column="0"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Stretch"
                  Margin="-12,0,0,0">

                <!-- Scroll-Activated Top Gradient Scrim -->
                <Border x:Name="LikedHeaderScrimBorder"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.16" />
                    </Border.OpacityTransition>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E60D0F14" Offset="0.0" />
                            <GradientStop Color="#C40D0F14" Offset="0.62" />
                            <GradientStop Color="#660D0F14" Offset="0.86" />
                            <GradientStop Color="#000D0F14" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Padding="34,68,24,18" Spacing="12">
                    <!-- Row 1: 44x44 Ruby Heart Badge + "Liked Songs" + Stats Subtitle -->
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="44"
                                Height="44"
                                CornerRadius="16"
                                Background="#28FF2D55"
                                BorderBrush="#55FF2D55"
                                BorderThickness="1.2"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEB52;"
                                      FontSize="19"
                                      Foreground="#FFFF2D55"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Liked Songs"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       CharacterSpacing="-16"
                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.LikedStatsSubtitle, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                       FontSize="12.5"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Row 2: Stacked Left-Aligned Library-Style LiquidGlass Slicers (Songs|Artists|Albums + A–Z|Recent) -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <!-- Category Filter Slicer: Songs | Artists | Albums -->
                        <controls:LiquidGlassPanel Height="42"
                                                   VerticalAlignment="Center"
                                                   GlassCornerRadius="21"
                                                   GlassPadding="4,3"
                                                   Preset="TabBar"
                                                   SampleLiveBackdrop="True"
                                                   HighlightAlphaMultiplier="0.65">
                            <Grid x:Name="LikedFilterSlicerContainer"
                                  SizeChanged="OnLikedSlicerContainerSizeChanged">
                                <Grid x:Name="LikedFilterSlicerIndicatorHost"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Stretch"
                                      Width="68"
                                      IsHitTestVisible="False">
                                    <Border CornerRadius="18"
                                            Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenActiveSegmentBorderBrush}"
                                            BorderThickness="1" />
                                    <controls:LiquidGlassPanel x:Name="LikedFilterSlicerLiquidGlass"
                                                               GlassCornerRadius="18"
                                                               Preset="TabBarItem"
                                                               SampleLiveBackdrop="True"
                                                               IsDraggableLens="True"
                                                               TintOpacityOverride="0.18"
                                                               HighlightAlphaMultiplier="0.90"
                                                               Opacity="0" />
                                </Grid>

                                <StackPanel x:Name="LikedFilterSlicerButtonsPanel"
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <Button x:Name="LikedBtnFilterSongs"
                                            Content="Songs"
                                            Click="OnLikedFilterSlicerButtonClicked"
                                            Command="{x:Bind ViewModel.SelectLikedFilterCommand, Mode=OneWay}"
                                            CommandParameter="Songs"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            CornerRadius="18"
                                            Padding="15,5"
                                            FontSize="12.5" />
                                    <Button x:Name="LikedBtnFilterArtists"
                                            Content="Artists"
                                            Click="OnLikedFilterSlicerButtonClicked"
                                            Command="{x:Bind ViewModel.SelectLikedFilterCommand, Mode=OneWay}"
                                            CommandParameter="Artists"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            CornerRadius="18"
                                            Padding="15,5"
                                            FontSize="12.5" />
                                    <Button x:Name="LikedBtnFilterAlbums"
                                            Content="Albums"
                                            Click="OnLikedFilterSlicerButtonClicked"
                                            Command="{x:Bind ViewModel.SelectLikedFilterCommand, Mode=OneWay}"
                                            CommandParameter="Albums"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            CornerRadius="18"
                                            Padding="15,5"
                                            FontSize="12.5" />
                                </StackPanel>
                            </Grid>
                        </controls:LiquidGlassPanel>

                        <!-- Sort Order Slicer: A–Z (FIRST) | Recent (SECOND) -->
                        <controls:LiquidGlassPanel Height="42"
                                                   VerticalAlignment="Center"
                                                   GlassCornerRadius="21"
                                                   GlassPadding="4,3"
                                                   Preset="TabBar"
                                                   SampleLiveBackdrop="True"
                                                   HighlightAlphaMultiplier="0.65"
                                                   Visibility="{x:Bind ViewModel.HasLikedSongsVisibility, Mode=OneWay}">
                            <Grid x:Name="LikedSortSlicerContainer"
                                  SizeChanged="OnLikedSlicerContainerSizeChanged">
                                <Grid x:Name="LikedSortSlicerIndicatorHost"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Stretch"
                                      Width="58"
                                      IsHitTestVisible="False">
                                    <Border CornerRadius="18"
                                            Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                                            BorderBrush="{ThemeResource TokenActiveSegmentBorderBrush}"
                                            BorderThickness="1" />
                                    <controls:LiquidGlassPanel x:Name="LikedSortSlicerLiquidGlass"
                                                               GlassCornerRadius="18"
                                                               Preset="TabBarItem"
                                                               SampleLiveBackdrop="True"
                                                               IsDraggableLens="True"
                                                               TintOpacityOverride="0.18"
                                                               HighlightAlphaMultiplier="0.90"
                                                               Opacity="0" />
                                </Grid>

                                <StackPanel x:Name="LikedSortSlicerButtonsPanel"
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <Button x:Name="LikedBtnSortAlpha"
                                            Content="A–Z"
                                            Click="OnLikedSortSlicerButtonClicked"
                                            Command="{x:Bind ViewModel.SelectLikedSortCommand, Mode=OneWay}"
                                            CommandParameter="Alphabetical"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            CornerRadius="18"
                                            Padding="15,5"
                                            FontSize="12.5" />
                                    <Button x:Name="LikedBtnSortRecent"
                                            Content="Recent"
                                            Click="OnLikedSortSlicerButtonClicked"
                                            Command="{x:Bind ViewModel.SelectLikedSortCommand, Mode=OneWay}"
                                            CommandParameter="Recent"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            CornerRadius="18"
                                            Padding="15,5"
                                            FontSize="12.5" />
                                </StackPanel>
                            </Grid>
                        </controls:LiquidGlassPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Mirrored Split Overlay Grid for Floating Liked A–Z/# Rail (Between Songs & Recs on 2-Col Songs tab, Far Right on Artists/Albums/Narrow) -->
            <Grid x:Name="LikedAlphabetRailOverlayGrid"
                  Grid.Column="0"
                  Margin="10,192,14,18"
                  ColumnSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58*" />
                    <ColumnDefinition Width="42*" />
                </Grid.ColumnDefinitions>
                <controls:AlphabetIndexRailControl x:Name="LikedAlphabetRail"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="1"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Stretch"
                                                   Margin="0,0,-8,0"
                                                   Visibility="{x:Bind ViewModel.LikedAlphabetRailVisibility, Mode=OneWay}"
                                                   LetterSelected="OnLikedAlphabetLetterSelected" />
            </Grid>
        </Grid>

        <!-- ================================================================================= -->
        <!-- LAYER 2: FLOATING LIQUID GLASS TOP HEADER BAR (Overlays CatalogScrollViewer)      -->
        <!-- Because this layer sits above MainWorkspaceContainer with SampleLiveBackdrop=True,-->
        <!-- scrolling songs pass directly behind these buttons and refract in real time!      -->
        <!-- ================================================================================= -->
        <Grid x:Name="FloatingTopHeaderOverlay"
              VerticalAlignment="Top"
              Padding="22,12,0,0"
              ColumnSpacing="16"
              Canvas.ZIndex="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="HeaderRightSidebarColumn" Width="324" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Height="52" ColumnSpacing="10" Margin="0,0,14,0">
                <Grid.ColumnDefinitions>
                    <!-- 0: Brand Pill -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 1: NavBar LiquidGlass Capsule (Home | Library | Liked | Playlists) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 2: Search Button / Expanding Inline LiquidGlass Search Bar -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 3: Flexible Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- 4: Floating Mini Player with Perimeter Progress Border & Jelly Scrubbing -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 5: Far-Right Settings Circular Button ONLY -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. Brand Pill (Xperience Player with Real Round App Icon Asset) -->
                <controls:LiquidGlassPanel Grid.Column="0"
                                           Height="46"
                                           VerticalAlignment="Center"
                                           GlassCornerRadius="23"
                                           GlassPadding="0"
                                           SampleLiveBackdrop="True"
                                           EnableHoverScale="True"
                                           HighlightAlphaMultiplier="0.65">
                    <Button Command="{x:Bind ViewModel.SelectSectionCommand, Mode=OneWay}"
                            CommandParameter="Home"
                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                            CornerRadius="23"
                            Padding="14,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="24" Height="24"
                                    CornerRadius="12"
                                    VerticalAlignment="Center">
                                <Image helpers:BitmapDecodeHelper.DecodeWidth="48" helpers:BitmapDecodeHelper.SourceUri="ms-appx:///Assets/Branding/xperience_icon_round_512.png"
                                       Width="24" Height="24"
                                       Stretch="UniformToFill" />
                            </Border>
                            <TextBlock x:Uid="AppTitle"
                                       helpers:Loc.Key="AppTitle"
                                       Text="Xperience Player"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </controls:LiquidGlassPanel>

                <!-- 2. Navigation Capsule (Home | Library | Liked | Playlists — 4 Tabs with Animated LiquidGlass Slicer) -->
                <controls:LiquidGlassPanel Grid.Column="1"
                                           Height="46"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           GlassCornerRadius="23"
                                           Preset="TabBar"
                                           SampleLiveBackdrop="True"
                                           HighlightAlphaMultiplier="0.65"
                                           GlassPadding="4,3">
                    <Grid x:Name="NavSlicerContainer"
                          Loaded="OnNavSlicerContainerLoaded"
                          SizeChanged="OnNavSlicerContainerSizeChanged">
                        <!-- Sliding Pill Indicator + Moving LiquidGlass Overlay (Hidden on non-tab views like Search/Settings/Artist/Album) -->
                        <Grid x:Name="NavSlicerIndicatorHost"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"
                              Width="0"
                              IsHitTestVisible="False">
                            <Border CornerRadius="19"
                                    Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                                    BorderBrush="{ThemeResource TokenActiveSegmentBorderBrush}"
                                    BorderThickness="1" />
                            <controls:LiquidGlassPanel x:Name="NavSlicerLiquidGlass"
                                                       GlassCornerRadius="19"
                                                       Preset="TabBarItem"
                                                       SampleLiveBackdrop="True"
                                                       IsDraggableLens="True"
                                                       TintOpacityOverride="0.18"
                                                       HighlightAlphaMultiplier="0.90"
                                                       Opacity="0" />
                        </Grid>

                        <StackPanel x:Name="NavSlicerButtonsPanel"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Left"
                                    SizeChanged="OnNavSlicerContainerSizeChanged">
                            <Button x:Name="NavBtnHome"
                                    Click="OnNavSlicerButtonClicked"
                                    Command="{x:Bind ViewModel.SelectSectionCommand, Mode=OneWay}"
                                    CommandParameter="Home"
                                    Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                    CornerRadius="19"
                                    Padding="13,7"
                                    FontSize="13"
                                    ToolTipService.ToolTip="Home">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE80F;" FontSize="13.5" />
                                    <TextBlock x:Name="NavTxtHome" helpers:Loc.Key="Nav_Home" Text="Home" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnLibrary"
                                    Click="OnNavSlicerButtonClicked"
                                    Command="{x:Bind ViewModel.SelectSectionCommand, Mode=OneWay}"
                                    CommandParameter="Library"
                                    Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                    CornerRadius="19"
                                    Padding="13,7"
                                    FontSize="13"
                                    ToolTipService.ToolTip="Library">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="13.5" />
                                    <TextBlock x:Name="NavTxtLibrary" helpers:Loc.Key="Nav_Library" Text="Library" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnLiked"
                                    Click="OnNavSlicerButtonClicked"
                                    Command="{x:Bind ViewModel.SelectSectionCommand, Mode=OneWay}"
                                    CommandParameter="Liked"
                                    Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                    CornerRadius="19"
                                    Padding="13,7"
                                    FontSize="13"
                                    ToolTipService.ToolTip="Liked Songs">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEB51;" FontSize="13.5" />
                                    <TextBlock x:Name="NavTxtLiked" helpers:Loc.Key="Nav_Liked" Text="Liked" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnPlaylists"
                                    Click="OnNavSlicerButtonClicked"
                                    Command="{x:Bind ViewModel.SelectSectionCommand, Mode=OneWay}"
                                    CommandParameter="Playlists"
                                    Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                    CornerRadius="19"
                                    Padding="13,7"
                                    FontSize="13"
                                    ToolTipService.ToolTip="Playlists">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE90B;" FontSize="13.5" />
                                    <TextBlock x:Name="NavTxtPlaylists" helpers:Loc.Key="Nav_Playlists" Text="Playlists" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </controls:LiquidGlassPanel>

                <!-- 3. Search Button / Expanding Inline LiquidGlass Search Bar (Directly to the RIGHT of NavBar) -->
                <controls:LiquidGlassPanel x:Name="SearchCapsulePanel"
                                           Grid.Column="2"
                                           Width="46" Height="46"
                                           VerticalAlignment="Center"
                                           GlassCornerRadius="23"
                                           SampleLiveBackdrop="True"
                                           EnableHoverScale="True"
                                           HighlightAlphaMultiplier="0.65">
                    <Grid>
                        <!-- Left Search Icon Button (Primary ink when collapsed, Vibrant Accent when expanded) -->
                        <Button x:Uid="SearchButton"
                                helpers:Loc.ToolTipKey="SearchButton_Tooltip"
                                Command="{x:Bind ViewModel.OpenSearchPageCommand, Mode=OneWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                Width="44" Height="46"
                                CornerRadius="23"
                                HorizontalAlignment="Left"
                                Padding="0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon x:Name="HeaderSearchIconIdle"
                                          Glyph="&#xE721;"
                                          FontSize="16"
                                          Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                          Opacity="1">
                                    <FontIcon.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.18" />
                                    </FontIcon.OpacityTransition>
                                </FontIcon>
                                <FontIcon x:Name="HeaderSearchIconActive"
                                          Glyph="&#xE721;"
                                          FontSize="16"
                                          Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                          Opacity="0">
                                    <FontIcon.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.18" />
                                    </FontIcon.OpacityTransition>
                                </FontIcon>
                            </Grid>
                        </Button>

                        <!-- Expanded Inline Search Input + Cycling Placeholder + Globe/Local Toggle + X Close/Clear -->
                        <Grid x:Name="HeaderSearchExpandedHost"
                              Margin="38,0,6,0"
                              Opacity="0"
                              IsHitTestVisible="False">
                            <Grid.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.16" />
                            </Grid.OpacityTransition>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Cycling Placeholder Text Overlay (Visible while empty/idle) -->
                            <TextBlock x:Name="SearchCyclingPlaceholderText"
                                       Grid.Column="0"
                                       Text="Search songs, albums, artists..."
                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                       FontSize="13"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,4,0"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Opacity="0.88">
                                <TextBlock.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.42" />
                                </TextBlock.OpacityTransition>
                            </TextBlock>

                            <TextBox x:Name="HeaderSearchTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource LiquidGlassSearchTextBoxStyle}"
                                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText=""
                                     VerticalAlignment="Center"
                                     Padding="6,6,4,6"
                                     KeyDown="OnHeaderSearchTextBoxKeyDown" />

                            <!-- Globe / Folder Search Scope Toggle Button -->
                            <Button x:Name="HeaderSearchSourceToggleButton"
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.ToggleSearchSourceCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SearchSourceTooltip, Mode=OneWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="32" Height="32"
                                    CornerRadius="16"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    helpers:MicroInteractions.HoverScale="1.14"
                                    helpers:MicroInteractions.PressScale="0.88">
                                <FontIcon Glyph="{x:Bind ViewModel.SearchSourceGlyph, Mode=OneWay}"
                                          FontSize="14.5"
                                          Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                          Opacity="0.88" />
                            </Button>

                            <!-- Clear Query or Close Search Page 'X' Button -->
                            <Button x:Name="HeaderSearchClearOrCloseButton"
                                    Grid.Column="2"
                                    Command="{x:Bind ViewModel.ClearOrCloseSearchCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SearchClearOrCloseTooltip, Mode=OneWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="32" Height="32"
                                    CornerRadius="16"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    helpers:MicroInteractions.HoverScale="1.14"
                                    helpers:MicroInteractions.PressScale="0.88">
                                <FontIcon Glyph="&#xE711;"
                                          FontSize="12.5"
                                          Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                          Opacity="0.88" />
                            </Button>
                        </Grid>
                    </Grid>
                </controls:LiquidGlassPanel>

                <!-- 4. Floating Mini Player with Perimeter Progress Border, Loading Sweep, Jelly Scrubbing & Click-to-Open Sidebar -->
                <controls:MiniPlayerProgressBorderControl x:Name="MiniPlayerBorderHost"
                                                          Grid.Column="4"
                                                          Width="264"
                                                          Height="46"
                                                          VerticalAlignment="Center"
                                                          PillCornerRadius="23"
                                                          IsLoading="{x:Bind ViewModel.IsTrackLoading, Mode=OneWay}"
                                                          CanSeek="{x:Bind ViewModel.CanSeekCurrentTrack, Mode=OneWay}"
                                                          Visibility="{x:Bind ViewModel.MiniPlayerHeaderVisibility, Mode=OneWay}"
                                                          Clicked="OnMiniPlayerClicked"
                                                          SeekRequested="OnMiniPlayerSeekRequested"
                                                          ToolTipService.ToolTip="Click to open Now Playing · Drag to scrub">
                    <controls:LiquidGlassPanel GlassCornerRadius="23"
                                               SampleLiveBackdrop="True"
                                               GlassPadding="6,4,8,4"
                                               EnableHoverScale="False"
                                               HighlightAlphaMultiplier="0.65">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Rounded-Square Track Thumbnail (<Image> only, ZERO ImageBrush) -->
                            <Border Grid.Column="0"
                                    Width="34" Height="34"
                                    CornerRadius="9"
                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                    BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                    BorderThickness="0.8"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid Opacity="{x:Bind ViewModel.CurrentTrack.DefaultCoverIconOpacity, Mode=OneWay}">
                                        <FontIcon Glyph="&#xEC4F;"
                                                  FontSize="13.5"
                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                    <Border CornerRadius="8.5"
                                            Opacity="{x:Bind ViewModel.CurrentTrack.CoverArtOpacity, Mode=OneWay}">
                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentTrack.SafeCoverArtUri, Mode=OneWay}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Track Title & Subtitle -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="1">
                                <Grid HorizontalAlignment="Left" ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay}"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <controls:ExplicitBadgeControl Grid.Column="1"
                                                                   IsCompact="True"
                                                                   Visibility="{x:Bind ViewModel.CurrentTrack.IsExplicit, Mode=OneWay}"
                                                                   VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.CurrentTrack.ArtistAlbumSubtitle, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                           FontSize="9.5"
                                           Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Mini Transport Controls (Click events excluded from MiniPlayer body click) -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="1"
                                        VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.PreviousTrackCommand, Mode=OneWay}"
                                        Background="Transparent" BorderThickness="0" Padding="4"
                                        helpers:MicroInteractions.HoverScale="1.18"
                                        helpers:MicroInteractions.PressScale="0.86">
                                    <FontIcon Glyph="&#xE892;" FontSize="10.5" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.TogglePlayPauseCommand, Mode=OneWay}"
                                        Background="Transparent" BorderThickness="0" Padding="4"
                                        helpers:MicroInteractions.HoverScale="1.18"
                                        helpers:MicroInteractions.PressScale="0.86">
                                    <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                </Button>
                                <Button Command="{x:Bind ViewModel.NextTrackCommand, Mode=OneWay}"
                                        Background="Transparent" BorderThickness="0" Padding="4"
                                        helpers:MicroInteractions.HoverScale="1.18"
                                        helpers:MicroInteractions.PressScale="0.86">
                                    <FontIcon Glyph="&#xE893;" FontSize="10.5" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </controls:LiquidGlassPanel>
                </controls:MiniPlayerProgressBorderControl>

                <!-- 5. Far-Right Circular Liquid Glass Settings Button ONLY (Now Playing Sidebar Toggle Removed) -->
                <controls:LiquidGlassPanel Grid.Column="5"
                                           Width="46" Height="46"
                                           VerticalAlignment="Center"
                                           GlassCornerRadius="23"
                                           SampleLiveBackdrop="True"
                                           EnableHoverScale="True">
                    <Button x:Uid="SettingsButton"
                            helpers:Loc.ToolTipKey="SettingsButton_Tooltip"
                            Command="{x:Bind ViewModel.ToggleSettingsStudioCommand, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="46" Height="46"
                            CornerRadius="23"
                            Padding="0">
                        <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                    </Button>
                </controls:LiquidGlassPanel>
            </Grid>
        </Grid>

        <!-- ================================================================================= -->
        <!-- OVERLAY 1: DRAGGABLE OPTICAL LIQUID GLASS LENS (Snell Bezel + Chromatic Dispersion)-->
        <!-- ================================================================================= -->
        <Canvas x:Name="DraggableLensCanvas"
                Visibility="{x:Bind ViewModel.DraggableLensVisibility, Mode=OneWay}">
            <controls:LiquidGlassPanel Canvas.Left="240"
                                       Canvas.Top="165"
                                       Width="340"
                                       Height="205"
                                       GlassCornerRadius="32"
                                       GlassPadding="20"
                                       SampleLiveBackdrop="True"
                                       IsDraggableLens="True">
                <Grid>
                    <StackPanel VerticalAlignment="Top" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                    BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="7,2">
                                <TextBlock Text="n = 1.52"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                            </Border>
                            <TextBlock Text="Optical Liquid Glass Lens"
                                       FontSize="15.5"
                                       FontWeight="Bold"
                                       Foreground="White" />
                        </StackPanel>
                        <TextBlock Text="Drag over albums &amp; text • Squircle Snell Bezel Refraction + Chromatic Dispersion + 3D Meniscus"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="#D8FFFFFF" />
                    </StackPanel>

                    <Border VerticalAlignment="Bottom"
                            HorizontalAlignment="Left"
                            Background="#24FFFFFF"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4">
                        <TextBlock Text="Click or drag anywhere on this lens"
                                   FontSize="10.5"
                                   Foreground="#CCFFFFFF" />
                    </Border>

                    <Button Command="{x:Bind ViewModel.ToggleDraggableLensCommand, Mode=OneWay}"
                            Style="{StaticResource GlassCircleIconButtonStyle}"
                            Width="28" Height="28" CornerRadius="14"
                            helpers:MicroInteractions.HoverScale="1.15"
                            helpers:MicroInteractions.PressScale="0.88"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="White" />
                    </Button>
                </Grid>
            </controls:LiquidGlassPanel>
        </Canvas>

        <!-- ================================================================================= -->
        <!-- OVERLAY 2: FLOATING OPTICAL LIQUID GLASS STUDIO (Live Backdrop Snell Refraction)  -->
        <!-- ================================================================================= -->
        <Canvas x:Name="SettingsStudioCanvas"
                Visibility="{x:Bind ViewModel.SettingsStudioVisibility, Mode=OneWay}">
            <controls:LiquidGlassPanel Canvas.Left="460"
                                       Canvas.Top="64"
                                       Width="464"
                                       MaxHeight="605"
                                       GlassCornerRadius="30"
                                       GlassPadding="22,18"
                                       SampleLiveBackdrop="True"
                                       IsDraggableLens="True">
                <ScrollViewer Style="{StaticResource LiquidGlassScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <!-- Studio Header (Draggable Handle) -->
                        <Grid>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock helpers:Loc.Key="Settings_Title"
                                           Text="Experience &amp; Liquid Glass Studio"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                <TextBlock Text="Drag panel to inspect live Snell bezel refraction over UI"
                                           FontSize="10.5"
                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                            </StackPanel>
                            <Button Command="{x:Bind ViewModel.ToggleSettingsStudioCommand, Mode=OneWay}"
                                     Style="{StaticResource GlassCircleIconButtonStyle}"
                                     Width="32" Height="32" CornerRadius="16"
                                     helpers:MicroInteractions.HoverScale="1.14"
                                     helpers:MicroInteractions.PressScale="0.88"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                            </Button>
                        </Grid>

                        <!-- 1. Dynamic Album Cover Accent & Manual Color Swatches -->
                        <Border Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                                BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="12,10">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Dynamic Album Cover Accent"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                            <Border Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="6,1">
                                                <TextBlock Text="{x:Bind ViewModel.ActiveAccentColorHex, Mode=OneWay}"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Automatically adapts UI accent to the active song's cover art, or pick a manual color below"
                                                   FontSize="10.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="1"
                                                  IsOn="{x:Bind ViewModel.IsDynamicCoverAccentEnabled, Mode=TwoWay}"
                                                  OnContent="Auto"
                                                  OffContent="Manual"
                                                  MinWidth="0"
                                                  VerticalAlignment="Center" />
                                </Grid>

                                <!-- Manual Custom Color Swatches Row -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                            CommandParameter="#FF2DD4BF"
                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                            Background="#FF2DD4BF" BorderBrush="#99FFFFFF" BorderThickness="1.5"
                                            ToolTipService.ToolTip="Turquoise Glass (Default)"
                                            helpers:MicroInteractions.HoverScale="1.18"
                                            helpers:MicroInteractions.PressScale="0.88" />
                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                            CommandParameter="#FFA855F7"
                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                            Background="#FFA855F7" BorderBrush="#99FFFFFF" BorderThickness="1.5"
                                            ToolTipService.ToolTip="Electric Violet"
                                            helpers:MicroInteractions.HoverScale="1.18"
                                            helpers:MicroInteractions.PressScale="0.88" />
                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                            CommandParameter="#FFF43F5E"
                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                            Background="#FFF43F5E" BorderBrush="#99FFFFFF" BorderThickness="1.5"
                                            ToolTipService.ToolTip="Rose Neon"
                                            helpers:MicroInteractions.HoverScale="1.18"
                                            helpers:MicroInteractions.PressScale="0.88" />
                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                            CommandParameter="#FFF59E0B"
                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                            Background="#FFF59E0B" BorderBrush="#99FFFFFF" BorderThickness="1.5"
                                            ToolTipService.ToolTip="Amber Gold"
                                            helpers:MicroInteractions.HoverScale="1.18"
                                            helpers:MicroInteractions.PressScale="0.88" />
                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                            CommandParameter="#FF38BDF8"
                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                            Background="#FF38BDF8" BorderBrush="#99FFFFFF" BorderThickness="1.5"
                                            ToolTipService.ToolTip="Ocean Cyan"
                                            helpers:MicroInteractions.HoverScale="1.18"
                                            helpers:MicroInteractions.PressScale="0.88" />
                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                            CommandParameter="#FF10B981"
                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                            Background="#FF10B981" BorderBrush="#99FFFFFF" BorderThickness="1.5"
                                            ToolTipService.ToolTip="Emerald Mint"
                                            helpers:MicroInteractions.HoverScale="1.18"
                                            helpers:MicroInteractions.PressScale="0.88" />
                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                            CommandParameter="#FFFF6B6B"
                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                            Background="#FFFF6B6B" BorderBrush="#99FFFFFF" BorderThickness="1.5"
                                            ToolTipService.ToolTip="Coral Sunset"
                                            helpers:MicroInteractions.HoverScale="1.18"
                                            helpers:MicroInteractions.PressScale="0.88" />
                                    <Button Command="{x:Bind ViewModel.SelectManualAccentColorCommand, Mode=OneWay}"
                                            CommandParameter="#FF6366F1"
                                            Width="28" Height="28" CornerRadius="14" Padding="0"
                                            Background="#FF6366F1" BorderBrush="#99FFFFFF" BorderThickness="1.5"
                                            ToolTipService.ToolTip="Royal Indigo"
                                            helpers:MicroInteractions.HoverScale="1.18"
                                            helpers:MicroInteractions.PressScale="0.88" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 1B. Apple Music Canvas (Animated Album Cover Artwork) -->
                        <Border Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Apple Music Canvas (Animated Covers)"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    <TextBlock Text="Automatically detects and loops Apple Music Editorial Motion Covers (plus EchoMusic &amp; ViviMusic Canvas fallbacks)"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.IsAppleMusicCanvasEnabled, Mode=TwoWay}"
                                              OnContent="Active"
                                              OffContent="Off"
                                              MinWidth="0"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 2. Online Lyrics Providers Priority (YouLyPlus, Paxsenix, Better Lyrics, LRCLIB, KuGou, SimpMusic) -->
                        <Border Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14,12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Online Lyrics Providers Priority"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="13.5"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="Order of cascade for synchronized letter-by-letter &amp; LRC lyrics (YouTube Music &amp; Local)"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            CornerRadius="10"
                                            Padding="8,3"
                                            VerticalAlignment="Top"
                                            Background="#24FFFFFF"
                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentLyricsProviderBadge, Mode=OneWay}"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.LyricsProviders, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LyricsProviderConfig">
                                            <Border Background="#1E000000"
                                                    BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="10,6"
                                                    Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            CornerRadius="8"
                                                            Padding="4,2"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                            BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{x:Bind PriorityLabel, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                   HorizontalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                        <TextBlock Text="{x:Bind CapabilityBadge, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="10"
                                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                                    </StackPanel>

                                                    <Button Grid.Column="2"
                                                            Click="OnToggleLyricsProviderClicked"
                                                            Tag="{x:Bind}"
                                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                                            BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                            Padding="8,3"
                                                            CornerRadius="10"
                                                            FontSize="10.5"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                    </Button>

                                                    <StackPanel Grid.Column="3"
                                                                Orientation="Horizontal"
                                                                Spacing="4"
                                                                VerticalAlignment="Center">
                                                        <Button Click="OnMoveLyricsProviderUpClicked"
                                                                Tag="{x:Bind}"
                                                                Style="{StaticResource GlassCircleIconButtonStyle}"
                                                                Width="26" Height="26" CornerRadius="13"
                                                                Padding="0"
                                                                ToolTipService.ToolTip="Move Provider Higher in Priority">
                                                            <FontIcon Glyph="&#xE74A;" FontSize="10" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                        </Button>
                                                        <Button Click="OnMoveLyricsProviderDownClicked"
                                                                Tag="{x:Bind}"
                                                                Style="{StaticResource GlassCircleIconButtonStyle}"
                                                                Width="26" Height="26" CornerRadius="13"
                                                                Padding="0"
                                                                ToolTipService.ToolTip="Move Provider Lower in Priority">
                                                            <FontIcon Glyph="&#xE74B;" FontSize="10" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 2B. Mornye FLAC Lossless & YouTube Music MP3 Downloader + Offline Metadata/Canvas Settings -->
                        <Border Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                                BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="14,12">
                            <StackPanel Spacing="9">
                                <Grid>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Downloads &amp; Offline Metadata (Mornye FLAC + YT Music)"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                   FontSize="10.5"
                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <!-- Default Download Quality Selector -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Default Download Quality"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="FLAC Lossless (Mornye)"
                                                Command="{x:Bind ViewModel.SelectDownloadFormatCommand, Mode=OneWay}"
                                                CommandParameter="FLAC"
                                                Style="{x:Bind GetSegmentButtonStyle(ViewModel.IsDownloadFormatFlac), Mode=OneWay}"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="12"
                                                Padding="8,5"
                                                FontSize="11" />
                                        <Button Grid.Column="1"
                                                Content="MP3 320kbps (YT Music)"
                                                Command="{x:Bind ViewModel.SelectDownloadFormatCommand, Mode=OneWay}"
                                                CommandParameter="MP3"
                                                Style="{x:Bind GetSegmentButtonStyle(ViewModel.IsDownloadFormatMp3), Mode=OneWay}"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="12"
                                                Padding="8,5"
                                                FontSize="11" />
                                        <Button Grid.Column="2"
                                                Content="M4A"
                                                Command="{x:Bind ViewModel.SelectDownloadFormatCommand, Mode=OneWay}"
                                                CommandParameter="M4A"
                                                Style="{x:Bind GetSegmentButtonStyle(ViewModel.IsDownloadFormatM4a), Mode=OneWay}"
                                                CornerRadius="12"
                                                Padding="10,5"
                                                FontSize="11" />
                                    </Grid>
                                </StackPanel>

                                <!-- Download Folder Picker -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind ViewModel.DownloadTargetDirectory, Mode=OneWay}"
                                               FontSize="10.5"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Content="Change Folder..."
                                            Command="{x:Bind ViewModel.PickDownloadDirectoryCommand, Mode=OneWay}"
                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                            BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                            CornerRadius="10"
                                            Padding="10,4"
                                            FontSize="10.5" />
                                </Grid>

                                <!-- Manual Metadata, Lyrics & Apple Canvas Toggles -->
                                <TextBlock Text="Included Metadata, Lyrics &amp; Offline Apple Canvas"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                           Margin="0,2,0,0" />

                                <Grid ColumnSpacing="8" RowSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox Grid.Row="0" Grid.Column="0"
                                              Content="Title &amp; Artist"
                                              IsChecked="{x:Bind ViewModel.DownloadIncludeTitleAndArtist, Mode=TwoWay}"
                                              FontSize="11" MinWidth="0" />
                                    <CheckBox Grid.Row="0" Grid.Column="1"
                                              Content="Album &amp; Track #"
                                              IsChecked="{x:Bind ViewModel.DownloadIncludeAlbumAndTrackNumber, Mode=TwoWay}"
                                              FontSize="11" MinWidth="0" />

                                    <CheckBox Grid.Row="1" Grid.Column="0"
                                              Content="1280px Cover Art"
                                              IsChecked="{x:Bind ViewModel.DownloadIncludeHighResCoverArt, Mode=TwoWay}"
                                              FontSize="11" MinWidth="0" />
                                    <CheckBox Grid.Row="1" Grid.Column="1"
                                              Content="Genre &amp; Year"
                                              IsChecked="{x:Bind ViewModel.DownloadIncludeGenreAndReleaseYear, Mode=TwoWay}"
                                              FontSize="11" MinWidth="0" />

                                    <CheckBox Grid.Row="2" Grid.Column="0"
                                              Content="ISRC &amp; Copyright"
                                              IsChecked="{x:Bind ViewModel.DownloadIncludeIsrcAndCopyright, Mode=TwoWay}"
                                              FontSize="11" MinWidth="0" />
                                    <CheckBox Grid.Row="2" Grid.Column="1"
                                              Content="ReplayGain Tag"
                                              IsChecked="{x:Bind ViewModel.DownloadIncludeReplayGain, Mode=TwoWay}"
                                              FontSize="11" MinWidth="0" />

                                    <CheckBox Grid.Row="3" Grid.Column="0"
                                              Content="Synced Lyrics (.LRC)"
                                              IsChecked="{x:Bind ViewModel.DownloadIncludeSynchronizedLyrics, Mode=TwoWay}"
                                              FontSize="11" MinWidth="0" />
                                    <CheckBox Grid.Row="3" Grid.Column="1"
                                              Content="Static Lyrics"
                                              IsChecked="{x:Bind ViewModel.DownloadIncludeStaticLyrics, Mode=TwoWay}"
                                              FontSize="11" MinWidth="0" />

                                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                              Content="Offline Apple Music Canvas Video (.canvas.mp4)"
                                              IsChecked="{x:Bind ViewModel.DownloadIncludeAppleCanvasOffline, Mode=TwoWay}"
                                              FontSize="11" MinWidth="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Real-Time Language & RTL/LTR Switcher -->
                        <StackPanel Spacing="6">
                            <TextBlock helpers:Loc.Key="Settings_Language"
                                       Text="Language &amp; Flow Direction (Hot-Reload)"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="English (US)"
                                        Command="{x:Bind ViewModel.ChangeLanguageCommand, Mode=OneWay}"
                                        CommandParameter="en-US"
                                        Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                        helpers:MicroInteractions.HoverScale="1.05"
                                        helpers:MicroInteractions.PressScale="0.94"
                                        FontSize="12" Padding="12,6" />
                                <Button Content="Español (ES)"
                                        Command="{x:Bind ViewModel.ChangeLanguageCommand, Mode=OneWay}"
                                        CommandParameter="es-ES"
                                        Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                        helpers:MicroInteractions.HoverScale="1.05"
                                        helpers:MicroInteractions.PressScale="0.94"
                                        FontSize="12" Padding="12,6" />
                                <Button Content="العربية (RTL)"
                                        Command="{x:Bind ViewModel.ChangeLanguageCommand, Mode=OneWay}"
                                        CommandParameter="ar-SA"
                                        Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                        helpers:MicroInteractions.HoverScale="1.05"
                                        helpers:MicroInteractions.PressScale="0.94"
                                        FontSize="12" Padding="12,6" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 3. Dynamic Theme Token Palettes (Dark & Light Mode) -->
                        <StackPanel Spacing="6">
                            <TextBlock helpers:Loc.Key="Settings_Theme"
                                       Text="Theme &amp; Mode (Dark / Light / High Contrast)"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🌙 Dark (Obsidian)"
                                            Command="{x:Bind ViewModel.ApplyThemeCommand, Mode=OneWay}"
                                            CommandParameter="ObsidianLiquidDark"
                                            Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                            helpers:MicroInteractions.HoverScale="1.04"
                                            helpers:MicroInteractions.PressScale="0.95"
                                            HorizontalAlignment="Stretch" FontSize="12" />
                                    <Button Grid.Column="1" Content="☀️ Light (Crystal Daylight)"
                                            Command="{x:Bind ViewModel.ApplyThemeCommand, Mode=OneWay}"
                                            CommandParameter="CrystalDaylight"
                                            Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                            helpers:MicroInteractions.HoverScale="1.04"
                                            helpers:MicroInteractions.PressScale="0.95"
                                            HorizontalAlignment="Stretch" FontSize="12" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Aurora Cyber"
                                            Command="{x:Bind ViewModel.ApplyThemeCommand, Mode=OneWay}"
                                            CommandParameter="NeonAuroraDark"
                                            Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                            helpers:MicroInteractions.HoverScale="1.04"
                                            helpers:MicroInteractions.PressScale="0.95"
                                            HorizontalAlignment="Stretch" FontSize="12" />
                                    <Button Grid.Column="1" Content="High Contrast"
                                            Command="{x:Bind ViewModel.ApplyThemeCommand, Mode=OneWay}"
                                            CommandParameter="HighContrastAccessibility"
                                            Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                            helpers:MicroInteractions.HoverScale="1.04"
                                            helpers:MicroInteractions.PressScale="0.95"
                                            HorizontalAlignment="Stretch" FontSize="12" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- 3. Window Backdrop Material & Performance Mode -->
                        <StackPanel Spacing="6">
                            <TextBlock helpers:Loc.Key="Settings_Backdrop"
                                       Text="Backdrop Material &amp; GPU Mode"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Mica + Glass"
                                        Command="{x:Bind ViewModel.ChangeBackdropCommand, Mode=OneWay}"
                                        CommandParameter="LiquidGlassMica"
                                        Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                        helpers:MicroInteractions.HoverScale="1.05"
                                        helpers:MicroInteractions.PressScale="0.94"
                                        FontSize="11.5" Padding="10,5" />
                                <Button Content="Mica Alt"
                                        Command="{x:Bind ViewModel.ChangeBackdropCommand, Mode=OneWay}"
                                        CommandParameter="MicaAlt"
                                        Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                        helpers:MicroInteractions.HoverScale="1.05"
                                        helpers:MicroInteractions.PressScale="0.94"
                                        FontSize="11.5" Padding="10,5" />
                                <Button Content="Acrylic"
                                        Command="{x:Bind ViewModel.ChangeBackdropCommand, Mode=OneWay}"
                                        CommandParameter="DesktopAcrylic"
                                        Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                        helpers:MicroInteractions.HoverScale="1.05"
                                        helpers:MicroInteractions.PressScale="0.94"
                                        FontSize="11.5" Padding="10,5" />
                                <Button Content="Solid (120FPS)"
                                        Command="{x:Bind ViewModel.ChangeBackdropCommand, Mode=OneWay}"
                                        CommandParameter="SolidPerformance"
                                        Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                        helpers:MicroInteractions.HoverScale="1.05"
                                        helpers:MicroInteractions.PressScale="0.94"
                                        FontSize="11.5" Padding="10,5" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 4. Win2D Optical Liquid Glass Shader Controls -->
                        <StackPanel Spacing="6">
                            <TextBlock helpers:Loc.Key="Settings_LiquidGlass"
                                       Text="Win2D Optical Liquid Glass Shader Controls"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock helpers:Loc.Key="Settings_FrostBlur" Text="Frost Blur Radius" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="30"
                                        Value="{x:Bind ViewModel.FrostBlurRadius, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind FormatPx(ViewModel.FrostBlurRadius), Mode=OneWay}"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock helpers:Loc.Key="Settings_Turbulence" Text="Turbulence Freq" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0.001" Maximum="0.025" StepFrequency="0.001"
                                        Value="{x:Bind ViewModel.TurbulenceFrequency, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind FormatFreq(ViewModel.TurbulenceFrequency), Mode=OneWay}"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock helpers:Loc.Key="Settings_Distortion" Text="Refraction Strength" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="200"
                                        Value="{x:Bind ViewModel.DistortionStrength, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind FormatPx(ViewModel.DistortionStrength), Mode=OneWay}"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock helpers:Loc.Key="Settings_TintOpacity" Text="Glass Tint Opacity" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                        Value="{x:Bind ViewModel.TintOpacityPercent, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind FormatPercent(ViewModel.TintOpacityPercent), Mode=OneWay}"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock helpers:Loc.Key="Settings_SpecularRim" Text="Specular &amp; Meniscus" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                        Value="{x:Bind ViewModel.SpecularRimPercent, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind FormatPercent(ViewModel.SpecularRimPercent), Mode=OneWay}"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- Studio Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button helpers:Loc.Key="Settings_ResetGlass"
                                    Content="Reset Liquid Glass"
                                    Command="{x:Bind ViewModel.ResetLiquidGlassPresetCommand, Mode=OneWay}"
                                    Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                    helpers:MicroInteractions.HoverScale="1.05"
                                    helpers:MicroInteractions.PressScale="0.94"
                                    FontSize="11.5" Padding="11,6" />
                            <Button Content="Toggle Optical Lens"
                                    Command="{x:Bind ViewModel.ToggleDraggableLensCommand, Mode=OneWay}"
                                    Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                    helpers:MicroInteractions.HoverScale="1.05"
                                    helpers:MicroInteractions.PressScale="0.94"
                                    FontSize="11.5" Padding="11,6" />
                            <Button helpers:Loc.Key="Settings_ExportTheme"
                                    Content="Export JSON"
                                    Command="{x:Bind ViewModel.ExportCustomThemeJsonCommand, Mode=OneWay}"
                                    Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                    helpers:MicroInteractions.HoverScale="1.05"
                                    helpers:MicroInteractions.PressScale="0.94"
                                    FontSize="11.5" Padding="11,6" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </controls:LiquidGlassPanel>
        </Canvas>

        <!-- ================================================================================= -->
        <!-- OVERLAY 2B: SONG LIST LIQUID GLASS CONTEXT MENU (Right-Click or '...' Button)     -->
        <!-- Grows with a fluid spring animation from the top-left click point (CenterPoint=0) -->
        <!-- ================================================================================= -->
        <Grid x:Name="TrackContextMenuOverlay"
              x:Load="{x:Bind ViewModel.IsTrackContextMenuOpen, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.TrackContextMenuVisibility, Mode=OneWay}"
              Background="Transparent"
              Tapped="OnContextMenuBackdropTapped"
              RightTapped="OnContextMenuBackdropRightTapped"
              Canvas.ZIndex="52">
            <Canvas x:Name="TrackContextMenuCanvas">
                <Grid x:Name="TrackContextMenuPopupHost"
                      Canvas.Left="240"
                      Canvas.Top="180"
                      Width="236"
                      CenterPoint="0,0,0"
                      Tapped="OnContextMenuCardTapped">
                    <controls:LiquidGlassPanel x:Name="TrackContextMenuGlassPanel"
                                               GlassCornerRadius="26"
                                               GlassPadding="14,14,14,12"
                                               SampleLiveBackdrop="True">
                        <StackPanel Spacing="10">
                            <!-- Top Row: Like & Download Glass Action Tiles -->
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Like Button Tile -->
                                <controls:LiquidGlassPanel Grid.Column="0"
                                                           Height="58"
                                                           GlassCornerRadius="18"
                                                           GlassPadding="0"
                                                           SampleLiveBackdrop="False"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.ContextMenuLikeCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            CornerRadius="18"
                                            Padding="8,6">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind ViewModel.ContextMenuLikeGlyph, Mode=OneWay}"
                                                      FontSize="17"
                                                      Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                      HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ViewModel.ContextMenuLikeLabel, Mode=OneWay}"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </controls:LiquidGlassPanel>

                                <!-- Download Button Tile (Hidden if track is already Local or Downloaded!) -->
                                <controls:LiquidGlassPanel Grid.Column="1"
                                                           Visibility="{x:Bind ViewModel.ContextMenuDownloadVisibility, Mode=OneWay}"
                                                           Height="58"
                                                           GlassCornerRadius="18"
                                                           GlassPadding="0"
                                                           SampleLiveBackdrop="False"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.ContextMenuDownloadCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            CornerRadius="18"
                                            Padding="8,6">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE896;"
                                                      FontSize="17"
                                                      Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                      HorizontalAlignment="Center" />
                                            <TextBlock Text="Download"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </Grid>

                            <!-- Divider Line -->
                            <Border Height="1"
                                    Background="#38FFFFFF"
                                    Margin="2,2,2,2" />

                            <!-- 6 Context Menu Action Rows -->
                            <StackPanel Spacing="3">
                                <!-- 1. Play Next -->
                                <Button Command="{x:Bind ViewModel.ContextMenuPlayNextCommand, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="Play Next"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- 2. Add to Queue -->
                                <Button Command="{x:Bind ViewModel.ContextMenuAddToQueueCommand, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="Add to Queue"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- 3. Add to Playlist -->
                                <Button Command="{x:Bind ViewModel.ContextMenuAddToPlaylistCommand, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE90B;" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="Add to Playlist"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- 4. Go to -ARTIST NAME -->
                                <Button Command="{x:Bind ViewModel.ContextMenuGoToArtistCommand, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ContextMenuGoToArtistLabel, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="168" />
                                    </StackPanel>
                                </Button>

                                <!-- 5. Go to -ALBUM NAME -->
                                <Button Command="{x:Bind ViewModel.ContextMenuGoToAlbumCommand, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xEC4F;" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ContextMenuGoToAlbumLabel, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="168" />
                                    </StackPanel>
                                </Button>

                                <!-- 6. More Information -->
                                <Button Command="{x:Bind ViewModel.ContextMenuMoreInfoCommand, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="More Information"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- Divider Line (Hidden if already Downloaded/Local) -->
                                <Border Height="1"
                                        Visibility="{x:Bind ViewModel.ContextMenuDownloadVisibility, Mode=OneWay}"
                                        Background="#30FFFFFF"
                                        Margin="2,3,2,3" />

                                <!-- 7. Choose Version & Quality (Recommended + Suggestions Modal) -->
                                <Button Command="{x:Bind ViewModel.ContextMenuDownloadCommand, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.ContextMenuDownloadVisibility, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE713;" FontSize="12" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                        <TextBlock Text="Choose Version &amp; Quality..."
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- 8. Download FLAC Lossless (Mornye Multi-Provider) -->
                                <Button Command="{x:Bind ViewModel.ContextMenuDownloadFlacCommand, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.ContextMenuDownloadVisibility, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                        <TextBlock Text="Download FLAC Lossless"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- 9. Download MP3 320kbps (YouTube Music Max Quality) -->
                                <Button Command="{x:Bind ViewModel.ContextMenuDownloadMp3Command, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.ContextMenuDownloadVisibility, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="Download MP3 (320kbps)"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- 10. GPU Music Visualizers (Shown when opened from Fullscreen Now Playing menu) -->
                                <Button Command="{x:Bind ViewModel.ContextMenuOpenVisualizersCommand, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.FullscreenMenuVisualizerItemVisibility, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                        <TextBlock Text="GPU Music Visualizers..."
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- 11. Equalizer (Shown in Fullscreen Now Playing menu) -->
                                <Button Click="OnContextMenuEqualizerClicked"
                                        Visibility="{x:Bind ViewModel.FullscreenMenuVisualizerItemVisibility, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE9E9;" FontSize="12" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                        <TextBlock Text="Equalizer (Bass / Treble)..."
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- 12. Playback Speed & Pitch / Tone (Shown in Fullscreen Now Playing menu) -->
                                <Button Click="OnContextMenuSpeedPitchClicked"
                                        Visibility="{x:Bind ViewModel.FullscreenMenuVisualizerItemVisibility, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xEC57;" FontSize="12" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                        <TextBlock Text="Speed &amp; Pitch..."
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    </StackPanel>
                                </Button>

                                <!-- 13. 1-Click Nightcore Real-Time DSP Mode (Shown in Fullscreen Now Playing menu) -->
                                <Button Command="{x:Bind ViewModel.ContextMenuToggleNightcoreCommand, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.FullscreenMenuVisualizerItemVisibility, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="#FFF472B6" />
                                        <TextBlock Text="{x:Bind ViewModel.NightcoreMenuLabel, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#FFF472B6" />
                                    </StackPanel>
                                </Button>

                                <!-- 14. Visual Music Sleep Timer / Temporizador de música (Shown in Fullscreen Now Playing menu) -->
                                <Button Click="OnContextMenuSleepTimerClicked"
                                        Visibility="{x:Bind ViewModel.FullscreenMenuVisualizerItemVisibility, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        CornerRadius="12"
                                        Padding="10,7"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE916;" FontSize="12" Foreground="#FF38BDF8" />
                                        <TextBlock Text="{x:Bind ViewModel.SleepTimerMenuLabel, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </controls:LiquidGlassPanel>
                </Grid>
            </Canvas>
        </Grid>

        <!-- ================================================================================= -->
        <!-- OVERLAY 2C: TRACK MORE INFORMATION MODAL (LiquidGlass Metadata Inspector)         -->
        <!-- ================================================================================= -->
        <Grid x:Name="TrackInfoModalOverlay"
              x:Load="{x:Bind ViewModel.IsTrackInfoModalOpen, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.TrackInfoModalVisibility, Mode=OneWay}"
              Background="#66000000"
              Tapped="OnTrackInfoModalBackdropTapped"
              Canvas.ZIndex="53">
            <controls:LiquidGlassPanel Width="420"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       GlassCornerRadius="28"
                                       GlassPadding="22,18"
                                       SampleLiveBackdrop="True">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Song Information"
                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <Button Command="{x:Bind ViewModel.CloseTrackInfoModalCommand, Mode=OneWay}"
                                Style="{StaticResource GlassCircleIconButtonStyle}"
                                Width="30" Height="30" CornerRadius="15"
                                HorizontalAlignment="Right">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="76" Height="76"
                                CornerRadius="16"
                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <FontIcon Glyph="&#xEC4F;"
                                          FontSize="26"
                                          Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                <Border CornerRadius="15"
                                        Opacity="{x:Bind ViewModel.ContextMenuTrack.CoverArtOpacity, Mode=OneWay}">
                                    <Border.Background>
                                        <ImageBrush helpers:BitmapDecodeHelper.DecodeWidth="128" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.ContextMenuTrack.SafeCoverArtUri, Mode=OneWay}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{x:Bind ViewModel.ContextMenuTrack.Title, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.ContextMenuTrack.Artist, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenSubheadingFontFamily}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ContextMenuTrack.Album, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                            BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14,10">
                        <TextBlock Text="{x:Bind ViewModel.ContextMenuTrackSourceDetail, Mode=OneWay}"
                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                    </Border>
                </StackPanel>
            </controls:LiquidGlassPanel>
        </Grid>

        <!-- ================================================================================= -->
        <!-- OVERLAY 2D: ADD TO PLAYLIST / CREATE NEW PLAYLIST MODAL (LiquidGlass)             -->
        <!-- Supports selecting an existing playlist OR creating a new playlist with Title,    -->
        <!-- Description, and optional Custom Cover Image (or automatic 2x2 collage).          -->
        <!-- ================================================================================= -->
        <Grid x:Name="AddToPlaylistModalOverlay"
              x:Load="{x:Bind ViewModel.IsAddToPlaylistModalOpen, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.AddToPlaylistModalVisibility, Mode=OneWay}"
              Background="#66000000"
              Tapped="OnAddToPlaylistModalBackdropTapped"
              Canvas.ZIndex="54">
            <controls:LiquidGlassPanel Width="448"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       GlassCornerRadius="28"
                                       GlassPadding="22,18"
                                       SampleLiveBackdrop="True">
                <StackPanel Spacing="14" Tapped="OnContextMenuCardTapped">
                    <Grid>
                        <TextBlock Text="Playlists &amp; Collection"
                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <Button Command="{x:Bind ViewModel.CloseAddToPlaylistModalCommand, Mode=OneWay}"
                                Style="{StaticResource GlassCircleIconButtonStyle}"
                                Width="30" Height="30" CornerRadius="15"
                                HorizontalAlignment="Right">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                        </Button>
                    </Grid>

                    <!-- Existing Playlists Quick-Add List -->
                    <StackPanel Visibility="{x:Bind ViewModel.HasPlaylistsVisibility, Mode=OneWay}" Spacing="6">
                        <TextBlock Text="Select a Playlist"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                        <ScrollViewer MaxHeight="148" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:UserPlaylist">
                                        <Button Click="OnAddToPlaylistItemClicked"
                                                Tag="{x:Bind}"
                                                Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                                BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="12,8">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE90B;" FontSize="14" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind TrackCountSubtitle, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Create New Playlist Section -->
                    <Border Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                            BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14,12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Create New Playlist"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />

                            <TextBox PlaceholderText="Playlist Title (e.g. Late Night Synthwave)"
                                     Text="{x:Bind ViewModel.NewPlaylistTitleInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     CornerRadius="12"
                                     FontSize="12.5" />

                            <TextBox PlaceholderText="Description (optional)"
                                     Text="{x:Bind ViewModel.NewPlaylistDescriptionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     CornerRadius="12"
                                     FontSize="12" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Leave cover empty for automatic 2×2 distinct-cover collage"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                                <Button Grid.Column="1"
                                        Content="Pick Custom Cover..."
                                        Command="{x:Bind ViewModel.PickNewPlaylistCoverImageCommand, Mode=OneWay}"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                        CornerRadius="12"
                                        Padding="12,5"
                                        FontSize="11.5" />
                            </Grid>

                            <Button Content="+ Create Playlist"
                                    Command="{x:Bind ViewModel.CreateNewPlaylistFromModalCommand, Mode=OneWay}"
                                    Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                    CornerRadius="14"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,8"
                                    FontSize="13"
                                    FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:LiquidGlassPanel>
        </Grid>

        <!-- ================================================================================= -->
        <!-- OVERLAY 2E: IMPORT YOUTUBE MUSIC PLAYLISTS MODAL (LiquidGlass)                    -->
        <!-- Lets signed-in users pick YouTube Music library playlists to import locally.      -->
        <!-- ================================================================================= -->
        <Grid x:Name="YouTubePlaylistImportModalOverlay"
              x:Load="{x:Bind ViewModel.IsYouTubePlaylistImportModalOpen, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.YouTubePlaylistImportModalVisibility, Mode=OneWay}"
              Background="#66000000"
              Tapped="OnYouTubePlaylistImportModalBackdropTapped"
              Canvas.ZIndex="58">
            <controls:LiquidGlassPanel Width="520"
                                       MaxHeight="660"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       GlassCornerRadius="28"
                                       GlassPadding="22,20"
                                       SampleLiveBackdrop="True">
                <Grid RowSpacing="14" Tapped="OnModalCardTapped">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="30" Height="30"
                                CornerRadius="15"
                                Background="#28FF2E54"
                                BorderBrush="#88FF2E54"
                                BorderThickness="1">
                            <FontIcon Glyph="&#xE8FD;" FontSize="13" Foreground="#FFFF4D6D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Import YouTube Music Playlists"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="17.5"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                            <TextBlock Text="YouTube Music Library"
                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                       FontSize="11.5"
                                       Foreground="#FFFF6B86" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.CloseYouTubePlaylistImportModalCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanDismissYouTubePlaylistImportModal, Mode=OneWay}"
                                Style="{StaticResource GlassCircleIconButtonStyle}"
                                Width="30" Height="30" CornerRadius="15"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                        </Button>
                    </Grid>

                    <!-- Info Note + Selection Controls -->
                    <StackPanel Grid.Row="1" Spacing="10">
                        <Border Background="#18FFFFFF"
                                BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,8">
                            <TextBlock Text="Select playlists to copy into your Playlists library. Removing an imported playlist from this app only removes it locally and won't affect your YouTube Music account."
                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                        </Border>

                        <Grid Visibility="{x:Bind ViewModel.ImportYouTubeSelectionToolbarVisibility, Mode=OneWay}" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.YouTubePlaylistImportStatusText, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    Content="Select All"
                                    Command="{x:Bind ViewModel.SelectAllYouTubeImportPlaylistsCommand, Mode=OneWay}"
                                    Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                    BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                    CornerRadius="10"
                                    Padding="10,4"
                                    FontSize="11.5" />
                            <Button Grid.Column="2"
                                    Content="Clear"
                                    Command="{x:Bind ViewModel.ClearYouTubeImportSelectionCommand, Mode=OneWay}"
                                    Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                    BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                    CornerRadius="10"
                                    Padding="10,4"
                                    FontSize="11.5" />
                        </Grid>
                    </StackPanel>

                    <!-- Body: Loading / Error / Empty / Scrollable Playlist List -->
                    <Grid Grid.Row="2" MinHeight="140">
                        <!-- Loading -->
                        <StackPanel Visibility="{x:Bind ViewModel.ImportYouTubeLoadingVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    Padding="0,24">
                            <ProgressRing Width="32"
                                          Height="32"
                                          IsActive="{x:Bind ViewModel.IsLoadingYouTubeLibraryPlaylists, Mode=OneWay}" />
                            <TextBlock Text="Loading your YouTube Music playlists..."
                                       FontSize="12.5"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Error -->
                        <StackPanel Visibility="{x:Bind ViewModel.ImportYouTubeErrorVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    Padding="16,20">
                            <TextBlock Text="{x:Bind ViewModel.YouTubePlaylistImportErrorText, Mode=OneWay}"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="#FFFF8A9B" />
                            <Button Content="Try Again"
                                    Command="{x:Bind ViewModel.OpenYouTubePlaylistImportModalCommand, Mode=OneWay}"
                                    Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                    BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                    CornerRadius="12"
                                    Padding="14,6"
                                    HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Empty -->
                        <StackPanel Visibility="{x:Bind ViewModel.EmptyYouTubeLibraryImportVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    Padding="16,24">
                            <FontIcon Glyph="&#xE90B;" FontSize="28" Foreground="{ThemeResource TokenSecondaryTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No playlists found in your YouTube Music library."
                                       FontSize="12.5"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                        </StackPanel>

                        <!-- Selectable Playlist List -->
                        <ScrollViewer Visibility="{x:Bind ViewModel.HasYouTubeLibraryImportItemsVisibility, Mode=OneWay}"
                                      MaxHeight="340"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.YouTubeLibraryImportItems, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:YouTubePlaylistImportItemViewModel">
                                        <Button Click="OnYouTubeImportPlaylistItemClicked"
                                                Tag="{x:Bind}"
                                                Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                                BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="10,8">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                          MinWidth="0"
                                                          Padding="0"
                                                          IsHitTestVisible="False"
                                                          IsTabStop="False"
                                                          VerticalAlignment="Center" />

                                                <Border Grid.Column="1"
                                                        Width="44" Height="44"
                                                        CornerRadius="10"
                                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                        BorderBrush="#33FFFFFF"
                                                        BorderThickness="0.8">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE90B;"
                                                                  FontSize="18"
                                                                  Opacity="{x:Bind FallbackIconOpacity, Mode=OneWay}"
                                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        <Border CornerRadius="9" Opacity="{x:Bind ArtworkOpacity, Mode=OneWay}">
                                                            <Image helpers:BitmapDecodeHelper.DecodeWidth="96"
                                                                   helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeArtworkUri, Mode=OneWay}"
                                                                   Stretch="UniformToFill" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                               FontSize="11.5"
                                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Border Grid.Column="3"
                                                        Visibility="{x:Bind AlreadyImportedBadgeVisibility, Mode=OneWay}"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="8"
                                                        Padding="8,3"
                                                        Background="#2634D399"
                                                        BorderBrush="#6634D399"
                                                        BorderThickness="0.8">
                                                    <TextBlock Text="Imported"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="10.5"
                                                               FontWeight="Bold"
                                                               Foreground="#FF6EE7B7" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>

                    <!-- Import Progress Strip -->
                    <StackPanel Grid.Row="3"
                                Visibility="{x:Bind ViewModel.ImportYouTubeProgressVisibility, Mode=OneWay}"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <ProgressRing Width="18"
                                      Height="18"
                                      IsActive="{x:Bind ViewModel.IsImportingYouTubePlaylists, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.YouTubePlaylistImportProgressText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Footer Actions -->
                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right">
                        <Button Content="Not Now"
                                Command="{x:Bind ViewModel.CloseYouTubePlaylistImportModalCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanDismissYouTubePlaylistImportModal, Mode=OneWay}"
                                Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                CornerRadius="14"
                                Padding="16,8"
                                FontSize="12.5" />
                        <Button Content="{x:Bind ViewModel.ImportYouTubePlaylistsButtonLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ImportSelectedYouTubePlaylistsCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanImportSelectedYouTubePlaylists, Mode=OneWay}"
                                Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                CornerRadius="14"
                                Padding="18,8"
                                FontSize="12.5"
                                FontWeight="Bold" />
                    </StackPanel>
                </Grid>
            </controls:LiquidGlassPanel>
        </Grid>

        <!-- ================================================================================= -->
        <!-- OVERLAY 2F: DELETE / REMOVE PLAYLIST CONFIRMATION MODAL (LiquidGlass)             -->
        <!-- Clarifies local-only removal for YouTube Music imported playlists.                -->
        <!-- ================================================================================= -->
        <Grid x:Name="DeletePlaylistConfirmationOverlay"
              x:Load="{x:Bind ViewModel.IsDeletePlaylistConfirmationOpen, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.DeletePlaylistConfirmationVisibility, Mode=OneWay}"
              Background="#66000000"
              Tapped="OnDeletePlaylistConfirmationBackdropTapped"
              Canvas.ZIndex="60">
            <controls:LiquidGlassPanel Width="430"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       GlassCornerRadius="26"
                                       GlassPadding="24,20"
                                       SampleLiveBackdrop="True">
                <StackPanel Spacing="14" Tapped="OnModalCardTapped">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="32" Height="32"
                                CornerRadius="16"
                                Background="#28FF4D6D"
                                BorderBrush="#88FF4D6D"
                                BorderThickness="1">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FFFF6B7A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.PendingDeletePlaylistTitle, Mode=OneWay}"
                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.PendingDeletePlaylistMessage, Mode=OneWay}"
                               FontFamily="{StaticResource TokenBodyFontFamily}"
                               FontSize="13"
                               LineHeight="19"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TokenSecondaryTextBrush}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0">
                        <Button Content="Cancel"
                                Command="{x:Bind ViewModel.CancelDeletePlaylistCommand, Mode=OneWay}"
                                Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                CornerRadius="14"
                                Padding="16,8"
                                FontSize="12.5" />
                        <Button Content="{x:Bind ViewModel.PendingDeletePlaylistConfirmLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ConfirmDeletePlaylistCommand, Mode=OneWay}"
                                Background="#FFD9364E"
                                Foreground="White"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,8"
                                FontSize="12.5"
                                FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </controls:LiquidGlassPanel>
        </Grid>

        <!-- ================================================================================= -->
        <!-- FLOATING LIQUIDGLASS DOWNLOAD PROGRESS BAR & ACTIVE STATUS PILL                   -->
        <!-- Floats above the bottom of the catalog, updates live per Mornye download stage,  -->
        <!-- clickable to expand the full persistent offline download queue flyout             -->
        <!-- ================================================================================= -->
        <Grid x:Name="FloatingDownloadProgressContainer"
              Visibility="{x:Bind ViewModel.DownloadBarVisibility, Mode=OneWay}"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,20"
              Canvas.ZIndex="42">
            <Grid.TranslationTransition>
                <Vector3Transition Duration="0:0:0.35" />
            </Grid.TranslationTransition>
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.25" />
            </Grid.OpacityTransition>

            <controls:LiquidGlassPanel Height="56"
                                       MinWidth="420"
                                       MaxWidth="540"
                                       GlassCornerRadius="24"
                                       GlassPadding="12,8,14,8"
                                       SampleLiveBackdrop="True"
                                       BorderBrush="#38FFFFFF"
                                       BorderThickness="1"
                                       Tapped="OnDownloadBarTapped"
                                       helpers:MicroInteractions.HoverScale="1.02"
                                       helpers:MicroInteractions.PressScale="0.98">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Glowing Download Pulsing Disk Icon -->
                    <Border Grid.Column="0"
                            Width="38" Height="38"
                            CornerRadius="19"
                            Background="#183BD5B9"
                            BorderBrush="#403BD5B9"
                            BorderThickness="1">
                        <FontIcon Glyph="&#xE896;"
                                  FontSize="16"
                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Center: Track Title, Quality Badge, Live Stage Text, Progress Bar -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.CurrentDownloadTitle, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />

                            <Border Grid.Column="1"
                                    Background="#22000000"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="0.8"
                                    CornerRadius="6"
                                    Padding="6,1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CurrentDownloadBadge, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                            </Border>

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind ViewModel.CurrentDownloadPercentText, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Live Stage Status -->
                        <TextBlock Text="{x:Bind ViewModel.CurrentDownloadStage, Mode=OneWay}"
                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                   FontSize="11"
                                   Opacity="0.8"
                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />

                        <!-- Bottom sleek progress bar -->
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{x:Bind ViewModel.CurrentDownloadPercent, Mode=OneWay}"
                                     Height="3"
                                     CornerRadius="1.5"
                                     Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                     Background="#20FFFFFF"
                                     Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Right Action Buttons: View Queue Button + Dismiss Button -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="6">
                        <Button Command="{x:Bind ViewModel.ToggleDownloadQueueFlyoutCommand, Mode=OneWay}"
                                Style="{StaticResource GlassCircleIconButtonStyle}"
                                Width="32" Height="32" CornerRadius="16"
                                ToolTipService.ToolTip="View download queue">
                            <FontIcon Glyph="&#xE90B;" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                        </Button>

                        <Button Command="{x:Bind ViewModel.DismissDownloadBarCommand, Mode=OneWay}"
                                Style="{StaticResource GlassCircleIconButtonStyle}"
                                Width="26" Height="26" CornerRadius="13"
                                ToolTipService.ToolTip="Hide bar">
                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </controls:LiquidGlassPanel>
        </Grid>

        <!-- ================================================================================= -->
        <!-- LIQUIDGLASS OFFLINE DOWNLOAD QUEUE FLYOUT PANEL                                   -->
        <!-- Displays active and completed track downloads with live progress & folder access   -->
        <!-- ================================================================================= -->
        <Grid x:Name="DownloadQueueFlyoutOverlay"
              x:Load="{x:Bind ViewModel.IsDownloadQueueFlyoutOpen, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.DownloadQueueFlyoutVisibility, Mode=OneWay}"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,84"
              Canvas.ZIndex="43">
            <controls:LiquidGlassPanel Width="470"
                                       MaxHeight="460"
                                       GlassCornerRadius="24"
                                       GlassPadding="18,14"
                                       SampleLiveBackdrop="True">
                <StackPanel Spacing="10">
                    <!-- Queue Header -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                            <TextBlock Text="Download Queue"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                            <Border Background="#203BD5B9"
                                    BorderBrush="#403BD5B9"
                                    BorderThickness="0.8"
                                    CornerRadius="8"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.DownloadQueueSummaryText, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Header Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                            <Button Command="{x:Bind ViewModel.OpenDownloadsFolderCommand, Mode=OneWay}"
                                    Style="{StaticResource GlassCircleIconButtonStyle}"
                                    Width="30" Height="30" CornerRadius="15"
                                    ToolTipService.ToolTip="Open downloads folder">
                                <FontIcon Glyph="&#xE838;" FontSize="12" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.ClearCompletedDownloadsCommand, Mode=OneWay}"
                                    Style="{StaticResource GlassCircleIconButtonStyle}"
                                    Width="30" Height="30" CornerRadius="15"
                                    ToolTipService.ToolTip="Clear completed downloads">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.CloseDownloadQueueFlyoutCommand, Mode=OneWay}"
                                    Style="{StaticResource GlassCircleIconButtonStyle}"
                                    Width="30" Height="30" CornerRadius="15"
                                    ToolTipService.ToolTip="Close">
                                <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#25FFFFFF" Margin="0,2,0,2" />

                    <!-- Queue Items Scrollable List -->
                    <ScrollViewer MaxHeight="360"
                                  Style="{StaticResource LiquidGlassScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DownloadQueue, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DownloadQueueItemViewModel">
                                    <Border CornerRadius="14"
                                            Background="#18FFFFFF"
                                            BorderBrush="#25FFFFFF"
                                            BorderThickness="0.8"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Cover Art Thumbnail -->
                                            <Border Grid.Column="0"
                                                    Width="42" Height="42"
                                                    CornerRadius="10"
                                                    Background="#25000000"
                                                    BorderBrush="#28FFFFFF"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <FontIcon Glyph="&#xEC4F;"
                                                              FontSize="16"
                                                              Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}" />
                                                    <Border CornerRadius="9"
                                                            Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                        <Border.Background>
                                                            <ImageBrush helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                        Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Metadata & Live Status -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{x:Bind Title, Mode=OneWay}"
                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                               FontSize="12.5"
                                                               FontWeight="Bold"
                                                               Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <Border Grid.Column="1"
                                                            Background="#20000000"
                                                            BorderBrush="#30FFFFFF"
                                                            BorderThickness="0.6"
                                                            CornerRadius="5"
                                                            Padding="5,1">
                                                        <TextBlock Text="{x:Bind ProviderBadge, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                   FontSize="9.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />

                                                <TextBlock Text="{x:Bind StageStatus, Mode=OneWay}"
                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                           FontSize="10.5"
                                                           Opacity="0.85"
                                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />

                                                <!-- Active Progress bar -->
                                                <ProgressBar Visibility="{x:Bind ProgressBarVisibility, Mode=OneWay}"
                                                             Minimum="0" Maximum="100"
                                                             Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                                             Height="2.5"
                                                             CornerRadius="1.25"
                                                             Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                             Background="#20FFFFFF"
                                                             Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Right Status Indicator & Play Button -->
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Spacing="4">
                                                <Button Visibility="{x:Bind StatusSuccessVisibility, Mode=OneWay}"
                                                        Click="OnQueueItemPlayClicked"
                                                        Style="{StaticResource GlassCircleIconButtonStyle}"
                                                        Width="26" Height="26" CornerRadius="13"
                                                        ToolTipService.ToolTip="Play">
                                                    <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                </Button>

                                                <Border Visibility="{x:Bind StatusSuccessVisibility, Mode=OneWay}"
                                                        Width="22" Height="22"
                                                        CornerRadius="11"
                                                        Background="#253BD5B9">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                </Border>

                                                <Border Visibility="{x:Bind StatusFailedVisibility, Mode=OneWay}"
                                                        Width="22" Height="22"
                                                        CornerRadius="11"
                                                        Background="#30FF5252">
                                                    <FontIcon Glyph="&#xEA39;" FontSize="10" Foreground="#FF5252" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </controls:LiquidGlassPanel>
        </Grid>

        <!-- ================================================================================= -->
        <!-- MODAL OVERLAY: RECOMMENDED DOWNLOAD & CANDIDATE VERSION SELECTOR                  -->
        <!-- Displays the verified top-scoring match from Tidal/Deezer/GDStudio/YTM             -->
        <!-- along with alternative editions (Studio, Remaster, Deluxe, Live, Direct FLAC)     -->
        <!-- ================================================================================= -->
        <Grid x:Name="DownloadCandidatesModalOverlay"
              x:Load="{x:Bind ViewModel.IsDownloadCandidatesModalOpen, Mode=OneWay}"
              Visibility="{x:Bind ViewModel.DownloadCandidatesModalVisibility, Mode=OneWay}"
              Background="#66000000"
              Tapped="OnDownloadCandidatesModalBackdropTapped"
              Canvas.ZIndex="55">
            <controls:LiquidGlassPanel Width="560"
                                       MaxHeight="620"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       GlassCornerRadius="28"
                                       GlassPadding="24,20"
                                       SampleLiveBackdrop="True"
                                       IsDraggableLens="False"
                                       Tapped="OnModalCardTapped">
                <StackPanel Spacing="14">
                    <!-- Modal Header -->
                    <Grid>
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE896;" FontSize="17" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                <TextBlock Text="Audio Download &amp; Versions"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TargetDownloadTrack.Title, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>

                        <Button Command="{x:Bind ViewModel.CloseDownloadOptionsModalCommand, Mode=OneWay}"
                                Style="{StaticResource GlassCircleIconButtonStyle}"
                                Width="30" Height="30" CornerRadius="15"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                        </Button>
                    </Grid>

                    <!-- Searching State (Loading ProgressRing) -->
                    <StackPanel Visibility="{x:Bind ViewModel.SearchingCandidatesVisibility, Mode=OneWay}"
                                Spacing="14"
                                HorizontalAlignment="Center"
                                Margin="0,32,0,32">
                        <ProgressRing IsActive="True"
                                      Width="46" Height="46"
                                      Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                      HorizontalAlignment="Center" />
                        <TextBlock Text="Searching verified Lossless sources on Tidal Hi-Fi, Deezer &amp; GDStudio..."
                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Verifying strict title, artist, duration, and audio variant match"
                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                   FontSize="11.5"
                                   Opacity="0.75"
                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Loaded Candidates Content -->
                    <StackPanel Visibility="{x:Bind ViewModel.CandidatesContentVisibility, Mode=OneWay}"
                                Spacing="12">

                        <!-- SECTION 1: RECOMMENDED VERSION CARD (Highlighted Gold/Teal) -->
                        <Border Visibility="{x:Bind ViewModel.RecommendedCandidateVisibility, Mode=OneWay}"
                                CornerRadius="18"
                                Background="#183BD5B9"
                                BorderBrush="#553BD5B9"
                                BorderThickness="1.2"
                                Padding="16,14">
                            <StackPanel Spacing="10">
                                <!-- Top badges: Star Recommended + Match Score -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{ThemeResource TokenPrimaryAccentBrush}"
                                                CornerRadius="7"
                                                Padding="8,2">
                                            <TextBlock Text="★ RECOMMENDED DOWNLOAD"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Foreground="Black" />
                                        </Border>

                                        <Border Background="#25000000"
                                                BorderBrush="#40FFFFFF"
                                                BorderThickness="0.8"
                                                CornerRadius="7"
                                                Padding="8,2">
                                            <TextBlock Text="{x:Bind ViewModel.RecommendedCandidate.MatchBadgeText, Mode=OneWay}"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Candidate Info: Artwork + Title + Album + Format -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Artwork -->
                                    <Border Grid.Column="0"
                                            Width="60" Height="60"
                                            CornerRadius="14"
                                            Background="#25000000"
                                            BorderBrush="#35FFFFFF"
                                            BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xEC4F;"
                                                      FontSize="22"
                                                      Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Opacity="{x:Bind ViewModel.RecommendedCandidate.DefaultCoverIconOpacity, Mode=OneWay}" />
                                            <Border CornerRadius="13"
                                                    Opacity="{x:Bind ViewModel.RecommendedCandidate.CoverArtOpacity, Mode=OneWay}">
                                                <Border.Background>
                                                    <ImageBrush helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.RecommendedCandidate.SafeCoverArtUri, Mode=OneWay}"
                                                                Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Text Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.RecommendedCandidate.Title, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="14.5"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />

                                        <TextBlock Text="{x:Bind ViewModel.RecommendedCandidate.SubtitleSummary, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />

                                        <TextBlock Text="{x:Bind ViewModel.RecommendedCandidate.ProviderAndIsrcText, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                    </StackPanel>
                                </Grid>

                                <!-- Action Button: Download Recommended -->
                                <Button Command="{x:Bind ViewModel.DownloadRecommendedCandidateCommand, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        Height="40"
                                        CornerRadius="14"
                                        Background="{ThemeResource TokenPrimaryAccentBrush}"
                                        BorderThickness="0"
                                        helpers:MicroInteractions.HoverScale="1.02"
                                        helpers:MicroInteractions.PressScale="0.97">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="Black" />
                                        <TextBlock Text="Download Recommended Version (FLAC Lossless)"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="Black" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 2: ALTERNATIVE EDITIONS & SOURCES LIST -->
                        <StackPanel Visibility="{x:Bind ViewModel.AlternativeCandidatesHeaderVisibility, Mode=OneWay}"
                                    Spacing="8">
                            <TextBlock Text="Other versions &amp; sources found:"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />

                            <ScrollViewer MaxHeight="210"
                                          Style="{StaticResource LiquidGlassScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AlternativeCandidates, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TrackDownloadCandidate">
                                            <Border CornerRadius="12"
                                                    Background="#15FFFFFF"
                                                    BorderBrush="#25FFFFFF"
                                                    BorderThickness="0.8"
                                                    Padding="10,8"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Artwork -->
                                                    <Border Grid.Column="0"
                                                            Width="38" Height="38"
                                                            CornerRadius="9"
                                                            Background="#25000000"
                                                            BorderBrush="#25FFFFFF"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xEC4F;"
                                                                      FontSize="15"
                                                                      Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}" />
                                                            <Border CornerRadius="8"
                                                                    Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                <Border.Background>
                                                                    <ImageBrush helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                                Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Metadata -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{x:Bind Title, Mode=OneWay}"
                                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxLines="1" />
                                                            <Border Grid.Column="1"
                                                                    Background="#20000000"
                                                                    BorderBrush="#30FFFFFF"
                                                                    BorderThickness="0.6"
                                                                    CornerRadius="5"
                                                                    Padding="5,1">
                                                                <TextBlock Text="{x:Bind VersionBadge, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                            </Border>
                                                        </Grid>

                                                        <TextBlock Text="{x:Bind SubtitleSummary, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="11"
                                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxLines="1" />

                                                        <TextBlock Text="{x:Bind ProviderAndIsrcText, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="10"
                                                                   Opacity="0.8"
                                                                   Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxLines="1" />
                                                    </StackPanel>

                                                    <!-- Download Candidate Button -->
                                                    <Button Grid.Column="2"
                                                            Click="OnCandidateDownloadButtonClicked"
                                                            Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                                            Height="32"
                                                            CornerRadius="10"
                                                            Padding="10,4"
                                                            VerticalAlignment="Center"
                                                            helpers:MicroInteractions.HoverScale="1.05"
                                                            helpers:MicroInteractions.PressScale="0.95">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <FontIcon Glyph="&#xE896;" FontSize="11" Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                            <TextBlock Text="Download"
                                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:LiquidGlassPanel>
        </Grid>

        <!-- ================================================================================= -->
        <!-- OVERLAY 3: FULLSCREEN NOW PLAYING & GPU MUSIC VISUALIZER STAGE                    -->
        <!-- Android Parity Redesign:                                                          -->
        <!-- - Luminous blurred album art backdrop (light & dark mode) + subtle bottom         -->
        <!--   ambient album-color gradient rising smoothly from the bottom edge               -->
        <!-- - Top-left circular LiquidGlass Back button | Top-right unified [Cast | Menu]     -->
        <!-- - Left playback deck: Large album cover, Title, Artist - Album, Squiggly          -->
        <!--   progress pill, transport controls (seek ±10s hidden by default via Settings),   -->
        <!--   bottom [Heart | Lyrics | Queue] pill, and ergonomic Windows Volume pill         -->
        <!-- - Right collapsible borderless Lyrics & Playing Queue (NO dark container box!)    -->
        <!--   with pixel-smooth top & bottom vertical edge fades                              -->
        <!-- ================================================================================= -->
        <Grid x:Name="FullscreenNowPlayingOverlay"
              Visibility="Collapsed"
              Canvas.ZIndex="45"
              Background="Transparent"
              CenterPoint="640,360,0">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="FullscreenPrimaryInkBrush" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="FullscreenSecondaryInkBrush" Color="#CCFFFFFF" />
                            <SolidColorBrush x:Key="FullscreenEdgeHairlineBrush" Color="#28FFFFFF" />
                            <SolidColorBrush x:Key="FullscreenQueueCardBrush" Color="#24FFFFFF" />
                            <SolidColorBrush x:Key="FullscreenQueueCardBorderBrush" Color="#26FFFFFF" />
                            <SolidColorBrush x:Key="FullscreenCoverRimBrush" Color="#42FFFFFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="FullscreenPrimaryInkBrush" Color="#FF0F172A" />
                            <SolidColorBrush x:Key="FullscreenSecondaryInkBrush" Color="#B81E293B" />
                            <SolidColorBrush x:Key="FullscreenEdgeHairlineBrush" Color="#1F0F172A" />
                            <SolidColorBrush x:Key="FullscreenQueueCardBrush" Color="#88FFFFFF" />
                            <SolidColorBrush x:Key="FullscreenQueueCardBorderBrush" Color="#1F0F172A" />
                            <SolidColorBrush x:Key="FullscreenCoverRimBrush" Color="#2E0F172A" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.ScaleTransition>
                <Vector3Transition Duration="0:0:0.42" />
            </Grid.ScaleTransition>
            <Grid.TranslationTransition>
                <Vector3Transition Duration="0:0:0.42" />
            </Grid.TranslationTransition>
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.32" />
            </Grid.OpacityTransition>

            <!-- 1. Luminous Full-Bleed Blurred Album Art Backdrop + Ambient Scrim + Bottom Album-Color Gradient -->
            <Grid x:Name="FullscreenBackdropStage" Canvas.ZIndex="1">
                <!-- 1A. Animated Ambient Base Canvas (DarkAmbient / LightAmbient) -->
                <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Border.Background>
                        <SolidColorBrush x:Name="FullscreenAmbientBackgroundBrush" Color="#FF141118" />
                    </Border.Background>
                </Border>

                <!-- 1B. Full-Bleed Album Cover Art at Full Luminosity -->
                <Image x:Name="FullscreenBackdropCoverImage"
                       helpers:BitmapDecodeHelper.DecodeWidth="512" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentTrack.SafeCoverArtUri, Mode=OneWay}"
                       Opacity="{x:Bind ViewModel.CurrentTrack.CoverArtOpacity, Mode=OneWay}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />

                <!-- 1C. GPU Composition Gaussian Blur (40dp equivalent matching Android NowPlayingBackground.kt) -->
                <Border x:Name="FullscreenBackdropBlurHost"
                        IsHitTestVisible="False"
                        Loaded="OnFullscreenBackdropBlurLoaded"
                        SizeChanged="OnFullscreenBackdropBlurSizeChanged" />

                <!-- 1D. Light, Luminous Vertical Dissolve Scrim (Theme-aware Dark & Light stops) -->
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="FullscreenScrimStop0" Offset="0.00" Color="#29141118" />
                            <GradientStop x:Name="FullscreenScrimStop1" Offset="0.16" Color="#00141118" />
                            <GradientStop x:Name="FullscreenScrimStop2" Offset="0.44" Color="#24141118" />
                            <GradientStop x:Name="FullscreenScrimStop3" Offset="0.68" Color="#6B141118" />
                            <GradientStop x:Name="FullscreenScrimStop4" Offset="0.86" Color="#C2141118" />
                            <GradientStop x:Name="FullscreenScrimStop5" Offset="1.00" Color="#E6141118" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 1E. Subtle Bottom Primary-Color Album Tint Gradient (Rises gently from bottom edge) -->
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="FullscreenBottomTintStop0" Offset="0.00" Color="#00EF4444" />
                            <GradientStop x:Name="FullscreenBottomTintStop1" Offset="0.54" Color="#00EF4444" />
                            <GradientStop x:Name="FullscreenBottomTintStop2" Offset="0.80" Color="#29EF4444" />
                            <GradientStop x:Name="FullscreenBottomTintStop3" Offset="1.00" Color="#4DEF4444" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 1F. Soft Horizontal Edge Vignette -->
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop x:Name="FullscreenVignetteStop0" Offset="0.00" Color="#4D141118" />
                            <GradientStop x:Name="FullscreenVignetteStop1" Offset="0.20" Color="#1A141118" />
                            <GradientStop x:Name="FullscreenVignetteStop2" Offset="0.80" Color="#00141118" />
                            <GradientStop x:Name="FullscreenVignetteStop3" Offset="1.00" Color="#4D141118" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 1G. Real-Time Win2D GPU Audio Spectrum Visualizer Layer -->
                <controls:GpuMusicVisualizerControl x:Name="FullscreenGpuVisualizer"
                                                    x:Load="{x:Bind ViewModel.IsFullscreenNowPlayingOpen, Mode=OneWay}"
                                                    ActiveVisualizer="{x:Bind ViewModel.SelectedVisualizer, Mode=OneWay}"
                                                    IsVisualizerActive="{x:Bind ViewModel.IsFullscreenNowPlayingOpen, Mode=OneWay}" />
            </Grid>

            <!-- 2. Top Floating Bar: Left Circular Back Button | Right Unified [Cast | Menu] LiquidGlass Pill -->
            <Grid VerticalAlignment="Top"
                  Margin="28,40,28,0"
                  Canvas.ZIndex="25">
                <!-- Top-Left Circular LiquidGlass Back Button -->
                <controls:LiquidGlassPanel HorizontalAlignment="Left"
                                           Width="44" Height="44"
                                           GlassCornerRadius="22"
                                           GlassPadding="0"
                                           SampleLiveBackdrop="True"
                                           EnableHoverScale="True">
                    <Button Command="{x:Bind ViewModel.CloseFullscreenNowPlayingCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Back to Workspace"
                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                            Width="44" Height="44"
                            CornerRadius="22"
                            Padding="0">
                        <FontIcon Glyph="&#xE72B;"
                                  FontSize="16"
                                  Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                    </Button>
                </controls:LiquidGlassPanel>

                <!-- Top-Right Action Bar: Visual Sleep Timer Countdown Pill + 1-Click Nightcore Pill + Unified [Cast | DSP | Menu (...)] -->
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- Visual Live Countdown Sleep Timer Badge (Appears on screen while Music Sleep Timer is active) -->
                    <controls:SleepTimerBadgeControl x:Name="FullscreenTopSleepTimerBadge"
                                                     BadgeClicked="OnFullscreenSleepTimerBadgeClicked"
                                                     VerticalAlignment="Center" />

                    <!-- Tactile 1-Click Nightcore Real-Time DSP Pill Button ("Nightcore ON" with neon glow & pulse) -->
                    <controls:NightcorePillButton x:Name="FullscreenTopNightcorePill"
                                                  VerticalAlignment="Center" />

                    <!-- Unified LiquidGlass Pill: Cast | Audio DSP & EQ | Menu (...) -->
                    <controls:LiquidGlassPanel Height="44"
                                               GlassCornerRadius="22"
                                               GlassPadding="6,0"
                                               SampleLiveBackdrop="True">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Click="OnSidebarCastClicked"
                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Padding="0"
                                    helpers:MicroInteractions.HoverScale="1.12"
                                    helpers:MicroInteractions.PressScale="0.90"
                                    ToolTipService.ToolTip="Cast Device">
                                <FontIcon Glyph="&#xEC15;"
                                          FontSize="15"
                                          Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                            </Button>

                            <Border Width="1" Height="18"
                                    Background="{ThemeResource FullscreenEdgeHairlineBrush}"
                                    Margin="2,0"
                                    IsHitTestVisible="False" />

                            <Button Click="OnFullscreenAudioDspButtonClicked"
                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Padding="0"
                                    helpers:MicroInteractions.HoverScale="1.12"
                                    helpers:MicroInteractions.PressScale="0.90"
                                    ToolTipService.ToolTip="Equalizer, Speed, Pitch, Nightcore &amp; Sleep Timer">
                                <FontIcon Glyph="&#xE9E9;"
                                          FontSize="15"
                                          Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                            </Button>

                            <Border Width="1" Height="18"
                                    Background="{ThemeResource FullscreenEdgeHairlineBrush}"
                                    Margin="2,0"
                                    IsHitTestVisible="False" />

                            <Button Click="OnFullscreenCurrentTrackMoreClicked"
                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Padding="0"
                                    helpers:MicroInteractions.HoverScale="1.12"
                                    helpers:MicroInteractions.PressScale="0.90"
                                    ToolTipService.ToolTip="Song Options, Audio Effects, Sleep Timer &amp; Visualizers">
                                <FontIcon Glyph="&#xE712;"
                                          FontSize="15.5"
                                          Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                            </Button>
                        </StackPanel>
                    </controls:LiquidGlassPanel>
                </StackPanel>
            </Grid>

            <!-- 3. Unified 2-Column Stage: Left Playback Deck | Right Borderless Collapsible Lyrics & Queue -->
            <Grid x:Name="FullscreenCenterStage"
                  Canvas.ZIndex="15"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch"
                  MaxWidth="1360"
                  Margin="48,92,48,22"
                  ColumnSpacing="48"
                  SizeChanged="OnFullscreenCenterStageSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.48*" />
                    <ColumnDefinition Width="0.52*" />
                </Grid.ColumnDefinitions>

                <!-- COLUMN 0: LEFT PLAYBACK DECK (Smoothly centers when Lyrics/Queue is closed) -->
                <StackPanel x:Name="FullscreenDeckColumnPanel"
                            Grid.Column="0"
                            Spacing="14"
                            MaxWidth="460"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Canvas.ZIndex="15">
                    <StackPanel.ScaleTransition>
                        <Vector3Transition Duration="0:0:0.46" />
                    </StackPanel.ScaleTransition>
                    <StackPanel.TranslationTransition>
                        <Vector3Transition Duration="0:0:0.46" />
                    </StackPanel.TranslationTransition>

                    <!-- 3A-0. Audio / Video Switcher Pill: [ Song | Video ] (Shown when official YouTube video is available) -->
                    <controls:LiquidGlassPanel Visibility="{x:Bind ViewModel.FullscreenAudioVideoSwitcherVisibility, Mode=OneWay}"
                                               Width="212" Height="38"
                                               HorizontalAlignment="Center"
                                               GlassCornerRadius="19"
                                               GlassPadding="3"
                                               SampleLiveBackdrop="True"
                                               HighlightAlphaMultiplier="0.72">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Song Tab -->
                            <Grid Grid.Column="0">
                                <Border CornerRadius="16"
                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                        BorderThickness="1"
                                        Opacity="{x:Bind ViewModel.FullscreenSongTabHighlightOpacity, Mode=OneWay}"
                                        IsHitTestVisible="False">
                                    <Border.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.22" />
                                    </Border.OpacityTransition>
                                </Border>
                                <Button Command="{x:Bind ViewModel.SelectFullscreenSongModeCommand, Mode=OneWay}"
                                        Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="16"
                                        Padding="10,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEC4F;" FontSize="12" Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                        <TextBlock Text="Song"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Video Tab -->
                            <Grid Grid.Column="1">
                                <Border CornerRadius="16"
                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                        BorderThickness="1"
                                        Opacity="{x:Bind ViewModel.FullscreenVideoTabHighlightOpacity, Mode=OneWay}"
                                        IsHitTestVisible="False">
                                    <Border.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.22" />
                                    </Border.OpacityTransition>
                                </Border>
                                <Button Command="{x:Bind ViewModel.SelectFullscreenVideoModeCommand, Mode=OneWay}"
                                        Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="16"
                                        Padding="10,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE714;" FontSize="12" Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                        <TextBlock Text="Video"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </controls:LiquidGlassPanel>

                    <!-- 3A-0b. Fullscreen-Only Video Playback Notice Pill (Never leaks to Settings) -->
                    <Border Visibility="{x:Bind ViewModel.FullscreenVideoErrorVisibility, Mode=OneWay}"
                            MaxWidth="420"
                            HorizontalAlignment="Center"
                            CornerRadius="16"
                            Padding="12,6"
                            Background="#CC26121A"
                            BorderBrush="#66FF7A99"
                            BorderThickness="1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE783;"
                                      FontSize="13"
                                      Foreground="#FFFF9EB5"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.FullscreenVideoErrorMessage, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFECF0"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Command="{x:Bind ViewModel.DismissFullscreenVideoErrorCommand, Mode=OneWay}"
                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                    Width="22" Height="22"
                                    CornerRadius="11"
                                    Padding="0"
                                    ToolTipService.ToolTip="Dismiss">
                                <FontIcon Glyph="&#xE711;" FontSize="9.5" Foreground="#CCFFECF0" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 3A. Large Rounded Hero Album Cover / Synchronized 16:9 Official Music Video Stage -->
                    <Border x:Name="FullscreenCoverOuterBorder"
                            Width="{x:Bind ViewModel.FullscreenCoverOuterWidth, Mode=OneWay}"
                            Height="{x:Bind ViewModel.FullscreenCoverOuterHeight, Mode=OneWay}"
                            CornerRadius="28"
                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                            BorderBrush="{ThemeResource FullscreenCoverRimBrush}"
                            BorderThickness="1.25"
                            HorizontalAlignment="Center"
                            helpers:MicroInteractions.HoverScale="1.02"
                            helpers:MicroInteractions.PressScale="0.985">
                        <Grid>
                            <!-- Default Minimalist Cover Fallback -->
                            <Grid Opacity="{x:Bind ViewModel.CurrentTrack.DefaultCoverIconOpacity, Mode=OneWay}">
                                <Border Width="196" Height="196"
                                        CornerRadius="98"
                                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                        BorderThickness="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                <Border Width="128" Height="128"
                                        CornerRadius="64"
                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                        BorderThickness="1.5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEC4F;"
                                              FontSize="56"
                                              Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- Apple Music Canvas Animated Motion Cover Layer (Loads Invisibly Underneath Static Cover, Reveals Only After First Decoded Frame) -->
                            <Border x:Name="FullscreenCanvasVideoContainer"
                                    CornerRadius="27"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.35" />
                                </Border.OpacityTransition>
                                <Grid>
                                    <MediaPlayerElement x:Name="FullscreenCanvasMediaPlayerElement"
                                                        AreTransportControlsEnabled="False"
                                                        Opacity="0"
                                                        Stretch="UniformToFill" />
                                    <canvas:CanvasControl x:Name="FullscreenCanvasVideoCanvas"
                                                          x:Load="{x:Bind ViewModel.IsFullscreenNowPlayingOpen, Mode=OneWay}"
                                                          ClearColor="Transparent"
                                                          Draw="OnFullscreenCanvasVideoCanvasDraw"
                                                          Unloaded="OnDynamicCanvasControlUnloaded" />
                                </Grid>
                            </Border>

                            <!-- Real Album Cover Artwork (Stays Cleanly Visible On Top at Opacity=1.0 While Canvas Loads, Cross-Fades Out Once First Frame Renders) -->
                            <Border x:Name="FullscreenStaticCoverHost"
                                    CornerRadius="27"
                                    Opacity="1"
                                    IsHitTestVisible="False">
                                <Border.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.35" />
                                </Border.OpacityTransition>
                                <Border CornerRadius="27"
                                        Opacity="{x:Bind ViewModel.CurrentTrack.CoverArtOpacity, Mode=OneWay}">
                                    <Image helpers:BitmapDecodeHelper.DecodeWidth="512" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentTrack.SafeCoverArtUri, Mode=OneWay}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch" />
                                </Border>
                            </Border>

                            <!-- Official YouTube Music Video Synchronized Playback Layer (Canción | Video Switcher) -->
                            <Border x:Name="FullscreenMusicVideoContainer"
                                    CornerRadius="27"
                                    Background="#FF05070B"
                                    Opacity="0"
                                    Visibility="{x:Bind ViewModel.FullscreenVideoLayerVisibility, Mode=OneWay}"
                                    IsHitTestVisible="False">
                                <Border.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.35" />
                                </Border.OpacityTransition>
                                <MediaPlayerElement x:Name="FullscreenMusicVideoPlayerElement"
                                                    x:Load="{x:Bind ViewModel.IsFullscreenNowPlayingOpen, Mode=OneWay}"
                                                    AreTransportControlsEnabled="False"
                                                    Stretch="Uniform"
                                                    Loaded="OnFullscreenMusicVideoPlayerElementLoaded"
                                                    Unloaded="OnFullscreenMusicVideoPlayerElementUnloaded" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 3B. Track Title + Explicit Badge + Artist - Album Subtitle -->
                    <StackPanel Spacing="3"
                                MaxWidth="420"
                                HorizontalAlignment="Center"
                                Margin="0,2,0,0">
                        <Grid HorizontalAlignment="Center" ColumnSpacing="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource FullscreenPrimaryInkBrush}"
                                       TextAlignment="Center"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <controls:ExplicitBadgeControl Grid.Column="1"
                                                           Visibility="{x:Bind ViewModel.CurrentTrack.IsExplicit, Mode=OneWay}"
                                                           VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.CurrentTrack.ArtistAlbumSubtitle, Mode=OneWay}"
                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource FullscreenSecondaryInkBrush}"
                                   TextAlignment="Center"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 3C. Squiggly Progress Bar Pill (Exact Windows Now Playing Sidebar Style) -->
                    <controls:LiquidGlassPanel Height="48"
                                               MinWidth="340"
                                               HorizontalAlignment="Stretch"
                                               GlassCornerRadius="24"
                                               GlassPadding="16,0"
                                               SampleLiveBackdrop="True">
                        <Grid ColumnSpacing="8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="FullscreenPositionTextBlock"
                                       Grid.Column="0"
                                       Text="{x:Bind ViewModel.FormattedPosition, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource FullscreenPrimaryInkBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="34" />

                            <controls:SquigglyProgressBarControl x:Name="FullscreenSquigglyProgressBar"
                                                                 Grid.Column="1"
                                                                 Height="28"
                                                                 VerticalAlignment="Center"
                                                                 IsPlaying="{x:Bind ViewModel.IsPlaying, Mode=OneWay}"
                                                                 IsLightMode="{x:Bind ViewModel.IsLightMode, Mode=OneWay}"
                                                                 SeekRequested="OnFullscreenSquigglySeekRequested"
                                                                 ScrubbingStateChanged="OnFullscreenSquigglyScrubbingStateChanged"
                                                                 ScrubbingProgressChanged="OnFullscreenSquigglyScrubbingProgressChanged" />

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind ViewModel.FormattedDuration, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource FullscreenSecondaryInkBrush}"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       MinWidth="34" />
                        </Grid>
                    </controls:LiquidGlassPanel>

                    <!-- 3D. Transport Controls Row: [Shuffle] [-5s*] [Prev] [Play/Pause] [Next] [+10s*] [Repeat] -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <!-- Shuffle -->
                        <Button Command="{x:Bind ViewModel.ToggleShuffleCommand, Mode=OneWay}"
                                Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                Width="42" Height="42"
                                CornerRadius="21"
                                Padding="0"
                                helpers:MicroInteractions.HoverScale="1.12"
                                helpers:MicroInteractions.PressScale="0.90"
                                ToolTipService.ToolTip="Shuffle Playback Queue">
                            <FontIcon Glyph="&#xE8B1;"
                                      FontSize="16"
                                      Foreground="{ThemeResource FullscreenPrimaryInkBrush}"
                                      Opacity="{x:Bind ViewModel.ShuffleButtonAccentOpacity, Mode=OneWay}" />
                        </Button>

                        <!-- Optional Rewind -5s (Hidden by default; controlled by Settings -> ShowFullscreenSeekButtons) -->
                        <controls:LiquidGlassPanel Visibility="{x:Bind ViewModel.FullscreenSeekButtonsVisibility, Mode=OneWay}"
                                                   Width="40" Height="40"
                                                   VerticalAlignment="Center"
                                                   GlassCornerRadius="20"
                                                   GlassPadding="0"
                                                   SampleLiveBackdrop="True"
                                                   EnableHoverScale="True">
                            <Button Command="{x:Bind ViewModel.Rewind5SecondsCommand, Mode=OneWay}"
                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                    Width="40" Height="40"
                                    CornerRadius="20"
                                    Padding="0"
                                    ToolTipService.ToolTip="Rewind 5 Seconds (-5s)">
                                <StackPanel Spacing="-2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE76B;" FontSize="10.5" Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                    <TextBlock Text="-5s" FontSize="8.5" FontWeight="Bold" Foreground="{ThemeResource FullscreenPrimaryInkBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </controls:LiquidGlassPanel>

                        <!-- Previous Track -->
                        <controls:LiquidGlassPanel Width="52" Height="52"
                                                   VerticalAlignment="Center"
                                                   GlassCornerRadius="26"
                                                   GlassPadding="0"
                                                   SampleLiveBackdrop="True"
                                                   EnableHoverScale="True">
                            <Button Command="{x:Bind ViewModel.PreviousTrackCommand, Mode=OneWay}"
                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                    Width="52" Height="52"
                                    CornerRadius="26"
                                    Padding="0"
                                    ToolTipService.ToolTip="Previous Track">
                                <FontIcon Glyph="&#xE892;"
                                          FontSize="17"
                                          Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                            </Button>
                        </controls:LiquidGlassPanel>

                        <!-- Center Hero Play / Pause (70px LiquidGlass with subtle dynamic accent halo) -->
                        <Grid Width="70" Height="70" VerticalAlignment="Center">
                            <Border x:Name="FullscreenPlayPauseAccentHalo"
                                    CornerRadius="35"
                                    Background="{ThemeResource TokenPrimaryAccentBrush}"
                                    Opacity="0.24"
                                    IsHitTestVisible="False" />
                            <controls:LiquidGlassPanel Width="70" Height="70"
                                                       GlassCornerRadius="35"
                                                       GlassPadding="0"
                                                       SampleLiveBackdrop="True"
                                                       EnableHoverScale="True">
                                <Button Command="{x:Bind ViewModel.TogglePlayPauseCommand, Mode=OneWay}"
                                        Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                        Width="70" Height="70"
                                        CornerRadius="35"
                                        Padding="0"
                                        ToolTipService.ToolTip="Play / Pause">
                                    <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                                              FontSize="26"
                                              Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                </Button>
                            </controls:LiquidGlassPanel>
                        </Grid>

                        <!-- Next Track -->
                        <controls:LiquidGlassPanel Width="52" Height="52"
                                                   VerticalAlignment="Center"
                                                   GlassCornerRadius="26"
                                                   GlassPadding="0"
                                                   SampleLiveBackdrop="True"
                                                   EnableHoverScale="True">
                            <Button Command="{x:Bind ViewModel.NextTrackCommand, Mode=OneWay}"
                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                    Width="52" Height="52"
                                    CornerRadius="26"
                                    Padding="0"
                                    ToolTipService.ToolTip="Next Track">
                                <FontIcon Glyph="&#xE893;"
                                          FontSize="17"
                                          Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                            </Button>
                        </controls:LiquidGlassPanel>

                        <!-- Optional Forward +10s (Hidden by default; controlled by Settings -> ShowFullscreenSeekButtons) -->
                        <controls:LiquidGlassPanel Visibility="{x:Bind ViewModel.FullscreenSeekButtonsVisibility, Mode=OneWay}"
                                                   Width="40" Height="40"
                                                   VerticalAlignment="Center"
                                                   GlassCornerRadius="20"
                                                   GlassPadding="0"
                                                   SampleLiveBackdrop="True"
                                                   EnableHoverScale="True">
                            <Button Command="{x:Bind ViewModel.Forward10SecondsCommand, Mode=OneWay}"
                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                    Width="40" Height="40"
                                    CornerRadius="20"
                                    Padding="0"
                                    ToolTipService.ToolTip="Forward 10 Seconds (+10s)">
                                <StackPanel Spacing="-2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE76C;" FontSize="10.5" Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                    <TextBlock Text="+10s" FontSize="8.5" FontWeight="Bold" Foreground="{ThemeResource FullscreenPrimaryInkBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </controls:LiquidGlassPanel>

                        <!-- Repeat -->
                        <Button Command="{x:Bind ViewModel.CycleRepeatModeCommand, Mode=OneWay}"
                                Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                Width="42" Height="42"
                                CornerRadius="21"
                                Padding="0"
                                helpers:MicroInteractions.HoverScale="1.12"
                                helpers:MicroInteractions.PressScale="0.90"
                                ToolTipService.ToolTip="{x:Bind ViewModel.RepeatModeTooltip, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.RepeatModeGlyph, Mode=OneWay}"
                                      FontSize="16"
                                      Foreground="{ThemeResource FullscreenPrimaryInkBrush}"
                                      Opacity="{x:Bind ViewModel.RepeatButtonAccentOpacity, Mode=OneWay}" />
                        </Button>
                    </StackPanel>

                    <!-- 3E. Bottom LiquidGlass 3-Action Pill: [Heart | Lyrics | Queue] (Matching Android) -->
                    <controls:LiquidGlassPanel Width="224" Height="56"
                                               HorizontalAlignment="Center"
                                               GlassCornerRadius="28"
                                               GlassPadding="10,0"
                                               SampleLiveBackdrop="True">
                        <Grid ColumnSpacing="4" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Heart / Like -->
                            <Button Grid.Column="0"
                                    Command="{x:Bind ViewModel.ToggleLikeCurrentTrackCommand, Mode=OneWay}"
                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                    Width="44" Height="44"
                                    CornerRadius="22"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    helpers:MicroInteractions.HoverScale="1.12"
                                    helpers:MicroInteractions.PressScale="0.90"
                                    ToolTipService.ToolTip="Like / Favorite Song">
                                <FontIcon x:Name="FullscreenLikeButtonIcon"
                                          Glyph="{x:Bind ViewModel.LikeButtonGlyph, Mode=OneWay}"
                                          FontSize="18"
                                          Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                            </Button>

                            <!-- Lyrics Toggle -->
                            <Grid Grid.Column="1" Width="44" Height="44" HorizontalAlignment="Center">
                                <Border x:Name="FullscreenLyricsActionHighlight"
                                        CornerRadius="22"
                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                        BorderThickness="1"
                                        Opacity="{x:Bind ViewModel.FullscreenLyricsPillHighlightOpacity, Mode=OneWay}"
                                        IsHitTestVisible="False">
                                    <Border.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.22" />
                                    </Border.OpacityTransition>
                                </Border>
                                <Button Command="{x:Bind ViewModel.ToggleFullscreenLyricsCommand, Mode=OneWay}"
                                        Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                        Width="44" Height="44"
                                        CornerRadius="22"
                                        Padding="0"
                                        helpers:MicroInteractions.HoverScale="1.10"
                                        helpers:MicroInteractions.PressScale="0.90"
                                        ToolTipService.ToolTip="Show / Hide Synchronized Lyrics">
                                    <FontIcon x:Name="FullscreenLyricsActionIcon"
                                              Glyph="&#xE90A;"
                                              FontSize="17"
                                              Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                </Button>
                            </Grid>

                            <!-- Queue Toggle -->
                            <Grid Grid.Column="2" Width="44" Height="44" HorizontalAlignment="Center">
                                <Border x:Name="FullscreenQueueActionHighlight"
                                        CornerRadius="22"
                                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                        BorderThickness="1"
                                        Opacity="{x:Bind ViewModel.FullscreenQueuePillHighlightOpacity, Mode=OneWay}"
                                        IsHitTestVisible="False">
                                    <Border.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.22" />
                                    </Border.OpacityTransition>
                                </Border>
                                <Button Command="{x:Bind ViewModel.ToggleFullscreenQueueCommand, Mode=OneWay}"
                                        Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                        Width="44" Height="44"
                                        CornerRadius="22"
                                        Padding="0"
                                        helpers:MicroInteractions.HoverScale="1.10"
                                        helpers:MicroInteractions.PressScale="0.90"
                                        ToolTipService.ToolTip="Show / Hide Playing Queue">
                                    <FontIcon x:Name="FullscreenQueueActionIcon"
                                              Glyph="&#xE90B;"
                                              FontSize="17"
                                              Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                </Button>
                            </Grid>
                        </Grid>
                    </controls:LiquidGlassPanel>

                    <!-- 3F. Ergonomic Windows Volume Bar Pill (Travels cleanly with the Left Deck) -->
                    <controls:LiquidGlassPanel Width="264" Height="38"
                                               HorizontalAlignment="Center"
                                               GlassCornerRadius="19"
                                               GlassPadding="12,0"
                                               SampleLiveBackdrop="True">
                        <Grid ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Command="{x:Bind ViewModel.ToggleMuteCommand, Mode=OneWay}"
                                    Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                    Width="28" Height="28"
                                    CornerRadius="14"
                                    Padding="0"
                                    helpers:MicroInteractions.HoverScale="1.12"
                                    helpers:MicroInteractions.PressScale="0.90"
                                    ToolTipService.ToolTip="Mute / Unmute">
                                <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}"
                                          FontSize="13.5"
                                          Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                            </Button>

                            <controls:LiquidGlassVolumeSlider Grid.Column="1"
                                                              Value="{x:Bind ViewModel.VolumePercent, Mode=TwoWay}"
                                                              VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind ViewModel.FormattedVolumePercent, Mode=OneWay}"
                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource FullscreenSecondaryInkBrush}"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       MinWidth="24" />
                        </Grid>
                    </controls:LiquidGlassPanel>
                </StackPanel>

                <!-- COLUMN 1: RIGHT BORDERLESS COLLAPSIBLE LYRICS & PLAYING QUEUE (ZERO Dark Container Box!) -->
                <Grid x:Name="FullscreenSidePanelRoot"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      RowSpacing="8">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.36" />
                    </Grid.OpacityTransition>
                    <Grid.TranslationTransition>
                        <Vector3Transition Duration="0:0:0.36" />
                    </Grid.TranslationTransition>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Centered LiquidGlass Tab Switcher: [Lyrics | Queue] -->
                    <controls:LiquidGlassPanel Grid.Row="0"
                                               Width="216" Height="40"
                                               HorizontalAlignment="Center"
                                               GlassCornerRadius="20"
                                               GlassPadding="3"
                                               SampleLiveBackdrop="True"
                                               HighlightAlphaMultiplier="0.65">
                        <Grid x:Name="FullscreenSlicerContainer">
                            <Grid x:Name="FullscreenSlicerIndicatorHost"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Stretch"
                                  Width="104"
                                  IsHitTestVisible="False">
                                <Border x:Name="FullscreenSlicerActiveBorder"
                                        CornerRadius="17"
                                        Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                                        BorderBrush="{ThemeResource TokenActiveSegmentBorderBrush}"
                                        BorderThickness="1" />
                                <controls:LiquidGlassPanel x:Name="FullscreenSlicerLiquidGlass"
                                                           GlassCornerRadius="17"
                                                           SampleLiveBackdrop="True"
                                                           IsDraggableLens="True"
                                                           TintOpacityOverride="0.18"
                                                           HighlightAlphaMultiplier="0.90"
                                                           Opacity="0" />
                            </Grid>

                            <Grid x:Name="FullscreenSlicerButtonsGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="FsBtnLyrics"
                                        Grid.Column="0"
                                        Click="OnFullscreenSlicerButtonClicked"
                                        Command="{x:Bind ViewModel.SelectFullscreenTabCommand, Mode=OneWay}"
                                        CommandParameter="Lyrics"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="17"
                                        Padding="0,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE90A;" FontSize="12.5" Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                        <TextBlock Text="Lyrics"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="FsBtnQueue"
                                        Grid.Column="1"
                                        Click="OnFullscreenSlicerButtonClicked"
                                        Command="{x:Bind ViewModel.SelectFullscreenTabCommand, Mode=OneWay}"
                                        CommandParameter="Queue"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="17"
                                        Padding="0,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE90B;" FontSize="12.5" Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                        <TextBlock Text="Queue"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </controls:LiquidGlassPanel>

                    <!-- Tab Content Host (Floating Directly Over Luminous Backdrop — NO Dark Box!) -->
                    <Grid x:Name="FullscreenSideTabContentHost" Grid.Row="1" Background="Transparent">

                        <!-- TAB A: SYNCHRONIZED LYRICS (Reusing Exact Windows Now Playing Win2D Engine + Vertical Alpha Edge Fade) -->
                        <Grid x:Name="FullscreenLyricsPanelRoot"
                              Visibility="{x:Bind ViewModel.FullscreenSidePanelLyricsVisibility, Mode=OneWay}"
                              Background="Transparent"
                              RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Lyrics Action Header: Lyrics Provider Indicator right beside Import .LRC -->
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        Margin="8,2,8,2">
                                <controls:LiquidGlassPanel Height="30"
                                                           GlassCornerRadius="15"
                                                           GlassPadding="12,0"
                                                           SampleLiveBackdrop="True">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="6.5" Height="6.5" CornerRadius="3.25"
                                                Background="{ThemeResource TokenPrimaryAccentBrush}"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentLyricsProviderBadge, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenSubheadingFontFamily}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource FullscreenPrimaryInkBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </controls:LiquidGlassPanel>

                                <controls:LiquidGlassPanel Height="30"
                                                           GlassCornerRadius="15"
                                                           GlassPadding="2,0"
                                                           SampleLiveBackdrop="True"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.ImportLrcForCurrentTrackCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            Height="30"
                                            CornerRadius="15"
                                            Padding="12,0"
                                            ToolTipService.ToolTip="Import a synchronized .lrc lyric file for the current song">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8E5;"
                                                      FontSize="11.5"
                                                      Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                            <TextBlock Text="Import .LRC"
                                                       FontFamily="{StaticResource TokenSubheadingFontFamily}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                        </StackPanel>
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </StackPanel>

                            <!-- Borderless Synchronized Lyrics Canvas with Pixel-Smooth Top & Bottom Vertical Alpha Edge Fade -->
                            <Grid Grid.Row="1" Background="Transparent">
                                <controls:SynchronizedLyricsCanvasControl x:Name="FullscreenSynchronizedLyricsControl"
                                                                          x:Load="{x:Bind ViewModel.IsFullscreenNowPlayingOpen, Mode=OneWay}"
                                                                          Visibility="{x:Bind ViewModel.LyricsContentVisibility, Mode=OneWay}"
                                                                          SyncFontSize="25"
                                                                          EnableVerticalEdgeFade="True"
                                                                          Lines="{x:Bind ViewModel.CurrentLyrics, Mode=OneWay}"
                                                                          PositionSeconds="{x:Bind ViewModel.CurrentPositionSeconds, Mode=OneWay}"
                                                                          IsPlaying="{x:Bind ViewModel.IsPlaying, Mode=OneWay}"
                                                                          IsLightMode="{x:Bind ViewModel.IsLightMode, Mode=OneWay}"
                                                                          LineClicked="OnFullscreenSynchronizedLyricLineClicked"
                                                                          UserScrollingChanged="OnFullscreenLyricsUserScrollingChanged" />

                                <controls:LyricsSkeletonControl x:Name="FullscreenLyricsSkeletonControl"
                                                                Visibility="{x:Bind ViewModel.LyricsLoadingVisibility, Mode=OneWay}"
                                                                IsActive="{x:Bind ViewModel.IsLyricsLoading, Mode=OneWay}"
                                                                IsLightMode="{x:Bind ViewModel.IsLightMode, Mode=OneWay}"
                                                                IsFullscreen="True" />

                                <controls:LyricsNotFoundControl x:Name="FullscreenLyricsNotFoundControl"
                                                                Visibility="{x:Bind ViewModel.LyricsNotFoundVisibility, Mode=OneWay}"
                                                                IsActive="{x:Bind ViewModel.IsLyricsNotFound, Mode=OneWay}"
                                                                IsLightMode="{x:Bind ViewModel.IsLightMode, Mode=OneWay}"
                                                                IsFullscreen="True"
                                                                Title="{x:Bind ViewModel.LyricsEmptyTitle, Mode=OneWay}"
                                                                Subtitle="{x:Bind ViewModel.LyricsEmptySubtitle, Mode=OneWay}"
                                                                HelperText="{x:Bind ViewModel.LyricsEmptyHelperText, Mode=OneWay}" />

                                <!-- Floating Sync Recenter Pill (Appears when manually scrolled) -->
                                <Grid x:Name="FullscreenLyricsSyncPillHost"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,12,18">
                                    <controls:LiquidGlassPanel Height="34"
                                                               GlassCornerRadius="17"
                                                               GlassPadding="2,0"
                                                               SampleLiveBackdrop="True"
                                                               EnableHoverScale="True">
                                        <Button Click="OnFullscreenLyricsSyncClicked"
                                                Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                                Height="34"
                                                CornerRadius="17"
                                                Padding="14,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE895;"
                                                          FontSize="12"
                                                          Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                                <TextBlock Text="Sync"
                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </controls:LiquidGlassPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- TAB B: PLAYING QUEUE (Reusing Exact Windows Now Playing Cards + Jelly Drag + Smooth Vertical Edge Fade) -->
                        <Grid x:Name="FullscreenQueuePanelRoot"
                              Visibility="{x:Bind ViewModel.FullscreenSidePanelQueueVisibility, Mode=OneWay}"
                              Background="Transparent"
                              RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Playing Queue Header Pills -->
                            <Grid Grid.Row="0" Margin="6,2,6,0">
                                <controls:LiquidGlassPanel HorizontalAlignment="Left"
                                                           Height="30"
                                                           GlassCornerRadius="15"
                                                           GlassPadding="12,0"
                                                           SampleLiveBackdrop="True">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE90B;"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                        <TextBlock Text="Playing Queue"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                    </StackPanel>
                                </controls:LiquidGlassPanel>

                                <controls:LiquidGlassPanel HorizontalAlignment="Right"
                                                           Height="30"
                                                           GlassCornerRadius="15"
                                                           GlassPadding="12,0"
                                                           SampleLiveBackdrop="True">
                                    <TextBlock Text="{x:Bind ViewModel.QueueCountSummary, Mode=OneWay}"
                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource FullscreenSecondaryInkBrush}"
                                               VerticalAlignment="Center" />
                                </controls:LiquidGlassPanel>
                            </Grid>

                            <!-- Borderless Floating Queue List with Smooth Top & Bottom Edge Fade -->
                            <ScrollViewer x:Name="FullscreenQueueScrollViewer"
                                          Grid.Row="1"
                                          Style="{StaticResource LiquidGlassScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          ViewChanged="OnFullscreenQueueScrollViewerViewChanged"
                                          SizeChanged="OnFullscreenQueueScrollViewerSizeChanged"
                                          Loaded="OnFullscreenQueueScrollViewerLoaded">
                                <StackPanel Spacing="8" Padding="4,18,4,42">
                                    <!-- Active Now Playing Card (Exact Sidebar LiquidGlass + 4-Bar Animated Equalizer) -->
                                    <Grid x:Name="FullscreenActiveQueueCardHost">
                                        <controls:LiquidGlassPanel GlassCornerRadius="16"
                                                                   GlassPadding="0"
                                                                   SampleLiveBackdrop="True"
                                                                   TintOpacityOverride="0.34"
                                                                   HighlightAlphaMultiplier="0.65">
                                            <Border x:Name="FullscreenActiveQueueCardBorder"
                                                    CornerRadius="16"
                                                    Padding="10,8"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                    RightTapped="OnSidebarCurrentTrackRightTapped">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Width="44" Height="44"
                                                            CornerRadius="10"
                                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                            BorderBrush="{ThemeResource FullscreenQueueCardBorderBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid Opacity="{x:Bind ViewModel.CurrentTrack.DefaultCoverIconOpacity, Mode=OneWay}">
                                                                <FontIcon Glyph="&#xEC4F;"
                                                                          FontSize="16"
                                                                          Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Border CornerRadius="9"
                                                                    Opacity="{x:Bind ViewModel.CurrentTrack.CoverArtOpacity, Mode=OneWay}">
                                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind ViewModel.CurrentTrack.SafeCoverArtUri, Mode=OneWay}"
                                                                       Stretch="UniformToFill" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1.5">
                                                        <Grid HorizontalAlignment="Left" ColumnSpacing="5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="FullscreenActiveCardTitleText"
                                                                       Grid.Column="0"
                                                                       Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay}"
                                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                       FontSize="13.5"
                                                                       FontWeight="Bold"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <controls:ExplicitBadgeControl Grid.Column="1"
                                                                                           IsCompact="True"
                                                                                           Visibility="{x:Bind ViewModel.CurrentTrack.IsExplicit, Mode=OneWay}"
                                                                                           VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Artist, Mode=OneWay}"
                                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                   FontSize="11.5"
                                                                   MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{ThemeResource FullscreenSecondaryInkBrush}" />
                                                    </StackPanel>

                                                    <!-- 4-Bar Animated Equalizer Pill -->
                                                    <Border x:Name="FullscreenActiveEqPill"
                                                            Grid.Column="2"
                                                            CornerRadius="9"
                                                            Padding="8,5"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="2.5"
                                                                    Height="15"
                                                                    VerticalAlignment="Center">
                                                            <Border x:Name="FullscreenEqBar1" Width="2.5" Height="5" CornerRadius="1.25" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                            <Border x:Name="FullscreenEqBar2" Width="2.5" Height="9" CornerRadius="1.25" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                            <Border x:Name="FullscreenEqBar3" Width="2.5" Height="6" CornerRadius="1.25" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                            <Border x:Name="FullscreenEqBar4" Width="2.5" Height="11" CornerRadius="1.25" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Static Handle Visual Alignment Indicator -->
                                                    <StackPanel Grid.Column="3"
                                                                Spacing="3.5"
                                                                VerticalAlignment="Center"
                                                                Margin="4,0,6,0"
                                                                Opacity="0.38">
                                                        <Border Width="13" Height="1.8" CornerRadius="0.9" Background="{ThemeResource FullscreenSecondaryInkBrush}" />
                                                        <Border Width="13" Height="1.8" CornerRadius="0.9" Background="{ThemeResource FullscreenSecondaryInkBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </controls:LiquidGlassPanel>
                                    </Grid>

                                    <!-- Upcoming Queue Cards with LiquidGlass & Jelly Drag Reorder -->
                                    <ItemsRepeater x:Name="FullscreenQueueItemsControl"
                                                   x:Load="{x:Bind ViewModel.IsFullscreenNowPlayingOpen, Mode=OneWay}"
                                                   ItemsSource="{x:Bind ViewModel.Queue, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="entities:TrackItem">
                                                <Border CornerRadius="16"
                                                        Background="{ThemeResource FullscreenQueueCardBrush}"
                                                        BorderBrush="{ThemeResource FullscreenQueueCardBorderBrush}"
                                                        BorderThickness="0.9"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        Tapped="OnQueueItemTapped"
                                                        RightTapped="OnTrackRowRightTapped"
                                                        Tag="{x:Bind}">
                                                    <Border CornerRadius="16"
                                                            Padding="10,8"
                                                            Background="Transparent">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Width="44" Height="44"
                                                                    CornerRadius="10"
                                                                    Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                                                    BorderBrush="{ThemeResource FullscreenQueueCardBorderBrush}"
                                                                    BorderThickness="1">
                                                                <Grid>
                                                                    <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xEC4F;"
                                                                                  FontSize="16"
                                                                                  Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <Border CornerRadius="9"
                                                                            Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                        <Image helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                               Stretch="UniformToFill" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1.5">
                                                                <Grid HorizontalAlignment="Left" ColumnSpacing="5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{x:Bind Title, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                               FontSize="13.5"
                                                                               FontWeight="SemiBold"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{ThemeResource FullscreenPrimaryInkBrush}"
                                                                               VerticalAlignment="Center" />
                                                                    <controls:ExplicitBadgeControl Grid.Column="1"
                                                                                                   IsCompact="True"
                                                                                                   Visibility="{x:Bind IsExplicit, Mode=OneWay}"
                                                                                                   VerticalAlignment="Center" />
                                                                    <FontIcon Grid.Column="2"
                                                                              Glyph="&#xE896;"
                                                                              FontSize="10"
                                                                              Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                              Opacity="{x:Bind DownloadedBadgeOpacity, Mode=OneWay}"
                                                                              VerticalAlignment="Center" />
                                                                </Grid>
                                                                <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                           FontSize="11.5"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{ThemeResource FullscreenSecondaryInkBrush}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Spacing="3"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{ThemeResource FullscreenSecondaryInkBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,2,0" />

                                                                <Button Click="OnTrackRowMoreClicked"
                                                                        Tag="{x:Bind}"
                                                                        Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                                        Width="24" Height="26"
                                                                        Opacity="0.72"
                                                                        VerticalAlignment="Center">
                                                                    <FontIcon Glyph="&#xE712;"
                                                                              FontSize="12"
                                                                              Foreground="{ThemeResource FullscreenSecondaryInkBrush}" />
                                                                </Button>

                                                                <!-- Dedicated '=' Jelly Drag Handle -->
                                                                <Border Background="Transparent"
                                                                        Padding="6,8"
                                                                        Tag="{x:Bind}"
                                                                        PointerPressed="OnFullscreenQueueDragHandlePointerPressed"
                                                                        PointerMoved="OnQueueDragHandlePointerMoved"
                                                                        PointerReleased="OnQueueDragHandlePointerReleased"
                                                                        PointerCanceled="OnQueueDragHandlePointerCanceled"
                                                                        PointerCaptureLost="OnQueueDragHandlePointerCaptureLost"
                                                                        ToolTipService.ToolTip="Drag to reorder">
                                                                    <StackPanel Spacing="3.5" VerticalAlignment="Center">
                                                                        <Border Width="13" Height="1.8" CornerRadius="0.9" Background="{ThemeResource FullscreenSecondaryInkBrush}" />
                                                                        <Border Width="13" Height="1.8" CornerRadius="0.9" Background="{ThemeResource FullscreenSecondaryInkBrush}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 4. Floating GPU Visualizer Selector & Custom .xviz.json Importer Popup (Opened via Top-Right '...' Menu) -->
            <controls:LiquidGlassPanel x:Name="FullscreenVisualizerSelectorPanel"
                                       x:Load="{x:Bind ViewModel.IsVisualizerSelectorOpen, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.VisualizerSelectorVisibility, Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,94,28,0"
                                       Width="316"
                                       GlassCornerRadius="24"
                                       GlassPadding="16,14"
                                       SampleLiveBackdrop="True"
                                       Canvas.ZIndex="28">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="GPU Music Visualizers"
                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource FullscreenPrimaryInkBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="+ Import"
                                Command="{x:Bind ViewModel.ImportCustomVisualizerCommand, Mode=OneWay}"
                                Style="{StaticResource LiquidPillActiveSegmentButtonStyle}"
                                Padding="10,4"
                                FontSize="11"
                                helpers:MicroInteractions.HoverScale="1.05"
                                helpers:MicroInteractions.PressScale="0.94"
                                ToolTipService.ToolTip="Import a custom GPU visualizer JSON file (.xviz.json)" />
                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.ToggleVisualizerSelectorCommand, Mode=OneWay}"
                                Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                Width="28" Height="28"
                                CornerRadius="14"
                                Padding="0"
                                ToolTipService.ToolTip="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableVisualizers, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:VisualizerDefinition">
                                <Button Click="OnVisualizerPresetClicked"
                                        Tag="{x:Bind}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                        BorderBrush="{ThemeResource FullscreenEdgeHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="12,8"
                                        helpers:MicroInteractions.HoverScale="1.03"
                                        helpers:MicroInteractions.PressScale="0.96">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                       FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource FullscreenPrimaryInkBrush}" />
                                            <TextBlock Text="{x:Bind Author, Mode=OneWay}"
                                                       FontFamily="{StaticResource TokenBodyFontFamily}"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource FullscreenSecondaryInkBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:LiquidGlassPanel>

            <!-- 5. Floating Audio DSP, Equalizer, Playback Speed, Pitch, 1-Click Nightcore & Music Sleep Timer Panel -->
            <controls:AudioDspPanelControl x:Name="FullscreenAudioDspPanel"
                                           x:Load="{x:Bind ViewModel.IsAudioDspPanelOpen, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.AudioDspPanelVisibility, Mode=OneWay}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Margin="0,94,28,0"
                                           Canvas.ZIndex="29"
                                           CloseRequested="OnFullscreenAudioDspPanelCloseRequested" />
        </Grid>
    </Grid>
</Page>
