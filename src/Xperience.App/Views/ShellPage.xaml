                                        BorderThickness="0"
                                        Padding="6,0"
                                        HorizontalAlignment="Center"
                                        FontFamily="{StaticResource TokenSubheadingFontFamily}"
                                        FontSize="14.5"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource AlbumArtistLinkBrush}"
                                        helpers:MicroInteractions.HoverScale="1.05"
                                        helpers:MicroInteractions.PressScale="0.95" />

                                <!-- Year • Song Count • Total Duration Metadata Line (or Skeleton) -->
                                <Grid HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentAlbumDetail.DisplayMetadataLine, Mode=OneWay}"
