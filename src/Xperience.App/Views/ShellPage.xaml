                                        Width="44"
                                        Height="44"
                                        CornerRadius="22"
                                        Padding="0"
                                        ToolTipService.ToolTip="Back">
                                    <FontIcon Glyph="&#xE72B;"
                                              FontSize="14"
                                              Foreground="{StaticResource AlbumPrimaryInkBrush}" />
                                </Button>
                            </controls:LiquidGlassPanel>
                        </StackPanel>

                        <!-- Two-Column Main Split: Left Album Info & Controls | Right Flat Tracklist -->
                        <Grid ColumnSpacing="48" Margin="6,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: Cover + Faithful Apple Canvas + Title + Artist + Year/Count/Duration + LiquidGlass Play/Shuffle + Expandable Description -->
