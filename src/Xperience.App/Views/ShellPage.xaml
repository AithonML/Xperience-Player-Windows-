<Page
    x:Class="Xperience.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:controls="using:Xperience.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:entities="using:Xperience.Core.Domain.Entities"
    xmlns:helpers="using:Xperience.App.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Xperience.Core.Domain.Models"
    xmlns:views="using:Xperience.App.Views"
    xmlns:vm="using:Xperience.App.ViewModels"
    FontFamily="{StaticResource TokenBodyFontFamily}"
    Background="{ThemeResource TokenAppBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="ArtistAmbientBackgroundBrush" Color="#FF1E222A" />
        <SolidColorBrush x:Key="ArtistCardBackgroundBrush" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="ArtistCardBorderBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="ArtistPrimaryInkBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ArtistSecondaryInkBrush" Color="#CCF1F5F9" />
        <SolidColorBrush x:Key="ArtistSkeletonFillBrush" Color="#24FFFFFF" />

        <SolidColorBrush x:Key="AlbumAmbientBackgroundBrush" Color="#FF1E222A" />
        <SolidColorBrush x:Key="AlbumCardBackgroundBrush" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="AlbumCardBorderBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="AlbumPrimaryInkBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AlbumSecondaryInkBrush" Color="#B8E2E8F0" />
        <SolidColorBrush x:Key="AlbumArtistLinkBrush" Color="#FF22D3EE" />
        <SolidColorBrush x:Key="AlbumTrackActiveBackgroundBrush" Color="#34D4A73A" />
        <SolidColorBrush x:Key="AlbumTrackActiveAccentBrush" Color="#FFD4A73A" />
        <SolidColorBrush x:Key="AlbumSkeletonFillBrush" Color="#24FFFFFF" />

        <SolidColorBrush x:Key="PlaylistAmbientBackgroundBrush" Color="#FF1E222A" />
        <SolidColorBrush x:Key="PlaylistCardBackgroundBrush" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="PlaylistCardBorderBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="PlaylistPrimaryInkBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="PlaylistSecondaryInkBrush" Color="#B8E2E8F0" />
        <SolidColorBrush x:Key="PlaylistArtistLinkBrush" Color="#FF22D3EE" />
        <SolidColorBrush x:Key="PlaylistTrackActiveBackgroundBrush" Color="#34D4A73A" />
        <SolidColorBrush x:Key="PlaylistTrackActiveAccentBrush" Color="#FFD4A73A" />
        <SolidColorBrush x:Key="PlaylistSkeletonFillBrush" Color="#24FFFFFF" />

        <!-- Shared Android-Style Library Queue Song Row Template (Overview, Songs A-Z, Recently Added) -->
        <DataTemplate x:Key="LibraryQueueSongRowTemplate" x:DataType="entities:TrackItem">
            <Grid MinHeight="64"
                  CornerRadius="16"
                  Tapped="OnLibrarySongRowTapped"
                  RightTapped="OnTrackRowRightTapped"
                  PointerEntered="OnLibrarySongRowPointerEntered"
                  PointerExited="OnLibrarySongRowPointerExited"
                  Tag="{x:Bind}"
                  Background="Transparent"
                  helpers:MicroInteractions.HoverScale="1.008"
                  helpers:MicroInteractions.PressScale="0.988">

                <!-- Layer 0: Base Frosted Translucent Glass Surface -->
                <Border CornerRadius="16"
                        Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                        BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                        BorderThickness="0.9"
                        IsHitTestVisible="False" />

                <!-- Layer 1: Active Playing Track Illuminated Accent Border & Fill -->
                <Border CornerRadius="16"
                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                        BorderThickness="1.25"
                        Opacity="{x:Bind ActiveRowHighlightOpacity, Mode=OneWay}"
                        IsHitTestVisible="False">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.22" />
                    </Border.OpacityTransition>
                </Border>

                <!-- Layer 2: Smooth Hover Highlight Layer -->
                <Border CornerRadius="16"
                        Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                </Border>

                <!-- Layer 3: Song Content (48x48 Cover, Title + [E], Artist • Album, Duration / Equalizer, Heart, Vertical ⋮) -->
                <Grid Padding="10,8,6,8" ColumnSpacing="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Column 0: Rounded-Square Cover Artwork (<Image> only, never ImageBrush) + Active Equalizer Scrim -->
                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            CornerRadius="11"
                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                            BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                            BorderThickness="0.7"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                <FontIcon Glyph="&#xEC4F;"
                                          FontSize="17"
                                          Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <Border CornerRadius="10.5"
                                    Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                <Image helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                            </Border>
                            <!-- Active Playing Scrim + 3-Bar Equalizer Overlay -->
                            <Border CornerRadius="10.5"
                                    Background="#A8080A12"
                                    BorderBrush="{ThemeResource TokenPrimaryAccentBrush}"
                                    BorderThickness="1.2"
                                    Opacity="{x:Bind PlayingIndicatorOpacity, Mode=OneWay}"
                                    IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="2.5"
                                            Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="3" Height="11" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                    <Border Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                    <Border Width="3" Height="9" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Column 1: Title (+ [E] + Offline Icon) & Artist • Album Subtitle -->
                    <StackPanel Grid.Column="1"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <Grid ColumnSpacing="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Opacity="{x:Bind InactiveTitleOpacity, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Opacity="{x:Bind ActiveTitleOpacity, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <controls:ExplicitBadgeControl Grid.Column="1"
                                                           IsCompact="True"
                                                           Visibility="{x:Bind IsExplicit, Mode=OneWay}"
                                                           VerticalAlignment="Center" />
                            <FontIcon Grid.Column="2"
                                      Glyph="&#xE896;"
                                      FontSize="10.5"
                                      Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                      Opacity="{x:Bind DownloadedBadgeOpacity, Mode=OneWay}"
                                      ToolTipService.ToolTip="Available Offline / Local Audio"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{x:Bind ArtistAlbumDotSubtitle, Mode=OneWay}"
                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Column 2: Duration (or 4-Bar Accent Equalizer Pill when Currently Playing) -->
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                   Opacity="{x:Bind InactiveTitleOpacity, Mode=OneWay}"
                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                        <Border CornerRadius="10"
                                Padding="7,4"
                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                BorderThickness="1"
                                Opacity="{x:Bind PlayingIndicatorOpacity, Mode=OneWay}"
                                IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="2" Height="12" VerticalAlignment="Center">
                                <Border Width="2.5" Height="7" CornerRadius="1.25" VerticalAlignment="Bottom" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                <Border Width="2.5" Height="12" CornerRadius="1.25" VerticalAlignment="Bottom" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                <Border Width="2.5" Height="9" CornerRadius="1.25" VerticalAlignment="Bottom" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                <Border Width="2.5" Height="6" CornerRadius="1.25" VerticalAlignment="Bottom" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Column 3: Heart / Love Button (Accent-colored filled heart when liked) -->
                    <Button Grid.Column="3"
                            Click="OnTrackRowLikeClicked"
                            Tag="{x:Bind}"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="34"
                            Height="34"
                            CornerRadius="17"
                            Padding="0"
                            ToolTipService.ToolTip="Like"
                            helpers:MicroInteractions.HoverScale="1.15"
                            helpers:MicroInteractions.PressScale="0.88">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEB51;"
                                      Opacity="0.76"
                                      FontSize="14"
                                      Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                            <FontIcon Glyph="&#xEB52;"
                                      FontSize="14"
                                      Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                      Visibility="{x:Bind IsLiked, Mode=OneWay}" />
                        </Grid>
                    </Button>

                    <!-- Column 4: Vertical 3-Dots More Options Button (NO Play Circle Button) -->
                    <Button Grid.Column="4"
                            Click="OnTrackRowMoreClicked"
                            Tag="{x:Bind}"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="34"
                            Height="34"
                            CornerRadius="17"
                            Padding="0"
                            ToolTipService.ToolTip="Song Options"
                            helpers:MicroInteractions.HoverScale="1.14"
                            helpers:MicroInteractions.PressScale="0.88">
                        <FontIcon Glyph="&#xE712;"
                                  FontSize="13.5"
                                  Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Liked Songs Row Template (Ruby Heart Fill matching Android LikedScreen.kt) -->
        <DataTemplate x:Key="LikedSongRowTemplate" x:DataType="entities:TrackItem">
            <Grid MinHeight="64"
                  CornerRadius="16"
                  Tapped="OnLibrarySongRowTapped"
                  RightTapped="OnTrackRowRightTapped"
                  PointerEntered="OnLibrarySongRowPointerEntered"
                  PointerExited="OnLibrarySongRowPointerExited"
                  Tag="{x:Bind}"
                  Background="Transparent"
                  helpers:MicroInteractions.HoverScale="1.008"
                  helpers:MicroInteractions.PressScale="0.988">

                <!-- Layer 0: Base Frosted Translucent Glass Surface -->
                <Border CornerRadius="16"
                        Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                        BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                        BorderThickness="0.9"
                        IsHitTestVisible="False" />

                <!-- Layer 1: Active Playing Track Illuminated Accent Border & Fill -->
                <Border CornerRadius="16"
                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                        BorderThickness="1.25"
                        Opacity="{x:Bind ActiveRowHighlightOpacity, Mode=OneWay}"
                        IsHitTestVisible="False">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.22" />
                    </Border.OpacityTransition>
                </Border>

                <!-- Layer 2: Smooth Hover Highlight Layer -->
                <Border CornerRadius="16"
                        Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                </Border>

                <!-- Layer 3: Song Content -->
                <Grid Padding="10,8,6,8" ColumnSpacing="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            CornerRadius="11"
                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                            BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                            BorderThickness="0.7"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                <FontIcon Glyph="&#xEC4F;"
                                          FontSize="17"
                                          Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <Border CornerRadius="10.5"
                                    Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                <Image helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                            </Border>
                            <Border CornerRadius="10.5"
                                    Background="#A8080A12"
                                    BorderBrush="{ThemeResource TokenPrimaryAccentBrush}"
                                    BorderThickness="1.2"
                                    Opacity="{x:Bind PlayingIndicatorOpacity, Mode=OneWay}"
                                    IsHitTestVisible="False">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="2.5"
                                            Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="3" Height="11" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                    <Border Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                    <Border Width="3" Height="9" CornerRadius="1.5" VerticalAlignment="Center" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <Grid ColumnSpacing="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Opacity="{x:Bind InactiveTitleOpacity, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Opacity="{x:Bind ActiveTitleOpacity, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <controls:ExplicitBadgeControl Grid.Column="1"
                                                           IsCompact="True"
                                                           Visibility="{x:Bind IsExplicit, Mode=OneWay}"
                                                           VerticalAlignment="Center" />
                            <FontIcon Grid.Column="2"
                                      Glyph="&#xE896;"
                                      FontSize="10.5"
                                      Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                      Opacity="{x:Bind DownloadedBadgeOpacity, Mode=OneWay}"
                                      ToolTipService.ToolTip="Available Offline / Local Audio"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{x:Bind ArtistAlbumDotSubtitle, Mode=OneWay}"
                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="2,0,0,0">
                        <TextBlock Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                   Opacity="{x:Bind InactiveTitleOpacity, Mode=OneWay}"
                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                        <Border CornerRadius="10"
                                Padding="7,4"
                                Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                                BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                                BorderThickness="1"
                                Opacity="{x:Bind PlayingIndicatorOpacity, Mode=OneWay}"
                                IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="2" Height="12" VerticalAlignment="Center">
                                <Border Width="2.5" Height="7" CornerRadius="1.25" VerticalAlignment="Bottom" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                <Border Width="2.5" Height="12" CornerRadius="1.25" VerticalAlignment="Bottom" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                <Border Width="2.5" Height="9" CornerRadius="1.25" VerticalAlignment="Bottom" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                                <Border Width="2.5" Height="6" CornerRadius="1.25" VerticalAlignment="Bottom" Background="{ThemeResource TokenPrimaryAccentBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Column 3: Ruby Heart / Unlike Button -->
                    <Button Grid.Column="3"
                            Click="OnTrackRowLikeClicked"
                            Tag="{x:Bind}"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="34"
                            Height="34"
                            CornerRadius="17"
                            Padding="0"
                            ToolTipService.ToolTip="Unlike"
                            helpers:MicroInteractions.HoverScale="1.15"
                            helpers:MicroInteractions.PressScale="0.88">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEB51;"
                                      Opacity="0.76"
                                      FontSize="14"
                                      Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                            <FontIcon Glyph="&#xEB52;"
                                      FontSize="14"
                                      Foreground="#FFFF2D55"
                                      Visibility="{x:Bind IsLiked, Mode=OneWay}" />
                        </Grid>
                    </Button>

                    <!-- Column 4: Vertical 3-Dots More Options Button -->
                    <Button Grid.Column="4"
                            Click="OnTrackRowMoreClicked"
                            Tag="{x:Bind}"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="34"
                            Height="34"
                            CornerRadius="17"
                            Padding="0"
                            ToolTipService.ToolTip="Song Options"
                            helpers:MicroInteractions.HoverScale="1.14"
                            helpers:MicroInteractions.PressScale="0.88">
                        <FontIcon Glyph="&#xE712;"
                                  FontSize="13.5"
                                  Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                  RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="90" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Liked Right Pane: "Fans Also Like & Recommended" Row Template (Android LikedRecommendationRow parity) -->
        <DataTemplate x:Key="LikedRecommendationRowTemplate" x:DataType="entities:TrackItem">
            <Grid MinHeight="64"
                  CornerRadius="16"
                  Tapped="OnLikedRecommendationTapped"
                  RightTapped="OnTrackRowRightTapped"
                  PointerEntered="OnLibrarySongRowPointerEntered"
                  PointerExited="OnLibrarySongRowPointerExited"
                  Tag="{x:Bind}"
                  Background="Transparent"
                  helpers:MicroInteractions.HoverScale="1.012"
                  helpers:MicroInteractions.PressScale="0.986">

                <!-- Layer 0: Base Translucent Card Surface -->
                <Border CornerRadius="16"
                        Background="{ThemeResource TokenSurfaceBackgroundBrush}"
                        BorderBrush="{ThemeResource TokenGlassBorderBrush}"
                        BorderThickness="0.9"
                        IsHitTestVisible="False" />

                <!-- Layer 1: Active Playing Track Accent Fill & Border -->
                <Border CornerRadius="16"
                        Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                        BorderBrush="{ThemeResource TokenAccentBadgeBorderBrush}"
                        BorderThickness="1.25"
                        Opacity="{x:Bind ActiveRowHighlightOpacity, Mode=OneWay}"
                        IsHitTestVisible="False">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.22" />
                    </Border.OpacityTransition>
                </Border>

                <!-- Layer 2: Smooth Hover Highlight -->
                <Border CornerRadius="16"
                        Background="{ThemeResource TokenActiveSegmentBackgroundBrush}"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                </Border>

                <!-- Layer 3: 48x48 Cover | Title + [E] & Artist | Heart | Circular Accent Play / EQ -->
                <Grid Padding="10,8,10,8" ColumnSpacing="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            CornerRadius="11"
                            Background="{ThemeResource TokenAccentBadgeBackgroundBrush}"
                            BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                            BorderThickness="0.7"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                <FontIcon Glyph="&#xEC4F;"
                                          FontSize="17"
                                          Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <Border CornerRadius="10.5"
                                    Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                <Image helpers:BitmapDecodeHelper.DecodeWidth="96" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <Grid ColumnSpacing="5" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Opacity="{x:Bind InactiveTitleOpacity, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                           Opacity="{x:Bind ActiveTitleOpacity, Mode=OneWay}"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <controls:ExplicitBadgeControl Grid.Column="1"
                                                           IsCompact="True"
                                                           Visibility="{x:Bind IsExplicit, Mode=OneWay}"
                                                           VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Heart Button -->
                    <Button Grid.Column="2"
                            Click="OnTrackRowLikeClicked"
                            Tag="{x:Bind}"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="32"
                            Height="32"
                            CornerRadius="16"
                            Padding="0"
                            ToolTipService.ToolTip="Like"
                            helpers:MicroInteractions.HoverScale="1.15"
                            helpers:MicroInteractions.PressScale="0.88">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEB51;"
                                      Opacity="0.78"
                                      FontSize="13.5"
                                      Foreground="{ThemeResource TokenSecondaryTextBrush}" />
                            <FontIcon Glyph="&#xEB52;"
                                      FontSize="13.5"
                                      Foreground="#FFFF2D55"
                                      Visibility="{x:Bind IsLiked, Mode=OneWay}" />
                        </Grid>
                    </Button>

                    <!-- Circular Accent Play Button (or 3-Bar Equalizer when Active) -->
                    <Button Grid.Column="3"
                            Click="OnLikedRecommendationPlayClicked"
                            Tag="{x:Bind}"
                            Width="32"
                            Height="32"
                            CornerRadius="16"
                            Padding="0"
                            Background="{ThemeResource TokenPrimaryAccentBrush}"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Play"
                            helpers:MicroInteractions.HoverScale="1.12"
                            helpers:MicroInteractions.PressScale="0.90">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;"
                                      FontSize="11"
                                      Margin="1.5,0,0,0"
                                      Foreground="#FF071018"
                                      Opacity="{x:Bind InactiveTitleOpacity, Mode=OneWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="2"
                                        Height="12"
                                        Opacity="{x:Bind PlayingIndicatorOpacity, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="2.5" Height="7" CornerRadius="1.25" VerticalAlignment="Bottom" Background="#FF071018" />
                                <Border Width="2.5" Height="12" CornerRadius="1.25" VerticalAlignment="Bottom" Background="#FF071018" />
                                <Border Width="2.5" Height="8" CornerRadius="1.25" VerticalAlignment="Bottom" Background="#FF071018" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootLayoutGrid"
          FlowDirection="{x:Bind ViewModel.CurrentFlowDirection, Mode=OneWay}"
          Background="{ThemeResource TokenAppBackgroundBrush}">

        <!-- ================================================================================= -->
        <!-- LAYER 1: BACKDROP CAPTURE LAYER (Registered with LiquidGlassBackdropManager)      -->
        <!-- Songs & Catalog scroll full-height (Y=0..Bottom) directly behind the floating     -->
        <!-- Liquid Glass Top Header Bar so header capsules optically refract scrolling items! -->
        <!-- ================================================================================= -->
        <Grid x:Name="MainWorkspaceContainer"
              Background="{ThemeResource TokenAppBackgroundBrush}"
              Padding="12,0,0,0"
              ColumnSpacing="16">

            <Grid.ColumnDefinitions>
                <!-- Left Workspace Column (Full-Height Unclipped Catalog ScrollViewer) -->
                <ColumnDefinition Width="*" />
                <!-- Right Now Playing Sidebar Column (Smoothly collapses to 0 when hidden) -->
                <ColumnDefinition x:Name="WorkspaceRightSidebarColumn" Width="324" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================================= -->
            <!-- COLUMN 0: UNIFIED FULL-HEIGHT CATALOG SCROLLVIEWER                            -->
            <!-- Padding="0" on ScrollViewer ensures ScrollContentPresenter starts at Y=0      -->
            <!-- (the very top of the window) so songs never clip at the header boundary!      -->
            <!-- Inner StackPanel Padding="10,68,14,28" places initial content below header.   -->
            <!-- ============================================================================= -->
            <!-- Ambient 4-Color Aurora Borealis Backdrop (Strictly Top-to-Mid-Screen, dissolves cleanly around Recently Played) -->
            <canvas:CanvasControl x:Name="HomeAuroraCanvas"
                                  Grid.Column="0"
                                  Visibility="{x:Bind ViewModel.HomeAuroraVisibility, Mode=OneWay}"
                                  Height="540"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Stretch"
                                  Margin="-12,0,-20,0"
                                  ClearColor="Transparent"
                                  Draw="OnHomeAuroraCanvasDraw"
                                  IsHitTestVisible="False" />

            <!-- Artist Full-Bleed Ambient Backdrop (Paints edge-to-edge behind scroll & sidebar gap) -->
            <Border x:Name="ArtistDetailFullBleedBackdrop"
                    Grid.Column="0"
                    Visibility="{x:Bind ViewModel.ArtistDetailViewVisibility, Mode=OneWay}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Margin="-12,0,-20,0"
                    Background="{StaticResource ArtistAmbientBackgroundBrush}"
                    IsHitTestVisible="False" />

            <!-- Album Full-Bleed Ambient Backdrop (Paints edge-to-edge behind scroll, top bar & sidebar gap) -->
            <Border x:Name="AlbumDetailFullBleedBackdrop"
                    Grid.Column="0"
                    Visibility="{x:Bind ViewModel.AlbumDetailViewVisibility, Mode=OneWay}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Margin="-12,0,-20,0"
                    Background="{StaticResource AlbumAmbientBackgroundBrush}"
                    IsHitTestVisible="False" />

            <!-- Playlist Full-Bleed Ambient Backdrop (Paints edge-to-edge behind scroll, top bar & sidebar gap) -->
            <Border x:Name="PlaylistDetailFullBleedBackdrop"
                    Grid.Column="0"
                    Visibility="{x:Bind ViewModel.PlaylistDetailViewVisibility, Mode=OneWay}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Margin="-12,0,-20,0"
                    Background="{StaticResource PlaylistAmbientBackgroundBrush}"
                    IsHitTestVisible="False" />

            <ScrollViewer x:Name="CatalogScrollViewer"
                          Grid.Column="0"
                          Style="{StaticResource LiquidGlassScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="-12,0,0,0"
                          Padding="0">
                <Grid>
                    <StackPanel Spacing="12" Padding="22,68,14,32">

                        <!-- ========================================================================= -->
                        <!-- VIEW 1: HOME DISCOVERY SCREEN (Default Startup Screen)                    -->
                        <!-- Unified dynamic Home experience with Aurora lighting & frosted cards      -->
                        <!-- ========================================================================= -->
                        <StackPanel x:Name="HomeSectionRoot"
                                    Visibility="{x:Bind ViewModel.HomeViewVisibility, Mode=OneWay}"
                                    Spacing="22"
                                    Margin="2,2,2,0">

                            <!-- Home Hero Header -->
                            <Grid Margin="2,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Home"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.HomePersonalizedSubtitle, Mode=OneWay}"
                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                               FontSize="12.5"
                                               Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <controls:LiquidGlassPanel Grid.Column="1"
                                                           Height="38"
                                                           VerticalAlignment="Center"
                                                           GlassCornerRadius="19"
                                                           GlassPadding="0"
                                                           EnableHoverScale="True">
                                    <Button Command="{x:Bind ViewModel.RefreshHomeFeedCommand, Mode=OneWay}"
                                            Style="{StaticResource TransparentEmbeddedButtonStyle}"
                                            CornerRadius="19"
                                            Padding="16,0"
                                            FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11.5" Foreground="{ThemeResource TokenPrimaryAccentBrush}" />
                                            <TextBlock Text="Refresh Recommendations" />
                                        </StackPanel>
                                    </Button>
                                </controls:LiquidGlassPanel>
                            </Grid>

                            <!-- 0. Connect Account Prompt Banner (Only when signed out & not snoozed/dismissed) -->
                            <controls:LiquidGlassPanel x:Name="HomeYtmLoginBanner"
                                                       Visibility="{x:Bind ViewModel.HomeYtmLoginPromptVisibility, Mode=OneWay}"
                                                       GlassCornerRadius="24"
                                                       GlassPadding="20,16"
                                                       Margin="2,0,2,0">
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="46" Height="46"
                                            CornerRadius="14"
                                            Background="#2A22D3EE"
                                            BorderBrush="#6622D3EE"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE90B;" FontSize="20" Foreground="#38BDF8" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Connect your YouTube Music account"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="15.5"
                                                   FontWeight="Bold"
                                                   Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                        <TextBlock Text="Sign in to unlock personalized recommendations, your mixes, and new releases from your feed."
                                                   FontFamily="{StaticResource TokenBodyFontFamily}"
                                                   FontSize="12.5"
                                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Command="{x:Bind ViewModel.SnoozeYtmLoginPromptCommand, Mode=OneWay}"
                                                Content="Later"
                                                Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                                BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="18"
                                                Padding="15,7"
                                                FontSize="12"
                                                helpers:MicroInteractions.HoverScale="1.05"
                                                helpers:MicroInteractions.PressScale="0.93" />
                                        <Button Command="{x:Bind ViewModel.DismissYtmLoginPromptCommand, Mode=OneWay}"
                                                Content="Dismiss"
                                                Style="{StaticResource LiquidPillSegmentButtonStyle}"
                                                BorderBrush="{ThemeResource TokenSurfaceBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="18"
                                                Padding="15,7"
                                                FontSize="12"
                                                helpers:MicroInteractions.HoverScale="1.05"
                                                helpers:MicroInteractions.PressScale="0.93" />
                                        <Button Command="{x:Bind ViewModel.OpenYouTubeMusicWebSignInCommand, Mode=OneWay}"
                                                Background="#22D3EE"
                                                Foreground="#06121A"
                                                BorderBrush="#88A5F3FC"
                                                BorderThickness="1"
                                                CornerRadius="18"
                                                Padding="18,7"
                                                FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                FontWeight="Bold"
                                                FontSize="12.5"
                                                helpers:MicroInteractions.HoverScale="1.06"
                                                helpers:MicroInteractions.PressScale="0.92"
                                                helpers:MicroInteractions.HoverElevationY="-2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="#06121A" />
                                                <TextBlock Text="Sign in" Foreground="#06121A" FontWeight="Bold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </controls:LiquidGlassPanel>

                            <!-- 1. Top Picks for You (Editorial Dynamic Carousel with Collage, Spotlight & Scrims) -->
                            <StackPanel Visibility="{x:Bind ViewModel.HomeTopPicksVisibility, Mode=OneWay}"
                                        Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,0,0">
                                    <Border Width="28" Height="28"
                                            CornerRadius="9"
                                            Background="#2422D3EE"
                                            BorderBrush="#5522D3EE"
                                            BorderThickness="1">
                                        <FontIcon Glyph="&#xE734;" FontSize="13" Foreground="#38BDF8" />
                                    </Border>
                                    <TextBlock Text="Top picks for you"
                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                               FontSize="18.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TokenPrimaryTextBrush}" />
                                </StackPanel>

                                <Grid x:Name="HomeTopPicksCarouselHost">
                                    <ScrollViewer x:Name="HomeTopPicksScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Padding="18,14,18,22"
                                                  Loaded="OnHomeHorizontalCarouselLoaded"
                                                  SizeChanged="OnHomeHorizontalCarouselSizeChanged"
                                                  ViewChanged="OnHomeHorizontalCarouselViewChanged">
                                        <ItemsControl x:Name="HomeTopPicksItemsControl"
                                                      ItemsSource="{x:Bind ViewModel.HomeTopPicks, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="14"
                                                                SizeChanged="OnHomeHorizontalItemsPanelSizeChanged" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:TopPickItem">
                                                    <Button Style="{StaticResource TransparentMediaCardButtonStyle}"
                                                            Padding="0"
                                                            Click="OnTopPickCardClicked"
                                                            Tag="{x:Bind}"
                                                            helpers:MicroInteractions.HoverScale="1.045"
                                                            helpers:MicroInteractions.PressScale="0.95"
                                                            helpers:MicroInteractions.HoverElevationY="-5">
                                                        <Border Width="204"
                                                                Height="274"
                                                                CornerRadius="24"
                                                                BorderBrush="#36FFFFFF"
                                                                BorderThickness="1"
                                                                Background="#FF141822">
                                                            <Grid>
                                                                <!-- Full-bleed authentic YouTube Music artwork layer -->
                                                                <Border CornerRadius="23" Visibility="{x:Bind IsSingleCover, Mode=OneWay}">
                                                                    <Image helpers:BitmapDecodeHelper.DecodeWidth="256"
                                                                           helpers:BitmapDecodeHelper.SourceUri="{x:Bind views:ShellPage.ResolveConditionalUri(IsSingleCover, SafeArtworkUri), Mode=OneWay}"
                                                                           Stretch="UniformToFill"
                                                                           HorizontalAlignment="Stretch"
                                                                           VerticalAlignment="Stretch" />
                                                                </Border>

                                                                <!-- Artist Spotlight Portrait layer (Dark ambient gradient + concentric rings + circular avatar) -->
                                                                <Grid Visibility="{x:Bind IsArtistSpotlight, Mode=OneWay}">
                                                                    <Border CornerRadius="23">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                                <GradientStop Color="#FF2A1F38" Offset="0.0" />
                                                                                <GradientStop Color="#FF181524" Offset="0.55" />
                                                                                <GradientStop Color="#FF0E1019" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <!-- Concentric Acoustic Rings behind Artist Spotlight Avatar -->
                                                                    <Border Width="164" Height="164"
                                                                            CornerRadius="82"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,24,0,0"
                                                                            BorderBrush="#1AFFFFFF"
                                                                            BorderThickness="1"
                                                                            IsHitTestVisible="False" />
                                                                    <Border Width="132" Height="132"
                                                                            CornerRadius="66"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,40,0,0"
                                                                            BorderBrush="#2CFFFFFF"
                                                                            BorderThickness="1"
                                                                            IsHitTestVisible="False" />
                                                                    <Border Width="98" Height="98"
                                                                            CornerRadius="49"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,57,0,0"
                                                                            BorderBrush="#CCFFFFFF"
                                                                            BorderThickness="2"
                                                                            Background="#FF1B2030">
                                                                        <Border CornerRadius="47">
                                                                            <Image helpers:BitmapDecodeHelper.DecodeWidth="128"
                                                                                   helpers:BitmapDecodeHelper.SourceUri="{x:Bind views:ShellPage.ResolveConditionalUri(IsArtistSpotlight, SafeArtworkUri), Mode=OneWay}"
                                                                                   Stretch="UniformToFill"
                                                                                   HorizontalAlignment="Stretch"
                                                                                   VerticalAlignment="Stretch" />
                                                                        </Border>
                                                                    </Border>
                                                                </Grid>

                                                                <!-- Concentric Acoustic Rings Overlay for Mix / Personal Station (Matches Android TopPicksSection) -->
                                                                <Grid Opacity="{x:Bind PersonalStationRingOpacity, Mode=OneWay}"
                                                                      IsHitTestVisible="False">
                                                                    <Border Width="196" Height="196"
                                                                            CornerRadius="98"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Margin="-36,-22,0,0"
                                                                            BorderBrush="#20FFFFFF"
                                                                            BorderThickness="1" />
                                                                    <Border Width="148" Height="148"
                                                                            CornerRadius="74"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Margin="-12,2,0,0"
                                                                            BorderBrush="#2AFFFFFF"
                                                                            BorderThickness="1" />
                                                                    <Border Width="104" Height="104"
                                                                            CornerRadius="52"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Margin="10,24,0,0"
                                                                            BorderBrush="#36FFFFFF"
                                                                            BorderThickness="1.2" />
                                                                    <Border Width="62" Height="62"
                                                                            CornerRadius="31"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Margin="31,45,0,0"
                                                                            BorderBrush="#42FFFFFF"
                                                                            BorderThickness="1.2" />
                                                                </Grid>

                                                                <!-- Real GPU Progressive Blur on Lower Artwork Band -->
                                                                <Border IsHitTestVisible="False"
                                                                        Loaded="OnProgressiveCardBlurLoaded"
                                                                        SizeChanged="OnProgressiveCardBlurSizeChanged" />

                                                                <!-- Progressive Dark Gradient Scrim -->
                                                                <Border IsHitTestVisible="False" CornerRadius="23">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                            <GradientStop Color="#10000000" Offset="0.0" />
                                                                            <GradientStop Color="#06000000" Offset="0.34" />
                                                                            <GradientStop Color="#7C070A12" Offset="0.60" />
                                                                            <GradientStop Color="#D6070A12" Offset="0.82" />
                                                                            <GradientStop Color="#F2070A12" Offset="1.0" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>

                                                                <!-- Top-Right Frosted Type Badge (Hidden for New Releases to match Android) -->
                                                                <Border HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        Margin="0,12,12,0"
                                                                        CornerRadius="13"
                                                                        Padding="10,4"
                                                                        Background="#7A121622"
                                                                        BorderBrush="#42FFFFFF"
                                                                        BorderThickness="0.8"
                                                                        Opacity="{x:Bind BadgeOpacity, Mode=OneWay}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <Ellipse Width="5" Height="5" Fill="{ThemeResource TokenPrimaryAccentBrush}" VerticalAlignment="Center" />
                                                                        <FontIcon Glyph="{x:Bind BadgeGlyph, Mode=OneWay}" FontSize="10.5" Foreground="White" />
                                                                        <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}"
                                                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                                   FontSize="10.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="White" />
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Editorial Typography Flush Bottom -->
                                                                <StackPanel VerticalAlignment="Bottom"
                                                                            Spacing="3"
                                                                            Margin="14,0,14,14">
                                                                    <TextBlock Text="{x:Bind Eyebrow, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                               FontSize="9.5"
                                                                               FontWeight="SemiBold"
                                                                               CharacterSpacing="55"
                                                                               Foreground="#D0DCE8F8"
                                                                               MaxLines="1"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                               FontSize="15.5"
                                                                               FontWeight="Bold"
                                                                               Foreground="White"
                                                                               MaxLines="2"
                                                                               TextWrapping="Wrap"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                                                               FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                               FontSize="11.5"
                                                                               Foreground="#C4E2ECFF"
                                                                               MaxLines="2"
                                                                               TextWrapping="Wrap"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <!-- 2. Recently Played (Android-matched Irregular Bento Mosaic Carousel with Scroll-Edge Shrinking) -->
                            <StackPanel Visibility="{x:Bind ViewModel.HasHomeRecentlyPlayedVisibility, Mode=OneWay}"
                                        Spacing="10">
                                <TextBlock Text="Recently Played"
                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                           FontSize="18.5"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TokenPrimaryTextBrush}"
                                           Margin="2,0,0,0" />

                                <Grid x:Name="HomeRecentlyPlayedCarouselHost">
                                    <ScrollViewer x:Name="HomeRecentlyPlayedScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Padding="18,12,18,20"
                                                  Loaded="OnHomeHorizontalCarouselLoaded"
                                                  SizeChanged="OnHomeHorizontalCarouselSizeChanged"
                                                  ViewChanged="OnHomeHorizontalCarouselViewChanged">
                                        <ItemsControl x:Name="HomeRecentlyPlayedItemsControl"
                                                      ItemsSource="{x:Bind ViewModel.HomeRecentlyPlayedAlbums, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:RecentlyPlayedMosaicPanel ColumnWidth="196"
                                                                                        MosaicHeight="416"
                                                                                        ColumnSpacing="12"
                                                                                        RowSpacing="12"
                                                                                        SingleItemSize="220"
                                                                                        MosaicArranged="OnHomeRecentlyPlayedMosaicArranged"
                                                                                        SizeChanged="OnHomeHorizontalItemsPanelSizeChanged" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:RecentAlbumItem">
                                                    <Border CornerRadius="24"
                                                            BorderBrush="#2AFFFFFF"
                                                            BorderThickness="1"
                                                            Background="#FF1A1E28"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            helpers:MicroInteractions.HoverScale="1.03"
                                                            helpers:MicroInteractions.PressScale="0.96">
                                                        <Grid Tapped="OnHomeRecentAlbumTapped"
                                                              RightTapped="OnHomeRecentAlbumRightTapped"
                                                              Tag="{x:Bind}"
                                                              Background="Transparent">
                                                            <Grid Opacity="{x:Bind DefaultCoverIconOpacity, Mode=OneWay}">
                                                                <FontIcon Glyph="&#xEC4F;"
                                                                          FontSize="34"
                                                                          Foreground="{ThemeResource TokenPrimaryAccentBrush}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                            </Grid>
                                                            <Border CornerRadius="23" Opacity="{x:Bind CoverArtOpacity, Mode=OneWay}">
                                                                <Image helpers:BitmapDecodeHelper.DecodeWidth="256" helpers:BitmapDecodeHelper.SourceUri="{x:Bind SafeCoverArtUri, Mode=OneWay}"
                                                                       Stretch="UniformToFill"
                                                                       HorizontalAlignment="Stretch"
                                                                       VerticalAlignment="Stretch" />
                                                            </Border>

                                                            <Border IsHitTestVisible="False"
                                                                    Loaded="OnProgressiveCardBlurLoaded"
                                                                    SizeChanged="OnProgressiveCardBlurSizeChanged" />

                                                            <Border IsHitTestVisible="False" CornerRadius="23">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                        <GradientStop Color="#00000000" Offset="0.0" />
                                                                        <GradientStop Color="#0C070A12" Offset="0.44" />
                                                                        <GradientStop Color="#84070A12" Offset="0.76" />
                                                                        <GradientStop Color="#CC070A12" Offset="1.0" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>

                                                            <StackPanel VerticalAlignment="Bottom" Spacing="2" Margin="13,0,13,11">
                                                                <TextBlock Text="{x:Bind AlbumTitle, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                                           FontSize="12.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="White"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                                           FontFamily="{StaticResource TokenBodyFontFamily}"
                                                                           FontSize="11"
                                                                           Foreground="#D6DCE8"
                                                                           MaxLines="1"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <!-- 3. More like: [Album] #1 (Up to 15 Similar Albums) -->
                            <StackPanel Visibility="{x:Bind ViewModel.HomeMoreLike1Visibility, Mode=OneWay}"
                                        Spacing="10">
                                <Grid Margin="2,0,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                        <Border Width="28" Height="28"
                                                CornerRadius="9"
                                                Background="#2422D3EE"
                                                BorderBrush="#5522D3EE"
                                                BorderThickness="1">
                                            <FontIcon Glyph="&#xE958;" FontSize="13" Foreground="#38BDF8" />
                                        </Border>
                                        <TextBlock Text="{x:Bind ViewModel.HomeMoreLike1Title, Mode=OneWay}"
                                                   FontFamily="{StaticResource TokenHeadingFontFamily}"
                                                   FontSize="18.5"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
