                    <!-- ========================================================================= -->
                    <!-- VIEW 3: ALBUM DETAIL SCREEN (Aligned with Android Sister App + Canvas)    -->
                    <!-- Left Album Column (Cover/Canvas, Info, LiquidGlass Play/Shuffle, Bio)     -->
                    <!-- Right Flat Tracklist Column + Other Versions + More by Artist Carousels   -->
                    <!-- ========================================================================= -->
                    <StackPanel x:Name="AlbumDetailSectionRoot"
                                x:Load="{x:Bind ViewModel.IsAlbumDetailViewOpen, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.AlbumDetailViewVisibility, Mode=OneWay}"
                                Spacing="26"
                                Margin="-22,-68,-14,-32"
                                Padding="28,74,28,42"
                                Background="{StaticResource AlbumAmbientBackgroundBrush}">

                        <!-- Top-Left Circular LiquidGlass Back Button (Icon Only) -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <controls:LiquidGlassPanel Width="44"
                                                       Height="44"
                                                       GlassCornerRadius="22"
                                                       GlassPadding="0"
                                                       SampleLiveBackdrop="True"
                                                       EnableHoverScale="True">
                                <Button Command="{x:Bind ViewModel.NavigateBackFromDetailCommand, Mode=OneWay}"
