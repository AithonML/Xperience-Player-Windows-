<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- REUSABLE CONTROL TEMPLATES FOR LIQUID GLASS BUTTONS & PILLS               -->
    <!-- ========================================================================= -->

    <!-- Embedded Glass Button Template (Completely transparent hover so parent LiquidGlassPanel handles all specular borders, meniscus, and elevation) -->
    <Style x:Key="TransparentEmbeddedButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TokenPrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="Transparent"
                          Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.95" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.75" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation & Filter Pill Button Template (Fills 100% of its parent pill container with matching CornerRadius) -->
    <Style x:Key="LiquidPillSegmentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TokenPrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="FontFamily" Value="{StaticResource TokenSubheadingFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="#24FFFFFF" />
                                        <Setter Target="RootGrid.BorderBrush" Value="#50FFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="#38FFFFFF" />
                                        <Setter Target="ContentPresenter.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent Media Card Button Style (Used for Artist Circles, Album Cards & Song Rows so hover never draws a rectangular box or clips scale/elevation) -->
    <Style x:Key="TransparentMediaCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,10,8,6" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="CardRoot"
                          Background="Transparent"
                          Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="CardContent.Opacity" Value="0.86" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="CardContent"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lightweight GPU-Composited Specular Glass Border for Song Rows (Zero Win2D CanvasControl overhead for 120 FPS scrolling & instant view switching) -->
    <Style x:Key="SpecularSongRowBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{ThemeResource TokenSurfaceBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TokenGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Lightweight GPU-Composited Specular Glass Card Border for Info/Settings Cards -->
    <Style x:Key="SpecularGlassCardBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Background" Value="{ThemeResource TokenSurfaceBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TokenGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Active Segmented Pill Button Style (Shows recessed/elevated glass capsule) -->
    <Style x:Key="LiquidPillActiveSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource LiquidPillSegmentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource TokenActiveSegmentBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TokenActiveSegmentBorderBrush}" />
    </Style>

    <!-- Bespoke Borderless Liquid Glass Search TextBox Style (Eliminates native WinUI box & underline) -->
    <Style x:Key="LiquidGlassSearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{ThemeResource TokenPrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource TokenPrimaryAccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TokenBodyFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent" VerticalAlignment="Center">
                        <TextBlock x:Name="PlaceholderTextContentPresenter"
                                   Text="{TemplateBinding PlaceholderText}"
                                   Foreground="{ThemeResource TokenSecondaryTextBrush}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Opacity="0.72"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" />
                        <ScrollViewer x:Name="ContentElement"
                                      HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                                      IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                                      IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                      Margin="0"
                                      Padding="0"
                                      VerticalAlignment="Center"
                                      IsTabStop="False"
                                      AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Circular Translucent Glass Icon Button Style -->
    <Style x:Key="GlassCircleIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#381E2126" />
        <Setter Property="BorderBrush" Value="#55FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource TokenPrimaryTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource TokenTealActionBrush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="#AAFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource TokenPrimaryAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dynamic Accent Circular Action Button Style (Used for '+' and Song Row Play Icon) -->
    <Style x:Key="TealActionCircleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource TokenTealActionBrush}" />
        <Setter Property="BorderBrush" Value="#66FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource TokenPrimaryAccentBrush}" />
                                        <Setter Target="RootGrid.BorderBrush" Value="#CCFFFFFF" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- CUSTOM LIQUID GLASS SCROLLBAR & SCROLLVIEWER TEMPLATES                    -->
    <!-- ========================================================================= -->

    <!-- Invisible Page-Up / Page-Down RepeatButton inside the Glass ScrollBar Track -->
    <Style x:Key="LiquidGlassTrackRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liquid Glass Pill Thumb Style (Adaptive translucent optical pill) -->
    <Style x:Key="LiquidGlassScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Background" Value="{ThemeResource TokenPrimaryAccentBrush}" />
        <Setter Property="BorderBrush" Value="#44FFFFFF" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid x:Name="ThumbRoot" Margin="0,1">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ThumbPill.Opacity" Value="0.80" />
                                        <Setter Target="ThumbPill.BorderBrush" Value="#AAFFFFFF" />
                                        <Setter Target="SpecularOverlay.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ThumbPill.Opacity" Value="0.95" />
                                        <Setter Target="ThumbPill.BorderBrush" Value="#FFFFFFFF" />
                                        <Setter Target="SpecularOverlay.Opacity" Value="0.60" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Dynamic Accent + Semi-Transparent Gradient Glass Pill -->
                        <Border x:Name="ThumbPill"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Opacity="0.38" />

                        <!-- Soft Vertical Gradient Mask on Thumb -->
                        <Border x:Name="SpecularOverlay"
                                CornerRadius="3"
                                Opacity="0.25"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0.0" Color="#66FFFFFF" />
                                    <GradientStop Offset="0.5" Color="#18FFFFFF" />
                                    <GradientStop Offset="1.0" Color="#44FFFFFF" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom Liquid Glass ScrollBar Style (Always-sleek capsule tube, track fades in only on hover) -->
    <Style x:Key="LiquidGlassScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#15FFFFFF" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="VerticalTrackBorder.Opacity" Value="0.45" />
                                        <Setter Target="HorizontalTrackBorder.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ScrollingIndicatorStates">
                                <VisualState x:Name="TouchIndicator" />
                                <VisualState x:Name="MouseIndicator" />
                                <VisualState x:Name="NoIndicator" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Vertical Liquid Glass ScrollBar -->
                        <Grid x:Name="VerticalRoot"
                              Width="6"
                              HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Soft Semi-Transparent Gradient Glass Capsule Track Background -->
                            <Border x:Name="VerticalTrackBorder"
                                    Grid.RowSpan="5"
                                    Width="6"
                                    CornerRadius="3"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Opacity="0.0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0.0" Color="#04FFFFFF" />
                                        <GradientStop Offset="0.15" Color="#12FFFFFF" />
                                        <GradientStop Offset="0.85" Color="#12FFFFFF" />
                                        <GradientStop Offset="1.0" Color="#04FFFFFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Zero-height Small Decrease/Increase so WinUI track math works without arrow buttons -->
                            <RepeatButton x:Name="VerticalSmallDecrease"
                                          Grid.Row="0"
                                          Height="1"
                                          Opacity="0"
                                          IsHitTestVisible="False"
                                          Style="{StaticResource LiquidGlassTrackRepeatButtonStyle}" />

                            <RepeatButton x:Name="VerticalLargeDecrease"
                                          Grid.Row="1"
                                          Style="{StaticResource LiquidGlassTrackRepeatButtonStyle}" />

                            <Thumb x:Name="VerticalThumb"
                                   Grid.Row="2"
                                   Width="6"
                                   Style="{StaticResource LiquidGlassScrollBarThumbStyle}" />

                            <RepeatButton x:Name="VerticalLargeIncrease"
                                          Grid.Row="3"
                                          Style="{StaticResource LiquidGlassTrackRepeatButtonStyle}" />

                            <RepeatButton x:Name="VerticalSmallIncrease"
                                          Grid.Row="4"
                                          Height="1"
                                          Opacity="0"
                                          IsHitTestVisible="False"
                                          Style="{StaticResource LiquidGlassTrackRepeatButtonStyle}" />

                            <Border x:Name="VerticalPanningThumb"
                                    Grid.Row="2"
                                    Visibility="Collapsed" />
                        </Grid>

                        <!-- Horizontal Liquid Glass ScrollBar -->
                        <Grid x:Name="HorizontalRoot"
                              Height="6"
                              VerticalAlignment="Center"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="HorizontalTrackBorder"
                                    Grid.ColumnSpan="5"
                                    Height="6"
                                    CornerRadius="3"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Opacity="0.0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0.0" Color="#04FFFFFF" />
                                        <GradientStop Offset="0.15" Color="#12FFFFFF" />
                                        <GradientStop Offset="0.85" Color="#12FFFFFF" />
                                        <GradientStop Offset="1.0" Color="#04FFFFFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <RepeatButton x:Name="HorizontalSmallDecrease"
                                          Grid.Column="0"
                                          Width="1"
                                          Opacity="0"
                                          IsHitTestVisible="False"
                                          Style="{StaticResource LiquidGlassTrackRepeatButtonStyle}" />

                            <RepeatButton x:Name="HorizontalLargeDecrease"
                                          Grid.Column="1"
                                          Style="{StaticResource LiquidGlassTrackRepeatButtonStyle}" />

                            <Thumb x:Name="HorizontalThumb"
                                   Grid.Column="2"
                                   Height="6"
                                   Style="{StaticResource LiquidGlassScrollBarThumbStyle}" />

                            <RepeatButton x:Name="HorizontalLargeIncrease"
                                          Grid.Column="3"
                                          Style="{StaticResource LiquidGlassTrackRepeatButtonStyle}" />

                            <RepeatButton x:Name="HorizontalSmallIncrease"
                                          Grid.Column="4"
                                          Width="1"
                                          Opacity="0"
                                          IsHitTestVisible="False"
                                          Style="{StaticResource LiquidGlassTrackRepeatButtonStyle}" />

                            <Border x:Name="HorizontalPanningThumb"
                                    Grid.Column="2"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom ScrollViewer Template embedding the LiquidGlassScrollBarStyle -->
    <Style x:Key="LiquidGlassScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollMode" Value="Disabled" />
        <Setter Property="VerticalScrollMode" Value="Enabled" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Content spans full width so elements pass smoothly behind the floating scrollbar -->
                        <ScrollContentPresenter x:Name="ScrollContentPresenter"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Margin="{TemplateBinding Padding}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!-- Top margin 78px keeps the scrollbar well below the top header and window caption buttons -->
                        <ScrollBar x:Name="VerticalScrollBar"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="2,78,2,18"
                                   HorizontalAlignment="Right"
                                   IsTabStop="False"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   Orientation="Vertical"
                                   Style="{StaticResource LiquidGlassScrollBarStyle}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   ViewportSize="{TemplateBinding ViewportHeight}" />

                        <ScrollBar x:Name="HorizontalScrollBar"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Margin="6,4,6,2"
                                   IsTabStop="False"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   Orientation="Horizontal"
                                   Style="{StaticResource LiquidGlassScrollBarStyle}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   ViewportSize="{TemplateBinding ViewportWidth}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
